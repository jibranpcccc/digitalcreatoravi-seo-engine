      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the primary architectural difference between Reusable Workflows and Composite Actions?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Reusable workflows operate at the job level, running on separate fresh runner virtual machines with independent billing, environment variables, and matrix support. Composite actions operate at the step level, executing sequentially inside the caller job's existing runner filesystem with near-zero initialization overhead."
          }
        },
        {
          "@type": "Question",
          "name": "Can Composite Actions natively inherit GitHub Organization Secrets?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Composite actions cannot directly access the secrets context. All secrets must be explicitly passed into the composite action as typed string inputs from the calling workflow. Reusable workflows, by contrast, support both explicit secret definitions and the convenient 'secrets: inherit' directive."
          }
        },
        {
          "@type": "Question",
          "name": "What is the maximum nesting depth for Reusable Workflows vs Composite Actions?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Reusable workflows enforce a hard limit of 4 nested call levels (caller -> workflow B -> workflow C -> workflow D). Composite actions support up to 10 nested levels of composite action calls inside a single step context."
          }
        },
        {
          "@type": "Question",
          "name": "Which approach is faster for multi-step setup scripts like caching and linting?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Composite actions are significantly faster for routine build steps because they avoid the 15 to 45-second latency of provisioning a new virtual machine runner, executing directly within the existing workspace."
          }
        }
      ]
