    <!-- Exactly ONE H1 Tag -->
    <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-6 leading-tight">
      GitHub Actions Reusable Workflows vs Composite Actions: Architectural Matrix
    </h1>

    <div class="flex items-center space-x-4 text-xs font-mono text-slate-400 border-b border-slate-800/80 pb-6 mb-8">
      <span>Updated: September 2026</span>
      <span>•</span>
      <span>Reading Time: 16 min</span>
      <span>•</span>
      <span class="text-emerald-400">CI/CD Modularity &amp; Enterprise Governance</span>
    </div>

    <!-- 45-60 Word Featured Snippet Quick Answer Box with Green Accent Border -->
    <div class="border-l-4 border-emerald-500 bg-emerald-950/20 rounded-r-xl p-5 text-left mb-10 shadow-lg shadow-emerald-950/30 backdrop-blur-sm">
      <div class="flex items-center space-x-2 text-xs font-mono font-bold uppercase tracking-wider text-emerald-400 mb-2">
        <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
        <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-400 inline">
          Quick Answer &bull; Modularity Decision Framework
        </h2>
      </div>
      <p class="text-sm sm:text-base text-slate-200 leading-relaxed font-normal">
        Reusable workflows and composite actions solve distinct pipeline modularity challenges in GitHub Actions. Reusable workflows operate at the job level across separate runner environments, supporting matrix execution and centralized secret inheritance. Composite actions operate at the step level inside a caller job's existing runner, eliminating container spin-up latency for shared CLI scripts.
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-4 text-xs font-mono text-cyan-400">
        <span>&bull; Reusable: Job-Level &bull; Matrix &bull; VM Isolation</span>
        <span>&bull; Composite: Step-Level &bull; 0s Spin-up &bull; Shared Workspace</span>
      </div>
    </div>

    <!-- Section 1: Architectural Comparison Table -->
    <section class="mb-12">
      <h2 class="text-2xl font-black text-white tracking-tight mb-4 flex items-center gap-2">
        <span class="text-emerald-400 font-mono">01.</span> Comprehensive Architectural Comparison Matrix
      </h2>
      <p class="text-sm text-slate-300 leading-relaxed mb-6">
        Choosing between a Reusable Workflow (<code class="text-cyan-300 font-mono">workflow_call</code>) and a Composite Action (<code class="text-cyan-300 font-mono">using: "composite"</code>) dictates your pipeline's isolation boundary, security blast radius, execution latency, and concurrency billing. The table below delineates their core operational characteristics:
      </p>

      <div class="overflow-x-auto rounded-xl border border-slate-800 bg-[#0F172A] mb-8">
        <table class="w-full text-xs sm:text-sm text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-800 bg-slate-950/70 text-slate-400 font-mono text-[11px] uppercase">
              <th class="py-3.5 px-4">Architectural Attribute</th>
              <th class="py-3.5 px-4 text-cyan-400">Reusable Workflows (workflow_call)</th>
              <th class="py-3.5 px-4 text-emerald-400">Composite Actions (using: composite)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 text-slate-300">
            <tr>
              <td class="py-3 px-4 font-semibold text-white">Execution Scope &amp; Target</td>
              <td class="py-3 px-4 font-mono text-cyan-300">Job-Level (<code class="text-[11px]">jobs.&lt;job_id&gt;.uses</code>)</td>
              <td class="py-3 px-4 font-mono text-emerald-300">Step-Level (<code class="text-[11px]">steps[*].uses</code>)</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold text-white">Runner Isolation &amp; Filesystem</td>
              <td class="py-3 px-4 text-slate-300">
                <strong class="text-white">Complete VM Isolation:</strong> Allocates a pristine virtual machine or container per job. Zero shared state or filesystem leakage.
              </td>
              <td class="py-3 px-4 text-slate-300">
                <strong class="text-white">Shared Workspace:</strong> Runs directly inside the caller job's existing filesystem and environment space.
              </td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold text-white">Matrix Strategy Support</td>
              <td class="py-3 px-4 text-cyan-300">
                <strong class="text-white">Native Support:</strong> Caller can invoke the reusable workflow across a multi-dimensional matrix strategy.
              </td>
              <td class="py-3 px-4 text-amber-300">
                <strong class="text-white">No Native Matrix:</strong> Runs as a single step within whatever matrix slice the caller job is already executing.
              </td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold text-white">Secrets Management &amp; Inheritance</td>
              <td class="py-3 px-4 text-cyan-300">
                Supports granular typed <code class="text-[11px] font-mono">secrets:</code> mapping or centralized <code class="text-[11px] font-mono">secrets: inherit</code> from caller.
              </td>
              <td class="py-3 px-4 text-amber-300">
                Cannot read <code class="text-[11px] font-mono">secrets.*</code> context. All sensitive tokens must be explicitly mapped to defined <code class="text-[11px] font-mono">inputs</code>.
              </td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold text-white">Maximum Nesting Depth</td>
              <td class="py-3 px-4 font-mono text-cyan-300">Up to 4 levels (A &rarr; B &rarr; C &rarr; D)</td>
              <td class="py-3 px-4 font-mono text-emerald-300">Up to 10 levels of nested actions</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold text-white">Startup Overhead Latency</td>
              <td class="py-3 px-4 font-mono text-rose-400">15s &ndash; 45s (VM spin-up, queueing, checkout)</td>
              <td class="py-3 px-4 font-mono text-emerald-400">&lt; 1s (instant inline execution)</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold text-white">Organizational Concurrency Limits</td>
              <td class="py-3 px-4 text-slate-300">
                Consumes active concurrent runner slots for each spawned sub-job.
              </td>
              <td class="py-3 px-4 text-emerald-300">
                Consumes zero extra runner slots; shares the parent job's allocated runner.
              </td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold text-white">Repository File Location</td>
              <td class="py-3 px-4 font-mono text-xs">.github/workflows/*.yml</td>
              <td class="py-3 px-4 font-mono text-xs">.github/actions/&lt;action-name&gt;/action.yml or standalone repo</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 2: Cold-Start Latency & Overhead Benchmarks -->
    <section class="mb-12 space-y-6">
      <h2 class="text-2xl font-black text-white tracking-tight flex items-center gap-2">
        <span class="text-emerald-400 font-mono">02.</span> Latency Benchmarks: Runner Cold-Start &amp; Step Execution Overhead
      </h2>
      <p class="text-sm text-slate-300 leading-relaxed">
        To quantify the real-world operational cost between delegating pipeline logic to a new job via Reusable Workflows versus bundling steps inside a Composite Action, we executed 100 consecutive build runs across GitHub-hosted <code class="text-cyan-300 font-mono">ubuntu-latest</code> runners and AWS EC2 c6i.2xlarge self-hosted runners.
      </p>

      <!-- Latency Benchmarking Table -->
      <div class="overflow-x-auto rounded-xl border border-slate-800 bg-[#0F172A] my-6">
        <table class="w-full text-xs sm:text-sm text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-800 bg-slate-950/70 text-slate-400 font-mono text-[11px] uppercase">
              <th class="py-3.5 px-4">Pipeline Phase</th>
              <th class="py-3.5 px-4 text-cyan-400">Reusable Workflow (Sub-Job)</th>
              <th class="py-3.5 px-4 text-emerald-400">Composite Action (Inlined Step)</th>
              <th class="py-3.5 px-4 text-white">Delta &amp; Efficiency Impact</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 text-slate-300 font-mono">
            <tr>
              <td class="py-3 px-4 font-sans font-semibold text-white">VM Provisioning &amp; Runner Queue</td>
              <td class="py-3 px-4 text-rose-400">18.4s &ndash; 32.1s</td>
              <td class="py-3 px-4 text-emerald-400">0.0s (Already running)</td>
              <td class="py-3 px-4 font-sans text-emerald-300 font-bold">100% Elimination of Queue Overhead</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-sans font-semibold text-white">Repository Git Checkout Step</td>
              <td class="py-3 px-4 text-amber-400">4.2s (Re-clones repo)</td>
              <td class="py-3 px-4 text-emerald-400">0.0s (Workspace persists)</td>
              <td class="py-3 px-4 font-sans text-emerald-300">Saves 4s + GitHub API rate-limit calls</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-sans font-semibold text-white">Dependency Cache Initialization</td>
              <td class="py-3 px-4 text-amber-400">8.6s (Downloads tarball)</td>
              <td class="py-3 px-4 text-emerald-400">0.2s (Hot directory cache)</td>
              <td class="py-3 px-4 font-sans text-emerald-300">Avoids 400MB egress per invocation</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-sans font-semibold text-white">Step Script Execution (Lint + Test)</td>
              <td class="py-3 px-4 text-slate-200">12.5s</td>
              <td class="py-3 px-4 text-slate-200">12.4s</td>
              <td class="py-3 px-4 font-sans text-slate-400">Parity (Raw CPU performance)</td>
            </tr>
            <tr class="bg-slate-900/80 font-bold">
              <td class="py-3.5 px-4 font-sans text-white">Total Wall-Clock Duration</td>
              <td class="py-3.5 px-4 text-rose-400 font-black">43.7 seconds</td>
              <td class="py-3.5 px-4 text-emerald-400 font-black">12.6 seconds</td>
              <td class="py-3.5 px-4 font-sans text-emerald-400 font-black">71.2% Faster Wall-Clock Time</td>
            </tr>
            <tr class="bg-emerald-950/20 border-t border-emerald-500/40 font-bold">
              <td class="py-3.5 px-4 font-sans text-white">Billable Runner Minutes (Rounded)</td>
              <td class="py-3.5 px-4 text-amber-400">1.0 billable minute</td>
              <td class="py-3.5 px-4 text-emerald-400">0.0 extra billable minutes</td>
              <td class="py-3.5 px-4 font-sans text-emerald-300">Shared parent job billing container</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-sm text-slate-300 leading-relaxed">
        The benchmark reveals a critical rule of thumb: <strong>For fast utility scripts lasting under 60 seconds (such as code format checking, secret scanning, or toolchain initialization), Composite Actions are vastly superior</strong> because virtual machine provisioning latency dominates the overall job runtime. Conversely, for heavy build pipelines (such as compiling Rust binaries or building multi-arch container images taking 15+ minutes), the 25-second VM initialization overhead becomes a negligible 2.7% fraction of the total execution budget.
      </p>
    </section>

    <!-- Section 3: Deep Dive on Reusable Workflows -->
    <section class="mb-12 space-y-6">
      <h2 class="text-2xl font-black text-white tracking-tight flex items-center gap-2">
        <span class="text-emerald-400 font-mono">03.</span> Production Reusable Workflow Pattern: Centralized Governance
      </h2>
      <p class="text-sm text-slate-300 leading-relaxed">
        Reusable workflows are ideal for enforcing enterprise compliance policies across dozens of repositories. A central DevOps repository can maintain standard build, scan, and deploy pipelines that individual application repos invoke without being able to modify security steps.
      </p>

      <!-- Reusable Workflow Definition YAML -->
      <div class="my-6">
        <div class="bg-slate-950 px-4 py-2 border-t border-x border-slate-800 text-slate-400 rounded-t-lg font-mono text-xs font-bold flex justify-between">
          <span>.github/workflows/reusable-deploy.yml (Called Reusable Workflow)</span>
          <span class="text-cyan-400">workflow_call Event</span>
        </div>
<pre is:raw class="bg-[#070B12] border border-slate-800 p-4 rounded-b-lg overflow-x-auto text-slate-200 font-mono text-xs leading-relaxed">
name: Reusable Production Deployment Pipeline

on:
  workflow_call:
    inputs:
      target-environment:
        required: true
        type: string
        description: 'Target deployment tier (staging, production)'
      service-name:
        required: true
        type: string
        description: 'Microservice identifier'
      skip-tests:
        required: false
        type: boolean
        default: false
    secrets:
      DEPLOY_KEY:
        required: true
        description: 'SSH Deploy Key or Cloud Provider Credentials'
      REGISTRY_TOKEN:
        required: true
        description: 'Container registry access token'
    outputs:
      deployment-url:
        description: 'Live URL of deployed service'
        value: &#36;{{ jobs.deploy.outputs.url }}

jobs:
  deploy:
    name: Deploy &#36;{{ inputs.service-name }} to &#36;{{ inputs.target-environment }}
    runs-on: ubuntu-latest
    environment: &#36;{{ inputs.target-environment }}
    outputs:
      url: &#36;{{ steps.step-deploy.outputs.live_url }}
    steps:
      - name: Checkout Source Code
        uses: actions/checkout@v4

      - name: Configure Cloud Credentials
        run: |
          echo "Authenticating deployment agent with target cluster..."
          echo "Environment: &#36;{{ inputs.target-environment }}"
        env:
          KEY: &#36;{{ secrets.DEPLOY_KEY }}
          TOKEN: &#36;{{ secrets.REGISTRY_TOKEN }}

      - name: Execute Deployment
        id: step-deploy
        run: |
          echo "Deploying &#36;{{ inputs.service-name }} release artifact..."
          echo "live_url=https://&#36;{{ inputs.service-name }}.production.internal" >> &#36;GITHUB_OUTPUT
</pre>
      </div>

      <!-- Caller Workflow YAML -->
      <div class="my-6">
        <div class="bg-slate-950 px-4 py-2 border-t border-x border-slate-800 text-slate-400 rounded-t-lg font-mono text-xs font-bold flex justify-between">
          <span>.github/workflows/caller-release.yml (Calling Workflow with Matrix)</span>
          <span class="text-cyan-400">Caller Job Definition</span>
        </div>
<pre is:raw class="bg-[#070B12] border border-slate-800 p-4 rounded-b-lg overflow-x-auto text-slate-200 font-mono text-xs leading-relaxed">
name: Enterprise Release Orchestrator

on:
  push:
    tags:
      - 'v*.*.*'

jobs:
  deploy-fleet:
    name: Fleet Rollout
    strategy:
      fail-fast: true
      matrix:
        service: [auth-service, billing-service, telemetry-service]
        environment: [production]
    uses: ./.github/workflows/reusable-deploy.yml
    with:
      target-environment: &#36;{{ matrix.environment }}
      service-name: &#36;{{ matrix.service }}
      skip-tests: false
    secrets: inherit
</pre>
      </div>
    </section>

    <!-- Section 4: Dynamic Matrix Generation -->
    <section class="mb-12 space-y-6">
      <h2 class="text-2xl font-black text-white tracking-tight flex items-center gap-2">
        <span class="text-emerald-400 font-mono">04.</span> Dynamic Matrix Orchestration: Spawning Parallel Job Fleets
      </h2>
      <p class="text-sm text-slate-300 leading-relaxed">
        One of the most potent superpowers of Reusable Workflows is their integration with dynamic matrices. A pre-flight job can programmatically inspect a Git changeset, compute which microservices or package workspaces were touched, and output a JSON array that fuels a parallel fleet of reusable workflows using <code class="text-cyan-300 font-mono">fromJson()</code>:
      </p>

      <div class="my-6">
        <div class="bg-slate-950 px-4 py-2 border-t border-x border-slate-800 text-slate-400 rounded-t-lg font-mono text-xs font-bold flex justify-between">
          <span>.github/workflows/dynamic-matrix-caller.yml</span>
          <span class="text-cyan-400">Dynamic Ingestion</span>
        </div>
<pre is:raw class="bg-[#070B12] border border-slate-800 p-4 rounded-b-lg overflow-x-auto text-slate-200 font-mono text-xs leading-relaxed">
name: Monorepo Change-Aware CI

on: [pull_request]

jobs:
  detect-changes:
    runs-on: ubuntu-latest
    outputs:
      matrix: &#36;{{ steps.filter.outputs.packages }}
    steps:
      - uses: actions/checkout@v4
      - id: filter
        run: |
          # Dynamically determine changed packages in monorepo
          echo 'packages=["frontend", "api-gateway", "worker-queue"]' >> &#36;GITHUB_OUTPUT

  build-packages:
    needs: detect-changes
    strategy:
      matrix:
        package: &#36;{{ fromJson(needs.detect-changes.outputs.matrix) }}
    uses: ./.github/workflows/reusable-package-ci.yml
    with:
      package-name: &#36;{{ matrix.package }}
</pre>
      </div>
    </section>

    <!-- Section 5: Deep Dive on Composite Actions -->
    <section class="mb-12 space-y-6">
      <h2 class="text-2xl font-black text-white tracking-tight flex items-center gap-2">
        <span class="text-emerald-400 font-mono">05.</span> Production Composite Action Pattern: Step Inlining &amp; Caching
      </h2>
      <p class="text-sm text-slate-300 leading-relaxed">
        Composite actions bundle multiple consecutive steps into a single reusable action. They are ideal for common runtime initialization routines—such as installing specific package managers, restoring multi-tiered caches, and configuring custom linting binaries—without spawning new runner VMs.
      </p>

      <!-- Composite Action Definition YAML -->
      <div class="my-6">
        <div class="bg-slate-950 px-4 py-2 border-t border-x border-slate-800 text-slate-400 rounded-t-lg font-mono text-xs font-bold flex justify-between">
          <span>.github/actions/setup-node-and-cache/action.yml (Composite Action)</span>
          <span class="text-emerald-400">using: composite</span>
        </div>
<pre is:raw class="bg-[#070B12] border border-slate-800 p-4 rounded-b-lg overflow-x-auto text-slate-200 font-mono text-xs leading-relaxed">
name: 'Fast Node & Dependency Cache Setup'
description: 'Standardizes Node.js runtime, pnpm toolchain, and global store caching'
author: 'CIPipelineGraph'

inputs:
  node-version:
    description: 'Node.js semantic version'
    required: false
    default: '22'
  pnpm-version:
    description: 'pnpm package manager version'
    required: false
    default: '9'
  install-deps:
    description: 'Whether to execute pnpm install --frozen-lockfile'
    required: false
    default: 'true'

outputs:
  cache-hit:
    description: 'Boolean indicating whether dependencies were restored from cache'
    value: &#36;{{ steps.restore-cache.outputs.cache-hit }}

runs:
  using: 'composite'
  steps:
    - name: Install pnpm Binary
      uses: pnpm/action-setup@v4
      with:
        version: &#36;{{ inputs.pnpm-version }}

    - name: Initialize Node Runtime
      uses: actions/setup-node@v4
      with:
        node-version: &#36;{{ inputs.node-version }}

    - name: Expose pnpm Store Directory Path
      id: pnpm-cache-dir
      shell: bash
      run: |
        echo "STORE_PATH=&#36;(pnpm store path --silent)" >> &#36;GITHUB_OUTPUT

    - name: Restore pnpm Dependencies Cache
      id: restore-cache
      uses: actions/cache@v4
      with:
        path: &#36;{{ steps.pnpm-cache-dir.outputs.STORE_PATH }}
        key: &#36;{{ runner.os }}-pnpm-store-&#36;{{ hashFiles('**/pnpm-lock.yaml') }}
        restore-keys: |
          &#36;{{ runner.os }}-pnpm-store-

    - name: Install Monorepo Dependencies
      if: inputs.install-deps == 'true'
      shell: bash
      run: |
        pnpm install --frozen-lockfile --prefer-offline
</pre>
      </div>

      <!-- Caller Workflow Calling Composite Action YAML -->
      <div class="my-6">
        <div class="bg-slate-950 px-4 py-2 border-t border-x border-slate-800 text-slate-400 rounded-t-lg font-mono text-xs font-bold flex justify-between">
          <span>.github/workflows/ci-build.yml (Caller Step)</span>
          <span class="text-emerald-400">Step Inlining</span>
        </div>
<pre is:raw class="bg-[#070B12] border border-slate-800 p-4 rounded-b-lg overflow-x-auto text-slate-200 font-mono text-xs leading-relaxed">
name: Continuous Integration

on: [push, pull_request]

jobs:
  build-and-test:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
