                <th class="px-4 py-3">Build Duration</th>
                <th class="px-4 py-3">Time Reduction</th>
                <th class="px-4 py-3">Runner Egress / Network</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60 font-mono text-xs">
              <tr class="hover:bg-slate-800/40">
                <td class="px-4 py-3 font-bold text-rose-400">Cold Build (No Cache)</td>
                <td class="px-4 py-3 text-slate-400">Default docker build</td>
                <td class="px-4 py-3 text-white font-semibold">9m 30s (570s)</td>
                <td class="px-4 py-3 text-slate-500">Baseline (0%)</td>
