      };

      // State
      let selectedNodeId = null;
      let parsedGraph = null;
      let viewBox = { x: 0, y: 0, width: 800, height: 500 };
      let isPanning = false;
      let startPoint = { x: 0, y: 0 };

      // DOM Elements
      const textarea = document.getElementById('yaml-input');
      const statJobCount = document.getElementById('stat-job-count');
      const statStages = document.getElementById('stat-stages');
      const statConcurrency = document.getElementById('stat-concurrency');
      const statStatus = document.getElementById('stat-status');
      const dagAlert = document.getElementById('dag-alert');
      const svg = document.getElementById('dag-svg');
      const stagesLayer = document.getElementById('dag-stages-layer');
      const edgesLayer = document.getElementById('dag-edges-layer');
      const nodesLayer = document.getElementById('dag-nodes-layer');
      const viewportGroup = document.getElementById('dag-viewport');

      // Inspector Elements
      const inspName = document.getElementById('insp-name');
      const inspTier = document.getElementById('insp-tier');
      const inspRunner = document.getElementById('insp-runner');
      const inspNeeds = document.getElementById('insp-needs');
      const inspDependents = document.getElementById('insp-dependents');

      // YAML Parser for CI Jobs & Needs
      function parseWorkflowYAML(yamlText) {
        const lines = yamlText.split('\\n');
        const jobs = {};
        let inJobs = false;
        let currentJob = null;
        let inNeedsList = false;

        for (let i = 0; i < lines.length; i++) {
          const line = lines[i];
          const trimmed = line.trim();
          if (!trimmed || trimmed.startsWith('#')) continue;

          const indent = line.search(/\\S/);

          // Detect top-level "jobs:"
          if (trimmed === 'jobs:' || trimmed.startsWith('jobs:')) {
            inJobs = true;
            currentJob = null;
            inNeedsList = false;
            continue;
          }

          if (inJobs) {
            // New top-level section under root cancels jobs:
            if (indent === 0 && !trimmed.startsWith('jobs:')) {
              inJobs = false;
              currentJob = null;
              continue;
            }

            // A job entry usually indented at 2 spaces (or 1 tab)
            // match "job_name:"
            const jobMatch = line.match(/^ {2}([a-zA-Z0-9_.-]+):\\s*$/);
            if (jobMatch) {
              const jobId = jobMatch[1];
              currentJob = jobId;
              inNeedsList = false;
              jobs[jobId] = {
                id: jobId,
                name: jobId,
                runsOn: 'ubuntu-latest',
                needs: [],
                dependents: []
              };
              continue;
            }

            if (currentJob && jobs[currentJob]) {
              // Check runs-on
              const runsOnMatch = trimmed.match(/^runs-on:\\s*(.+)$/);
              if (runsOnMatch) {
                jobs[currentJob].runsOn = runsOnMatch[1].replace(/['"\\[\\]]/g, '').trim();
                inNeedsList = false;
                continue;
              }

              // Check name:
              const nameMatch = trimmed.match(/^name:\\s*['"]?([^'"]+)['"]?$/);
              if (nameMatch && indent >= 4) {
                jobs[currentJob].name = nameMatch[1].trim();
                continue;
              }

              // Check inline needs: needs: [job1, job2] or needs: job1
              const needsInline = trimmed.match(/^needs:\\s*(.+)$/);
              if (needsInline) {
                const val = needsInline[1].trim();
                if (val.startsWith('[')) {
                  // array format
                  const items = val.replace(/[\\[\\]'"]/g, '').split(',').map(s => s.trim()).filter(Boolean);
                  jobs[currentJob].needs.push(...items);
                  inNeedsList = false;
                } else if (val === '') {
                  // multi-line array
                  inNeedsList = true;
                } else {
                  // single job
                  jobs[currentJob].needs.push(val.replace(/['"]/g, '').trim());
                  inNeedsList = false;
                }
                continue;
              }

              // Multi-line needs items: "- jobname"
              if (inNeedsList) {
                const itemMatch = trimmed.match(/^- ([a-zA-Z0-9_.-]+)$/);
                if (itemMatch) {
                  jobs[currentJob].needs.push(itemMatch[1]);
                  continue;
                } else if (!trimmed.startsWith('-')) {
                  inNeedsList = false;
                }
              }
            }
          }
        }

        return jobs;
      }

      // Build DAG and compute topological stages + cycles
      function buildDAG(jobs) {
        const jobIds = Object.keys(jobs);
        if (jobIds.length === 0) {
          return { isValid: false, error: "No jobs defined under 'jobs:' section.", jobs: {}, stages: [] };
        }

        // Populate dependents
        jobIds.forEach(id => {
          jobs[id].needs.forEach(parent => {
            if (jobs[parent]) {
              if (!jobs[parent].dependents.includes(id)) {
                jobs[parent].dependents.push(id);
              }
            }
          });
        });

        // Check for missing dependencies
        const missingDeps = [];
        jobIds.forEach(id => {
          jobs[id].needs.forEach(parent => {
            if (!jobs[parent]) {
              missingDeps.push(\`Job '\${id}' depends on undefined job '\${parent}'\`);
            }
          });
        });

        // Detect Cycles via Kahn's Algorithm / In-degree
        const inDegree = {};
        jobIds.forEach(id => {
          // only count existing parent dependencies
          inDegree[id] = jobs[id].needs.filter(p => jobs[p]).length;
        });

        const queue = jobIds.filter(id => inDegree[id] === 0);
        const stages = [];
        const jobStage = {};
        let processedCount = 0;

        let currentTier = queue.slice();
        let tierIndex = 0;

        while (currentTier.length > 0) {
          stages[tierIndex] = currentTier.slice();
          currentTier.forEach(id => {
            jobStage[id] = tierIndex;
            processedCount++;
          });

          const nextTier = [];
          currentTier.forEach(u => {
            jobs[u].dependents.forEach(v => {
              inDegree[v]--;
              if (inDegree[v] === 0) {
                nextTier.push(v);
              }
            });
          });

          currentTier = nextTier;
          tierIndex++;
        }

        const hasCycle = processedCount < jobIds.length;
        let cycleInfo = null;

        if (hasCycle) {
          const stuckJobs = jobIds.filter(id => inDegree[id] > 0);
          cycleInfo = \`Circular Dependency Deadlock Detected! Unresolvable jobs: \${stuckJobs.join(', ')}\`;
        }

        return {
          isValid: !hasCycle && missingDeps.length === 0,
          error: cycleInfo || (missingDeps.length > 0 ? missingDeps.join('; ') : null),
          jobs,
          stages,
          jobStage
        };
      }

      // Render DAG into SVG Canvas
      function renderDAG(dag) {
        stagesLayer.innerHTML = '';
        edgesLayer.innerHTML = '';
        nodesLayer.innerHTML = '';

        if (!dag || Object.keys(dag.jobs).length === 0) {
          statJobCount.textContent = '0';
          statStages.textContent = '0';
          statConcurrency.textContent = '0';
          statStatus.textContent = 'EMPTY';
          statStatus.className = 'text-xs font-bold text-slate-400 mt-1';
          return;
        }

        const jobCount = Object.keys(dag.jobs).length;
        statJobCount.textContent = jobCount;
        statStages.textContent = dag.stages.length;

        const maxConcurrency = Math.max(...dag.stages.map(s => s.length), 0);
        statConcurrency.textContent = maxConcurrency;

        if (dag.isValid) {
          statStatus.textContent = 'DAG VALID';
          statStatus.className = 'text-xs font-bold text-emerald-400 mt-1';
          dagAlert.className = 'hidden';
        } else {
          statStatus.textContent = 'CYCLE / ERROR';
          statStatus.className = 'text-xs font-bold text-rose-400 mt-1';
          dagAlert.className = 'p-3 rounded-lg text-xs font-mono bg-rose-950/40 border border-rose-800/80 text-rose-300';
          dagAlert.textContent = dag.error || 'Invalid dependency layout detected.';
          if (dag.stages.length === 0) return;
        }

        // Layout parameters
        const nodeWidth = 170;
        const nodeHeight = 65;
        const stageGapX = 220;
        const nodeGapY = 85;
        const paddingLeft = 50;
        const paddingTop = 60;

        const nodePositions = {};

        // Calculate positions
        dag.stages.forEach((stageJobs, stageIdx) => {
          const stageX = paddingLeft + stageIdx * stageGapX;
          const totalHeight = stageJobs.length * nodeGapY;

          // Render Stage column header & subtle divider
          const colX = stageX - 15;
          const colW = nodeWidth + 30;
          const colH = Math.max(500, (maxConcurrency + 1) * nodeGapY + 80);

          const stageBg = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
          stageBg.setAttribute('x', colX);
          stageBg.setAttribute('y', 15);
          stageBg.setAttribute('width', colW);
          stageBg.setAttribute('height', colH);
          stageBg.setAttribute('rx', '8');
          stageBg.setAttribute('fill', stageIdx % 2 === 0 ? '#0B1120' : '#080E18');
          stageBg.setAttribute('stroke', '#1E293B');
          stageBg.setAttribute('stroke-width', '1');
          stageBg.setAttribute('stroke-dasharray', '4 4');
          stagesLayer.appendChild(stageBg);

          const stageText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
          stageText.setAttribute('x', stageX + nodeWidth / 2);
          stageText.setAttribute('y', 35);
          stageText.setAttribute('text-anchor', 'middle');
          stageText.setAttribute('fill', '#94A3B8');
          stageText.setAttribute('font-family', 'JetBrains Mono, monospace');
          stageText.setAttribute('font-size', '11');
          stageText.setAttribute('font-weight', 'bold');
          stageText.textContent = \`STAGE \${stageIdx} (\${stageJobs.length} parallel)\`;
          stagesLayer.appendChild(stageText);

          stageJobs.forEach((jobId, jobIdx) => {
            const nodeY = paddingTop + jobIdx * nodeGapY;
            nodePositions[jobId] = {
              x: stageX,
              y: nodeY,
              cx: stageX + nodeWidth / 2,
              cy: nodeY + nodeHeight / 2,
              rightX: stageX + nodeWidth,
              leftX: stageX
            };
          });
        });

        // Render Directed Edges (Bezier Curves)
        Object.keys(dag.jobs).forEach(targetId => {
          const targetPos = nodePositions[targetId];
          if (!targetPos) return;

          dag.jobs[targetId].needs.forEach(sourceId => {
            const sourcePos = nodePositions[sourceId];
            if (!sourcePos) return;

            const startX = sourcePos.rightX;
            const startY = sourcePos.cy;
            const endX = targetPos.leftX;
            const endY = targetPos.cy;

            const deltaX = Math.max(30, (endX - startX) / 2);
            const pathData = \`M \${startX} \${startY} C \${startX + deltaX} \${startY}, \${endX - deltaX} \${endY}, \${endX} \${endY}\`;

            const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            path.setAttribute('d', pathData);
            path.setAttribute('fill', 'none');
            path.setAttribute('stroke', '#06B6D4');
            path.setAttribute('stroke-width', '2');
            path.setAttribute('stroke-opacity', '0.7');
            path.setAttribute('marker-end', 'url(#arrow)');
            path.setAttribute('data-source', sourceId);
            path.setAttribute('data-target', targetId);
            path.classList.add('dag-edge');
            edgesLayer.appendChild(path);
          });
        });

        // Render Job Nodes
        Object.keys(dag.jobs).forEach(jobId => {
          const pos = nodePositions[jobId];
          if (!pos) return;
          const job = dag.jobs[jobId];
          const stageIdx = dag.jobStage[jobId] ?? 0;

          const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
          g.setAttribute('transform', \`translate(\${pos.x}, \${pos.y})\`);
          g.setAttribute('data-job-id', jobId);
          g.classList.add('dag-node-group', 'cursor-pointer');

          // Card Background
          const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
          rect.setAttribute('width', nodeWidth);
          rect.setAttribute('height', nodeHeight);
          rect.setAttribute('rx', '10');
          rect.setAttribute('fill', '#0F172A');
          rect.setAttribute('stroke', '#1E293B');
          rect.setAttribute('stroke-width', '1.5');
          rect.classList.add('node-box', 'transition-all');
          g.appendChild(rect);

          // Status Icon Circle
          const iconCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          iconCircle.setAttribute('cx', 18);
          iconCircle.setAttribute('cy', 22);
          iconCircle.setAttribute('r', 6);
          iconCircle.setAttribute('fill', stageIdx === 0 ? '#10B981' : (job.dependents.length === 0 ? '#8B5CF6' : '#06B6D4'));
          g.appendChild(iconCircle);

          // Job Title
          const title = document.createElementNS('http://www.w3.org/2000/svg', 'text');
          title.setAttribute('x', 32);
          title.setAttribute('y', 26);
          title.setAttribute('fill', '#FFFFFF');
          title.setAttribute('font-family', 'JetBrains Mono, monospace');
          title.setAttribute('font-size', '12');
          title.setAttribute('font-weight', 'bold');
          title.textContent = jobId.length > 15 ? jobId.substring(0, 13) + '..' : jobId;
          g.appendChild(title);

          // Runner Badge text
          const runner = document.createElementNS('http://www.w3.org/2000/svg', 'text');
          runner.setAttribute('x', 14);
          runner.setAttribute('y', 48);
          runner.setAttribute('fill', '#94A3B8');
          runner.setAttribute('font-family', 'JetBrains Mono, monospace');
          runner.setAttribute('font-size', '9.5');
          runner.textContent = job.runsOn.length > 16 ? job.runsOn.substring(0, 14) + '..' : job.runsOn;
          g.appendChild(runner);

          // Upstream & Downstream badges
          const badges = document.createElementNS('http://www.w3.org/2000/svg', 'text');
          badges.setAttribute('x', nodeWidth - 10);
          badges.setAttribute('y', 48);
          badges.setAttribute('text-anchor', 'end');
          badges.setAttribute('fill', '#38BDF8');
          badges.setAttribute('font-family', 'JetBrains Mono, monospace');
          badges.setAttribute('font-size', '9');
          badges.textContent = \`in:\${job.needs.length} out:\${job.dependents.length}\`;
          g.appendChild(badges);

          // Node Click Interaction
          g.addEventListener('click', (e) => {
            e.stopPropagation();
            selectNode(jobId, dag);
          });

          nodesLayer.appendChild(g);
        });

        // Adjust SVG Viewport
        const requiredWidth = paddingLeft * 2 + dag.stages.length * stageGapX;
        const requiredHeight = paddingTop * 2 + (maxConcurrency + 1) * nodeGapY;
        svg.setAttribute('viewBox', \`0 0 \${Math.max(800, requiredWidth)} \${Math.max(500, requiredHeight)}\`);
      }

      // Highlight selected node and immediate / transitive connections
      function selectNode(jobId, dag) {
        selectedNodeId = jobId;
        const job = dag.jobs[jobId];
        if (!job) return;

        // Update Inspector
        inspName.textContent = jobId;
        inspTier.textContent = \`Stage \${dag.jobStage[jobId] ?? 0}\`;
        inspRunner.textContent = job.runsOn || 'ubuntu-latest';
        inspNeeds.textContent = job.needs.length > 0 ? job.needs.join(', ') : 'None (Root Node)';
        inspDependents.textContent = job.dependents.length > 0 ? job.dependents.join(', ') : 'None (Terminal Leaf)';

        // Highlighting in SVG
        const allNodes = document.querySelectorAll('.dag-node-group');
        const allEdges = document.querySelectorAll('.dag-edge');

        allNodes.forEach(node => {
          const id = node.getAttribute('data-job-id');
          const rect = node.querySelector('rect');
          if (id === jobId) {
            rect.setAttribute('stroke', '#22D3EE');
            rect.setAttribute('stroke-width', '3');
            rect.setAttribute('fill', '#162238');
          } else if (job.needs.includes(id)) {
            rect.setAttribute('stroke', '#8B5CF6');
            rect.setAttribute('stroke-width', '2');
            rect.setAttribute('fill', '#1A1B2E');
          } else if (job.dependents.includes(id)) {
            rect.setAttribute('stroke', '#10B981');
            rect.setAttribute('stroke-width', '2');
            rect.setAttribute('fill', '#0E231D');
          } else {
            rect.setAttribute('stroke', '#1E293B');
            rect.setAttribute('stroke-width', '1');
            rect.setAttribute('fill', '#0F172A');
          }
        });

        allEdges.forEach(edge => {
          const s = edge.getAttribute('data-source');
          const t = edge.getAttribute('data-target');

          if (t === jobId) {
            // upstream edge
            edge.setAttribute('stroke', '#8B5CF6');
            edge.setAttribute('stroke-width', '3');
            edge.setAttribute('marker-end', 'url(#arrow-upstream)');
            edge.setAttribute('stroke-opacity', '1');
          } else if (s === jobId) {
            // downstream edge
            edge.setAttribute('stroke', '#10B981');
            edge.setAttribute('stroke-width', '3');
            edge.setAttribute('marker-end', 'url(#arrow-highlight)');
            edge.setAttribute('stroke-opacity', '1');
          } else {
            edge.setAttribute('stroke', '#334155');
            edge.setAttribute('stroke-width', '1.5');
            edge.setAttribute('marker-end', 'url(#arrow)');
            edge.setAttribute('stroke-opacity', '0.3');
          }
        });
      }

      // Re-evaluate current YAML and re-render
      function updateWorkflow() {
        const text = textarea.value;
        const jobs = parseWorkflowYAML(text);
        parsedGraph = buildDAG(jobs);
        renderDAG(parsedGraph);
        if (selectedNodeId && parsedGraph.jobs[selectedNodeId]) {
          selectNode(selectedNodeId, parsedGraph);
        }
      }

      // Presets
      function loadPreset(presetKey) {
        if (!PRESETS[presetKey]) return;
        textarea.value = PRESETS[presetKey];
        document.querySelectorAll('.preset-btn').forEach(b => {
          b.classList.remove('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40');
          b.classList.add('bg-slate-800', 'text-slate-300', 'border-slate-700');
        });
        const activeBtn = document.getElementById(\`btn-preset-\${presetKey}\`);
        if (activeBtn) {
          activeBtn.classList.remove('bg-slate-800', 'text-slate-300', 'border-slate-700');
          activeBtn.classList.add('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40');
        }
        selectedNodeId = null;
        updateWorkflow();
      }

      // Event Listeners
      document.getElementById('btn-preset-node')?.addEventListener('click', () => loadPreset('node'));
      document.getElementById('btn-preset-python')?.addEventListener('click', () => loadPreset('python'));
      document.getElementById('btn-preset-monorepo')?.addEventListener('click', () => loadPreset('monorepo'));

      textarea.addEventListener('input', () => {
        updateWorkflow();
      });

      document.getElementById('btn-copy-yaml')?.addEventListener('click', () => {
        navigator.clipboard.writeText(textarea.value);
        const btn = document.getElementById('btn-copy-yaml');
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        btn.classList.add('text-cyan-400');
        setTimeout(() => {
          btn.textContent = orig;
          btn.classList.remove('text-cyan-400');
        }, 1500);
      });

      document.getElementById('btn-reset-yaml')?.addEventListener('click', () => {
        loadPreset('node');
      });

      document.getElementById('btn-fit-view')?.addEventListener('click', () => {
        if (parsedGraph) renderDAG(parsedGraph);
      });

      document.getElementById('btn-export-svg')?.addEventListener('click', () => {
        const svgData = new XMLSerializer().serializeToString(svg);
        const blob = new Blob([svgData], { type: 'image/svg+xml;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'github-actions-dag-pipeline.svg';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });

      // Clear highlights when clicking canvas background
      svg.addEventListener('click', () => {
        selectedNodeId = null;
        inspName.textContent = 'Select a job node in the canvas';
        inspTier.textContent = 'Stage 0';
        inspRunner.textContent = 'ubuntu-latest';
        inspNeeds.textContent = 'None';
        inspDependents.textContent = 'None';
        if (parsedGraph) renderDAG(parsedGraph);
      });

      // Initial run
      loadPreset('node');
    })();
  </script>
</Layout>
