    steps:
      - run: docker push ghcr.io/org/app:latest`,

        monorepo: `name: Turborepo Monorepo Full Pipeline
on: [pull_request, push]

jobs:
  typecheck:
    runs-on: ubuntu-latest
    steps:
      - run: turbo run typecheck

  lint:
    runs-on: ubuntu-latest
    steps:
      - run: turbo run lint

  unit-frontend:
    runs-on: ubuntu-latest
    needs: [typecheck, lint]
    steps:
      - run: turbo run test --filter=web

  unit-backend:
    runs-on: ubuntu-latest
    needs: [typecheck, lint]
    steps:
      - run: turbo run test --filter=api

  e2e-tests:
    runs-on: ubuntu-latest
    needs: [unit-frontend, unit-backend]
    steps:
      - run: turbo run test:e2e

  build-packages:
    runs-on: ubuntu-latest
    needs: [unit-frontend, unit-backend]
