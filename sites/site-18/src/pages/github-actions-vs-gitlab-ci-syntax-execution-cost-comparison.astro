<pre is:raw class="bg-[#070B12] border border-slate-800 p-4 rounded-b-lg overflow-x-auto text-slate-200">
jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - run: npm run lint

  unit-test:
    runs-on: ubuntu-latest
    steps:
      - run: npm run test:unit

  build-deploy:
    runs-on: ubuntu-latest
    # Explicit DAG Dependencies
    needs: [lint, unit-test]
    steps:
      - run: npm run build
      - run: npm run deploy
</pre>
            </div>

            <div>
