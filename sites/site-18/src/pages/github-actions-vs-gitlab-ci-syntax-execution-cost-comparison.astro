                GitLab CI (.gitlab-ci.yml)
              </div>
<pre is:raw class="bg-[#070B12] border border-slate-800 p-4 rounded-b-lg overflow-x-auto text-slate-200">
stages:
  - validate
  - release

lint:
  stage: validate
  script:
    - npm run lint

unit-test:
  stage: validate
  script:
    - npm run test:unit

build-deploy:
  stage: release
  # DAG Bypass ignores stage barrier
  needs: ["lint", "unit-test"]
  script:
    - npm run build
    - npm run deploy
</pre>
            </div>
