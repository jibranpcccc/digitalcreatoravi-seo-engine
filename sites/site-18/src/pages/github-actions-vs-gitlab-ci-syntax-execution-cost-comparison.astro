  - release

lint:
  stage: validate
  script:
    - npm run lint

unit-test:
  stage: validate
  script:
    - npm run test:unit

build-deploy:
  stage: release
  # DAG Bypass ignores stage barrier
  needs: ["lint", "unit-test"]
  script:
    - npm run build
    - npm run deploy
</pre>
