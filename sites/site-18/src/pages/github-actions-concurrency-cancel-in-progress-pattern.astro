const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "@id": "https://site-18-chi.vercel.app/github-actions-concurrency-cancel-in-progress-pattern/#article",
      "headline": "GitHub Actions Concurrency: Cancel In-Progress Workflow Runs Correctly",
      "description": "Production pattern for implementing concurrency groups and cancel-in-progress in GitHub Actions to avoid duplicate CI builds and save runner minutes.",
      "url": "https://site-18-chi.vercel.app/github-actions-concurrency-cancel-in-progress-pattern/",
      "inLanguage": "en-US",
      "datePublished": "2026-09-08T00:00:00+00:00",
      "author": { "@type": "Organization", "name": "CIPipelineGraph Systems" }
    }
  ]
};
---

<Layout
  title="GitHub Actions Concurrency: Cancel In-Progress Workflow Runs"
  description="Production pattern for implementing concurrency groups and cancel-in-progress in GitHub Actions to avoid duplicate CI builds and save runner minutes."
  canonical="https://site-18-chi.vercel.app/github-actions-concurrency-cancel-in-progress-pattern/"
  schema={schema}
>
  <article class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-xs text-slate-500 font-mono mb-6">
      <a href="/" class="hover:text-emerald-400">CIPipelineGraph</a> / <span>CI Optimization</span>
    </nav>

    <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-6">
      GitHub Actions Concurrency: Cancel In-Progress Workflow Runs Correctly
    </h1>

    <div class="bg-emerald-950/20 border-l-4 border-l-emerald-500 border-y border-r border-emerald-500/30 rounded-xl p-6 shadow-xl mb-10">
      <div class="text-xs font-bold uppercase tracking-wider text-emerald-400 font-mono mb-2">
        ⚡ Quick Answer: GitHub Actions Concurrency
      </div>
      <p class="text-sm sm:text-base text-slate-200 leading-relaxed">
        To prevent rapid git pushes from queueing redundant builds, add top-level <code>concurrency</code> to your workflow YAML using <code>group: &#36;&#123;&#123; github.workflow &#125;&#125;-&#36;&#123;&#123; github.ref &#125;&#125;</code> and <code>cancel-in-progress: true</code>. For pull requests, scope the group to <code>github.head_ref || github.run_id</code> so main branch production deployments are never accidentally cancelled mid-flight.
      </p>
    </div>

    <h2 class="text-2xl font-bold text-white mb-4">Fail-Safe Branch & PR Concurrency Pattern</h2>
    <div class="rounded-xl border border-slate-800 bg-slate-900/90 p-4 font-mono text-xs text-cyan-300 overflow-x-auto mb-8">
      <pre is:raw>
name: Continuous Integration &amp; Tests

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

# Cancel outdated PR builds, but never cancel sequential main deploys
concurrency:
  group: &#36;{"{{"} github.workflow {"}}"} - &#36;{"{{"} github.head_ref || github.run_id {"}}"}
  cancel-in-progress: &#36;{"{{"} github.event_name == 'pull_request' {"}}"}

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Run Test Suite
        run: npm test
      </pre>
    </div>

    <p class="text-slate-300 text-sm leading-relaxed mb-6">
      Check our CI cost and speed benchmarks: <a href="/github-actions-vs-gitlab-ci-syntax-execution-cost-comparison/" class="text-cyan-400 hover:underline">GitHub Actions vs GitLab CI</a> and <a href="/matrix-build-optimization-github-actions-cache-speed/" class="text-cyan-400 hover:underline">Matrix Build Cache Optimization</a>.
    </p>

    <div class="mt-8 pt-8 border-t border-slate-800 flex justify-between items-center text-xs text-slate-400 font-mono">
      <span>CIPipelineGraph Automation Lab</span>
      <a href="/" class="text-cyan-400 hover:underline">Visual DAG Parser →</a>
    </div>
  </article>
</Layout>
