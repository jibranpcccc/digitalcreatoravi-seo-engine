      <pre is:raw class="bg-slate-950 p-4 rounded-lg border border-slate-800 text-xs font-mono text-cyan-300 overflow-x-auto"><code># Recipe 1: Docker-in-Docker (DinD) - Bind host docker socket to enable building containers inside act
act -j build-docker-image \
  --secret-file .secrets \
  --container-daemon-socket /var/run/docker.sock \
  -P ubuntu-latest=catthehacker/ubuntu:act-latest

# Recipe 2: Run a single matrix cell (e.g. only run Node 20 on Ubuntu instead of all 9 matrix jobs)
act -j unit-tests \
  --matrix node-version:20 \
  --secret-file .secrets

# Recipe 3: Preserve container state on failure for interactive forensic inspection
act -j test \
  --secret-file .secrets \
  --reuse \
  -P ubuntu-latest=catthehacker/ubuntu:act-latest

# Recipe 4: Enable verbose step-by-step debug logging
act -j deploy \
  --secret-file .secrets \
  -v
</code></pre>

