---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  schemaJson?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description,
  canonical = "https://site-18-chi.vercel.app/",
  schemaJson,
  image = "/og-banner.png",
  type = "website"
} = Astro.props;

const canonicalUrl = canonical.endsWith('/') ? canonical : `${canonical}/`;
const ogImageUrl = image.startsWith('http') ? image : `https://site-18-chi.vercel.app${image.startsWith('/') ? '' : '/'}${image}`;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="CIPipelineGraph" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Machine-Readable LLM Discovery -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Context Index" />

    <!-- Search Engine Tokens -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#090D16" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Schema.org Structured Data -->
    {schemaJson && (
      <script type="application/ld+json" set:html={schemaJson} />
    )}

    <!-- Zero-Cookie Telemetry -->
    <script is:inline>
      try {
        const pv = {
          p: window.location.pathname,
          r: document.referrer || 'direct',
          t: new Date().toISOString()
        };
        const s = JSON.parse(localStorage.getItem('__ci_telemetry') || '[]');
        s.push(pv);
        localStorage.setItem('__ci_telemetry', JSON.stringify(s.slice(-30)));
      } catch (e) {}
    </script>

    <!-- Fleet Master Analytics Beacon -->
    <script is:inline>
      (function() {
        try {
          var payload = JSON.stringify({
            site: window.location.hostname,
            path: window.location.pathname,
            ref: document.referrer || "direct",
            screen: window.innerWidth + "x" + window.innerHeight,
            ts: Date.now()
          });
          var endpoint = "https://webhookwatch.vercel.app/api/track/";
          if (navigator.sendBeacon) {
            navigator.sendBeacon(endpoint, payload);
          } else {
            fetch(endpoint, { method: "POST", body: payload, keepalive: true, headers: { "Content-Type": "application/json" } }).catch(function(){});
          }
        } catch(e) {}
      })();
    </script>
      <link rel="alternate" type="application/rss+xml" title="RSS 2.0 Feed" href="/rss.xml" />
      <!-- Search Console & Webmaster Verification -->
    <meta name="google-site-verification" content="google6fe267a998c19a9a" />
    <meta name="msvalidate.01" content="BING-VERIFICATION-FLEET-2026" />

      <!-- Google Analytics (GA4) Integration -->
    {import.meta.env.PUBLIC_GA_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`}></script>
        <script define:vars={{ gaId: import.meta.env.PUBLIC_GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId, { anonymize_ip: true });
        </script>
      </>
    )}

  </head>
  <body class="bg-[#090D16] text-slate-100 antialiased font-['Plus_Jakarta_Sans',sans-serif] selection:bg-cyan-500/30 selection:text-cyan-200 min-h-screen flex flex-col relative overflow-x-hidden">

    <!-- Ambient Visual Glows -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[960px] h-[380px] bg-gradient-to-b from-cyan-600/10 via-blue-600/5 to-transparent blur-[140px] pointer-events-none -z-10"></div>
    <div class="fixed top-96 -left-48 w-80 h-80 bg-cyan-500/5 blur-[120px] pointer-events-none -z-10"></div>
    <div class="fixed top-96 -right-48 w-80 h-80 bg-emerald-500/5 blur-[120px] pointer-events-none -z-10"></div>

    <!-- Announcement Bar -->
    <div class="border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-md text-xs py-2 px-4 text-center text-slate-400 flex items-center justify-center space-x-3">
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-cyan-500/15 text-cyan-400 border border-cyan-500/30">
        NEW 2026 BENCHMARK
      </span>
      <span class="hidden sm:inline">GitHub Actions vs GitLab CI Runner Cost & DAG Concurrency Matrix</span>
      <span class="sm:hidden">GHA vs GitLab CI Cost Matrix</span>
      <a href="/github-actions-vs-gitlab-ci-syntax-execution-cost-comparison/" class="text-cyan-400 hover:text-cyan-300 font-semibold underline underline-offset-2 ml-1">
        Explore Benchmark &rarr;
      </a>
    </div>

    <!-- Navigation Header -->
    <header class="border-b border-slate-800/80 bg-[#090D16]/90 backdrop-blur-xl sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center space-x-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-500 via-blue-500 to-emerald-500 p-[1px] shadow-lg shadow-cyan-500/20 group-hover:shadow-cyan-500/40 transition duration-300">
            <div class="w-full h-full bg-[#0B1120] rounded-[11px] flex items-center justify-center font-mono font-black text-cyan-400 text-sm">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="18" cy="18" r="3"></circle>
                <circle cx="6" cy="6" r="3"></circle>
                <circle cx="6" cy="18" r="3"></circle>
                <path d="M18 9a9 9 0 0 1-9 9"></path>
                <line x1="6" y1="9" x2="6" y2="15"></line>
              </svg>
            </div>
          </div>
          <div class="flex flex-col">
            <div class="flex items-center space-x-1.5">
              <span class="text-lg font-black tracking-tight text-white group-hover:text-cyan-400 transition">
                CIPipeline<span class="text-cyan-400">Graph</span>
              </span>
              <span class="text-[9px] uppercase font-mono font-bold px-1.5 py-0.5 rounded bg-cyan-500/10 text-cyan-400 border border-cyan-500/25">
                DAG ENGINE
              </span>
            </div>
            <span class="text-[10px] font-mono text-slate-400 tracking-wider">CI/CD Syntax & Graph Validator</span>
          </div>
        </a>

        <!-- Desktop Nav Links -->
        <nav class="hidden lg:flex items-center space-x-1 text-sm font-medium text-slate-300">
          <a href="/" class="px-3.5 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            <span>DAG Visualizer</span>
          </a>
          <a href="/github-actions-vs-gitlab-ci-syntax-execution-cost-comparison/" class="px-3.5 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition">
            GHA vs GitLab CI
          </a>
          <a href="/matrix-build-optimization-github-actions-cache-speed/" class="px-3.5 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition">
            Matrix & Caching
          </a>
          <a href="/act-run-github-actions-locally-debugging-guide/" class="px-3.5 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition">
            Run GHA Locally (act)
          </a>
        </nav>

        <!-- Right Action Items -->
        <div class="flex items-center space-x-2.5">
          <a
            href="/llms.txt"
            class="flex items-center space-x-1.5 px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-700/80 hover:border-cyan-500/60 text-xs font-mono text-cyan-400 shadow-sm transition"
            title="Machine-readable LLM Context Index"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
            <span>llms.txt</span>
          </a>
          <a
            href="https://github.com/jibranpcccc/digitalcreatoravi-seo-engine"
            target="_blank"
            rel="noopener"
            class="hidden sm:flex items-center space-x-1.5 px-3 py-1.5 rounded-lg bg-slate-800/80 border border-slate-700/80 hover:border-slate-500 text-xs font-semibold text-slate-200 transition"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            <span>GitHub</span>
          </a>
          <a
            href="/#visualizer"
            class="inline-flex items-center px-3.5 py-1.5 rounded-lg bg-gradient-to-r from-cyan-500 via-blue-500 to-emerald-500 hover:from-cyan-400 hover:to-emerald-400 text-slate-950 text-xs font-bold shadow-md shadow-cyan-500/20 transition"
          >
            Launch Visualizer
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 py-8 w-full">
      <slot />
    </main>

    <!-- Site Footer -->
    <footer class="border-t border-slate-800/80 bg-[#05070D] mt-24 py-16 text-sm text-slate-400">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
          <!-- Column 1: Brand & Identity -->
          <div class="md:col-span-2">
            <div class="flex items-center space-x-3 mb-3">
              <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-500 to-emerald-500 flex items-center justify-center font-mono font-bold text-slate-950 text-xs">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="18" cy="18" r="3"></circle>
                  <circle cx="6" cy="6" r="3"></circle>
                  <circle cx="6" cy="18" r="3"></circle>
                  <path d="M18 9a9 9 0 0 1-9 9"></path>
                  <line x1="6" y1="9" x2="6" y2="15"></line>
                </svg>
              </div>
              <span class="text-base font-extrabold text-white">CIPipeline<span class="text-cyan-400">Graph</span></span>
            </div>
            <p class="text-xs text-slate-400 max-w-sm leading-relaxed mb-4">
              Open-access developer toolkit and interactive DAG visualizer for GitHub Actions, GitLab CI, and containerized workflow pipelines. Built for speed, precision, and zero data leakage.
            </p>
            <div class="inline-flex items-center space-x-2 px-2.5 py-1 rounded-md bg-slate-900 border border-slate-800 text-[11px] font-mono text-cyan-400">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span>100% In-Browser AST DAG Parsing • Zero Secrets or Workflow Exfiltration</span>
            </div>
          </div>

          <!-- Column 2: Deep Dive Guides -->
          <div>
            <h4 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Guides & Comparisons</h4>
            <ul class="space-y-2 text-xs text-slate-400">
              <li><a href="/github-actions-vs-gitlab-ci-syntax-execution-cost-comparison/" class="hover:text-cyan-400 transition">GHA vs GitLab CI Syntax & Costs</a></li>
              <li><a href="/matrix-build-optimization-github-actions-cache-speed/" class="hover:text-cyan-400 transition">Matrix & Cache Speedup Guide</a></li>
              <li><a href="/act-run-github-actions-locally-debugging-guide/" class="hover:text-cyan-400 transition">Local GHA Debugging with Act</a></li>
              <li><a href="/#visualizer" class="hover:text-cyan-400 transition">DAG Dependency Visualizer</a></li>
            </ul>
          </div>

          <!-- Column 3: Standards & Machine Endpoints -->
          <div>
            <h4 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Discovery & Standards</h4>
            <ul class="space-y-2 text-xs text-slate-400">
              <li><a href="/llms.txt" class="hover:text-cyan-400 transition font-mono">/llms.txt</a></li>
              <li><a href="/robots.txt" class="hover:text-cyan-400 transition font-mono">/robots.txt</a></li>
              <li><a href="/sitemap.xml" class="hover:text-cyan-400 transition font-mono">/sitemap.xml</a></li>
              <li><a href="/8303260f1bf94264ac6d00aa93efde28.txt" class="hover:text-cyan-400 transition font-mono">IndexNow Key</a></li>
            </ul>
          </div>
        </div>

        <div class="border-t border-slate-800/80 pt-6 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-400 gap-4">
          <p>&copy; 2026 CIPipelineGraph. Open engineering tools released under MIT License.</p>
          <p class="text-[11px] text-slate-400">Astro SSG • Sub-millisecond Topological DAG Sorting</p>
        </div>
      </div>
    </footer>
  </body>
</html>
