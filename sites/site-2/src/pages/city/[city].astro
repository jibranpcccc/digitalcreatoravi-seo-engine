---
import Layout from '../../layouts/Layout.astro';
import properties from '../../data/properties.json';

export async function getStaticPaths() {
  const cities = [...new Set(properties.map(p => p.city))];
  return cities.map(city => {
    const cityProps = properties.filter(p => p.city === city);
    return {
      params: { city },
      props: { city, properties: cityProps }
    };
  });
}

const { city, properties: cityProps } = Astro.props;
const avgSpeed = Math.round(cityProps.reduce((acc, p) => acc + p.download_mbps, 0) / cityProps.length);
const minRate = Math.min(...cityProps.map(p => p.monthly_rate_eur));

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": `${city} Remote Work & Coliving Hub`,
  "description": `Verified coliving spaces and remote work communities in ${city} with high-speed fiber internet.`,
  "geo": {
    "@type": "GeoCoordinates"
  }
};
---

<Layout 
  title={`Best Verified Coliving Spaces in ${city} (2026 Remote Work Guide)`}
  description={`Compare ${cityProps.length} verified coliving communities in ${city}. Average download speed ${avgSpeed} Mbps, rates starting from €${minRate}/month.`}
  canonical={`https://workationradar.com/city/${encodeURIComponent(city)}`}
  schemaJson={JSON.stringify(schemaData)}
>
  <div class="py-8">
    <nav class="flex items-center space-x-2 text-xs text-stone-400 mb-6 font-medium">
      <a href="/" class="hover:text-amber-400">Home</a>
      <span>/</span>
      <span class="text-stone-300">Cities</span>
      <span>/</span>
      <span class="text-amber-400 font-bold">{city}</span>
    </nav>

    <!-- Header -->
    <div class="mb-12 border-b border-stone-800 pb-8">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-amber-950/60 border border-amber-800 text-amber-400 text-xs font-semibold mb-4">
        <span>{cityProps.length} Verified Spaces</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4">
        Verified Coliving Spaces in <span class="text-amber-400">{city}</span>
      </h1>
      <p class="text-stone-400 max-w-2xl leading-relaxed">
        Looking for reliable remote work accommodation in {city}? Every space in our directory has been tested for fiber connection reliability, ergonomic seating, and power failover systems.
      </p>

      <!-- City Quick Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8">
        <div class="p-4 rounded-xl bg-stone-900 border border-stone-800">
          <span class="text-xs text-stone-500 block">Average Speed</span>
          <span class="text-2xl font-bold text-emerald-400">{avgSpeed} Mbps</span>
        </div>
        <div class="p-4 rounded-xl bg-stone-900 border border-stone-800">
          <span class="text-xs text-stone-500 block">Starting Rate</span>
          <span class="text-2xl font-bold text-white">&euro;{minRate}<span class="text-xs text-stone-400 font-normal"> / mo</span></span>
        </div>
        <div class="p-4 rounded-xl bg-stone-900 border border-stone-800">
          <span class="text-xs text-stone-500 block">Power Resilience</span>
          <span class="text-2xl font-bold text-amber-400">100% Backed</span>
        </div>
        <div class="p-4 rounded-xl bg-stone-900 border border-stone-800">
          <span class="text-xs text-stone-500 block">Seating Standard</span>
          <span class="text-2xl font-bold text-stone-200">Ergonomic</span>
        </div>
      </div>
    </div>

    <!-- Listings -->
    <div class="space-y-6">
      {cityProps.map((prop) => (
        <div class="p-6 rounded-xl bg-stone-900 border border-stone-800 hover:border-amber-500/50 transition duration-200 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
          <div class="max-w-2xl">
            <div class="flex items-center space-x-3 mb-2">
              <span class="text-xs font-bold text-amber-400 bg-amber-950 px-2 py-0.5 rounded border border-amber-900">
                Score: {prop.productivity_score}/100
              </span>
              <span class="text-xs text-stone-400 font-mono">Tested: {prop.verified_date}</span>
            </div>
            <h2 class="text-xl font-bold text-white mb-2">
              <a href={`/space/${prop.slug}`} class="hover:text-amber-400 transition">
                {prop.name}
              </a>
            </h2>
            <p class="text-sm text-stone-400 mb-4">
              {prop.description}
            </p>
            <div class="flex flex-wrap gap-4 text-xs text-stone-300">
              <span>🚀 <strong>{prop.download_mbps} Mbps</strong> Down / {prop.upload_mbps} Mbps Up</span>
              <span>💺 <strong>{prop.chair_model}</strong></span>
              <span>🔋 <strong>{prop.backup_power}</strong></span>
            </div>
          </div>

          <div class="flex flex-col items-start md:items-end justify-between min-w-[140px] pt-4 md:pt-0 border-t md:border-t-0 border-stone-800 w-full md:w-auto">
            <span class="text-xs text-stone-500">Monthly All-Inclusive</span>
            <span class="text-2xl font-extrabold text-white mb-3">&euro;{prop.monthly_rate_eur}</span>
            <a 
              href={`/space/${prop.slug}`}
              class="w-full text-center px-4 py-2 rounded-lg bg-amber-600 hover:bg-amber-500 text-white text-xs font-bold transition shadow-md shadow-amber-600/20"
            >
              Inspect Specs &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
