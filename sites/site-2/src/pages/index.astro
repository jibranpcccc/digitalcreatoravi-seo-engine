---
import Layout from '../layouts/Layout.astro';
import properties from '../data/properties.json';

const totalSpaces = properties.length;
const cities = [...new Set(properties.map(p => p.city))];
---

<Layout 
  title="WorkationRadar: Verified Coliving Spaces with Speedtests & Ergonomics"
  description="Directory of global verified remote work coliving spaces featuring verified fiber speedtests, Herman Miller/Steelcase chairs, and power backup status."
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 text-center max-w-3xl mx-auto">
    <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-amber-950/60 border border-amber-800 text-amber-400 text-xs font-semibold mb-6">
      <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
      <span>{totalSpaces} Verified Workation Communities</span>
    </div>
    <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white mb-6 leading-tight">
      Coliving Built for <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-orange-400">Deep Work</span>
    </h1>
    <p class="text-lg text-stone-400 mb-8 leading-relaxed">
      Never arrive at an Airbnb with broken WiFi or a kitchen stool again. Every property includes verified speedtest results, ergonomic chair models, and power backup specs.
    </p>

    <!-- City Filter Tags -->
    <div class="flex flex-wrap justify-center gap-2 mb-8">
      {cities.map((city) => (
        <a 
          href={`/city/${encodeURIComponent(city)}`}
          class="px-4 py-1.5 rounded-full bg-stone-900 border border-stone-800 hover:border-amber-500 hover:text-amber-400 text-xs font-semibold text-stone-300 transition"
        >
          {city}
        </a>
      ))}
    </div>
  </section>

  <!-- Spaces Grid -->
  <section class="py-8">
    <div class="flex justify-between items-end mb-8 border-b border-stone-800 pb-4">
      <div>
        <h2 class="text-2xl font-bold text-white">Verified Remote Work Spaces</h2>
        <p class="text-sm text-stone-400 mt-1">Inspected for sub-30ms ping, dedicated call booths, and ergonomic seating.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {properties.map((prop) => (
        <div class="p-6 rounded-xl bg-stone-900 border border-stone-800 hover:border-amber-500/50 transition duration-200 flex flex-col justify-between shadow-sm">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-semibold text-stone-400">{prop.city}, {prop.country}</span>
              <span class="text-xs font-bold text-amber-400 bg-amber-950 px-2 py-0.5 rounded border border-amber-900">
                Score: {prop.productivity_score}/100
              </span>
            </div>
            <h3 class="text-lg font-bold text-white mb-2 leading-snug">
              <a href={`/space/${prop.slug}`} class="hover:text-amber-400 transition">
                {prop.name}
              </a>
            </h3>
            <p class="text-xs text-stone-400 mb-4 line-clamp-2">
              {prop.description}
            </p>

            <!-- Specs Grid -->
            <div class="grid grid-cols-2 gap-2 text-xs bg-stone-950 p-3 rounded-lg border border-stone-850 mb-4">
              <div>
                <span class="text-stone-500 block">Download</span>
                <span class="font-bold text-emerald-400">{prop.download_mbps} Mbps</span>
              </div>
              <div>
                <span class="text-stone-500 block">Chair Model</span>
                <span class="font-semibold text-stone-300 truncate block">{prop.chair_model}</span>
              </div>
              <div>
                <span class="text-stone-500 block">Call Booths</span>
                <span class="font-semibold text-stone-300">{prop.phone_booths_count} Private Booths</span>
              </div>
              <div>
                <span class="text-stone-500 block">Power Backup</span>
                <span class="font-semibold text-stone-300 truncate block">{prop.backup_power}</span>
              </div>
            </div>
          </div>

          <div class="flex items-center justify-between pt-4 border-t border-stone-800 text-sm">
            <div>
              <span class="text-xs text-stone-500 block">Monthly Rate</span>
              <span class="font-bold text-white">&euro;{prop.monthly_rate_eur}<span class="text-xs text-stone-400 font-normal"> / mo</span></span>
            </div>
            <a 
              href={`/space/${prop.slug}`}
              class="px-3 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-500 text-white text-xs font-semibold transition"
            >
              View Space &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
