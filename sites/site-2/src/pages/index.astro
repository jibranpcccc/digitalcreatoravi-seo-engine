---
import Layout from '../layouts/Layout.astro';
import properties from '../data/properties.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const totalSpaces = properties.length;
const cities = [...new Set(properties.map(p => p.city))];
const regions = ["All", "Europe", "Asia", "Americas", "Africa"];

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://workationradar.com/#website",
      "url": "https://workationradar.com",
      "name": "WorkationRadar",
      "description": "Global verified coliving directory for remote workers with independent fiber speedtests and ergonomic chair inspections.",
      "publisher": {
        "@type": "Organization",
        "@id": "https://workationradar.com/#organization",
        "name": "WorkationRadar Field Inspection Collective",
        "url": "https://workationradar.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://workationradar.com/favicon.svg"
        }
      }
    },
    {
      "@type": "ItemList",
      "@id": "https://workationradar.com/#spaces",
      "name": "Verified Global Coliving Spaces",
      "itemListElement": properties.map((prop, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": prop.name,
        "description": prop.description,
        "url": `https://workationradar.com/space/${prop.slug}`
      }))
    }
  ]
};
---

<Layout 
  title="WorkationRadar: Verified Coliving Spaces with Speedtests & Ergonomics (2026)"
  description="Independent directory of verified remote work coliving communities featuring verified fiber speedtests, Herman Miller seating, and power backup specs."
  canonical="https://workationradar.com/"
  schemaJson={JSON.stringify(schemaData)}
>
  <!-- Hero Section -->
  <section class="pt-8 pb-14 md:pt-14 md:pb-20 text-center max-w-4xl mx-auto relative">
    <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-stone-900 border border-stone-800 text-stone-300 text-xs font-semibold mb-8 shadow-sm">
      <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
      <span>{totalSpaces} Verified Global Communities</span>
      <span class="text-stone-600">•</span>
      <span class="text-amber-400 font-mono">16 Empirical Inspection Points</span>
    </div>

    <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white mb-8 leading-[1.1]">
      Workation Coliving Built For <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-orange-300 to-emerald-400">
        High-Output Deep Work
      </span>
    </h1>

    <p class="text-base sm:text-xl text-stone-400 mb-10 max-w-2xl mx-auto leading-relaxed">
      Never land at a coliving hub with unstable WiFi or a dining chair again. We independently inspect fiber speeds, phone booth soundproofing, and power backup generators.
    </p>

    <!-- City Filter Tags -->
    <div class="flex flex-wrap justify-center gap-2 mb-10">
      {cities.map((city) => (
        <a 
          href={`${base}/city/${encodeURIComponent(city)}`}
          class="px-4 py-1.5 rounded-full bg-stone-900 border border-stone-800 hover:border-amber-500 hover:text-amber-400 text-xs font-semibold text-stone-300 transition"
        >
          {city}
        </a>
      ))}
    </div>

    <!-- Stats Bar -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-10 border-t border-stone-800/80 text-left">
      <div class="p-4 rounded-xl bg-stone-900/50 border border-stone-800/60">
        <span class="text-[11px] font-mono uppercase tracking-wider text-stone-400 block mb-1">Fastest Verified Speed</span>
        <span class="text-2xl font-black text-emerald-400 font-mono">600 Mbps</span>
        <span class="text-[11px] text-stone-400 block mt-0.5">Sun & Co (Javea, Spain)</span>
      </div>
      <div class="p-4 rounded-xl bg-stone-900/50 border border-stone-800/60">
        <span class="text-[11px] font-mono uppercase tracking-wider text-stone-400 block mb-1">Lowest Starting Rate</span>
        <span class="text-2xl font-black text-amber-400 font-mono">&euro;680 / mo</span>
        <span class="text-[11px] text-stone-400 block mt-0.5">Bansko (Bulgaria)</span>
      </div>
      <div class="p-4 rounded-xl bg-stone-900/50 border border-stone-800/60">
        <span class="text-[11px] font-mono uppercase tracking-wider text-stone-400 block mb-1">Ergonomic Standard</span>
        <span class="text-2xl font-black text-stone-200 font-mono">100% Verified</span>
        <span class="text-[11px] text-stone-400 block mt-0.5">Herman Miller & Steelcase</span>
      </div>
      <div class="p-4 rounded-xl bg-stone-900/50 border border-stone-800/60">
        <span class="text-[11px] font-mono uppercase tracking-wider text-stone-400 block mb-1">Power Resilience</span>
        <span class="text-2xl font-black text-orange-400 font-mono">UPS + Generator</span>
        <span class="text-[11px] text-stone-400 block mt-0.5">Zero Outage Guarantee</span>
      </div>
    </div>
  </section>

  <!-- Interactive Generative UI Filter & Sizer Tool -->
  <section id="filter-tool" class="py-12 border-t border-stone-800/80">
    <div class="max-w-3xl mx-auto mb-8 text-center">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-semibold mb-3">
        <span>INTERACTIVE DIRECTORY SIZER</span>
      </div>
      <h2 class="text-3xl font-extrabold text-white tracking-tight">Filter by Budget, WiFi & Ergonomics</h2>
      <p class="text-stone-400 text-sm mt-2">Adjust monthly budget and connectivity requirements to filter verified properties in real-time.</p>
    </div>

    <div class="max-w-4xl mx-auto bg-stone-900/90 border border-stone-800 rounded-2xl p-6 sm:p-8 shadow-2xl backdrop-blur-xl mb-12">
      <!-- Currency Switcher & Header Bar -->
      <div class="flex flex-wrap items-center justify-between gap-4 pb-6 mb-6 border-b border-stone-800">
        <div class="flex items-center space-x-2">
          <span class="text-xs font-bold text-stone-400 uppercase tracking-wider">Currency:</span>
          <div class="inline-flex rounded-xl p-1 bg-stone-950 border border-stone-800">
            <button type="button" class="currency-btn px-3 py-1 text-xs font-bold rounded-lg bg-amber-500/20 text-amber-400 border border-amber-500/40 transition" data-curr="EUR" data-sym="€" data-rate="1.0">EUR (€)</button>
            <button type="button" class="currency-btn px-3 py-1 text-xs font-semibold rounded-lg text-stone-400 hover:text-stone-200 transition" data-curr="USD" data-sym="$" data-rate="1.08">USD ($)</button>
            <button type="button" class="currency-btn px-3 py-1 text-xs font-semibold rounded-lg text-stone-400 hover:text-stone-200 transition" data-curr="GBP" data-sym="£" data-rate="0.85">GBP (£)</button>
          </div>
        </div>

        <!-- Quick Filter Preset Chips -->
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs text-stone-400 font-medium">Quick:</span>
          <button type="button" class="preset-chip px-2.5 py-1 rounded-lg text-[11px] font-mono border border-amber-500 bg-amber-500/10 text-amber-300 transition" data-preset="all">All Hubs</button>
          <button type="button" class="preset-chip px-2.5 py-1 rounded-lg text-[11px] font-mono border border-stone-800 bg-stone-950 text-stone-400 hover:border-stone-700 transition" data-preset="herman">Herman Miller</button>
          <button type="button" class="preset-chip px-2.5 py-1 rounded-lg text-[11px] font-mono border border-stone-800 bg-stone-950 text-stone-400 hover:border-stone-700 transition" data-preset="generator">Generator Backup</button>
          <button type="button" class="preset-chip px-2.5 py-1 rounded-lg text-[11px] font-mono border border-stone-800 bg-stone-950 text-stone-400 hover:border-stone-700 transition" data-preset="budget">Sub-€1k</button>
          <button type="button" class="preset-chip px-2.5 py-1 rounded-lg text-[11px] font-mono border border-stone-800 bg-stone-950 text-stone-400 hover:border-stone-700 transition" data-preset="speed">400+ Mbps</button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
        <!-- Region Filter -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-stone-400 mb-2">Target Region</label>
          <select id="filterRegion" class="w-full bg-stone-950 border border-stone-700/80 rounded-xl px-4 py-3 text-xs sm:text-sm text-stone-200 focus:outline-none focus:border-amber-500 transition">
            {regions.map(r => (
              <option value={r}>{r === "All" ? "All Continents" : r}</option>
            ))}
          </select>
        </div>

        <!-- Max Budget Slider -->
        <div>
          <div class="flex justify-between text-xs font-bold mb-2">
            <span class="text-stone-400 uppercase tracking-wider">Max Monthly Budget</span>
            <span id="budgetVal" class="text-amber-400 font-mono">&euro;1,500 / mo</span>
          </div>
          <input id="budgetSlider" type="range" min="600" max="2500" step="50" value="1500" class="w-full h-2 bg-stone-950 rounded-lg appearance-none cursor-pointer accent-amber-500" />
        </div>

        <!-- Min Speed Slider -->
        <div>
          <div class="flex justify-between text-xs font-bold mb-2">
            <span class="text-stone-400 uppercase tracking-wider">Min Download Speed</span>
            <span id="speedVal" class="text-emerald-400 font-mono">200 Mbps</span>
          </div>
          <input id="speedSlider" type="range" min="100" max="600" step="50" value="200" class="w-full h-2 bg-stone-950 rounded-lg appearance-none cursor-pointer accent-emerald-500" />
        </div>
      </div>

      <div class="mt-6 pt-6 border-t border-stone-800 flex items-center justify-between text-xs font-mono">
        <span class="text-stone-400">Matching Properties: <strong id="matchCount" class="text-amber-400 text-sm">10</strong> of {totalSpaces}</span>
        <button id="resetFilters" type="button" class="text-stone-400 hover:text-amber-400 transition underline underline-offset-4">
          Reset Filters
        </button>
      </div>
    </div>
  </section>

  <!-- Spaces Grid -->
  <section class="py-8">
    <div class="flex justify-between items-end mb-8 border-b border-stone-800 pb-4">
      <div>
        <h2 class="text-2xl font-bold text-white">Inspected Remote Work Properties</h2>
        <p class="text-sm text-stone-400 mt-1">Grounded data verified by on-site inspection teams.</p>
      </div>
      <a href={`${base}/llms.txt`} class="text-xs font-mono text-amber-400 hover:text-amber-300 underline underline-offset-4">
        /llms.txt Context &rarr;
      </a>
    </div>

    <div id="propertiesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {properties.map((prop) => (
        <div 
          class="prop-card p-5 rounded-2xl bg-stone-900/90 border border-stone-800 hover:border-amber-500/60 transition duration-300 flex flex-col justify-between shadow-xl overflow-hidden group"
          data-region={prop.region}
          data-rate-eur={prop.monthly_rate_eur}
          data-speed={prop.download_mbps}
          data-chair={prop.chair_model}
          data-power={prop.backup_power}
        >
          <div>
            <!-- Cover Graphic -->
            <div class="rounded-xl overflow-hidden border border-stone-800 mb-4 relative">
              <img 
                src={`${base}/images/spaces/${prop.slug}.webp`} 
                alt={prop.name}
                class="w-full h-44 object-cover group-hover:scale-[1.02] transition duration-500"
                loading="lazy"
                width="600"
                height="338"
              />
              <div class="absolute top-3 right-3 px-2.5 py-1 rounded-md bg-stone-950/80 border border-stone-800 text-[11px] font-mono font-bold text-emerald-400 backdrop-blur-sm">
                Score: {prop.productivity_score}/100
              </div>
            </div>

            <!-- Header Info -->
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-semibold text-amber-400 font-mono uppercase tracking-wider">{prop.city}, {prop.country}</span>
              <span class="text-[11px] text-stone-400 font-mono">{prop.region}</span>
            </div>

            <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition mb-2 leading-snug">
              <a href={`${base}/space/${prop.slug}`}>
                {prop.name}
              </a>
            </h3>

            <p class="text-xs text-stone-400 mb-4 line-clamp-2 leading-relaxed">
              {prop.description}
            </p>

            <!-- Specs Grid -->
            <div class="grid grid-cols-2 gap-2 text-xs bg-stone-950 p-3 rounded-xl border border-stone-850 mb-4">
              <div>
                <span class="text-stone-400 text-[10px] block uppercase font-mono">Download</span>
                <span class="font-bold text-emerald-400 font-mono text-sm">{prop.download_mbps} Mbps</span>
              </div>
              <div>
                <span class="text-stone-400 text-[10px] block uppercase font-mono">Latency</span>
                <span class="font-bold text-blue-400 font-mono text-sm">{prop.ping_ms} ms</span>
              </div>
              <div>
                <span class="text-stone-400 text-[10px] block uppercase font-mono">Chair</span>
                <span class="font-semibold text-stone-300 truncate block">{prop.chair_model}</span>
              </div>
              <div>
                <span class="text-stone-400 text-[10px] block uppercase font-mono">Phone Booths</span>
                <span class="font-semibold text-stone-300">{prop.phone_booths_count} Private Booths</span>
              </div>
            </div>
          </div>

          <div class="flex items-center justify-between pt-4 border-t border-stone-800 text-sm">
            <div>
              <span class="text-[10px] text-stone-400 uppercase font-mono block">Monthly Rate</span>
              <span class="font-bold text-white text-base"><span class="card-curr-sym">&euro;</span><span class="card-rate-val">{prop.monthly_rate_eur}</span><span class="text-xs text-stone-400 font-normal font-mono"> / mo</span></span>
            </div>
            <a 
              href={`${base}/space/${prop.slug}`}
              class="px-4 py-2 rounded-xl bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-500 hover:to-orange-500 text-white text-xs font-bold shadow-md shadow-amber-600/20 transition"
            >
              Inspect Space &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<script is:inline>
  const fRegion = document.getElementById('filterRegion');
  const fBudget = document.getElementById('budgetSlider');
  const fSpeed = document.getElementById('speedSlider');
  const budgetVal = document.getElementById('budgetVal');
  const speedVal = document.getElementById('speedVal');
  const matchCount = document.getElementById('matchCount');
  const resetBtn = document.getElementById('resetFilters');
  const cards = document.querySelectorAll('.prop-card');
  const currBtns = document.querySelectorAll('.currency-btn');
  const presetChips = document.querySelectorAll('.preset-chip');

  let currentCurrency = 'EUR';
  let currencySymbol = '€';
  let currencyRate = 1.0;
  let activePreset = 'all';

  function updateCurrency(curr, sym, rate) {
    currentCurrency = curr;
    currencySymbol = sym;
    currencyRate = rate;

    // Update Currency buttons
    currBtns.forEach(btn => {
      if (btn.dataset.curr === curr) {
        btn.className = 'currency-btn px-3 py-1 text-xs font-bold rounded-lg bg-amber-500/20 text-amber-400 border border-amber-500/40 transition';
      } else {
        btn.className = 'currency-btn px-3 py-1 text-xs font-semibold rounded-lg text-stone-400 hover:text-stone-200 transition';
      }
    });

    // Update cards price display
    cards.forEach(card => {
      const eurRate = parseInt(card.dataset.rateEur);
      const converted = Math.round(eurRate * currencyRate);
      const symEl = card.querySelector('.card-curr-sym');
      const valEl = card.querySelector('.card-rate-val');
      if (symEl) symEl.textContent = currencySymbol;
      if (valEl) valEl.textContent = converted.toLocaleString();
    });

    filterCards();
  }

  currBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      updateCurrency(btn.dataset.curr, btn.dataset.sym, parseFloat(btn.dataset.rate));
    });
  });

  presetChips.forEach(chip => {
    chip.addEventListener('click', () => {
      activePreset = chip.dataset.preset;
      presetChips.forEach(c => {
        if (c === chip) {
          c.className = 'preset-chip px-2.5 py-1 rounded-lg text-[11px] font-mono border border-amber-500 bg-amber-500/10 text-amber-300 transition';
        } else {
          c.className = 'preset-chip px-2.5 py-1 rounded-lg text-[11px] font-mono border border-stone-800 bg-stone-950 text-stone-400 hover:border-stone-700 transition';
        }
      });
      filterCards();
    });
  });

  function filterCards() {
    const region = fRegion.value;
    const maxRateEur = parseInt(fBudget.value);
    const minSpeed = parseInt(fSpeed.value);

    const convertedBudget = Math.round(maxRateEur * currencyRate);
    budgetVal.textContent = currencySymbol + convertedBudget.toLocaleString() + ' / mo';
    speedVal.textContent = minSpeed + ' Mbps';

    let count = 0;
    cards.forEach(card => {
      const cRegion = card.dataset.region;
      const cRateEur = parseInt(card.dataset.rateEur);
      const cSpeed = parseInt(card.dataset.speed);
      const cChair = card.dataset.chair.toLowerCase();
      const cPower = card.dataset.power.toLowerCase();

      const matchRegion = region === 'All' || cRegion === region;
      const matchRate = cRateEur <= maxRateEur;
      const matchSpeed = cSpeed >= minSpeed;

      let matchPreset = true;
      if (activePreset === 'herman') {
        matchPreset = cChair.includes('herman miller');
      } else if (activePreset === 'generator') {
        matchPreset = cPower.includes('generator') || cPower.includes('inverter') || cPower.includes('solar');
      } else if (activePreset === 'budget') {
        matchPreset = cRateEur < 1000;
      } else if (activePreset === 'speed') {
        matchPreset = cSpeed >= 400;
      }

      if (matchRegion && matchRate && matchSpeed && matchPreset) {
        card.style.display = 'flex';
        count++;
      } else {
        card.style.display = 'none';
      }
    });

    matchCount.textContent = count;
  }

  fRegion.addEventListener('change', filterCards);
  fBudget.addEventListener('input', filterCards);
  fSpeed.addEventListener('input', filterCards);

  resetBtn.addEventListener('click', () => {
    fRegion.value = 'All';
    fBudget.value = '1500';
    fSpeed.value = '200';
    activePreset = 'all';
    presetChips.forEach((c, idx) => {
      if (idx === 0) {
        c.className = 'preset-chip px-2.5 py-1 rounded-lg text-[11px] font-mono border border-amber-500 bg-amber-500/10 text-amber-300 transition';
      } else {
        c.className = 'preset-chip px-2.5 py-1 rounded-lg text-[11px] font-mono border border-stone-800 bg-stone-950 text-stone-400 hover:border-stone-700 transition';
      }
    });
    updateCurrency('EUR', '€', 1.0);
  });

  filterCards();
</script>
