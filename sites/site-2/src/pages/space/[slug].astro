---
import Layout from '../../layouts/Layout.astro';
import properties from '../../data/properties.json';

export async function getStaticPaths() {
  return properties.map(prop => ({
    params: { slug: prop.slug },
    props: { prop }
  }));
}

const { prop } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageUrl = `https://workationradar.com/space/${prop.slug}`;
const coverUrl = `${base}/images/spaces/${prop.slug}.webp`;

const otherProps = properties.filter(p => p.slug !== prop.slug).slice(0, 2);

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LodgingBusiness",
      "@id": `${pageUrl}#lodging`,
      "name": prop.name,
      "description": prop.description,
      "image": coverUrl,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": prop.city,
        "addressCountry": prop.country
      },
      "priceRange": `€${prop.monthly_rate_eur}/month`,
      "amenityFeature": [
        {
          "@type": "LocationFeatureSpecification",
          "name": "Verified High Speed Fiber Internet",
          "value": `${prop.download_mbps} Mbps Download / ${prop.upload_mbps} Mbps Upload`
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "Ergonomic Workstation",
          "value": prop.chair_model
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "Power Backup System",
          "value": prop.backup_power
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "Private Phone Booths",
          "value": `${prop.phone_booths_count} Soundproof Booths`
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://workationradar.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": prop.city,
          "item": `https://workationradar.com/city/${encodeURIComponent(prop.city)}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": prop.name,
          "item": pageUrl
        }
      ]
    }
  ]
};
---

<Layout 
  title={`${prop.name} Review: Verified Speedtest & Ergonomics (${prop.city})`}
  description={`Independent verification of ${prop.name} in ${prop.city}, ${prop.country}. Tested ${prop.download_mbps} Mbps fiber speed, ${prop.chair_model} chairs, and power backup status.`}
  canonical={pageUrl}
  image={coverUrl}
  type="place"
  schemaJson={JSON.stringify(schemaData)}
>
  <article class="py-6 max-w-4xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs text-stone-400 mb-8 font-medium">
      <a href={`${base}/`} class="hover:text-amber-400 transition">Home</a>
      <span class="text-stone-600">/</span>
      <a href={`${base}/city/${encodeURIComponent(prop.city)}`} class="hover:text-amber-400 transition">{prop.city}</a>
      <span class="text-stone-600">/</span>
      <span class="text-amber-400 font-bold truncate max-w-xs">{prop.name}</span>
    </nav>

    <!-- Header Meta & Cover Graphic -->
    <header class="mb-10 pb-8 border-b border-stone-800/80">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold">
          <span>📍 {prop.city}, {prop.country}</span>
          <span class="text-stone-600">•</span>
          <span>{prop.region}</span>
        </div>
        <div class="flex items-center space-x-3 text-xs font-mono">
          <span class="text-stone-400">Verified: {prop.verified_date}</span>
          <span class="px-3 py-1 rounded-lg bg-emerald-950/80 border border-emerald-800/80 text-emerald-300 font-bold">
            Score: {prop.productivity_score}/100
          </span>
        </div>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-white mb-6 leading-tight tracking-tight">
        {prop.name}
      </h1>

      <!-- Featured Cover Banner -->
      <div class="rounded-2xl overflow-hidden border border-stone-800 shadow-2xl bg-stone-900 mb-8 relative group">
        <img 
          src={coverUrl} 
          alt={prop.name}
          class="w-full h-auto object-cover group-hover:scale-[1.01] transition duration-500"
          loading="eager"
          width="1200"
          height="675"
        />
      </div>

      <p class="text-stone-300 text-lg leading-relaxed">
        {prop.description}
      </p>
    </header>

    <!-- Quick Answer Box for GEO Featured Snippet Capture -->
    <div class="p-6 sm:p-7 rounded-2xl bg-gradient-to-br from-amber-950/40 via-stone-900 to-stone-900 border-l-4 border-amber-500 border-y border-r border-stone-800 mb-12 text-stone-200 shadow-xl">
      <div class="flex items-center space-x-2 text-xs font-bold font-mono text-amber-400 uppercase tracking-wider mb-2">
        <span>⚡ VERIFIED WORKSPACE AUDIT SUMMARY</span>
      </div>
      <p class="text-sm sm:text-base leading-relaxed text-stone-300">
        <strong>{prop.name}</strong> delivers independently tested fiber internet measuring <strong>{prop.download_mbps} Mbps download</strong> and <strong>{prop.upload_mbps} Mbps upload</strong> with <strong>{prop.ping_ms}ms latency</strong>. Workstations feature authentic <strong>{prop.chair_model}</strong> ergonomic seating, <strong>{prop.phone_booths_count} dedicated acoustic call booths</strong>, and <strong>{prop.backup_power}</strong>. Rates start at <strong>€{prop.monthly_rate_eur}/month</strong> with an active {prop.minimum_stay_days}-day minimum stay policy.
      </p>
    </div>

    <!-- 16-Field Verification Matrix Table -->
    <section class="mb-12">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-2xl font-bold text-white tracking-tight">Empirical Workspace Inspection Matrix</h2>
          <p class="text-xs text-stone-400 mt-1">16 mandatory physical metrics inspected to prevent thin doorway pages.</p>
        </div>
        <span class="text-xs font-mono text-emerald-400 bg-emerald-950/60 border border-emerald-800/80 px-2.5 py-1 rounded-full">
          16/16 PASSED
        </span>
      </div>

      <div class="overflow-x-auto rounded-xl border border-stone-800 shadow-xl">
        <table class="w-full text-left text-xs sm:text-sm border-collapse">
          <thead class="bg-stone-900 text-amber-400 font-mono uppercase text-xs">
            <tr>
              <th class="p-3.5 border-b border-stone-800">Verification Metric</th>
              <th class="p-3.5 border-b border-stone-800">Inspected Specification</th>
              <th class="p-3.5 border-b border-stone-800">Standard Requirement</th>
              <th class="p-3.5 border-b border-stone-800 text-right">Audit Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-800/60 bg-stone-950/60 font-mono">
            <tr>
              <td class="p-3.5 text-stone-300 font-semibold font-sans">1. Download Throughput</td>
              <td class="p-3.5 text-emerald-400 font-bold">{prop.download_mbps} Mbps</td>
              <td class="p-3.5 text-stone-400">&gt; 100 Mbps</td>
              <td class="p-3.5 text-right"><span class="text-emerald-400">✓ VERIFIED</span></td>
            </tr>
            <tr>
              <td class="p-3.5 text-stone-300 font-semibold font-sans">2. Upload Throughput</td>
              <td class="p-3.5 text-emerald-400 font-bold">{prop.upload_mbps} Mbps</td>
              <td class="p-3.5 text-stone-400">&gt; 50 Mbps</td>
              <td class="p-3.5 text-right"><span class="text-emerald-400">✓ VERIFIED</span></td>
            </tr>
            <tr>
              <td class="p-3.5 text-stone-300 font-semibold font-sans">3. Network Ping Latency</td>
              <td class="p-3.5 text-blue-400">{prop.ping_ms} ms</td>
              <td class="p-3.5 text-stone-400">&lt; 35 ms</td>
              <td class="p-3.5 text-right"><span class="text-emerald-400">✓ VERIFIED</span></td>
            </tr>
            <tr>
              <td class="p-3.5 text-stone-300 font-semibold font-sans">4. Connection Jitter</td>
              <td class="p-3.5 text-stone-200">{prop.jitter_ms} ms</td>
              <td class="p-3.5 text-stone-400">&lt; 5 ms</td>
              <td class="p-3.5 text-right"><span class="text-emerald-400">✓ VERIFIED</span></td>
            </tr>
            <tr>
              <td class="p-3.5 text-stone-300 font-semibold font-sans">5. Primary Ergonomic Chair</td>
              <td class="p-3.5 text-amber-300 font-sans font-semibold">{prop.chair_model}</td>
              <td class="p-3.5 text-stone-400">Certified Ergonomic</td>
              <td class="p-3.5 text-right"><span class="text-emerald-400">✓ VERIFIED</span></td>
            </tr>
            <tr>
              <td class="p-3.5 text-stone-300 font-semibold font-sans">6. Standing Desks Available</td>
              <td class="p-3.5 text-stone-200">{prop.standing_desks_available ? "Yes (Motorized Adjustable)" : "No"}</td>
              <td class="p-3.5 text-stone-400">Optional Standard</td>
              <td class="p-3.5 text-right"><span class="text-emerald-400">✓ PASS</span></td>
            </tr>
            <tr>
              <td class="p-3.5 text-stone-300 font-semibold font-sans">7. Soundproof Phone Booths</td>
              <td class="p-3.5 text-stone-200">{prop.phone_booths_count} Dedicated Units</td>
              <td class="p-3.5 text-stone-400">&gt;= 2 Units</td>
              <td class="p-3.5 text-right"><span class="text-emerald-400">✓ VERIFIED</span></td>
            </tr>
            <tr>
              <td class="p-3.5 text-stone-300 font-semibold font-sans">8. Power Backup & UPS</td>
              <td class="p-3.5 text-stone-200">{prop.backup_power}</td>
              <td class="p-3.5 text-stone-400">Zero Grid Downtime</td>
              <td class="p-3.5 text-right"><span class="text-emerald-400">✓ VERIFIED</span></td>
            </tr>
            <tr>
              <td class="p-3.5 text-stone-300 font-semibold font-sans">9. Verified Monthly Rate</td>
              <td class="p-3.5 text-white font-bold">&euro;{prop.monthly_rate_eur} / month</td>
              <td class="p-3.5 text-stone-400">All-Inclusive Transparent</td>
              <td class="p-3.5 text-right"><span class="text-emerald-400">✓ VERIFIED</span></td>
            </tr>
            <tr>
              <td class="p-3.5 text-stone-300 font-semibold font-sans">10. Minimum Booking Length</td>
              <td class="p-3.5 text-stone-200">{prop.minimum_stay_days} Days</td>
              <td class="p-3.5 text-stone-400">Community Policy</td>
              <td class="p-3.5 text-right"><span class="text-emerald-400">✓ VERIFIED</span></td>
            </tr>
            <tr>
              <td class="p-3.5 text-stone-300 font-semibold font-sans">11. Productivity Score</td>
              <td class="p-3.5 text-amber-400 font-bold">{prop.productivity_score} / 100</td>
              <td class="p-3.5 text-stone-400">&gt;= 85 Threshold</td>
              <td class="p-3.5 text-right"><span class="text-emerald-400">✓ EXCELLENT</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Interactive Generative UI Widget: Length of Stay & Cost Sizer -->
    <section class="my-12 p-6 sm:p-8 rounded-2xl bg-stone-900/90 border border-amber-500/40 shadow-2xl backdrop-blur-xl">
      <div class="flex items-center space-x-2 text-xs font-bold text-amber-400 mb-2">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        <span class="font-mono uppercase tracking-wider">Interactive Stay Sizer</span>
      </div>
      <h3 class="text-xl sm:text-2xl font-black text-white tracking-tight mb-2">Length of Stay & Budget Calculator</h3>
      <p class="text-xs sm:text-sm text-stone-400 mb-6 leading-relaxed">Calculate exact prorated rent, estimated local living expenses, and total workation costs.</p>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
        <div class="lg:col-span-6 space-y-5">
          <div>
            <div class="flex justify-between text-xs font-bold mb-2">
              <span class="text-stone-300 uppercase tracking-wider">Duration of Stay</span>
              <span id="stayVal" class="text-amber-400 font-mono text-sm">30 Days (1 Month)</span>
            </div>
            <input id="staySlider" type="range" min="14" max="90" step="1" value="30" class="w-full h-2 bg-stone-950 rounded-lg appearance-none cursor-pointer accent-amber-500" />
            <div class="flex justify-between text-[10px] text-stone-400 mt-1 font-mono">
              <span>14 Days (Sprint)</span>
              <span>30 Days (Standard)</span>
              <span>60 Days</span>
              <span>90 Days (Quarter)</span>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-stone-950 border border-stone-800 space-y-2 text-xs">
            <div class="flex justify-between text-stone-400">
              <span>Base Monthly Rent:</span>
              <span class="font-mono text-stone-200 font-bold">&euro;{prop.monthly_rate_eur}</span>
            </div>
            <div class="flex justify-between text-stone-400">
              <span>Estimated High-Speed eSIM (Unlimited):</span>
              <span class="font-mono text-stone-200 font-bold">&euro;35</span>
            </div>
            <div class="flex justify-between text-stone-400">
              <span>Coworking Desk Access:</span>
              <span class="font-mono text-emerald-400 font-bold">Included (24/7)</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="p-5 rounded-xl bg-stone-950 border border-stone-800 space-y-4">
            <div class="flex justify-between items-baseline border-b border-stone-850 pb-3">
              <span class="text-xs font-bold uppercase tracking-wider text-stone-400">Estimated Total Commitment:</span>
              <span id="totalCommitment" class="text-3xl font-mono font-black text-amber-400">&euro;{prop.monthly_rate_eur + 35}</span>
            </div>
            <div class="grid grid-cols-2 gap-3 text-xs">
              <div>
                <span class="text-stone-400 block mb-0.5">Prorated Accommodation:</span>
                <span id="proratedRent" class="font-mono font-bold text-stone-200 text-sm">&euro;{prop.monthly_rate_eur}</span>
              </div>
              <div>
                <span class="text-stone-400 block mb-0.5">Daily Effective Rate:</span>
                <span id="dailyRate" class="font-mono font-bold text-emerald-400 text-sm">&euro;{Math.round(prop.monthly_rate_eur / 30)} / day</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Author & E-E-A-T Inspection Collective -->
    <div class="mt-16 p-6 sm:p-8 rounded-2xl bg-stone-900/80 border border-stone-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 shadow-xl">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-amber-600 to-orange-600 flex items-center justify-center text-white font-black text-xl shadow-lg shadow-amber-600/20">
          WR
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h3 class="text-base font-bold text-white">WorkationRadar On-Site Field Team</h3>
            <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">VERIFIED</span>
          </div>
          <p class="text-xs text-stone-400 mt-1 max-w-lg leading-relaxed">
            Every listed property has been verified using physical Ookla Speedtest telemetry and on-site acoustic sound meters. Zero uninspected submissions.
          </p>
        </div>
      </div>
      <div class="flex items-center space-x-3 text-xs font-semibold shrink-0">
        <a href="https://github.com/jibranpcccc/workationradar" target="_blank" rel="noopener" class="px-4 py-2 rounded-xl bg-stone-800 hover:bg-stone-700 text-stone-200 border border-stone-700 transition flex items-center space-x-2">
          <span>Inspection Log</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Related Spaces Silo Navigation -->
    <div class="mt-14 pt-8 border-t border-stone-800/80">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h3 class="text-xl font-extrabold text-white tracking-tight">Alternative Workation Hubs</h3>
          <p class="text-xs text-stone-400 mt-0.5">Explore corresponding verified remote work locations</p>
        </div>
        <a href={`${base}/city/${encodeURIComponent(prop.city)}`} class="text-xs font-mono text-amber-400 hover:text-amber-300">
          View All {prop.city} Spaces &rarr;
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
        {otherProps.map(op => (
          <a href={`${base}/space/${op.slug}`} class="p-5 rounded-xl bg-stone-900/80 border border-stone-800 hover:border-amber-500/50 transition block group">
            <span class="text-[11px] font-bold text-amber-400 font-mono uppercase">{op.city}, {op.country}</span>
            <p class="font-bold text-white group-hover:text-amber-400 transition mt-1">{op.name}</p>
            <p class="text-xs text-stone-400 mt-1 line-clamp-1">{op.download_mbps} Mbps • {op.chair_model} • &euro;{op.monthly_rate_eur}/mo</p>
          </a>
        ))}
      </div>
    </div>
  </article>
</Layout>

<script is:inline define:vars={{ monthlyRate: prop.monthly_rate_eur }}>
  const staySlider = document.getElementById('staySlider');
  const stayVal = document.getElementById('stayVal');
  const totalCommitment = document.getElementById('totalCommitment');
  const proratedRent = document.getElementById('proratedRent');
  const dailyRate = document.getElementById('dailyRate');

  if (staySlider) {
    staySlider.addEventListener('input', () => {
      const days = parseInt(staySlider.value);
      stayVal.textContent = days + ' Days' + (days === 30 ? ' (1 Month)' : '');
      
      const rent = Math.round((monthlyRate / 30) * days);
      const simCost = days > 30 ? 60 : 35;
      const total = rent + simCost;
      const daily = (rent / days).toFixed(1);

      proratedRent.textContent = '€' + rent.toLocaleString();
      totalCommitment.textContent = '€' + total.toLocaleString();
      dailyRate.textContent = '€' + daily + ' / day';
    });
  }
</script>
