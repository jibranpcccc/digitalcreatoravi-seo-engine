---
import Layout from '../../layouts/Layout.astro';
import properties from '../../data/properties.json';

export async function getStaticPaths() {
  return properties.map(prop => ({
    params: { slug: prop.slug },
    props: { prop }
  }));
}

const { prop } = Astro.props;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": prop.name,
  "description": prop.description,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": prop.city,
    "addressCountry": prop.country
  },
  "priceRange": `€${prop.monthly_rate_eur}/month`,
  "amenityFeature": [
    {
      "@type": "LocationFeatureSpecification",
      "name": "Verified High Speed Internet",
      "value": `${prop.download_mbps} Mbps Download`
    },
    {
      "@type": "LocationFeatureSpecification",
      "name": "Ergonomic Seating",
      "value": prop.chair_model
    },
    {
      "@type": "LocationFeatureSpecification",
      "name": "Power Backup",
      "value": prop.backup_power
    }
  ]
};
---

<Layout 
  title={`${prop.name} Review: Verified Speedtest & Ergonomics (${prop.city})`}
  description={`Independent verification of ${prop.name} in ${prop.city}, ${prop.country}. Tested ${prop.download_mbps} Mbps fiber speed, ${prop.chair_model} chairs, and power backup status.`}
  canonical={`https://workationradar.com/space/${prop.slug}`}
  schemaJson={JSON.stringify(schemaData)}
>
  <article class="py-8 max-w-4xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs text-stone-400 mb-6 font-medium">
      <a href="/" class="hover:text-amber-400">Home</a>
      <span>/</span>
      <a href={`/city/${encodeURIComponent(prop.city)}`} class="hover:text-amber-400">{prop.city}</a>
      <span>/</span>
      <span class="text-amber-400 font-bold truncate max-w-xs">{prop.name}</span>
    </nav>

    <!-- Header & Score -->
    <div class="border-b border-stone-800 pb-8 mb-8">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-stone-900 border border-stone-800 text-xs text-stone-300">
          <span>📍 {prop.city}, {prop.country}</span>
          <span>•</span>
          <span>{prop.region}</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="text-xs text-stone-500 font-mono">Verified: {prop.verified_date}</span>
          <span class="px-3 py-1 rounded-lg bg-amber-950 border border-amber-800 text-amber-400 font-bold text-sm">
            Productivity Score: {prop.productivity_score}/100
          </span>
        </div>
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4 leading-tight">
        {prop.name}
      </h1>
      <p class="text-stone-300 text-lg leading-relaxed">
        {prop.description}
      </p>
    </div>

    <!-- Quick Answer Box for GEO Extractability -->
    <div class="p-6 rounded-xl bg-stone-900 border-l-4 border-amber-500 border-y border-r border-stone-800 mb-10 text-stone-200">
      <h2 class="text-sm font-bold text-amber-400 uppercase tracking-wider mb-2">Verified Remote Work Summary</h2>
      <p class="text-sm leading-relaxed">
        <strong>{prop.name}</strong> provides tested fiber internet delivering <strong>{prop.download_mbps} Mbps download</strong> and <strong>{prop.upload_mbps} Mbps upload</strong> with <strong>{prop.ping_ms}ms latency</strong>. The workspace features authentic <strong>{prop.chair_model}</strong> ergonomic chairs, <strong>{prop.phone_booths_count} dedicated soundproof call booths</strong>, and <strong>{prop.backup_power}</strong>. Rates start at <strong>€{prop.monthly_rate_eur}/month</strong> with a {prop.minimum_stay_days}-day minimum commitment.
      </p>
    </div>

    <!-- 16-Field Verification Matrix -->
    <h2 class="text-2xl font-bold text-white mb-4">Empirical Workspace Inspection Matrix</h2>
    <div class="overflow-x-auto mb-10">
      <table class="w-full text-left text-sm border border-stone-800 rounded-xl overflow-hidden">
        <thead class="bg-stone-900 text-stone-300">
          <tr>
            <th class="p-3.5 border-b border-stone-800">Verification Metric</th>
            <th class="p-3.5 border-b border-stone-800">Inspected Specification</th>
            <th class="p-3.5 border-b border-stone-800">Standard Requirement</th>
            <th class="p-3.5 border-b border-stone-800">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-850">
          <tr class="bg-stone-950">
            <td class="p-3.5 font-semibold text-stone-300">Download Throughput</td>
            <td class="p-3.5 text-emerald-400 font-bold">{prop.download_mbps} Mbps</td>
            <td class="p-3.5 text-stone-400">&gt; 100 Mbps</td>
            <td class="p-3.5 text-emerald-400">✓ Verified Exceeds</td>
          </tr>
          <tr class="bg-stone-900/40">
            <td class="p-3.5 font-semibold text-stone-300">Upload Throughput</td>
            <td class="p-3.5 text-emerald-400 font-bold">{prop.upload_mbps} Mbps</td>
            <td class="p-3.5 text-stone-400">&gt; 50 Mbps</td>
            <td class="p-3.5 text-emerald-400">✓ Verified Exceeds</td>
          </tr>
          <tr class="bg-stone-950">
            <td class="p-3.5 font-semibold text-stone-300">Ping & Jitter</td>
            <td class="p-3.5 text-stone-200">{prop.ping_ms} ms ping / {prop.jitter_ms} ms jitter</td>
            <td class="p-3.5 text-stone-400">&lt; 40 ms</td>
            <td class="p-3.5 text-emerald-400">✓ Ultra Low Latency</td>
          </tr>
          <tr class="bg-stone-900/40">
            <td class="p-3.5 font-semibold text-stone-300">Ergonomic Seating</td>
            <td class="p-3.5 text-stone-200 font-bold">{prop.chair_model}</td>
            <td class="p-3.5 text-stone-400">Lumbar Adjustable Task Chair</td>
            <td class="p-3.5 text-emerald-400">✓ Tier 1 Ergonomic</td>
          </tr>
          <tr class="bg-stone-950">
            <td class="p-3.5 font-semibold text-stone-300">Standing Desks</td>
            <td class="p-3.5 text-stone-200">{prop.standing_desks_available ? "Available in Hot-Desk Area" : "None"}</td>
            <td class="p-3.5 text-stone-400">At least 2 available</td>
            <td class="p-3.5 text-emerald-400">✓ Present</td>
          </tr>
          <tr class="bg-stone-900/40">
            <td class="p-3.5 font-semibold text-stone-300">Private Call Booths</td>
            <td class="p-3.5 text-stone-200 font-bold">{prop.phone_booths_count} Soundproof Booths</td>
            <td class="p-3.5 text-stone-400">&gt;= 2 per 20 members</td>
            <td class="p-3.5 text-emerald-400">✓ High Ratio</td>
          </tr>
          <tr class="bg-stone-950">
            <td class="p-3.5 font-semibold text-stone-300">Electrical Redundancy</td>
            <td class="p-3.5 text-stone-200 font-bold">{prop.backup_power}</td>
            <td class="p-3.5 text-stone-400">Battery or Diesel Failover</td>
            <td class="p-3.5 text-emerald-400">✓ 100% Uptime Protected</td>
          </tr>
          <tr class="bg-stone-900/40">
            <td class="p-3.5 font-semibold text-stone-300">All-Inclusive Rate</td>
            <td class="p-3.5 text-white font-extrabold">&euro;{prop.monthly_rate_eur} / month</td>
            <td class="p-3.5 text-stone-400">Rent + Coworking + Utilities</td>
            <td class="p-3.5 text-stone-200">Fixed Rate</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Related City Links -->
    <div class="mt-12 pt-8 border-t border-stone-800 flex justify-between items-center">
      <a href={`/city/${encodeURIComponent(prop.city)}`} class="text-sm font-semibold text-amber-400 hover:underline">
        &larr; View all coliving spaces in {prop.city}
      </a>
      <a href="/" class="text-sm text-stone-400 hover:text-stone-200">
        Browse Global Directory &rarr;
      </a>
    </div>
  </article>
</Layout>
