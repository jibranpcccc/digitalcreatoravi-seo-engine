  canonical="https://site-16-indol.vercel.app/docker-compose-gpu-passthrough-nvidia-container-toolkit/"
  schema={schema}
>
  <article class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-xs text-slate-500 font-mono mb-6">
      <a href="/" class="hover:text-emerald-400">DevConfigHub</a> / <span>Docker Blueprints</span>
    </nav>

    <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-6">
      Docker Compose GPU Passthrough Guide with NVIDIA Container Toolkit
    </h1>

    <div class="bg-emerald-950/20 border-l-4 border-l-emerald-500 border-y border-r border-emerald-500/30 rounded-xl p-6 shadow-xl mb-10">
      <div class="text-xs font-bold uppercase tracking-wider text-emerald-400 font-mono mb-2">
        ⚡ Quick Answer: Docker Compose GPU Access
      </div>
      <p class="text-sm sm:text-base text-slate-200 leading-relaxed">
        To pass NVIDIA GPUs into modern Docker Compose (Compose v2), install the <strong>NVIDIA Container Toolkit</strong> on the host OS and configure the container service under <code>deploy.resources.reservations.devices</code> with driver set to <code>nvidia</code>, capabilities to <code>[gpu]</code>, and count to <code>all</code>. This replaces the deprecated <code>--gpus</code> CLI flag and legacy runtime directives.
      </p>
    </div>

    <h2 class="text-2xl font-bold text-white mb-4">Complete docker-compose.yml Manifest for Ollama & PyTorch</h2>
    <div class="rounded-xl border border-slate-800 bg-slate-900/90 p-4 font-mono text-xs text-cyan-300 overflow-x-auto mb-8">
      <pre is:raw>
services:
  ollama:
    image: ollama/ollama:latest
    container_name: local-ollama-gpu
    restart: unless-stopped
    ports:
      - "11434:11434"
    volumes:
      - ollama_models:/root/.ollama
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]

volumes:
  ollama_models:
      </pre>
    </div>

