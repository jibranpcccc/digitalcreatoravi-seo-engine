        Local Developer Environment FAQ
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800">
        <h3 class="text-sm font-bold text-white mb-2">What is the difference between DevContainers and Docker Compose?</h3>
        <p class="text-xs text-slate-400 leading-relaxed">
          DevContainers (<code class="font-mono text-emerald-400">devcontainer.json</code>) configure the developer workspace, editor extensions, lifecycle hooks, and shell environment inside a container. Docker Compose orchestrates multi-service backend topologies (databases, caches, queues). In modern workflows, DevContainers frequently reference a <code class="font-mono text-cyan-400">docker-compose.yml</code> file to mount editor tooling onto one service while running companion services.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800">
        <h3 class="text-sm font-bold text-white mb-2">When should I choose Nix Flakes over Docker containers?</h3>
        <p class="text-xs text-slate-400 leading-relaxed">
          Choose Nix Flakes when you require native CPU performance, zero virtualization memory overhead, and instant shell activation without Docker daemon latency. Nix Flakes excel for compiling Rust, C++, and Go where native file I/O speed is paramount, while Docker excels for isolating services with complex OS-level daemons like PostgreSQL and Redis.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800">
        <h3 class="text-sm font-bold text-white mb-2">How do you achieve sub-second startup in local Docker databases?</h3>
        <p class="text-xs text-slate-400 leading-relaxed">
          Mount the database storage directory on a memory-backed tmpfs volume, disable durability guarantees with <code class="font-mono text-amber-400">fsync=off</code> and <code class="font-mono text-amber-400">synchronous_commit=off</code>, and utilize Docker Compose v2 healthcheck dependencies (<code class="font-mono text-emerald-400">condition: service_healthy</code>) to prevent race conditions during application boot.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800">
        <h3 class="text-sm font-bold text-white mb-2">What is Docker-in-Docker (DinD) vs Docker-outside-of-Docker (DooD)?</h3>
        <p class="text-xs text-slate-400 leading-relaxed">
          Docker-in-Docker runs a child Docker daemon inside the container with privileged flags. Docker-outside-of-Docker mounts the host's <code class="font-mono text-purple-400">/var/run/docker.sock</code> into the container, allowing sibling container orchestration without nested virtualization overhead or privileged security concessions.
        </p>
      </div>
    </div>
  </section>

  <!-- Client-side Interactive Generator Script -->
  <script is:inline>
    (function() {
      // Elements
      const stackRadios = document.querySelectorAll('input[name="stack"]');
      const dbRadios = document.querySelectorAll('input[name="database"]');
      const featPgvector = document.getElementById('feat-pgvector');
      const featDind = document.getElementById('feat-dind');
      const featTmpfs = document.getElementById('feat-tmpfs');

      const codeCompose = document.getElementById('code-compose');
      const codeDevcontainer = document.getElementById('code-devcontainer');
      const codeNix = document.getElementById('code-nix');

      const tabCompose = document.getElementById('tab-compose');
      const tabDevcontainer = document.getElementById('tab-devcontainer');
      const tabNix = document.getElementById('tab-nix');

      const viewCompose = document.getElementById('view-compose');
      const viewDevcontainer = document.getElementById('view-devcontainer');
      const viewNix = document.getElementById('view-nix');

      const copyBtn = document.getElementById('copy-btn');
      const copyText = document.getElementById('copy-text');
      const copyIcon = document.getElementById('copy-icon');
      const metricPort = document.getElementById('metric-port');
      const cliHint = document.getElementById('cli-hint');

      let currentTab = 'compose';

      function getSelectedStack() {
        const checked = document.querySelector('input[name="stack"]:checked');
        return checked ? checked.value : 'node';
      }

      function getSelectedDb() {
        const checked = document.querySelector('input[name="database"]:checked');
        return checked ? checked.value : 'both';
      }

      function generateConfigs() {
        const stack = getSelectedStack();
        const db = getSelectedDb();
        const hasPgvector = featPgvector.checked && (db === 'postgres' || db === 'both');
        const hasDind = featDind.checked;
        const hasTmpfs = featTmpfs.checked;

        // Auto disable pgvector if db has no postgres
        if (db === 'redis' || db === 'none') {
          featPgvector.disabled = true;
          featPgvector.parentElement.classList.add('opacity-50');
        } else {
          featPgvector.disabled = false;
          featPgvector.parentElement.classList.remove('opacity-50');
        }

        // Stack info
        const stackConfig = {
          node: {
            name: "Node.js 20 & TypeScript Suite",
            servicePort: 3000,
            command: '["pnpm", "run", "dev"]',
            postCreate: "pnpm install",
            user: "node",
            extensions: ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "eamodio.gitlens"],
            nixPkgs: "nodejs_20\n            pnpm"
          },
          python: {
            name: "Python 3.12 & FastAPI Engine",
            servicePort: 8000,
            command: '["uv", "run", "uvicorn", "main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"]',
            postCreate: "uv sync",
            user: "vscode",
            extensions: ["ms-python.python", "charliermarsh.ruff", "tamasfe.even-better-toml"],
            nixPkgs: "python312\n            uv\n            ruff"
          },
          rust: {
            name: "Rust 1.80+ Systems Workstation",
            servicePort: 8080,
            command: '["cargo", "watch", "-x", "run"]',
            postCreate: "cargo check",
            user: "vscode",
            extensions: ["rust-lang.rust-analyzer", "tamasfe.even-better-toml", "vadimcn.vscode-lldb"],
            nixPkgs: "rustc\n            cargo\n            rust-analyzer\n            clippy"
          },
          go: {
            name: "Go 1.23 High-Throughput Service",
            servicePort: 8080,
            command: '["air"]',
            postCreate: "go mod download",
            user: "vscode",
            extensions: ["golang.go", "golang.delve-dap"],
            nixPkgs: "go_1_23\n            gopls\n            golangci-lint"
          }
        }[stack];

        metricPort.textContent = `${stackConfig.servicePort}` + (db === 'both' ? ' / 5432 / 6379' : db === 'postgres' ? ' / 5432' : db === 'redis' ? ' / 6379' : '');
        cliHint.textContent = `docker compose up -d && code .`;

        // 1. Compose Config
        let compose = `services:\n  app:\n    build:\n      context: .\n      dockerfile: Dockerfile\n    volumes:\n      - .:/workspace:cached\n`;
        
        if (hasDind) {
          compose += `      - /var/run/docker.sock:/var/run/docker.sock\n`;
        }

        compose += `    ports:\n      - "${stackConfig.servicePort}:${stackConfig.servicePort}"\n    environment:\n      - ENV=development\n`;

        if (db === 'postgres' || db === 'both') {
          compose += `      - DATABASE_URL=postgresql://postgres:postgres@postgres:5432/app_dev?sslmode=disable\n`;
        }
        if (db === 'redis' || db === 'both') {
          compose += `      - REDIS_URL=redis://redis:6379/0\n`;
        }

        if (db !== 'none') {
          compose += `    depends_on:\n`;
          if (db === 'postgres' || db === 'both') {
            compose += `      postgres:\n        condition: service_healthy\n`;
          }
          if (db === 'redis' || db === 'both') {
            compose += `      redis:\n        condition: service_healthy\n`;
          }
        }

        compose += `    command: ${stackConfig.command}\n`;

        // Postgres Service
        if (db === 'postgres' || db === 'both') {
          const pgImg = hasPgvector ? 'pgvector/pgvector:pg16' : 'postgres:16-alpine';
          compose += `\n  postgres:\n    image: ${pgImg}\n    restart: unless-stopped\n    ports:\n      - "5432:5432"\n    environment:\n      - POSTGRES_USER=postgres\n      - POSTGRES_PASSWORD=postgres\n      - POSTGRES_DB=app_dev\n`;
          
          if (hasTmpfs) {
            compose += `    command:\n      - "postgres"\n      - "-c"\n      - "fsync=off"\n      - "-c"\n      - "synchronous_commit=off"\n      - "-c"\n      - "full_page_writes=off"\n      - "-c"\n      - "shared_buffers=256MB"\n    tmpfs:\n      - /var/lib/postgresql/data:rw,noexec,nosuid,size=1024m\n`;
          } else {
            compose += `    volumes:\n      - postgres_data:/var/lib/postgresql/data\n`;
          }

          compose += `    healthcheck:\n      test: ["CMD-SHELL", "pg_isready -U postgres -d app_dev"]\n      interval: 2s\n      timeout: 3s\n      retries: 10\n      start_period: 2s\n`;
        }

        // Redis Service
        if (db === 'redis' || db === 'both') {
          compose += `\n  redis:\n    image: redis:7-alpine\n    restart: unless-stopped\n    ports:\n      - "6379:6379"\n`;
          if (hasTmpfs) {
            compose += `    command: ["redis-server", "--save", "", "--appendonly", "no"]\n`;
          }
          compose += `    healthcheck:\n      test: ["CMD", "redis-cli", "ping"]\n      interval: 2s\n      timeout: 2s\n      retries: 5\n      start_period: 1s\n`;
        }

        if ((db === 'postgres' || db === 'both') && !hasTmpfs) {
          compose += `\nvolumes:\n  postgres_data:\n`;
        }

        codeCompose.textContent = compose;

        // 2. DevContainer Config
        const forwardPorts = [stackConfig.servicePort];
        if (db === 'postgres' || db === 'both') forwardPorts.push(5432);
        if (db === 'redis' || db === 'both') forwardPorts.push(6379);

        const portsAttributes = {
          [stackConfig.servicePort]: {
            label: "Application Dev Server",
            onAutoForward: "openBrowser"
          }
        };
        if (db === 'postgres' || db === 'both') {
          portsAttributes["5432"] = {
            label: "PostgreSQL 16 Engine",
            onAutoForward: "silent"
          };
        }
        if (db === 'redis' || db === 'both') {
          portsAttributes["6379"] = {
            label: "Redis 7 In-Memory Cache",
            onAutoForward: "silent"
          };
        }

        const devcontainerObj = {
          name: stackConfig.name,
          dockerComposeFile: "docker-compose.yml",
          service: "app",
          workspaceFolder: "/workspace",
          customizations: {
            vscode: {
              settings: {
                "terminal.integrated.defaultProfile.linux": "bash",
                "editor.formatOnSave": true
              },
              extensions: stackConfig.extensions
            }
          },
          forwardPorts: forwardPorts,
          portsAttributes: portsAttributes,
          postCreateCommand: stackConfig.postCreate,
          remoteUser: stackConfig.user
        };

        if (hasDind) {
          devcontainerObj.features = {
            "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
              version: "latest",
              enableNonRootDocker: "true"
            }
          };
        }

        codeDevcontainer.textContent = JSON.stringify(devcontainerObj, null, 2);

        // 3. Nix Flake Config
        let nixPkgsList = stackConfig.nixPkgs;
        if (db === 'postgres' || db === 'both') nixPkgsList += `\n            postgresql_16`;
        if (db === 'redis' || db === 'both') nixPkgsList += `\n            redis`;
        nixPkgsList += `\n            git\n            docker-compose`;

        const nixFlake = `{\n  description = "Hermetic Development Shell via Nix Flakes";\n\n  inputs = {\n    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";\n    flake-utils.url = "github:numtide/flake-utils";\n  };\n\n  outputs = { self, nixpkgs, flake-utils }:\n    flake-utils.lib.eachDefaultSystem (system:\n      let\n        pkgs = import nixpkgs { inherit system; };\n      in\n      {\n        devShells.default = pkgs.mkShell {\n          buildInputs = with pkgs; [\n            ${nixPkgsList}\n          ];\n\n          shellHook = ''\n            echo "🔥 DevConfigHub Hermetic Environment [System: \${system}]"\n            export DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_dev"\n            export REDIS_URL="redis://localhost:6379/0"\n          '';\n        };\n      }\n    );\n}`;

        codeNix.textContent = nixFlake;
      }

      // Event Listeners for inputs
      stackRadios.forEach(r => r.addEventListener('change', generateConfigs));
      dbRadios.forEach(r => r.addEventListener('change', generateConfigs));
      featPgvector.addEventListener('change', generateConfigs);
      featDind.addEventListener('change', generateConfigs);
      featTmpfs.addEventListener('change', generateConfigs);

      // Tabs
      function setTab(tabName) {
        currentTab = tabName;
        [tabCompose, tabDevcontainer, tabNix].forEach(btn => {
          btn.classList.remove('bg-emerald-500/20', 'text-emerald-400', 'border', 'border-emerald-500/40');
          btn.classList.add('text-slate-400');
        });
        [viewCompose, viewDevcontainer, viewNix].forEach(v => v.classList.add('hidden'));

        if (tabName === 'compose') {
          tabCompose.classList.add('bg-emerald-500/20', 'text-emerald-400', 'border', 'border-emerald-500/40');
          tabCompose.classList.remove('text-slate-400');
          viewCompose.classList.remove('hidden');
          copyText.textContent = "Copy docker-compose.yml";
        } else if (tabName === 'devcontainer') {
          tabDevcontainer.classList.add('bg-emerald-500/20', 'text-emerald-400', 'border', 'border-emerald-500/40');
          tabDevcontainer.classList.remove('text-slate-400');
          viewDevcontainer.classList.remove('hidden');
          copyText.textContent = "Copy devcontainer.json";
        } else if (tabName === 'nix') {
          tabNix.classList.add('bg-emerald-500/20', 'text-emerald-400', 'border', 'border-emerald-500/40');
          tabNix.classList.remove('text-slate-400');
          viewNix.classList.remove('hidden');
          copyText.textContent = "Copy flake.nix";
        }
      }

      tabCompose.addEventListener('click', () => setTab('compose'));
      tabDevcontainer.addEventListener('click', () => setTab('devcontainer'));
      tabNix.addEventListener('click', () => setTab('nix'));

      // 1-Click Copy
      copyBtn.addEventListener('click', async () => {
        let textToCopy = "";
        if (currentTab === 'compose') textToCopy = codeCompose.textContent;
        if (currentTab === 'devcontainer') textToCopy = codeDevcontainer.textContent;
        if (currentTab === 'nix') textToCopy = codeNix.textContent;

        try {
          await navigator.clipboard.writeText(textToCopy);
          copyText.textContent = "Copied to Clipboard!";
          copyBtn.classList.remove('bg-emerald-500', 'text-slate-950');
          copyBtn.classList.add('bg-cyan-400', 'text-slate-950');
          setTimeout(() => {
            setTab(currentTab);
            copyBtn.classList.add('bg-emerald-500', 'text-slate-950');
            copyBtn.classList.remove('bg-cyan-400');
          }, 2000);
        } catch (e) {
          console.error("Copy failed", e);
        }
      });

      // Initial run
      generateConfigs();
    })();
  </script>
</Layout>
