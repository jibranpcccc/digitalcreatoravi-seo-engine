---
import Layout from '../layouts/Layout.astro';

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://site-16-indol.vercel.app/#app",
      "name": "DevConfigHub Dev Environment Generator",
      "url": "https://site-16-indol.vercel.app/",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Linux, macOS, Windows",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "Interactive local development configuration generator for Docker Compose, DevContainers, and Nix Flakes across Node.js, Python, Rust, and Go."
    },
    {
      "@type": "FAQPage",
      "@id": "https://site-16-indol.vercel.app/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the difference between DevContainers and Docker Compose?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "DevContainers (devcontainer.json) configure the developer workspace, editor extensions, lifecycle hooks, and shell environment inside a container. Docker Compose orchestrates multi-service backend topologies (databases, caches, queues). In modern workflows, DevContainers frequently reference a docker-compose.yml file to mount editor tooling onto one service while running database companions."
          }
        },
        {
          "@type": "Question",
          "name": "When should I choose Nix Flakes over Docker containers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Choose Nix Flakes when you require native CPU performance, zero virtualization memory overhead, and instant shell activation without Docker daemon latency. Nix Flakes excel for compiling Rust, C++, and Go where native file I/O speed is paramount, while Docker excels for isolating services with complex OS-level daemons like PostgreSQL and Redis."
          }
        },
        {
          "@type": "Question",
          "name": "How do you achieve sub-second startup in local Docker databases?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mount the database storage directory on a memory-backed tmpfs volume, disable durability guarantees with fsync=off and synchronous_commit=off, and utilize Docker Compose v2 healthcheck dependencies (condition: service_healthy) to prevent race conditions during application boot."
          }
        },
        {
          "@type": "Question",
          "name": "What is Docker-in-Docker (DinD) vs Docker-outside-of-Docker (DooD)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Docker-in-Docker runs a child Docker daemon inside the container with privileged flags. Docker-outside-of-Docker mounts the host's /var/run/docker.sock into the container, allowing sibling container orchestration without nested virtualization overhead or privileged security concessions."
          }
        }
      ]
    }
  ]
};

const pageTitle = "DevConfigHub: DevContainer & Docker Compose Generator";
const pageDescription = "Generate production-tuned DevContainer, Docker Compose, and Nix Flakes configs for Node.js, Python, Rust, and Go with PostgreSQL 16, pgvector, and Redis 7.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="https://site-16-indol.vercel.app/"
  schemaJson={JSON.stringify(schemaData)}
>
  <!-- Hero Section -->
  <section class="py-8 sm:py-12 border-b border-slate-800/80 relative">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono mb-6">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      Interactive Local Dev Environment Architect
    </div>

    <!-- EXACTLY ONE H1 -->
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white mb-6 leading-tight">
      Modern Developer Config Hub: <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-cyan-400 to-blue-500">DevContainer, Docker Compose & Nix Flakes</span>
    </h1>

    <!-- 45-60 Word Quick Answer Featured Snippet Box with Green Accent Border -->
    <div class="my-6 p-5 sm:p-6 rounded-2xl bg-gradient-to-br from-emerald-950/40 via-slate-900/60 to-slate-950/80 border-l-4 border-emerald-500 border-y border-r border-slate-800 shadow-xl shadow-emerald-950/20">
      <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-emerald-400 font-bold mb-2.5">
        <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>Quick Answer & Architecture Summary</span>
      </div>
      <p class="text-slate-200 text-sm sm:text-base leading-relaxed">
        DevConfigHub provides production-ready local development configurations bridging DevContainers, Docker Compose, and Nix Flakes. DevContainers isolate editor tooling and extensions inside containers, Docker Compose orchestrates multi-service databases with optimized filesystem caching, and Nix Flakes delivers hermetic, zero-container toolchain reproducibility. Together, they eliminate environment drift and enable instantaneous developer onboarding across any operating system.
      </p>
    </div>

    <p class="text-base sm:text-lg text-slate-400 max-w-3xl leading-relaxed">
      Configure your stack in seconds below. Pick your primary runtime, database companions, and specialized developer features to produce battle-hardened <code class="text-emerald-400 font-mono text-sm bg-slate-900 px-1.5 py-0.5 rounded">docker-compose.yml</code> and <code class="text-cyan-400 font-mono text-sm bg-slate-900 px-1.5 py-0.5 rounded">devcontainer.json</code> files ready for production repos.
    </p>
  </section>

  <!-- Interactive Config Generator Section -->
  <section id="generator" class="py-12">
    <div class="flex flex-col lg:flex-row gap-8 items-start">
      
      <!-- Left Controls Panel -->
      <div class="w-full lg:w-5/12 bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-2xl backdrop-blur-sm">
        <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-6">
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
            Configuration Matrix
          </h2>
          <span class="text-xs font-mono text-slate-400">Auto-evaluates</span>
        </div>

        <!-- 1. Select Stack -->
        <div class="mb-6">
          <label class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-300 mb-2.5">
            1. Primary Language & Runtime
          </label>
          <div class="grid grid-cols-2 gap-2.5">
            <label class="flex items-center p-3 rounded-xl border border-slate-700/80 bg-slate-950/60 hover:border-emerald-500/60 cursor-pointer transition has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-950/20">
              <input type="radio" name="stack" value="node" checked class="w-4 h-4 text-emerald-500 bg-slate-900 border-slate-700 focus:ring-emerald-500" />
              <div class="ml-2.5">
                <span class="block text-xs font-bold text-white">Node.js / TS</span>
                <span class="block text-[10px] text-slate-400 font-mono">v20 LTS • pnpm</span>
              </div>
            </label>

            <label class="flex items-center p-3 rounded-xl border border-slate-700/80 bg-slate-950/60 hover:border-emerald-500/60 cursor-pointer transition has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-950/20">
              <input type="radio" name="stack" value="python" class="w-4 h-4 text-emerald-500 bg-slate-900 border-slate-700 focus:ring-emerald-500" />
              <div class="ml-2.5">
                <span class="block text-xs font-bold text-white">Python / FastAPI</span>
                <span class="block text-[10px] text-slate-400 font-mono">v3.12 • uv & ruff</span>
              </div>
            </label>

            <label class="flex items-center p-3 rounded-xl border border-slate-700/80 bg-slate-950/60 hover:border-emerald-500/60 cursor-pointer transition has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-950/20">
              <input type="radio" name="stack" value="rust" class="w-4 h-4 text-emerald-500 bg-slate-900 border-slate-700 focus:ring-emerald-500" />
              <div class="ml-2.5">
                <span class="block text-xs font-bold text-white">Rust</span>
                <span class="block text-[10px] text-slate-400 font-mono">1.80+ • cargo & clippy</span>
              </div>
            </label>

            <label class="flex items-center p-3 rounded-xl border border-slate-700/80 bg-slate-950/60 hover:border-emerald-500/60 cursor-pointer transition has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-950/20">
              <input type="radio" name="stack" value="go" class="w-4 h-4 text-emerald-500 bg-slate-900 border-slate-700 focus:ring-emerald-500" />
              <div class="ml-2.5">
                <span class="block text-xs font-bold text-white">Go (Golang)</span>
                <span class="block text-[10px] text-slate-400 font-mono">v1.23 • gopls & delve</span>
              </div>
            </label>
          </div>
        </div>

        <!-- 2. Select Database -->
        <div class="mb-6">
          <label class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-300 mb-2.5">
            2. Database & Cache Layer
          </label>
          <div class="grid grid-cols-2 gap-2.5">
            <label class="flex items-center p-3 rounded-xl border border-slate-700/80 bg-slate-950/60 hover:border-cyan-500/60 cursor-pointer transition has-[:checked]:border-cyan-500 has-[:checked]:bg-cyan-950/20">
              <input type="radio" name="database" value="both" checked class="w-4 h-4 text-cyan-500 bg-slate-900 border-slate-700 focus:ring-cyan-500" />
              <div class="ml-2.5">
                <span class="block text-xs font-bold text-white">Postgres 16 + Redis 7</span>
                <span class="block text-[10px] text-slate-400 font-mono">Full stack companion</span>
              </div>
            </label>

            <label class="flex items-center p-3 rounded-xl border border-slate-700/80 bg-slate-950/60 hover:border-cyan-500/60 cursor-pointer transition has-[:checked]:border-cyan-500 has-[:checked]:bg-cyan-950/20">
              <input type="radio" name="database" value="postgres" class="w-4 h-4 text-cyan-500 bg-slate-900 border-slate-700 focus:ring-cyan-500" />
              <div class="ml-2.5">
                <span class="block text-xs font-bold text-white">Postgres 16 Only</span>
                <span class="block text-[10px] text-slate-400 font-mono">Port 5432 • Alpine</span>
              </div>
            </label>

            <label class="flex items-center p-3 rounded-xl border border-slate-700/80 bg-slate-950/60 hover:border-cyan-500/60 cursor-pointer transition has-[:checked]:border-cyan-500 has-[:checked]:bg-cyan-950/20">
              <input type="radio" name="database" value="redis" class="w-4 h-4 text-cyan-500 bg-slate-900 border-slate-700 focus:ring-cyan-500" />
              <div class="ml-2.5">
                <span class="block text-xs font-bold text-white">Redis 7 Only</span>
                <span class="block text-[10px] text-slate-400 font-mono">Port 6379 • In-memory</span>
              </div>
            </label>

            <label class="flex items-center p-3 rounded-xl border border-slate-700/80 bg-slate-950/60 hover:border-cyan-500/60 cursor-pointer transition has-[:checked]:border-cyan-500 has-[:checked]:bg-cyan-950/20">
              <input type="radio" name="database" value="none" class="w-4 h-4 text-cyan-500 bg-slate-900 border-slate-700 focus:ring-cyan-500" />
              <div class="ml-2.5">
                <span class="block text-xs font-bold text-white">None (Stateless)</span>
                <span class="block text-[10px] text-slate-400 font-mono">App container only</span>
              </div>
            </label>
          </div>
        </div>

        <!-- 3. Specialized Features -->
        <div class="mb-6">
          <label class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-300 mb-2.5">
            3. Advanced Engineering Features
          </label>
          <div class="space-y-2.5">
            <label class="flex items-start p-3 rounded-xl border border-slate-700/80 bg-slate-950/60 hover:border-blue-500/60 cursor-pointer transition has-[:checked]:border-blue-500 has-[:checked]:bg-blue-950/20">
              <input type="checkbox" id="feat-pgvector" checked class="mt-0.5 w-4 h-4 text-blue-500 rounded bg-slate-900 border-slate-700 focus:ring-blue-500" />
              <div class="ml-3">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold text-white">pgvector Support</span>
                  <span class="px-1.5 py-0.5 rounded text-[9px] font-mono bg-blue-500/20 text-blue-400">AI / RAG</span>
                </div>
                <span class="text-[11px] text-slate-400 leading-normal block mt-0.5">
                  Swaps standard Postgres image with <code class="text-slate-300">pgvector/pgvector:pg16</code> for native vector embeddings and cosine distance indexing.
                </span>
              </div>
            </label>

            <label class="flex items-start p-3 rounded-xl border border-slate-700/80 bg-slate-950/60 hover:border-purple-500/60 cursor-pointer transition has-[:checked]:border-purple-500 has-[:checked]:bg-purple-950/20">
              <input type="checkbox" id="feat-dind" class="mt-0.5 w-4 h-4 text-purple-500 rounded bg-slate-900 border-slate-700 focus:ring-purple-500" />
              <div class="ml-3">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold text-white">Docker-in-Docker / Socket Mount</span>
                  <span class="px-1.5 py-0.5 rounded text-[9px] font-mono bg-purple-500/20 text-purple-400">CI / Testcontainers</span>
                </div>
                <span class="text-[11px] text-slate-400 leading-normal block mt-0.5">
                  Injects host Docker socket into DevContainer to run Testcontainers, k3s, or nested container builds.
                </span>
              </div>
            </label>

            <label class="flex items-start p-3 rounded-xl border border-slate-700/80 bg-slate-950/60 hover:border-amber-500/60 cursor-pointer transition has-[:checked]:border-amber-500 has-[:checked]:bg-amber-950/20">
              <input type="checkbox" id="feat-tmpfs" checked class="mt-0.5 w-4 h-4 text-amber-500 rounded bg-slate-900 border-slate-700 focus:ring-amber-500" />
              <div class="ml-3">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold text-white">RAM-Backed tmpfs Speed Flags</span>
                  <span class="px-1.5 py-0.5 rounded text-[9px] font-mono bg-amber-500/20 text-amber-400">10x Speedup</span>
                </div>
                <span class="text-[11px] text-slate-400 leading-normal block mt-0.5">
                  Disables fsync durability and uses memory mounts for sub-second database boot and ultra-fast integration tests.
                </span>
              </div>
            </label>
          </div>
        </div>

        <!-- Quick Summary Metrics -->
        <div class="p-4 rounded-xl bg-slate-950/80 border border-slate-800 text-xs text-slate-400 space-y-1.5 font-mono">
          <div class="flex justify-between">
            <span class="text-slate-400">Lifecycle Engine:</span>
            <span class="text-emerald-400 font-bold" id="metric-lifecycle">postCreateCommand</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Compose Version:</span>
            <span class="text-cyan-400 font-bold">Compose Spec v2.29</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Container Port:</span>
            <span class="text-white font-bold" id="metric-port">3000 / 5432</span>
          </div>
        </div>

      </div>

      <!-- Right Output & Code Display Panel -->
      <div class="w-full lg:w-7/12 bg-slate-950 border border-slate-800 rounded-2xl shadow-2xl overflow-hidden flex flex-col">
        <!-- Header with Tabs and 1-Click Copy -->
        <div class="bg-slate-900/90 border-b border-slate-800 px-4 py-3 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-1.5">
            <button
              id="tab-compose"
              class="tab-btn px-3.5 py-1.5 rounded-lg text-xs font-mono font-bold transition bg-emerald-500/20 text-emerald-400 border border-emerald-500/40"
              data-target="compose"
            >
              docker-compose.yml
            </button>
            <button
              id="tab-devcontainer"
              class="tab-btn px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium transition text-slate-400 hover:text-white hover:bg-slate-800/60"
              data-target="devcontainer"
            >
              devcontainer.json
            </button>
            <button
              id="tab-nix"
              class="tab-btn px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium transition text-slate-400 hover:text-white hover:bg-slate-800/60"
              data-target="nix"
            >
              flake.nix
            </button>
          </div>

          <div class="flex items-center gap-2">
            <button
              id="copy-btn"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-mono font-bold shadow-md shadow-emerald-500/20 transition cursor-pointer"
            >
              <svg id="copy-icon" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span id="copy-text">Copy File</span>
            </button>
          </div>
        </div>

        <!-- Code Content Area -->
        <div class="p-4 sm:p-6 overflow-x-auto bg-[#070A11] flex-grow max-h-[600px] overflow-y-auto font-mono text-xs sm:text-sm leading-relaxed text-slate-300 selection:bg-emerald-500/30">
          <div id="view-compose" class="code-view">
            <pre id="code-compose" is:raw class="whitespace-pre overflow-x-auto">services:
  app:
    build:
      context: .
      dockerfile: Dockerfile
    volumes:
      - .:/workspace:cached
    ports:
      - "3000:3000"
    environment:
      - NODE_ENV=development
      - DATABASE_URL=postgresql://postgres:postgres@postgres:5432/app_dev?sslmode=disable
      - REDIS_URL=redis://redis:6379/0
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    command: ["pnpm", "run", "dev"]

  postgres:
    image: pgvector/pgvector:pg16
    restart: unless-stopped
    ports:
      - "5432:5432"
    environment:
      - POSTGRES_USER=postgres
      - POSTGRES_PASSWORD=postgres
      - POSTGRES_DB=app_dev
    command:
      - "postgres"
      - "-c"
      - "fsync=off"
      - "-c"
      - "synchronous_commit=off"
      - "-c"
      - "full_page_writes=off"
      - "-c"
      - "shared_buffers=256MB"
    tmpfs:
      - /var/lib/postgresql/data:rw,noexec,nosuid,size=1024m
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d app_dev"]
      interval: 2s
      timeout: 3s
      retries: 10
      start_period: 2s

  redis:
    image: redis:7-alpine
    restart: unless-stopped
    ports:
      - "6379:6379"
    command: ["redis-server", "--save", "", "--appendonly", "no"]
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 2s
      timeout: 2s
      retries: 5
      start_period: 1s</pre>
          </div>

          <div id="view-devcontainer" class="code-view hidden">
            <pre id="code-devcontainer" is:raw class="whitespace-pre overflow-x-auto">{
  "name": "Node.js 20 & Full-Stack Suite",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "ms-azuretools.vscode-docker",
        "ckolkman.vscode-postgres"
      ]
    }
  },
  "forwardPorts": [3000, 5432, 6379],
  "portsAttributes": {
    "3000": {
      "label": "Application Dev Server",
      "onAutoForward": "openBrowser"
    },
    "5432": {
      "label": "PostgreSQL 16 Engine",
      "onAutoForward": "silent"
    },
    "6379": {
      "label": "Redis 7 In-Memory Cache",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "pnpm install",
  "remoteUser": "node"
}</pre>
          </div>

          <div id="view-nix" class="code-view hidden">
            <pre id="code-nix" is:raw class="whitespace-pre overflow-x-auto">{
  description = "Hermetic Development Shell via Nix Flakes";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    flake-utils.url = "github:numtide/flake-utils";
  };

  outputs = { self, nixpkgs, flake-utils }:
    flake-utils.lib.eachDefaultSystem (system:
      let
        pkgs = import nixpkgs { inherit system; };
      in
      {
        devShells.default = pkgs.mkShell {
          buildInputs = with pkgs; [
            nodejs_20
            pnpm
            postgresql_16
            redis
            git
            docker-compose
          ];

          shellHook = ''
            echo "🔥 DevConfigHub Hermetic Environment Activated [System: ${system}]"
            export DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_dev"
            export REDIS_URL="redis://localhost:6379/0"
          '';
        };
      }
    );
}</pre>
          </div>
        </div>

        <!-- Terminal Quick Run Hint Footer -->
        <div class="bg-slate-900 border-t border-slate-800 px-4 py-2.5 flex items-center justify-between text-[11px] font-mono text-slate-400">
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">&gt;</span>
            <span id="cli-hint">docker compose up -d</span>
          </div>
          <span class="text-slate-400">Zero-lag local telemetry</span>
        </div>
      </div>

    </div>
  </section>

  <!-- Architecture Cheatsheet Section -->
  <section id="cheatsheet" class="py-12 border-t border-slate-800/80">
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-mono mb-3">
        Engineers Matrix 2026
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
        Local Dev Environment Architecture Cheatsheet
      </h2>
      <p class="text-slate-400 text-sm sm:text-base mt-2 max-w-3xl">
        Compare the three primary paradigms for engineering workstation isolation, disk overhead, filesystem latency, and cross-platform compatibility.
      </p>
    </div>

    <!-- Comparative Table -->
    <div class="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-900/60 shadow-xl mb-12">
      <table class="w-full text-left text-xs sm:text-sm">
        <thead class="bg-slate-950/80 text-slate-300 font-mono uppercase text-[11px] border-b border-slate-800">
          <tr>
            <th class="p-4 sm:p-5">Dimension</th>
            <th class="p-4 sm:p-5 text-emerald-400">VS Code DevContainers</th>
            <th class="p-4 sm:p-5 text-cyan-400">Docker Compose Alone</th>
            <th class="p-4 sm:p-5 text-purple-400">Nix Flakes DevShell</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/80 text-slate-300 font-sans">
          <tr class="hover:bg-slate-800/30 transition">
