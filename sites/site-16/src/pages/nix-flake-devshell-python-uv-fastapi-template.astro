      <h2 class="text-2xl font-bold text-white border-b border-slate-800 pb-2">
        Production `flake.nix` Multi-Platform DevShell Blueprint for Python 3.12 &amp; FastAPI
      </h2>
      <p>
        The complete, copy-pasteable <code>flake.nix</code> configuration below exports a declarative development shell. It pins Python 3.12, Astral uv, PostgreSQL client headers, OpenSSL 3, and native macOS security frameworks, automatically synchronizing a local virtualenv on shell entry:
      </p>

      <pre is:raw class="bg-slate-950 p-4 rounded-lg border border-slate-800 text-xs font-mono text-cyan-300 overflow-x-auto"><code>{
  description = "Sub-second hermetic Python 3.12 + uv + FastAPI development shell";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    flake-utils.url = "github:numtide/flake-utils";
  };

  outputs = { self, nixpkgs, flake-utils }:
    flake-utils.lib.eachDefaultSystem (system:
      let
        pkgs = import nixpkgs {
          inherit system;
          config.allowUnfree = true;
        };
      in
      {
        devShells.default = pkgs.mkShell {
          name = "fastapi-uv-devshell";

          buildInputs = with pkgs; [
            python312Full
            uv
            git
            openssl
            pkg-config
            libffi
            postgresql
          ] ++ pkgs.lib.optionals pkgs.stdenv.isDarwin [
            darwin.apple_sdk.frameworks.Security
            darwin.apple_sdk.frameworks.CoreFoundation
            darwin.apple_sdk.frameworks.SystemConfiguration
          ];

          shellHook = ''
            export VIRTUAL_ENV="$PWD/.venv"
            export PATH="$VIRTUAL_ENV/bin:$PATH"
            
            # Explicitly export C library headers for compilation
            export CPATH="${pkgs.postgresql}/include:${pkgs.openssl.dev}/include:${pkgs.libffi.dev}/include:$CPATH"
            export LIBRARY_PATH="${pkgs.postgresql.lib}/lib:${pkgs.openssl.out}/lib:${pkgs.libffi.out}/lib:$LIBRARY_PATH"
            export LD_LIBRARY_PATH="${pkgs.postgresql.lib}/lib:${pkgs.openssl.out}/lib:${pkgs.libffi.out}/lib:$LD_LIBRARY_PATH"

            # Auto-initialize and sync virtual environment via Astral uv
            if [ ! -d "$VIRTUAL_ENV" ]; then
              echo "[Nix DevShell] Creating virtualenv via Astral uv..."
              uv venv -p python3.12
            fi
            
            # Sub-second wheel sync with editable installation
            if [ -f "pyproject.toml" ]; then
              uv pip install -q -e ".[dev]" 2>/dev/null || uv pip install -q -e . 2>/dev/null || true
            fi
            echo "[Nix DevShell] Hermetic environment activated: Python $(python --version 2>&1 | awk '{print $2}') | uv $(uv --version | awk '{print $2}')"
          '';
        };
      });
}</code></pre>

