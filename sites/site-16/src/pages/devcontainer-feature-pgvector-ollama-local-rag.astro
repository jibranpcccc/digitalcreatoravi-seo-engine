const canonicalUrl = "https://site-16-indol.vercel.app/devcontainer-feature-pgvector-ollama-local-rag/";
const pageTitle = "DevContainer pgvector + Ollama: Instant Local RAG";
const pageDescription = "Zero-install local RAG development stack with VS Code DevContainers, pgvector (Postgres 16), and GPU-accelerated Ollama. Complete configs and testing script.";

const devcontainerJsonCode = `{
  "name": "Local RAG (pgvector + Ollama)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11",
      "installTools": true
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "username": "vscode"
    }
  },
  "forwardPorts": [5432, 11434],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "cweijan.vscode-database-client2"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "sqltools.connections": [
          {
            "name": "Local pgvector DB",
            "dialect": "PostgreSQL",
            "server": "db",
            "port": 5432,
            "database": "rag_db",
            "username": "postgres",
            "password": "rag_password"
          }
        ]
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "remoteUser": "vscode"
}`;

const dockerComposeCode = `version: "3.8"

services:
  app:
    image: mcr.microsoft.com/devcontainers/base:ubuntu-24.04
    volumes:
      - ..:/workspace:cached
    network_mode: service:db
    command: sleep infinity

  db:
    image: pgvector/pgvector:pg16
    restart: unless-stopped
    environment:
      POSTGRES_DB: rag_db
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: rag_password
      POSTGRES_HOST_AUTH_METHOD: md5
    ports:
      - "5432:5432"
    volumes:
      - pgvector-data:/var/lib/postgresql/data
    networks:
      - rag-net

  ollama:
    image: ollama/ollama:latest
    restart: unless-stopped
    ports:
      - "11434:11434"
    volumes:
      - ollama-models:/root/.ollama
    networks:
      - rag-net
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]

volumes:
  pgvector-data:
  ollama-models:

networks:
  rag-net:
    driver: bridge`;

const setupShCode = `#!/usr/bin/env bash
set -e

echo "==> Waiting for PostgreSQL pgvector service to initialize..."
until pg_isready -h db -U postgres; do
  sleep 1
done

echo "==> Initializing pgvector extension in rag_db..."
PGPASSWORD=rag_password psql -h db -U postgres -d rag_db -c "CREATE EXTENSION IF NOT EXISTS vector;"

echo "==> Installing Python RAG client libraries..."
pip install --no-cache-dir psycopg[binary] pgvector requests numpy

echo "==> Pulling Ollama embedding model (nomic-embed-text:latest)..."
curl -s -X POST http://ollama:11434/api/pull -d '{"name": "nomic-embed-text"}'

echo "==> Pre-pulling optional local chat model (llama3.2:1b)..."
curl -s -X POST http://ollama:11434/api/pull -d '{"name": "llama3.2:1b"}'

echo "==> Local RAG DevContainer is fully configured and ready!"`;

const testPythonCode = `"""
Quickstart: Test pgvector + Ollama local RAG in < 30 seconds
Executes embedding generation, table creation, HNSW indexing, and cosine search.
"""
import json
import urllib.request
import psycopg
from pgvector.psycopg import register_vector

OLLAMA_URL = "http://ollama:11434/api/embeddings"
MODEL_NAME = "nomic-embed-text"

def get_embedding(text: str) -> list[float]:
    req = urllib.request.Request(
        OLLAMA_URL,
        data=json.dumps({"model": MODEL_NAME, "prompt": text}).encode("utf-8"),
        headers={"Content-Type": "application/json"}
    )
    with urllib.request.urlopen(req) as response:
        data = json.loads(response.read().decode("utf-8"))
        return data["embedding"]

def main():
    print("1. Connecting to pgvector PostgreSQL database...")
    conn = psycopg.connect(
        "host=db dbname=rag_db user=postgres password=rag_password"
    )
    register_vector(conn)

    with conn.cursor() as cur:
        cur.execute("CREATE EXTENSION IF NOT EXISTS vector;")
        cur.execute("DROP TABLE IF EXISTS documents;")
        cur.execute("""
            CREATE TABLE documents (
                id SERIAL PRIMARY KEY,
                content TEXT NOT NULL,
                metadata JSONB DEFAULT '{}'::jsonb,
                embedding vector(768)
            );
        """)

        # Sample Knowledge Base with Metadata
        corpus = [
            ("DevContainers configure reproducible Docker development environments using devcontainer.json.", {"category": "devops"}),
            ("PostgreSQL pgvector extension enables fast vector similarity queries using HNSW indexing.", {"category": "database"}),
            ("Ollama runs open-source large language models and embeddings natively with local GPU acceleration.", {"category": "ai"}),
            ("Kubernetes Ingress-Nginx directs incoming HTTP traffic to backend containerized cluster pods.", {"category": "networking"}),
            ("Retrieval-Augmented Generation blends vector search similarity with contextual prompt injection.", {"category": "ai"})
        ]

        print("2. Generating local embeddings with Ollama...")
        for doc, meta in corpus:
            vec = get_embedding(doc)
            cur.execute(
                "INSERT INTO documents (content, metadata, embedding) VALUES (%s, %s, %s);",
                (doc, json.dumps(meta), vec)
            )
        conn.commit()

        # Build HNSW Cosine Distance Index
        print("3. Building HNSW vector index (cosine distance)...")
        cur.execute("""
            CREATE INDEX ON documents 
            USING hnsw (embedding vector_cosine_ops)
            WITH (m = 16, ef_construction = 64);
        """)
        conn.commit()

        # Test Semantic Query
        query = "How do I run AI models locally in containers?"
        print(f"\\n4. Querying: '{query}'")
        q_vec = get_embedding(query)

        # '<=>' operator computes cosine distance in pgvector
        cur.execute("""
            SELECT id, content, metadata->>'category' AS category, 1 - (embedding <=> %s) AS cosine_similarity
            FROM documents
            ORDER BY embedding <=> %s
            LIMIT 2;
        """, (q_vec, q_vec))

        results = cur.fetchall()
        print("\\n=== Nearest Neighbor Semantic Search Results ===")
        for row in results:
            doc_id, content, cat, sim = row
            print(f"[Score: {sim:.4f} | Category: {cat}] #{doc_id}: {content}")

    conn.close()

if __name__ == "__main__":
    main()`;
