        const monthsAdded = relocatedMonths - baselineMonths;
        const monthlySaved = Math.max(0, baselineBurn - hubBurn);
        const annualSaved = monthlySaved * 12;

        multiplierValue.textContent = multiplier.toFixed(1) + 'x';
        monthsAddedLabel.textContent = (monthsAdded >= 0 ? '+' : '') + monthsAdded.toFixed(1) + ' months gained';
        baselineMonthsTxt.textContent = baselineMonths.toFixed(1) + ' Months';
        relocatedMonthsTxt.textContent = relocatedMonths.toFixed(1) + ' Months';

        monthlySavedTxt.textContent = '+$' + Math.round(monthlySaved).toLocaleString() + '/mo';
        annualSavedTxt.textContent = '+$' + Math.round(annualSaved).toLocaleString() + '/yr';

        // Calculate progress bar percentages
        const maxMonths = Math.max(baselineMonths, relocatedMonths, 36);
        const baselinePct = Math.min(100, Math.max(8, (baselineMonths / maxMonths) * 100));
        const relocatedPct = Math.min(100, Math.max(8, (relocatedMonths / maxMonths) * 100));

        baselineBar.style.width = baselinePct + '%';
        relocatedBar.style.width = relocatedPct + '%';
      }

      function updateCityBudget(key) {
        const city = cityData[key];
        if (!city) return;

        selectedCityKey = key;
        customBurnSlider.value = city.baseBurn;
        customBurnDisplay.textContent = '$' + city.baseBurn.toLocaleString() + '/mo';

        cityFlag.textContent = city.flag;
        cityNameLabel.textContent = city.name;
        relocatedCityShort.textContent = city.short;
        budgetCityName.textContent = city.short;

        budgetRent.textContent = '$' + city.rent;
        budgetCoworking.textContent = '$' + city.coworking;
        budgetFood.textContent = '$' + city.food;
        budgetHealth.textContent = '$' + city.health;
        budgetTransport.textContent = '$' + city.transport;

        // Button state classes
        cityButtons.forEach(btn => {
          if (btn.dataset.city === key) {
            btn.className = 'city-btn p-3 rounded-xl border text-left transition-all border-emerald-500/80 bg-emerald-500/10 text-white shadow-sm ring-1 ring-emerald-500/30';
            const priceDiv = btn.querySelector('.font-mono');
            if (priceDiv) {
              priceDiv.className = 'text-[11px] text-emerald-400 font-mono mt-1 font-bold';
            }
          } else {
            btn.className = 'city-btn p-3 rounded-xl border text-left transition-all border-slate-800 bg-slate-950/60 text-slate-300 hover:border-slate-700 hover:text-white';
            const priceDiv = btn.querySelector('.font-mono');
            if (priceDiv) {
              priceDiv.className = 'text-[11px] text-slate-400 font-mono mt-1 font-bold';
            }
          }
        });

        updateCalculations();
      }

      // Event Listeners
      savingsInput.addEventListener('input', () => {
        savingsSlider.value = savingsInput.value;
        updateCalculations();
      });

      savingsSlider.addEventListener('input', () => {
        savingsInput.value = savingsSlider.value;
        updateCalculations();
      });

      currentBurnInput.addEventListener('input', () => {
        currentBurnSlider.value = currentBurnInput.value;
        updateCalculations();
      });

      currentBurnSlider.addEventListener('input', () => {
        currentBurnInput.value = currentBurnSlider.value;
        updateCalculations();
      });

      customBurnSlider.addEventListener('input', () => {
        customBurnDisplay.textContent = '$' + parseInt(customBurnSlider.value, 10).toLocaleString() + '/mo';
        updateCalculations();
      });

      cityButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          updateCityBudget(btn.dataset.city);
        });
      });

      // Initialize
      updateCityBudget('chiang-mai');
    })();
  </script>
</Layout>
