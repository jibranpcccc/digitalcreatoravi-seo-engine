              <td class="p-3 border-r border-slate-800 text-emerald-300">Exempt from AMT for 5 years</td>
              <td class="p-3 text-emerald-400 font-bold">3 Years Fast-Track</td>
            </tr>
            <tr class="hover:bg-slate-800/50">
              <td class="p-3 font-semibold text-white border-r border-slate-800">Singapore</td>
              <td class="p-3 border-r border-slate-800">Tech.Pass / ONE Pass</td>
              <td class="p-3 border-r border-slate-800">S$22,500 – S$30,000/mo ($17,000+ USD)</td>
              <td class="p-3 border-r border-slate-800">22% – 24%</td>
