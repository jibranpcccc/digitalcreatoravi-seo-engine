          </div>
        </div>
      </div>

      <script is:raw>
        function updateTaxCalc() {
          const usd = parseFloat(document.getElementById('calc-usd-salary').value) || 0;
          const fx = parseFloat(document.getElementById('calc-fx-rate').value) || 32.0;
          const twd = usd * fx;

          function calcTaiwanProgressive(income) {
            let tax = 0;
            if (income <= 560000) {
              tax = income * 0.05;
            } else if (income <= 1260000) {
              tax = 560000 * 0.05 + (income - 560000) * 0.12;
            } else if (income <= 2520000) {
              tax = 560000 * 0.05 + 700000 * 0.12 + (income - 1260000) * 0.20;
            } else if (income <= 4720000) {
              tax = 560000 * 0.05 + 700000 * 0.12 + 1260000 * 0.20 + (income - 2520000) * 0.30;
            } else {
              tax = 560000 * 0.05 + 700000 * 0.12 + 1260000 * 0.20 + 2200000 * 0.30 + (income - 4720000) * 0.40;
            }
            return Math.max(0, tax);
          }

          const stdTaxTwd = calcTaiwanProgressive(twd);
          const excess = Math.max(0, twd - 3000000);
          const goldTaxableTwd = Math.min(twd, 3000000) + (excess * 0.5);
          const goldTaxTwd = calcTaiwanProgressive(goldTaxableTwd);
          const savedTwd = stdTaxTwd - goldTaxTwd;

          const stdTaxUsd = stdTaxTwd / fx;
          const goldTaxUsd = goldTaxTwd / fx;
          const savedUsd = savedTwd / fx;

          const effStd = (usd > 0) ? ((stdTaxUsd / usd) * 100).toFixed(2) : '0.00';
          const effGold = (usd > 0) ? ((goldTaxUsd / usd) * 100).toFixed(2) : '0.00';

          document.getElementById('calc-out-standard').textContent = '$' + Math.round(stdTaxUsd).toLocaleString();
          document.getElementById('calc-rate-standard').textContent = effStd + '% effective';
          document.getElementById('calc-out-gold').textContent = '$' + Math.round(goldTaxUsd).toLocaleString();
          document.getElementById('calc-rate-gold').textContent = effGold + '% effective';
          document.getElementById('calc-out-saved').textContent = '$' + Math.round(savedUsd).toLocaleString() + ' / yr';
        }

        document.getElementById('calc-usd-salary').addEventListener('input', updateTaxCalc);
        document.getElementById('calc-fx-rate').addEventListener('input', updateTaxCalc);
        updateTaxCalc();
      </script>

