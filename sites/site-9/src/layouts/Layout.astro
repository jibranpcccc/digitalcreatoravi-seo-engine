---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  slug?: string;
  schema?: Record<string, any>;
}

const {
  title,
  description,
  canonical,
  slug = '',
  schema
} = Astro.props;

const siteUrl = 'https://site-9-inky.vercel.app';
const fullCanonical = canonical || (slug ? `${siteUrl}/${slug}/` : siteUrl + '/');
const ogImage = `${siteUrl}/og-preview.png`;
---

<!DOCTYPE html>
<html lang="en" class="bg-slate-950 text-slate-100 antialiased selection:bg-emerald-500 selection:text-slate-950">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="FounderRunway" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon & Search Console -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🚀</text></svg>" />

    <!-- Structured Data Schema -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  
    <!-- Fleet Master Analytics Beacon -->
    <script is:inline>
      (function() {
        try {
          var payload = JSON.stringify({
            site: window.location.hostname,
            path: window.location.pathname,
            ref: document.referrer || "direct",
            screen: window.innerWidth + "x" + window.innerHeight,
            ts: Date.now()
          });
          var endpoint = "https://webhookwatch.vercel.app/api/track/";
          if (navigator.sendBeacon) {
            navigator.sendBeacon(endpoint, payload);
          } else {
            fetch(endpoint, { method: "POST", body: payload, keepalive: true, headers: { "Content-Type": "application/json" } }).catch(function(){});
          }
        } catch(e) {}
      })();
    </script>
      <link rel="alternate" type="application/rss+xml" title="RSS 2.0 Feed" href="/rss.xml" />
      <!-- Search Console & Webmaster Verification -->
    <meta name="google-site-verification" content="google6fe267a998c19a9a" />
    <meta name="msvalidate.01" content="BING-VERIFICATION-FLEET-2026" />

    <!-- Google Analytics 4 (GA4) Integration -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-FRW9026009"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FRW9026009', { anonymize_ip: true });
    </script>

  </head>
  <body class="min-h-screen flex flex-col bg-slate-950 text-slate-100 font-sans">
    <!-- Top Announcement Bar -->
    <div class="bg-gradient-to-r from-emerald-950/70 via-slate-900 to-slate-950 border-b border-emerald-900/30 px-4 py-1.5 text-center text-xs text-emerald-400 font-medium">
      <span class="inline-flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        2026 Global Geo-Arbitrage Index: Average Bootstrapped Runway Extended by 3.8x
      </span>
    </div>

    <!-- Header -->
    <header class="border-b border-slate-800/80 bg-slate-950/90 backdrop-blur sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center group-hover:border-emerald-400 transition-colors shadow-sm shadow-emerald-500/10">
            <span class="text-lg">🚀</span>
          </div>
          <div>
            <span class="font-extrabold text-lg tracking-tight text-white flex items-center gap-1">
              Founder<span class="text-emerald-400">Runway</span>
            </span>
            <span class="block text-[10px] text-slate-400 font-mono leading-none">Geo-Arbitrage for Bootstrappers</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-300">
          <a href="/chiang-mai-vs-bali-runway-calculator/" class="hover:text-emerald-400 transition-colors flex items-center gap-1">
            <span>Chiang Mai vs Bali</span>
          </a>
          <a href="/lisbon-nhr-tax-runway-founder-guide/" class="hover:text-emerald-400 transition-colors flex items-center gap-1">
            <span>Lisbon & NHR 2.0</span>
          </a>
          <a href="/top-latin-america-tech-hubs-for-bootstrappers/" class="hover:text-emerald-400 transition-colors flex items-center gap-1">
            <span>Latin America Hubs</span>
          </a>
        </nav>

        <div class="flex items-center gap-3">
          <a href="/#calculator" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 hover:bg-emerald-500/20 hover:border-emerald-400 text-xs font-semibold transition-all">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
            </svg>
            Calculate Runway
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 bg-slate-950 py-12 text-slate-400 text-sm">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
        <div class="md:col-span-2">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xl">🚀</span>
            <span class="font-bold text-white tracking-tight text-base">FounderRunway Financial Intelligence</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed max-w-sm mb-4">
            Empowering bootstrapped founders, indie hackers, and remote engineers to maximize financial runway, eliminate dilutive venture capital dependency, and achieve default alive profitability through global geo-arbitrage.
          </p>
          <div class="inline-flex flex-wrap items-center gap-2 text-[11px] font-mono text-emerald-400">
            <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800">2026 Cost Benchmarks</span>
            <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800">Verified Visa Protocols</span>
            <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800">Zero Referral Bias</span>
          </div>
        </div>

        <div>
          <h4 class="font-semibold text-white text-xs uppercase tracking-wider mb-3">In-Depth Guides</h4>
          <ul class="space-y-2 text-xs">
            <li><a href="/chiang-mai-vs-bali-runway-calculator/" class="hover:text-emerald-400 transition-colors">Chiang Mai vs Bali Cost Matrix</a></li>
            <li><a href="/lisbon-nhr-tax-runway-founder-guide/" class="hover:text-emerald-400 transition-colors">Lisbon NHR 2.0 & D8 Tech Guide</a></li>
            <li><a href="/top-latin-america-tech-hubs-for-bootstrappers/" class="hover:text-emerald-400 transition-colors">Top Latin America Hubs for US SaaS</a></li>
            <li><a href="/#calculator" class="hover:text-emerald-400 transition-colors">Interactive Runway Simulator</a></li>
          </ul>
        </div>

        <div>
          <h4 class="font-semibold text-white text-xs uppercase tracking-wider mb-3">Resources & Meta</h4>
          <ul class="space-y-2 text-xs">
            <li><a href="/llms.txt" class="text-emerald-400 hover:underline flex items-center gap-1"><span>llms.txt Specification</span></a></li>
            <li><a href="/sitemap.xml" class="hover:text-slate-300">XML Sitemap Index</a></li>
            <li><a href="/robots.txt" class="hover:text-slate-300">Crawler Directives</a></li>
