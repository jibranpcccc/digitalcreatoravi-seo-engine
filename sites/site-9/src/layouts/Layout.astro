          </ul>
        </div>
      </div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-6 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
        <div>© 2026 FounderRunway. Built for independent bootstrappers worldwide. All benchmarks modeled in USD.</div>
        <div class="flex gap-4">
          <a href="/sitemap.xml" class="hover:text-slate-400">Sitemap</a>
          <a href="/robots.txt" class="hover:text-slate-400">Robots</a>
          <a href="/llms.txt" class="hover:text-slate-400">llms.txt</a>
        </div>
      </div>
    </footer>
  </body>
</html>
