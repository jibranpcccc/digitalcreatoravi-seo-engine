---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "@id": "https://nomadtreaty.vercel.app/cyprus-non-dom-tax-nomad-guide/#article",
      "headline": "Cyprus 60-Day Rule & Non-Dom Tax Regime for Digital Nomads (2026 Guide)",
      "description": "Comprehensive analysis of the Cyprus 60-day tax residency rule, 0% tax on dividends and capital gains under non-dom status, and SDC exemption for remote founders.",
      "url": "https://nomadtreaty.vercel.app/cyprus-non-dom-tax-nomad-guide/",
      "inLanguage": "en-US",
      "datePublished": "2026-09-08T00:00:00+00:00",
      "author": { "@type": "Organization", "name": "NomadTreaty Tax Desk" }
    },
    {
      "@type": "FAQPage",
      "@id": "https://nomadtreaty.vercel.app/cyprus-non-dom-tax-nomad-guide/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does the Cyprus 60-day tax residency rule work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Under the 60-day rule, individuals can become tax resident in Cyprus by spending at least 60 days in Cyprus during the tax year, provided they do not reside in any other single state for more than 183 days, maintain a permanent residential home in Cyprus, and conduct business or hold employment in Cyprus."
          }
        },
        {
          "@type": "Question",
          "name": "What taxes are eliminated under Cyprus non-domicile status?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cyprus non-dom residents are 100% exempt from the Special Defence Contribution (SDC), meaning 0% tax on worldwide dividend income, 0% tax on interest income, and 0% tax on capital gains from the sale of shares."
          }
        }
      ]
    }
  ]
};
