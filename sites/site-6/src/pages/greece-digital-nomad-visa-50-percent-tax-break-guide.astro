      <h2 class="text-2xl font-bold text-white border-b border-slate-800 pb-2">
        Executable Python Model: Statutory 50% Tax Reduction &amp; Net Retention Script
      </h2>
      <p class="text-slate-300 leading-relaxed">
        The following standalone Python CLI script models exact progressive tax liabilities, the 50% statutory reduction under Law 4758/2020 Article 5C, and effective tax rates across custom revenue tiers:
      </p>

      <pre is:raw class="bg-slate-950 p-4 rounded-lg border border-slate-800 text-xs font-mono text-emerald-300 overflow-x-auto"><code>#!/usr/bin/env python3
"""Greece Law 4758/2020 Article 5C Tax Reduction Calculator."""

def calculate_greek_nomad_tax(gross_eur: float, has_50_pct_exemption: bool = True) -> dict:
    # Under Law 4758 Article 5C, 50% of Greek-source income is exempt
    taxable_base = gross_eur * 0.50 if has_50_pct_exemption else gross_eur
    
    # 2026 Greek Progressive Income Tax Brackets
    brackets = [
        (10000, 0.09),  # 0 to 10k: 9%
        (10000, 0.22),  # 10k to 20k: 22%
        (10000, 0.28),  # 20k to 30k: 28%
        (10000, 0.36),  # 30k to 40k: 36%
        (float('inf'), 0.44)  # > 40k: 44%
    ]
    
    total_tax = 0.0
    remaining = taxable_base
    
    for cap, rate in brackets:
        if remaining &lt;= 0:
            break
        taxable_in_tier = min(remaining, cap)
        total_tax += taxable_in_tier * rate
        remaining -= taxable_in_tier
        
    effective_rate = (total_tax / gross_eur) * 100
    net_retained = gross_eur - total_tax
    
    return {
        "gross_eur": gross_eur,
        "taxable_base": taxable_base,
        "total_tax_eur": round(total_tax, 2),
        "effective_rate_pct": round(effective_rate, 2),
        "net_retained_eur": round(net_retained, 2)
    }

if __name__ == "__main__":
    for gross in [60000, 85000, 120000, 200000]:
        res = calculate_greek_nomad_tax(gross, has_50_pct_exemption=True)
        print(f"Gross: €{res['gross_eur']:,} -> Tax: €{res['total_tax_eur']:,} (Effective: {res['effective_rate_pct']}%) | Net: €{res['net_retained_eur']:,}")
</code></pre>

      <h2 class="text-2xl font-bold text-white border-b border-slate-800 pb-2">
        Step-by-Step Application Roadmap: From Consular Type D Visa to Biometric Permit
