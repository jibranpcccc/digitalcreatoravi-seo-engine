---
import Layout from '../layouts/Layout.astro';

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Digital Nomad Tax Calculator & Treaty Directory (2026)",
  "description": "Comprehensive international tax residency matrix, 183-day day-counting guidelines, and bilateral double taxation treaties for remote tech workers.",
  "publisher": {
    "@type": "Organization",
    "name": "NomadTreaty Intelligence"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does the 183-day rule work for digital nomads in 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under international tax law and OECD model treaties, spending 183 days or more in a jurisdiction within a tax year automatically triggers full tax residency, subjecting your worldwide income to local progressive taxes. However, spending under 183 days does not guarantee non-residency if your center of vital interests (housing, family, primary bank) remains in the country."
      }
    },
    {
      "@type": "Question",
      "name": "Which country offers the lowest tax rate for digital nomads in Europe?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Croatia and Malta offer 0% tax on foreign-sourced income under their digital nomad permits. For nomads seeking permanent long-term residency and EU citizenship pathways, Cyprus offers a territorial non-dom regime (0% on dividends/gains), while Spain's Beckham Law provides a flat 24% rate up to €600,000."
      }
    },
    {
      "@type": "Question",
      "name": "Can US remote workers legally avoid state income taxes while living abroad?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, US citizens abroad can utilize the Foreign Earned Income Exclusion (FEIE, $130,000+ for 2026) to reduce federal tax, but they must break state domicile (especially in sticky states like California, New York, or Virginia) by establishing non-domicile in states like Texas, Florida, or Wyoming before departing."
      }
    }
  ]
};

const combinedSchema = {
  "@context": "https://schema.org",
  "@graph": [pageSchema, faqSchema]
};

const countries = [
  {
    country: "Spain",
    regime: "Beckham Law (Nomad Visa)",
    taxRate: "Flat 24%",
    minIncome: "€2,670 / mo",
    stayReq: "Minimum 183 days",
    territorial: "Yes (Only Spanish-source income taxed at full)",
    rating: "9.4/10",
    slug: "spain-digital-nomad-visa-beckham-law-guide"
  },
  {
    country: "Portugal",
    regime: "NHR 2.0 (TIFIC)",
    taxRate: "Flat 20%",
    minIncome: "€3,280 / mo",
    stayReq: "183 days / year",
    territorial: "Qualifying tech & research activities",
    rating: "9.1/10",
    slug: "portugal-nhr-tax-nomad-calculator-2026"
  },
  {
    country: "Dubai (UAE)",
    regime: "Remote Work Visa",
    taxRate: "0% Personal Income Tax",
    minIncome: "$3,500 / mo",
    stayReq: "Visit once every 180 days",
    territorial: "Complete zero tax exemption",
    rating: "9.8/10",
    slug: "183-day-rule-tax-residency-nomad-guide"
  },
  {
    country: "Cyprus",
    regime: "Non-Dom Tax Status",
    taxRate: "0% Dividends & Capital Gains",
    minIncome: "€3,500 / mo",
    stayReq: "60-Day Rule eligible",
    territorial: "Progressive on local salary, 0% on foreign capital",
    rating: "9.6/10",
    slug: "183-day-rule-tax-residency-nomad-guide"
  },
  {
    country: "Croatia",
    regime: "Digital Nomad Residence",
    taxRate: "0% on Foreign Income",
    minIncome: "€2,870 / mo",
    stayReq: "Up to 12 months (non-renewable on-site)",
    territorial: "100% exempt from Croatian personal income tax",
    rating: "8.9/10",
    slug: "183-day-rule-tax-residency-nomad-guide"
  },
  {
    country: "Costa Rica",
    regime: "Nomad Law (Estancia)",
    taxRate: "0% Foreign Income Tax",
    minIncome: "$3,000 / mo",
    stayReq: "180 days minimum",
    territorial: "Pure territorial tax system",
    rating: "9.0/10",
    slug: "183-day-rule-tax-residency-nomad-guide"
  }
];
---

<Layout
  title="Digital Nomad Tax Calculator & Treaty Directory (2026) | NomadTreaty"
  description="Verified 2026 digital nomad tax rates, 183-day residency rules, and double taxation treaty directory across Spain, Portugal, Dubai, Cyprus, and Costa Rica."
  schema={combinedSchema}
>
  <!-- Hero Section -->
  <section class="py-16 md:py-24 border-b border-slate-900 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(16,185,129,0.15),rgba(255,255,255,0))]"></div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 relative">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        September 2026 Verified Tax Rates • 183-Day Day Counting Engine
      </div>
      
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white mb-6 leading-tight">
        Digital Nomad Tax Calculator & <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300">Treaty Directory (2026)</span>
      </h1>

      <!-- Quick Answer Box -->
      <div class="bg-emerald-950/40 border border-emerald-500/30 rounded-2xl p-6 mb-8 backdrop-blur-sm shadow-xl shadow-emerald-950/50">
        <div class="flex items-center gap-2 text-emerald-400 font-bold text-xs uppercase tracking-wider mb-2">
          <span>⚡</span> Quick Answer (Tax Residency Rule)
        </div>
        <p class="text-slate-200 text-base sm:text-lg leading-relaxed font-medium">
          Digital nomads triggering the <strong>183-day physical presence threshold</strong> in any country become full tax residents subject to worldwide taxation. For zero or low-tax European residency, <strong>Cyprus Non-Dom (60-day rule)</strong> and <strong>Croatia (0% foreign tax)</strong> are top choices, while <strong>Spain's Beckham Law</strong> offers a flat 24% regime with long-term EU settlement.
        </p>
        <div class="mt-4 pt-4 border-t border-emerald-500/20 flex flex-wrap gap-4 text-xs text-slate-400">
          <span><strong>Bilateral Treaties:</strong> 120+ OECD Double Tax Agreements audited</span>
          <span><strong>Day Counting:</strong> Rolling 365 vs Calendar Year formulas</span>
          <span><strong>Updated:</strong> September 6, 2026</span>
        </div>
      </div>

      <!-- Key Takeaways -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800">
          <div class="text-emerald-400 font-bold text-sm mb-1">⏱️ 183-Day Rule Trap</div>
          <p class="text-xs text-slate-300">Leaving before day 183 does not protect you if you maintain permanent housing or family connections.</p>
        </div>
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800">
          <div class="text-teal-400 font-bold text-sm mb-1">🇪🇺 European Low-Tax Hubs</div>
          <p class="text-xs text-slate-300">Spain (24% flat), Portugal NHR 2.0 (20%), and Cyprus Non-Dom (0% on dividends) lead Western Europe.</p>
        </div>
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800">
          <div class="text-amber-300 font-bold text-sm mb-1">📜 Double Tax Relief</div>
          <p class="text-xs text-slate-300">Tie-breaker rules in bilateral DTTs prevent dual-residency double taxation on remote software contracts.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Master Tax Matrix Section -->
  <section id="matrix" class="py-16 bg-slate-950 border-b border-slate-900">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-2">2026 Nomad Visa & Tax Regime Matrix</h2>
        <p class="text-slate-400 text-sm">Empirical comparison of headline tax rates, income hurdles, and physical presence rules.</p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-900/50 backdrop-blur-sm shadow-2xl">
        <table class="w-full text-left text-sm text-slate-300">
          <thead class="bg-slate-900 text-xs uppercase tracking-wider text-slate-400 border-b border-slate-800">
            <tr>
              <th scope="col" class="px-6 py-4 font-bold text-white">Country</th>
              <th scope="col" class="px-6 py-4 font-bold text-white">Tax Regime</th>
              <th scope="col" class="px-6 py-4 font-bold text-emerald-400">Effective Tax Rate</th>
              <th scope="col" class="px-6 py-4 font-bold text-white">Min Monthly Income</th>
              <th scope="col" class="px-6 py-4 font-bold text-white">Stay Requirement</th>
              <th scope="col" class="px-6 py-4 font-bold text-white">Territorial Scope</th>
              <th scope="col" class="px-6 py-4 font-bold text-white">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80">
            {countries.map((c) => (
              <tr class="hover:bg-slate-800/40 transition-colors">
                <td class="px-6 py-4 font-bold text-white whitespace-nowrap">
                  {c.country}
                </td>
                <td class="px-6 py-4 text-xs text-slate-300 font-medium">{c.regime}</td>
                <td class="px-6 py-4 font-bold font-mono text-emerald-400">{c.taxRate}</td>
                <td class="px-6 py-4 font-mono text-xs">{c.minIncome}</td>
                <td class="px-6 py-4 text-xs text-slate-400">{c.stayReq}</td>
                <td class="px-6 py-4 text-xs text-slate-400">{c.territorial}</td>
                <td class="px-6 py-4 text-xs">
                  <a href={`/${c.slug}/`} class="text-emerald-400 hover:underline font-semibold">View Guide →</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Deep Dive Pillar Guides -->
  <section class="py-16 bg-slate-900/30 border-b border-slate-900">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-10 text-center">
        <h2 class="text-3xl font-extrabold text-white mb-3">Granular Tax Strategy Blueprints</h2>
        <p class="text-slate-400 text-sm max-w-2xl mx-auto">In-depth mathematical teardowns of European nomad visas, social security exemptions, and legal residency frameworks.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <a href="/spain-digital-nomad-visa-beckham-law-guide/" class="group p-6 rounded-2xl bg-slate-900/70 border border-slate-800 hover:border-emerald-500/50 hover:bg-slate-800/50 transition-all flex flex-col justify-between">
          <div>
            <div class="text-xs uppercase font-bold tracking-widest text-emerald-400 mb-2">Spain Residence</div>
            <h3 class="text-xl font-bold text-white group-hover:text-emerald-300 transition-colors mb-3">
              Spain Digital Nomad Visa & Beckham Law Guide (2026)
            </h3>
            <p class="text-xs text-slate-400 leading-relaxed mb-4">
              How remote tech workers pay a flat 24% tax rate instead of 47% progressive rates. Social security bilateral agreements explained.
            </p>
          </div>
          <div class="text-xs font-semibold text-emerald-400 flex items-center gap-1 group-hover:gap-2 transition-all">
            Read Spain Guide →
          </div>
        </a>

        <!-- Card 2 -->
        <a href="/portugal-nhr-tax-nomad-calculator-2026/" class="group p-6 rounded-2xl bg-slate-900/70 border border-slate-800 hover:border-emerald-500/50 hover:bg-slate-800/50 transition-all flex flex-col justify-between">
          <div>
            <div class="text-xs uppercase font-bold tracking-widest text-teal-400 mb-2">Portugal Updates</div>
            <h3 class="text-xl font-bold text-white group-hover:text-teal-300 transition-colors mb-3">
              Portugal NHR 2.0 & Digital Nomad Tax Calculator
            </h3>
            <p class="text-xs text-slate-400 leading-relaxed mb-4">
              The shift from legacy NHR to the 20% TIFIC incentive for remote tech workers and startups. Net income formulas and cost of living math.
            </p>
          </div>
          <div class="text-xs font-semibold text-teal-400 flex items-center gap-1 group-hover:gap-2 transition-all">
            Read Portugal Guide →
          </div>
        </a>

        <!-- Card 3 -->
        <a href="/183-day-rule-tax-residency-nomad-guide/" class="group p-6 rounded-2xl bg-slate-900/70 border border-slate-800 hover:border-emerald-500/50 hover:bg-slate-800/50 transition-all flex flex-col justify-between">
          <div>
            <div class="text-xs uppercase font-bold tracking-widest text-amber-400 mb-2">Legal Day Counting</div>
            <h3 class="text-xl font-bold text-white group-hover:text-amber-300 transition-colors mb-3">
              183-Day Rule Demystified: How to Avoid Tax Residency Traps
            </h3>
            <p class="text-xs text-slate-400 leading-relaxed mb-4">
              How immigration authorities share flight data with tax authorities. Center of vital interests tests and bilateral treaty tie-breakers.
            </p>
          </div>
          <div class="text-xs font-semibold text-amber-400 flex items-center gap-1 group-hover:gap-2 transition-all">
            Read 183-Day Guide →
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section with Schema -->
  <section class="py-16 bg-slate-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-8 text-center">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((item) => (
          <div class="p-6 rounded-xl bg-slate-900/50 border border-slate-800">
            <h3 class="text-base sm:text-lg font-bold text-white mb-2">{item.name}</h3>
            <p class="text-sm text-slate-300 leading-relaxed">{item.acceptedAnswer.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
