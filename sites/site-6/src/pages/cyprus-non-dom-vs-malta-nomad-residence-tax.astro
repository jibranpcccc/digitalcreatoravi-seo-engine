export function computeCyprusNonDomTax(profile: NomadIncomeProfile): TaxOutcome {
  const { salaryEur, dividendsEur, capitalGainsEur } = profile;
  const gross = salaryEur + dividendsEur + capitalGainsEur;

  // 1. Cyprus Progressive Salary Tax (assuming standard 2026 brackets)
  let salaryTax = 0;
  if (salaryEur > 19500) {
    const b1 = Math.min(salaryEur, 28000) - 19500;
    salaryTax += b1 * 0.20;
  }
  if (salaryEur > 28000) {
    const b2 = Math.min(salaryEur, 36300) - 28000;
    salaryTax += b2 * 0.25;
  }
  if (salaryEur > 36300) {
    const b3 = Math.min(salaryEur, 60000) - 36300;
    salaryTax += b3 * 0.30;
  }
  if (salaryEur > 60000) {
    salaryTax += (salaryEur - 60000) * 0.35;
  }

  // 2. Cyprus Dividend Tax under Non-Dom = 0% SDC
  const dividendTax = 0;

  // 3. Cyprus Capital Gains on Securities = 0%
  // 4. GESY Healthcare: 2.65% on passive/dividend + salary, capped at €180,000 cap (€4,770 max)
  const gesyEligibleIncome = Math.min(gross, 180000);
  const gesyContribution = gesyEligibleIncome * 0.0265;

  const totalTax = salaryTax + dividendTax + gesyContribution;
  const netTakeHome = gross - totalTax;

  return {
    jurisdiction: "Cyprus 60-Day Non-Dom",
    grossIncome: gross,
