    <!-- Client-side Script for Calculator -->
    <script is:inline>
      const slider = document.getElementById('incomeRange');
      const display = document.getElementById('incomeDisplay');
      const stdTaxOut = document.getElementById('standardTaxOut');
      const stdRateOut = document.getElementById('standardRateOut');
      const bckTaxOut = document.getElementById('beckhamTaxOut');
      const bckRateOut = document.getElementById('beckhamRateOut');
      const savOut = document.getElementById('savingsOut');

      function calculateTax(val) {
        // Approximate standard IRPF combined scale
        let std = 0;
        if (val <= 12450) {
          std = val * 0.19;
        } else if (val <= 20200) {
          std = 12450 * 0.19 + (val - 12450) * 0.24;
        } else if (val <= 35200) {
          std = 12450 * 0.19 + 7750 * 0.24 + (val - 20200) * 0.30;
        } else if (val <= 60000) {
          std = 12450 * 0.19 + 7750 * 0.24 + 15000 * 0.30 + (val - 35200) * 0.37;
        } else if (val <= 300000) {
          std = 12450 * 0.19 + 7750 * 0.24 + 15000 * 0.30 + 24800 * 0.37 + (val - 60000) * 0.45;
        } else {
          std = 12450 * 0.19 + 7750 * 0.24 + 15000 * 0.30 + 24800 * 0.37 + 240000 * 0.45 + (val - 300000) * 0.47;
        }

        let bck = val * 0.24;
        if (val > 600000) {
          bck = 600000 * 0.24 + (val - 600000) * 0.47;
        }

        const delta = std - bck;

        display.textContent = '€' + Number(val).toLocaleString();
        stdTaxOut.textContent = '€' + Math.round(std).toLocaleString();
        stdRateOut.textContent = ((std / val) * 100).toFixed(1) + '% effective';
        bckTaxOut.textContent = '€' + Math.round(bck).toLocaleString();
        bckRateOut.textContent = ((bck / val) * 100).toFixed(1) + '% flat';

        if (delta >= 0) {
          savOut.textContent = '+€' + Math.round(delta).toLocaleString() + ' / yr';
          savOut.className = 'text-xl font-mono font-bold text-cyan-300 mt-1';
        } else {
          savOut.textContent = '-€' + Math.abs(Math.round(delta)).toLocaleString() + ' / yr';
          savOut.className = 'text-xl font-mono font-bold text-rose-400 mt-1';
        }
      }

      if (slider) {
        slider.addEventListener('input', (e) => calculateTax(e.target.value));
      }
    </script>

