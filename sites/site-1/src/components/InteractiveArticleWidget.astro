---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

{slug === 'ollama-vs-vllm-benchmark' && (
  <div class="my-10 p-6 sm:p-8 rounded-2xl bg-slate-900/90 border border-blue-500/40 shadow-2xl backdrop-blur-xl relative overflow-hidden not-prose">
    <div class="absolute top-0 right-0 w-64 h-64 bg-blue-500/10 blur-[90px] pointer-events-none -z-10"></div>
    
    <div class="flex items-center space-x-2 text-xs font-bold text-blue-400 mb-2">
      <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
      <span class="font-mono uppercase tracking-wider">Interactive Generative Tool</span>
    </div>
    <h3 class="text-xl sm:text-2xl font-black text-white tracking-tight mb-2">Live Concurrency & Throughput Simulator</h3>
    <p class="text-xs sm:text-sm text-slate-400 mb-6 leading-relaxed">Simulate single-user vs continuous batching concurrency to see where PagedAttention delivers throughput gains.</p>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
      <div class="lg:col-span-6 space-y-5">
        <div>
          <div class="flex justify-between text-xs font-bold mb-2">
            <span class="text-slate-300 uppercase tracking-wider">Simultaneous Client Streams</span>
            <span id="concurrencyVal" class="text-blue-400 font-mono text-sm">10 streams</span>
          </div>
          <input id="concurrencySlider" type="range" min="1" max="32" value="10" class="w-full h-2 bg-slate-950 rounded-lg appearance-none cursor-pointer accent-blue-500" />
          <div class="flex justify-between text-[10px] text-slate-400 mt-1 font-mono">
            <span>1 (Solo Dev)</span>
            <span>8 (Small Team)</span>
            <span>16 (Microservice)</span>
            <span>32 (Prod Spike)</span>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-3">
          <div class="flex justify-between items-center text-xs">
            <span class="text-slate-400">Target GPU:</span>
            <span class="font-mono text-slate-200 font-bold">NVIDIA GeForce RTX 4090 (24GB)</span>
          </div>
          <div class="flex justify-between items-center text-xs">
            <span class="text-slate-400">Model Architecture:</span>
            <span class="font-mono text-slate-200 font-bold">Llama 3.3 8B (Q8_0 Precision)</span>
          </div>
          <div class="flex justify-between items-center text-xs">
            <span class="text-slate-400">Continuous Batching:</span>
            <span id="batchingStatus" class="font-mono text-emerald-400 font-bold">ACTIVE (vLLM Engine)</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-6 space-y-4">
        <!-- Ollama Card -->
        <div class="p-4 rounded-xl bg-slate-950/90 border border-slate-800">
          <div class="flex justify-between items-center mb-2">
            <span class="text-xs font-bold text-slate-300 font-mono">OLLAMA (v0.5.4)</span>
            <span id="ollamaQueueBadge" class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30">QUEUED SEQUENTIAL</span>
          </div>
          <div class="flex justify-between items-baseline">
            <span class="text-xs text-slate-400">Total Throughput:</span>
            <span id="ollamaTps" class="text-xl font-mono font-black text-slate-200">72 tok/s</span>
          </div>
          <div class="w-full bg-slate-900 h-2 rounded-full mt-2 overflow-hidden">
            <div id="ollamaBar" class="bg-blue-500 h-full rounded-full transition-all duration-200" style="width: 25%"></div>
          </div>
          <div class="flex justify-between text-[11px] text-slate-400 mt-2 font-mono">
            <span>Average Latency / Stream:</span>
            <span id="ollamaLatency" class="text-amber-400 font-bold">138 ms</span>
          </div>
        </div>

        <!-- vLLM Card -->
        <div class="p-4 rounded-xl bg-slate-950/90 border border-emerald-500/40 shadow-lg shadow-emerald-500/5">
          <div class="flex justify-between items-center mb-2">
            <span class="text-xs font-bold text-emerald-400 font-mono">vLLM (v0.6.2)</span>
            <span id="vllmSpeedupBadge" class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold">3.8x FASTER</span>
          </div>
          <div class="flex justify-between items-baseline">
            <span class="text-xs text-slate-400">Total Throughput:</span>
            <span id="vllmTps" class="text-xl font-mono font-black text-emerald-400">280 tok/s</span>
          </div>
          <div class="w-full bg-slate-900 h-2 rounded-full mt-2 overflow-hidden">
            <div id="vllmBar" class="bg-emerald-500 h-full rounded-full transition-all duration-200" style="width: 95%"></div>
          </div>
          <div class="flex justify-between text-[11px] text-slate-400 mt-2 font-mono">
            <span>Average Latency / Stream:</span>
            <span id="vllmLatency" class="text-emerald-400 font-bold">36 ms</span>
          </div>
        </div>
      </div>
    </div>
  </div>
)}

{slug === 'vram-requirements-calculator-70b' && (
