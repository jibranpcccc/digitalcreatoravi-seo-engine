{slug === 'custom-mcp-server-python-tutorial' && (
  <div class="my-10 p-6 sm:p-8 rounded-2xl bg-slate-900/90 border border-cyan-500/40 shadow-2xl backdrop-blur-xl relative overflow-hidden not-prose">
    <div class="absolute top-0 right-0 w-64 h-64 bg-cyan-500/10 blur-[90px] pointer-events-none -z-10"></div>

    <div class="flex items-center space-x-2 text-xs font-bold text-cyan-400 mb-2">
      <span class="w-2 h-2 rounded-full bg-cyan-500 animate-pulse"></span>
      <span class="font-mono uppercase tracking-wider">Interactive MCP Tool Generator</span>
    </div>
    <h3 class="text-xl sm:text-2xl font-black text-white tracking-tight mb-2">FastMCP Tool Definition Generator</h3>
    <p class="text-xs sm:text-sm text-slate-400 mb-6 leading-relaxed">Design custom Python tool functions and instantly generate Pydantic schemas compatible with Claude Code and Cursor.</p>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <div class="lg:col-span-5 space-y-4 text-xs">
        <div>
          <label class="block font-bold text-slate-300 mb-1">Tool Identifier Name</label>
          <input id="mcpToolName" type="text" value="query_customer_db" class="w-full bg-slate-950 border border-slate-700/80 rounded-xl px-3 py-2 text-slate-200 font-mono focus:outline-none focus:border-cyan-500" />
        </div>
        <div>
          <label class="block font-bold text-slate-300 mb-1">Tool Description (Docstring)</label>
          <input id="mcpToolDesc" type="text" value="Fetch customer record by email from local encrypted SQLite table" class="w-full bg-slate-950 border border-slate-700/80 rounded-xl px-3 py-2 text-slate-200 focus:outline-none focus:border-cyan-500" />
        </div>
        <div>
          <label class="block font-bold text-slate-300 mb-1">Primary Parameter</label>
          <input id="mcpToolParam" type="text" value="email: str" class="w-full bg-slate-950 border border-slate-700/80 rounded-xl px-3 py-2 text-slate-200 font-mono focus:outline-none focus:border-cyan-500" />
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 relative">
          <div class="flex justify-between items-center mb-2 pb-2 border-b border-slate-850">
            <span class="text-[11px] font-mono text-cyan-400">server.py (FastMCP)</span>
            <button id="copyMcpBtn" type="button" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 text-[11px] font-mono transition flex items-center space-x-1">
              <span>📋 Copy Server Code</span>
            </button>
          </div>
          <pre id="mcpCodeBlock" class="text-xs font-mono text-cyan-300 overflow-x-auto p-2 leading-relaxed">from mcp.server.fastmcp import FastMCP

mcp = FastMCP("LocalAgentTools")

@mcp.tool()
def query_customer_db(email: str) -> str:
    """Fetch customer record by email from local encrypted SQLite table"""
    return f"Customer record verified for &#123;email&#125;"

if __name__ == "__main__":
    mcp.run(transport="stdio")</pre>
        </div>
      </div>
    </div>
  </div>
)}

<script is:inline>
  // Setup interactivity based on current active widget
  
  // 1. Concurrency Simulator
  const cSlider = document.getElementById('concurrencySlider');
  if (cSlider) {
    const cVal = document.getElementById('concurrencyVal');
    const oTps = document.getElementById('ollamaTps');
    const oBar = document.getElementById('ollamaBar');
    const oLat = document.getElementById('ollamaLatency');
    const vTps = document.getElementById('vllmTps');
    const vBar = document.getElementById('vllmBar');
    const vLat = document.getElementById('vllmLatency');
    const vBadge = document.getElementById('vllmSpeedupBadge');

    cSlider.addEventListener('input', () => {
      const streams = parseInt(cSlider.value);
      cVal.textContent = streams + (streams === 1 ? ' stream' : ' streams');

      // Ollama queuing logic
      let ollamaThroughput = streams === 1 ? 68 : Math.min(74, 68 + streams * 0.8);
      let ollamaLatencyMs = Math.round(15 + streams * 14.5);
      
      // vLLM continuous batching logic
      let vllmThroughput = Math.round(Math.min(310, 64 + streams * 22.5));
      let vllmLatencyMs = Math.round(16 + streams * 2.2);

      oTps.textContent = Math.round(ollamaThroughput) + ' tok/s';
      oLat.textContent = ollamaLatencyMs + ' ms';
      oBar.style.width = Math.min(100, Math.round((ollamaThroughput / 310) * 100)) + '%';

      vTps.textContent = vllmThroughput + ' tok/s';
      vLat.textContent = vllmLatencyMs + ' ms';
      vBar.style.width = Math.min(100, Math.round((vllmThroughput / 310) * 100)) + '%';

      const speedup = (vllmThroughput / ollamaThroughput).toFixed(1);
      vBadge.textContent = speedup + 'x FASTER';
    });
  }

  // 2. VRAM Sizer
  const vSelect = document.getElementById('vramQuantSelect');
  const vCtx = document.getElementById('vramCtxSlider');
  if (vSelect && vCtx) {
    const vCtxVal = document.getElementById('vramCtxVal');
    const vTotal = document.getElementById('vramTotalVal');
    const vWeights = document.getElementById('vramWeightsVal');
    const vKv = document.getElementById('vramKvVal');
    const vHw = document.getElementById('vramHwVal');

    function updateVram() {
      const bpw = parseFloat(vSelect.value);
      const ctx = parseInt(vCtx.value);
      vCtxVal.textContent = ctx.toLocaleString() + ' tokens';

      const weightsGb = (70 * 1e9 * bpw) / (8 * (1024**3));
      const kvGb = (ctx / 1024) * 0.225;
      const totalGb = weightsGb + kvGb + 1.8;

      vWeights.textContent = weightsGb.toFixed(1) + ' GB';
      vKv.textContent = kvGb.toFixed(1) + ' GB';
      vTotal.textContent = totalGb.toFixed(1) + ' GB';

      if (totalGb <= 48) {
        vHw.textContent = 'Fits across Dual RTX 3090 / 4090 (48GB)';
        vHw.className = 'text-xs font-mono font-bold px-3 py-1.5 rounded-lg bg-emerald-950/60 text-emerald-300 border border-emerald-800/80 block text-center';
      } else if (totalGb <= 64) {
        vHw.textContent = 'Requires Mac Studio 64GB+ or 3x GPUs (72GB)';
        vHw.className = 'text-xs font-mono font-bold px-3 py-1.5 rounded-lg bg-amber-950/60 text-amber-300 border border-amber-800/80 block text-center';
      } else {
        vHw.textContent = 'Enterprise Rig Required: Quad RTX 3090/4090 (96GB)';
        vHw.className = 'text-xs font-mono font-bold px-3 py-1.5 rounded-lg bg-rose-950/60 text-rose-300 border border-rose-800/80 block text-center';
      }
    }

    vSelect.addEventListener('change', updateVram);
    vCtx.addEventListener('input', updateVram);
  }

  // 3. DeepSeek R1 Modelfile Builder
  const r1Model = document.getElementById('r1ModelSelect');
  const r1Temp = document.getElementById('r1TempSlider');
  const r1Ctx = document.getElementById('r1CtxSlider');
  if (r1Model && r1Temp && r1Ctx) {
    const r1TempVal = document.getElementById('r1TempVal');
    const r1CtxVal = document.getElementById('r1CtxVal');
    const codeEl = document.getElementById('modelfileCode');
    const copyBtn = document.getElementById('copyModelfileBtn');

    function updateModelfile() {
      const m = r1Model.value;
      const t = parseFloat(r1Temp.value).toFixed(2);
      const c = parseInt(r1Ctx.value);
      r1TempVal.textContent = t + (t == 0.60 ? ' (Optimal)' : '');
      r1CtxVal.textContent = c.toLocaleString() + ' tokens';

      const content = `FROM ${m}\nPARAMETER temperature ${t}\nPARAMETER top_p 0.95\nPARAMETER num_ctx ${c}\nSYSTEM """You are an expert AI engineering assistant. Output your chain-of-thought inside <think>...</think> tags before answering."""`;
      codeEl.textContent = content;
    }

    r1Model.addEventListener('change', updateModelfile);
    r1Temp.addEventListener('input', updateModelfile);
    r1Ctx.addEventListener('input', updateModelfile);

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(codeEl.textContent);
        copyBtn.textContent = '✓ Copied!';
        setTimeout(() => copyBtn.textContent = '📋 Copy Modelfile', 2000);
      });
    }
  }

  // 4. Mac M4 Max Energy Calculator
  const mHours = document.getElementById('macHoursSlider');
  const mKwh = document.getElementById('macKwhSlider');
  if (mHours && mKwh) {
    const mHoursVal = document.getElementById('macHoursVal');
    const mKwhVal = document.getElementById('macKwhVal');
    const mCost = document.getElementById('macPowerCost');
    const gCost = document.getElementById('gpuPowerCost');
    const mSavings = document.getElementById('macSavingsVal');

    function updateEnergy() {
      const h = parseInt(mHours.value);
      const k = parseFloat(mKwh.value);
      mHoursVal.textContent = h + ' hrs/day';
      mKwhVal.textContent = '$' + k.toFixed(2) + ' / kWh';

      const macAnnualKwh = (65 * h * 365) / 1000;
      const gpuAnnualKwh = (720 * h * 365) / 1000;

      const macTotal = macAnnualKwh * k;
      const gpuTotal = gpuAnnualKwh * k;
      const diff = gpuTotal - macTotal;

      mCost.textContent = '$' + macTotal.toFixed(2) + ' / yr';
      gCost.textContent = '$' + gpuTotal.toFixed(2) + ' / yr';
      mSavings.textContent = 'Net Savings: $' + diff.toFixed(2) + ' / year';
    }

    mHours.addEventListener('input', updateEnergy);
    mKwh.addEventListener('input', updateEnergy);
  }

  // 5. FastMCP Tool Generator
  const mcpName = document.getElementById('mcpToolName');
  const mcpDesc = document.getElementById('mcpToolDesc');
  const mcpParam = document.getElementById('mcpToolParam');
  if (mcpName && mcpDesc && mcpParam) {
    const codeBlock = document.getElementById('mcpCodeBlock');
    const copyBtn = document.getElementById('copyMcpBtn');

    function updateMcp() {
      const name = mcpName.value.trim().replace(/\s+/g, '_') || 'custom_tool';
      const desc = mcpDesc.value.trim() || 'Custom local tool execution';
      const param = mcpParam.value.trim() || 'input_data: str';

      const pName = param.split(':')[0].trim();

      const code = `from mcp.server.fastmcp import FastMCP\n\nmcp = FastMCP("LocalAgentTools")\n\n@mcp.tool()\ndef ${name}(${param}) -> str:\n    """${desc}"""\n    return f"Execution complete for {${pName}}"\n\nif __name__ == "__main__":\n    mcp.run(transport="stdio")`;
      codeBlock.textContent = code;
    }

    mcpName.addEventListener('input', updateMcp);
    mcpDesc.addEventListener('input', updateMcp);
    mcpParam.addEventListener('input', updateMcp);

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(codeBlock.textContent);
        copyBtn.textContent = '✓ Copied!';
        setTimeout(() => copyBtn.textContent = '📋 Copy Server Code', 2000);
      });
    }
  }
</script>
