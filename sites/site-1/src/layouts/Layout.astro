---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  schemaJson?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { 
  title, 
  description, 
  canonical = "https://localagentstack.com", 
  schemaJson,
  image = "/images/covers/ollama-vs-vllm-benchmark.webp",
  type = "website"
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Absolute URL for OG Image
const cleanPath = image.startsWith(base) && base.length > 0 ? image.slice(base.length) : image;
const ogImageUrl = image.startsWith('http') 
  ? image 
  : `https://localagentstack.com${cleanPath.startsWith('/') ? '' : '/'}${cleanPath}`;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:site_name" content="LocalAgentStack" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Machine-Readable Discovery -->
    <link rel="alternate" type="text/plain" href={`${base}/llms.txt`} title="LLM Context Index" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Search Console & Webmaster Verification -->
    <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || "google-site-verification-localagentstack"} />
    <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION || "BING-VERIFICATION-LOCALAGENTSTACK"} />

    <!-- Analytics Integration (GA4 + Privacy Telemetry) -->
    {import.meta.env.PUBLIC_GA_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`}></script>
        <script define:vars={{ gaId: import.meta.env.PUBLIC_GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId, { anonymize_ip: true });
        </script>
      </>
    )}
    <script is:inline>
      // Zero-Cookie Privacy-Preserving Traffic Telemetry
      try {
        const pv = {
          p: window.location.pathname,
          r: document.referrer || 'direct',
          t: new Date().toISOString()
        };
        const s = JSON.parse(localStorage.getItem('__site_telemetry') || '[]');
        s.push(pv);
        localStorage.setItem('__site_telemetry', JSON.stringify(s.slice(-50)));
      } catch (e) {}
    </script>

    {schemaJson && (
      <script type="application/ld+json" set:html={schemaJson} />
    )}
  </head>
  <body class="bg-[#090d16] text-slate-100 antialiased font-['Plus_Jakarta_Sans',sans-serif] selection:bg-blue-600 selection:text-white min-h-screen flex flex-col relative overflow-x-hidden">
    
    <!-- Background Ambient Glows -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[400px] bg-gradient-to-b from-blue-600/15 via-indigo-600/5 to-transparent blur-[120px] pointer-events-none -z-10"></div>
    <div class="fixed top-96 -left-48 w-96 h-96 bg-blue-500/10 blur-[140px] pointer-events-none -z-10"></div>
    <div class="fixed top-96 -right-48 w-96 h-96 bg-emerald-500/10 blur-[140px] pointer-events-none -z-10"></div>

    <!-- Top Announcement Bar -->
    <div class="border-b border-slate-800/80 bg-slate-900/60 backdrop-blur-md text-xs py-2 px-4 text-center text-slate-400 flex items-center justify-center space-x-3">
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-500/20 text-blue-400 border border-blue-500/30">
        NEW
      </span>
      <span>DeepSeek R1 & vLLM 0.6.2 Concurrency Sizing Matrix Released</span>
      <a href={`${base}/inference/ollama-vs-vllm-benchmark`} class="text-blue-400 hover:text-blue-300 font-semibold underline underline-offset-2 ml-1">
        Read Benchmark &rarr;
      </a>
    </div>

    <!-- Header Navigation -->
    <header class="border-b border-slate-800/80 bg-[#090d16]/80 backdrop-blur-xl sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href={`${base}/`} class="flex items-center space-x-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 p-[1px] shadow-lg shadow-blue-500/20 group-hover:shadow-blue-500/40 transition duration-300">
            <div class="w-full h-full bg-slate-950 rounded-[11px] flex items-center justify-center font-black text-transparent bg-clip-text bg-gradient-to-tr from-blue-400 to-indigo-300 text-base">
              LA
            </div>
          </div>
          <div class="flex flex-col">
            <span class="text-lg font-black tracking-tight text-white group-hover:text-blue-400 transition">
              LocalAgent<span class="text-blue-500">Stack</span>
            </span>
            <span class="text-[10px] font-mono text-slate-400 tracking-widest uppercase">Open Inference Lab</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center space-x-1 text-sm font-medium text-slate-300">
          <a href={`${base}/inference/ollama-vs-vllm-benchmark`} class="px-3.5 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition">
            Inference
          </a>
          <a href={`${base}/hardware/vram-requirements-calculator-70b`} class="px-3.5 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition">
            Hardware & VRAM
          </a>
          <a href={`${base}/models/deepseek-r1-local-setup-ollama`} class="px-3.5 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition">
            Reasoning Models
          </a>
          <a href={`${base}/agents/custom-mcp-server-python-tutorial`} class="px-3.5 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition">
            MCP Agents
          </a>
        </nav>

        <div class="flex items-center space-x-2.5">
          <a 
            href="https://github.com/jibranpcccc/digitalcreatoravi-seo-engine" 
            target="_blank" 
            rel="noopener"
            class="flex items-center space-x-1.5 px-3 py-1.5 rounded-lg bg-slate-800/80 border border-slate-700/80 hover:border-slate-500 text-xs font-semibold text-slate-200 transition"
            title="GitHub Repository"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            <span class="hidden sm:inline">GitHub</span>
          </a>
          <a 
            href={`${base}/llms.txt`} 
            class="flex items-center space-x-1.5 px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-700/80 hover:border-blue-500/60 text-xs font-mono text-blue-400 shadow-sm transition"
            title="Machine-readable LLM Context Index"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
            <span>llms.txt</span>
          </a>
          <a 
            href={`${base}/#vram-sizer`}
            class="hidden sm:inline-flex items-center px-4 py-1.5 rounded-lg bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white text-xs font-bold shadow-md shadow-blue-500/20 transition"
          >
            VRAM Sizer
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow max-w-6xl mx-auto px-4 py-8 w-full">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 bg-[#060911] mt-24 py-16 text-sm text-slate-400">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
          <div class="md:col-span-2">
            <div class="flex items-center space-x-3 mb-3">
              <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center font-bold text-white text-xs">
                LA
              </div>
              <span class="text-base font-extrabold text-white">LocalAgentStack</span>
            </div>
            <p class="text-xs text-slate-400 max-w-sm leading-relaxed mb-4">
              Open-access empirical research, hardware sizing equations, and reproducible orchestration blueprints for self-hosted AI models.
            </p>
            <div class="inline-flex items-center space-x-2 px-2.5 py-1 rounded-md bg-slate-900 border border-slate-800 text-[11px] font-mono text-emerald-400">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>100% Privacy • Air-Gapped Compliance</span>
            </div>
          </div>

          <div>
            <h4 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Specifications</h4>
            <ul class="space-y-2 text-xs text-slate-400">
              <li><a href={`${base}/inference/ollama-vs-vllm-benchmark`} class="hover:text-blue-400 transition">Ollama vs vLLM Concurrency</a></li>
              <li><a href={`${base}/hardware/vram-requirements-calculator-70b`} class="hover:text-blue-400 transition">70B Model VRAM Sizing</a></li>
              <li><a href={`${base}/models/deepseek-r1-local-setup-ollama`} class="hover:text-blue-400 transition">DeepSeek R1 Ollama Setup</a></li>
              <li><a href={`${base}/hardware/mac-studio-m4-max-llm-benchmarks`} class="hover:text-blue-400 transition">M4 Max Tokens/Sec Sizing</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Community & Transparency</h4>
            <ul class="space-y-2 text-xs text-slate-400">
              <li><a href="https://github.com/jibranpcccc/digitalcreatoravi-seo-engine" target="_blank" rel="noopener" class="hover:text-blue-400 transition flex items-center space-x-1.5">
                <svg class="w-3.5 h-3.5 fill-slate-400" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                <span>GitHub Repository</span>
              </a></li>
              <li><a href={`${base}/llms.txt`} class="hover:text-blue-400 transition font-mono">/llms.txt</a></li>
              <li><a href={`${base}/robots.txt`} class="hover:text-blue-400 transition font-mono">/robots.txt</a></li>
              <li><a href={`${base}/sitemap.xml`} class="hover:text-blue-400 transition font-mono">/sitemap.xml</a></li>
            </ul>
          </div>
        </div>

        <div class="border-t border-slate-800/80 pt-6 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-400 gap-4">
          <p>&copy; 2026 LocalAgentStack. Empirical benchmarks released under MIT License.</p>
          <p class="text-[11px] text-slate-400">Built with Astro SSG • Edge-Hosted with Zero Server Overhead</p>
        </div>
      </div>
    </footer>
  </body>
</html>
