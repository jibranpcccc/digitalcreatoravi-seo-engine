---
import Layout from '../layouts/Layout.astro';

const articles = [
  {
    title: "Ollama vs vLLM: Concurrency & Throughput Benchmark (2026)",
    desc: "Single-user developer latency vs 10-stream continuous batching throughput on RTX 4090.",
    category: "inference",
    slug: "ollama-vs-vllm-benchmark",
    tps: "280 tok/s",
    badge: "BENCHMARK"
  },
  {
    title: "VRAM Requirements Calculator for 70B Models: Sizing Guide",
    desc: "Exact memory computation for Q4_K_M vs FP8 across 8k to 64k context windows.",
    category: "hardware",
    slug: "vram-requirements-calculator-70b",
    tps: "45.4 GB Min",
    badge: "CALCULATOR"
  },
  {
    title: "DeepSeek R1 Local Setup Ollama: Step-by-Step Optimization",
    desc: "Optimal chain-of-thought parameter tuning, temperature 0.6, and custom Modelfile templates.",
    category: "models",
    slug: "deepseek-r1-local-setup-ollama",
    tps: "58 tok/s (14B)",
    badge: "SETUP GUIDE"
  },
  {
    title: "Mac Studio M4 Max LLM Speed: Tokens Per Second Report",
    desc: "Unified memory bandwidth (546 GB/s) testing across 8B, 32B, and 70B parameter models.",
    category: "hardware",
    slug: "mac-studio-m4-max-llm-benchmarks",
    tps: "22.4 tok/s (70B)",
    badge: "HARDWARE"
  },
  {
    title: "Custom MCP Server Python Tutorial: Build Production Tools",
    desc: "FastMCP stdio transport, automated schema generation, and stateful SQLite integrations.",
    category: "agents",
    slug: "custom-mcp-server-python-tutorial",
    tps: "< 4ms IPC",
    badge: "TUTORIAL"
  }
];
---

<Layout 
  title="LocalAgentStack: Local AI Inference, Hardware Benchmarks & MCP Orchestration"
  description="Empirical hardware benchmarks, local LLM inference guides, VRAM calculators, and Model Context Protocol architectures for AI engineers."
>
  <!-- Hero Section -->
  <section class="py-12 md:py-16 text-center max-w-3xl mx-auto">
    <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-blue-950/60 border border-blue-800 text-blue-400 text-xs font-semibold mb-6">
      <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
      <span>2026 Empirical Benchmark Suite</span>
    </div>
    <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white mb-6 leading-tight">
      Deploy Local AI Models with <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">Zero Cloud Latency</span>
    </h1>
    <p class="text-lg text-slate-400 mb-8 leading-relaxed">
      Empirical tokens-per-second benchmarks, VRAM calculations, and production Model Context Protocol (MCP) architectures. Built for privacy-first developers and local agent engineers.
    </p>
    <div class="flex flex-wrap justify-center gap-4 text-sm font-semibold">
      <a href="#benchmarks" class="px-6 py-3 rounded-lg bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-500/20 transition">
        Explore Benchmarks
      </a>
      <a href="/llms.txt" class="px-6 py-3 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition">
        View llms.txt Specs
      </a>
    </div>
  </section>

  <!-- Key Pillar Grid -->
  <section id="benchmarks" class="py-8">
    <div class="flex justify-between items-end mb-8 border-b border-slate-800 pb-4">
      <div>
        <h2 class="text-2xl font-bold text-white">Foundational Architecture Guides</h2>
        <p class="text-sm text-slate-400 mt-1">Verified hardware specs, reproducible code, and passage-level answers.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {articles.map((art) => (
        <a 
          href={`/${art.category}/${art.slug}`}
          class="group block p-6 rounded-xl bg-slate-900 border border-slate-800 hover:border-blue-500/50 hover:bg-slate-850 transition duration-200 shadow-sm"
        >
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-bold px-2.5 py-0.5 rounded bg-blue-950 text-blue-400 border border-blue-900">
              {art.badge}
            </span>
            <span class="text-xs font-mono text-emerald-400 font-semibold bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-900">
              {art.tps}
            </span>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-blue-400 transition mb-2 leading-snug">
            {art.title}
          </h3>
          <p class="text-sm text-slate-400 leading-relaxed mb-4">
            {art.desc}
          </p>
          <div class="flex items-center text-xs font-semibold text-blue-400 group-hover:translate-x-1 transition duration-150">
            <span>Read full specification &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
