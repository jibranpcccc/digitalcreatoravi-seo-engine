    <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 font-mono text-sm text-cyan-300 mb-8">
      NRR = ((Starting MRR + Expansion MRR - Contraction MRR - Churned MRR) / Starting MRR) * 100
    </div>

