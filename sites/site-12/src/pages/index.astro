  <!-- FAQ Section (Reflecting FAQPage Schema) -->
  <section class="border-t border-slate-800/80 pt-12 pb-8">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-bold text-white mb-6">
        Frequently Asked Questions: SaaS Unit Economics & Valuation
      </h2>

      <div class="space-y-4">
        <div class="border border-slate-800/80 rounded-xl p-5 bg-slate-900/50">
          <h3 class="text-sm font-bold text-white mb-2">
            Why must SaaS LTV be adjusted for Gross Margin?
          </h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Traditional revenue LTV (ARPU / Churn) ignores cost of goods sold such as server hosting, AI API tokens, and payment processing fees. Multiplying by Gross Margin % reveals true gross profit per customer, preventing founders from overspending on customer acquisition.
          </p>
        </div>

        <div class="border border-slate-800/80 rounded-xl p-5 bg-slate-900/50">
          <h3 class="text-sm font-bold text-white mb-2">
            What is an ideal LTV:CAC ratio for bootstrapped SaaS companies?
          </h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            For bootstrapped SaaS, a healthy LTV:CAC ratio is between 3.0x and 5.0x. A ratio below 2.0x burns working capital, while a ratio above 6.0x often indicates under-investment in proven paid marketing and organic growth funnels.
          </p>
        </div>

        <div class="border border-slate-800/80 rounded-xl p-5 bg-slate-900/50">
          <h3 class="text-sm font-bold text-white mb-2">
            Why is a CAC payback period under 12 months vital for self-funded software?
          </h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Without external venture capital, upfront acquisition cash must replenish operating bank reserves rapidly. A payback period under 12 months allows a founder to reinvest cash collections within the same fiscal year to fund continuous growth.
          </p>
        </div>

        <div class="border border-slate-800/80 rounded-xl p-5 bg-slate-900/50">
          <h3 class="text-sm font-bold text-white mb-2">
            How does the Rule of 40 correlate with SaaS valuation multiples?
          </h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            SaaS acquirers and private equity firms use the Rule of 40 (YoY Growth Rate + Free Cash Flow Margin) to price businesses. Companies scoring above 40% typically receive 8x to 12x ARR multiples, whereas sub-20% companies trade at 2x to 4x ARR.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Client-Side Calculator Logic -->
  <script is:inline>
    function calculateMetrics() {
      var arpu = parseFloat(document.getElementById('input-arpu').value) || 0;
      var churnPercent = parseFloat(document.getElementById('input-churn').value) || 0.1;
      var marginPercent = parseFloat(document.getElementById('input-margin').value) || 10;
      var cac = parseFloat(document.getElementById('input-cac').value) || 0;
      var growthPercent = parseFloat(document.getElementById('input-growth').value) || 0;
      var fcfPercent = parseFloat(document.getElementById('input-fcf').value) || 0;

      // Update display labels
      document.getElementById('display-arpu').textContent = '$' + arpu.toFixed(2);
      document.getElementById('display-churn').textContent = churnPercent.toFixed(1) + '%';
      document.getElementById('display-margin').textContent = marginPercent.toFixed(0) + '%';
      document.getElementById('display-cac').textContent = '$' + cac.toFixed(2);

      // Math calculations
      var churnDecimal = churnPercent / 100;
      var marginDecimal = marginPercent / 100;

      // Avg lifespan in months = 1 / churnDecimal
      var lifespanMonths = churnDecimal > 0 ? (1 / churnDecimal) : 0;

      // Gross profit per month = ARPU * marginDecimal
      var grossProfitMonthly = arpu * marginDecimal;

      // Gross Margin-Adjusted LTV = grossProfitMonthly / churnDecimal
      var ltv = churnDecimal > 0 ? (grossProfitMonthly / churnDecimal) : 0;

      // LTV:CAC Ratio
      var ratio = cac > 0 ? (ltv / cac) : (ltv > 0 ? 99.9 : 0);

      // CAC Payback Period (Months) = CAC / grossProfitMonthly
      var payback = grossProfitMonthly > 0 ? (cac / grossProfitMonthly) : 0;

      // Rule of 40 = Growth % + FCF %
      var rule40 = growthPercent + fcfPercent;

      // Render Outputs
      document.getElementById('out-ltv').textContent = '$' + ltv.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('out-lifespan').textContent = lifespanMonths.toFixed(1) + ' mo';
      document.getElementById('out-ratio').textContent = (cac === 0 ? 'N/A' : ratio.toFixed(2) + 'x');
      document.getElementById('out-payback').innerHTML = payback.toFixed(1) + ' <span class="text-sm font-normal text-slate-400">Months</span>';
      document.getElementById('out-rule40').textContent = rule40.toFixed(1) + '%';

      // Badges logic: Ratio
      var badgeRatio = document.getElementById('badge-ratio');
      if (ratio >= 5.0) {
        badgeRatio.className = 'inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-cyan-500/20 text-cyan-300 border border-cyan-500/30';
        badgeRatio.textContent = 'HYPER-EFFICIENT (UNDER-INVESTING)';
      } else if (ratio >= 3.0) {
        badgeRatio.className = 'inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-emerald-500/20 text-emerald-400 border border-emerald-500/30';
        badgeRatio.textContent = 'IDEAL SAAS SWEET SPOT (3.0x - 5.0x)';
      } else if (ratio >= 1.5) {
        badgeRatio.className = 'inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-amber-500/20 text-amber-300 border border-amber-500/30';
        badgeRatio.textContent = 'MARGINAL (CAPITAL AT RISK)';
      } else {
        badgeRatio.className = 'inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-rose-500/20 text-rose-300 border border-rose-500/30';
        badgeRatio.textContent = 'CRITICAL (VALUE DESTRUCTION)';
      }

      // Badges logic: Payback
      var badgePayback = document.getElementById('badge-payback');
      if (payback <= 6.0) {
        badgePayback.className = 'inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-emerald-500/20 text-emerald-400 border border-emerald-500/30';
        badgePayback.textContent = 'TOP-DECILE CASH RECOVERY (<= 6 MO)';
      } else if (payback <= 12.0) {
        badgePayback.className = 'inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-teal-500/20 text-teal-300 border border-teal-500/30';
        badgePayback.textContent = 'HEALTHY BOOTSTRAPPED PACE (7 - 12 MO)';
      } else if (payback <= 18.0) {
        badgePayback.className = 'inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-amber-500/20 text-amber-300 border border-amber-500/30';
        badgePayback.textContent = 'BORDERLINE CASHFLOW (13 - 18 MO)';
      } else {
        badgePayback.className = 'inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-rose-500/20 text-rose-300 border border-rose-500/30';
        badgePayback.textContent = 'INSOLVENCY RISK (> 18 MO)';
      }

      // Badges logic: Rule of 40
      var badgeRule40 = document.getElementById('badge-rule40');
      if (rule40 >= 40.0) {
        badgeRule40.className = 'inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-purple-500/20 text-purple-300 border border-purple-500/30';
        badgeRule40.textContent = 'ELITE TIER (>= 40%)';
      } else if (rule40 >= 20.0) {
        badgeRule40.className = 'inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-blue-500/20 text-blue-300 border border-blue-500/30';
        badgeRule40.textContent = 'MODERATE HEALTH (20% - 39%)';
      } else {
        badgeRule40.className = 'inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-slate-700 text-slate-300 border border-slate-600';
        badgeRule40.textContent = 'BELOW THRESHOLD (< 20%)';
      }

      // Multiple Estimation
      var outMultiple = document.getElementById('out-multiple');
      var outMultipleNotes = document.getElementById('out-multiple-notes');
      if (rule40 >= 40.0 && ratio >= 3.0 && payback <= 12.0) {
        outMultiple.textContent = '7.5x - 11.0x ARR';
        outMultipleNotes.textContent = 'Outstanding unit economics. Both Rule of 40 score (' + rule40.toFixed(1) + '%) and payback velocity qualify this business for top-decile M&A exit multiples.';
      } else if (ratio >= 2.5 && payback <= 14.0) {
        outMultiple.textContent = '4.5x - 7.0x ARR';
        outMultipleNotes.textContent = 'Healthy bootstrapped profile with sustainable cash regeneration. Strong foundation for steady organic expansion and high-probability micro-acquisition.';
      } else {
        outMultiple.textContent = '2.0x - 4.0x ARR';
        outMultipleNotes.textContent = 'Constrained valuation due to extended payback (' + payback.toFixed(1) + ' mo) or low LTV:CAC. Prioritize churn reduction or pricing adjustments to expand margin.';
      }
    }

    // Attach event listeners
    ['input-arpu', 'input-churn', 'input-margin', 'input-cac', 'input-growth', 'input-fcf'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el) {
        el.addEventListener('input', calculateMetrics);
      }
    });

    // Preset handlers
    document.getElementById('preset-micro').addEventListener('click', function() {
      document.getElementById('input-arpu').value = 49;
      document.getElementById('input-churn').value = 3.5;
      document.getElementById('input-margin').value = 85;
      document.getElementById('input-cac').value = 180;
      document.getElementById('input-growth').value = 45;
      document.getElementById('input-fcf').value = 15;
      calculateMetrics();
    });

    document.getElementById('preset-prosumer').addEventListener('click', function() {
      document.getElementById('input-arpu').value = 19;
      document.getElementById('input-churn').value = 5.8;
      document.getElementById('input-margin').value = 75;
      document.getElementById('input-cac').value = 45;
      document.getElementById('input-growth').value = 65;
      document.getElementById('input-fcf').value = 10;
      calculateMetrics();
    });

    document.getElementById('preset-mid').addEventListener('click', function() {
      document.getElementById('input-arpu').value = 299;
      document.getElementById('input-churn').value = 1.6;
      document.getElementById('input-margin').value = 88;
      document.getElementById('input-cac').value = 1200;
      document.getElementById('input-growth').value = 35;
      document.getElementById('input-fcf').value = 25;
      calculateMetrics();
    });

    // Run on mount
    calculateMetrics();
  </script>
</Layout>
