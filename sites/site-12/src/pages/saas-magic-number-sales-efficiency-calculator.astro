  <script is:inline>
    function updateMagicNumber() {
      var priorRev = parseFloat(document.getElementById('prior-rev').value) || 0;
      var currRev = parseFloat(document.getElementById('curr-rev').value) || 0;
      var smExpense = parseFloat(document.getElementById('sm-expense').value) || 0;
      var grossMargin = (parseFloat(document.getElementById('gross-margin').value) || 80) / 100;

      var netNewARR = (currRev - priorRev) * 4;
      var magicNumber = smExpense > 0 ? (netNewARR / smExpense) : 0;
      var gmAdjusted = magicNumber * grossMargin;
      var cacPayback = gmAdjusted > 0 ? (12 / gmAdjusted) : 999;

      var outMagic = document.getElementById('out-magic-number');
      var outBadge = document.getElementById('out-efficiency-badge');
      var outNetNew = document.getElementById('out-net-new-arr');
      var outGMAdj = document.getElementById('out-gm-adj');
      var outPayback = document.getElementById('out-cac-payback');
      var outStance = document.getElementById('out-capital-stance');

      outMagic.textContent = magicNumber.toFixed(2);
      outNetNew.textContent = '$' + Math.round(netNewARR).toLocaleString();
      outGMAdj.textContent = gmAdjusted.toFixed(2);
      outPayback.textContent = cacPayback > 99 ? '> 99 Mo' : cacPayback.toFixed(1) + ' Months';

      if (magicNumber < 0.5) {
        outBadge.textContent = 'Capital Destructive (< 0.5)';
        outBadge.className = 'mt-2 inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-rose-500/20 text-rose-300 border border-rose-500/30';
        outStance.textContent = 'Freeze S&M Spend';
        outStance.className = 'text-rose-400 font-bold text-sm';
      } else if (magicNumber < 0.75) {
        outBadge.textContent = 'Flawed / Inefficient (0.5 - 0.74)';
        outBadge.className = 'mt-2 inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30';
        outStance.textContent = 'Optimize Funnel';
        outStance.className = 'text-amber-400 font-bold text-sm';
      } else if (magicNumber <= 1.0) {
        outBadge.textContent = 'Good / Sustainable (0.75 - 1.0)';
        outBadge.className = 'mt-2 inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-500/30';
        outStance.textContent = 'Scale Predictably';
        outStance.className = 'text-cyan-400 font-bold text-sm';
      } else {
        outBadge.textContent = 'Hyper-Efficient (> 1.0)';
        outBadge.className = 'mt-2 inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
        outStance.textContent = 'Accelerate GTM';
        outStance.className = 'text-emerald-400 font-bold text-sm';
      }
    }

    document.getElementById('prior-rev').addEventListener('input', updateMagicNumber);
    document.getElementById('curr-rev').addEventListener('input', updateMagicNumber);
    document.getElementById('sm-expense').addEventListener('input', updateMagicNumber);
    document.getElementById('gross-margin').addEventListener('input', updateMagicNumber);

    // Initial run
    updateMagicNumber();
  </script>

  


  


  


