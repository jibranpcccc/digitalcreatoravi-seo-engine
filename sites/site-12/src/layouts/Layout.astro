      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 bg-[#060a10] mt-24 py-16 text-sm text-slate-400">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
          <div class="md:col-span-2">
            <div class="flex items-center space-x-3 mb-3">
              <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center font-mono font-bold text-slate-950 text-xs">
                Σ$
