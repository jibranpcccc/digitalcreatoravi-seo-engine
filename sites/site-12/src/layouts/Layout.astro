          </a>
          <a href={`${base}/b2b-saas-churn-benchmarks-by-acv-2026`} class="px-3 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition">
            Churn Benchmarks
          </a>
          <a href={`${base}/rule-of-40-saas-valuation-growth-model`} class="px-3 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition">
            Rule of 40
