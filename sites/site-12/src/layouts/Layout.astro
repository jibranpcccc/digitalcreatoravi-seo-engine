              <li><a href={`${base}/saas-ltv-cac-payback-period-calculator`} class="hover:text-emerald-400 transition">LTV/CAC & Payback Period</a></li>
              <li><a href={`${base}/b2b-saas-churn-benchmarks-by-acv-2026`} class="hover:text-emerald-400 transition">B2B Churn Rates by ACV Tier</a></li>
              <li><a href={`${base}/rule-of-40-saas-valuation-growth-model`} class="hover:text-emerald-400 transition">Rule of 40 Growth Valuation</a></li>
            </ul>
