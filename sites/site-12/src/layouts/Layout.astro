              <li><a href={`${base}/llms.txt`} class="hover:text-emerald-400 transition font-mono">/llms.txt (LLM Summary)</a></li>
              <li><a href={`${base}/robots.txt`} class="hover:text-emerald-400 transition font-mono">/robots.txt</a></li>
              <li><a href={`${base}/sitemap.xml`} class="hover:text-emerald-400 transition font-mono">/sitemap.xml</a></li>
