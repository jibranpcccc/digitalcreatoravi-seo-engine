---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  schemaJson?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description,
  canonical = "https://site-15-ruby.vercel.app/",
  schemaJson,
  image = "/og-banner.png",
  type = "website"
} = Astro.props;

const canonicalUrl = canonical.endsWith('/') ? canonical : `${canonical}/`;
const ogImageUrl = image.startsWith('http') ? image : `https://site-15-ruby.vercel.app${image.startsWith('/') ? '' : '/'}${image}`;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="EORCalculator" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Machine-Readable LLM Discovery -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Context Index" />

    <!-- Theme & Colors -->
    <meta name="theme-color" content="#090D16" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Schema.org Structured Data -->
    {schemaJson && (
      <script type="application/ld+json" set:html={schemaJson} />
    )}

    <!-- Fleet Master Analytics Beacon -->
    <script is:inline>
      (function() {
        try {
          var payload = JSON.stringify({
            site: window.location.hostname,
            path: window.location.pathname,
            ref: document.referrer || "direct",
            screen: window.innerWidth + "x" + window.innerHeight,
            ts: Date.now()
          });
          var endpoint = "https://webhookwatch.vercel.app/api/track/";
          if (navigator.sendBeacon) {
            navigator.sendBeacon(endpoint, payload);
          } else {
            fetch(endpoint, { method: "POST", body: payload, keepalive: true, headers: { "Content-Type": "application/json" } }).catch(function(){});
          }
        } catch(e) {}
      })();
    </script>
      <link rel="alternate" type="application/rss+xml" title="RSS 2.0 Feed" href="/rss.xml" />
      <!-- Search Console & Webmaster Verification -->
    <meta name="google-site-verification" content="google6fe267a998c19a9a" />
    <meta name="msvalidate.01" content="BING-VERIFICATION-FLEET-2026" />

    <!-- Google Analytics 4 (GA4) Integration -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-EOR1526015"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-EOR1526015', { anonymize_ip: true });
    </script>

  </head>
  <body class="bg-[#090D16] text-slate-100 antialiased font-['Plus_Jakarta_Sans',sans-serif] selection:bg-emerald-500/30 selection:text-emerald-200 min-h-screen flex flex-col relative overflow-x-hidden">

    <!-- Ambient Visual Background Glows -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[380px] bg-gradient-to-b from-emerald-600/10 via-cyan-600/5 to-transparent blur-[140px] pointer-events-none -z-10"></div>
    <div class="fixed top-96 -left-48 w-96 h-96 bg-emerald-500/5 blur-[140px] pointer-events-none -z-10"></div>
    <div class="fixed top-96 -right-48 w-96 h-96 bg-cyan-500/5 blur-[140px] pointer-events-none -z-10"></div>

    <!-- Announcement Bar -->
    <div class="border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-md text-xs py-2 px-4 text-center text-slate-400 flex items-center justify-center space-x-3">
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
        2026 AUDIT
      </span>
      <span class="hidden sm:inline">Exposing hidden 1.5%–2.5% foreign exchange markups in global payroll invoices</span>
      <span class="sm:hidden">Hidden 1.5%-2.5% FX fee breakdown</span>
      <a href="/deel-vs-remote-com-pricing-hidden-fees-breakdown/" class="text-emerald-400 hover:text-emerald-300 font-semibold underline underline-offset-2 ml-1">
        Deel vs Remote Audit &rarr;
      </a>
    </div>

    <!-- Navigation Header -->
    <header class="border-b border-slate-800/80 bg-[#090D16]/90 backdrop-blur-xl sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center space-x-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 via-teal-500 to-cyan-500 p-[1px] shadow-lg shadow-emerald-500/20 group-hover:shadow-emerald-500/40 transition duration-300">
            <div class="w-full h-full bg-[#0B1120] rounded-[11px] flex items-center justify-center font-mono font-black text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-300 text-sm">
              EOR$
            </div>
          </div>
          <div class="flex flex-col">
            <div class="flex items-center space-x-1.5">
              <span class="text-lg font-black tracking-tight text-white group-hover:text-emerald-400 transition">
                EOR<span class="text-emerald-400">Calculator</span>
              </span>
              <span class="text-[9px] uppercase font-mono font-bold px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/25">
                TRUE COST
              </span>
            </div>
            <span class="text-[10px] font-mono text-slate-400 tracking-wider">Global Payroll & FX Fee Intelligence</span>
          </div>
        </a>

        <!-- Desktop Nav Links -->
        <nav class="hidden lg:flex items-center space-x-1 text-sm font-medium text-slate-300">
          <a href="/" class="px-3.5 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>True-Cost Calculator</span>
          </a>
          <a href="/deel-vs-remote-com-pricing-hidden-fees-breakdown/" class="px-3.5 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition">
            Deel vs Remote.com
          </a>
          <a href="/contractor-vs-eor-legal-misclassification-risk-matrix/" class="px-3.5 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition">
            Misclassification Matrix
          </a>
          <a href="/hiring-remote-engineers-in-latin-america-vs-eastern-europe-eor-cost/" class="px-3.5 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition">
            LATAM vs Eastern Europe
          </a>
        </nav>

        <!-- Right Action Items -->
        <div class="flex items-center space-x-2.5">
          <a
            href="/llms.txt"
            class="flex items-center space-x-1.5 px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-700/80 hover:border-emerald-500/60 text-xs font-mono text-emerald-400 shadow-sm transition"
            title="Machine-readable LLM Context Index"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>llms.txt</span>
          </a>
          <a
            href="/#calculator"
            class="inline-flex items-center px-3.5 py-1.5 rounded-lg bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 text-xs font-bold shadow-md shadow-emerald-500/20 transition"
          >
            Launch Calculator
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 py-8 w-full">
      <slot />
    </main>

    <!-- Site Footer -->
    <footer class="border-t border-slate-800/80 bg-[#060911] mt-24 py-16 text-sm text-slate-400">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
          <!-- Column 1: Brand & Identity -->
          <div class="md:col-span-2">
            <div class="flex items-center space-x-3 mb-3">
              <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-emerald-500 to-teal-500 flex items-center justify-center font-mono font-bold text-slate-950 text-xs">
                EOR$
              </div>
              <span class="text-base font-extrabold text-white">EOR<span class="text-emerald-400">Calculator</span></span>
            </div>
            <p class="text-xs text-slate-400 max-w-sm leading-relaxed mb-4">
              Independent financial intelligence model and employer cost auditing engine. Calculating the real Total Cost to Company (TCTC) including statutory employer social taxes, entity fees, deposit locks, and undisclosed foreign exchange spreads across top international Employer of Record platforms.
            </p>
            <div class="inline-flex items-center space-x-2 px-2.5 py-1 rounded-md bg-slate-900 border border-slate-800 text-[11px] font-mono text-emerald-400">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span>Independent Benchmark • Zero Affiliate Bias • 2026 Statutory Rates</span>
            </div>
          </div>

          <!-- Column 2: Comparisons & Guides -->
          <div>
            <h4 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Audits & Guides</h4>
            <ul class="space-y-2 text-xs text-slate-400">
              <li><a href="/deel-vs-remote-com-pricing-hidden-fees-breakdown/" class="hover:text-emerald-400 transition">Deel vs Remote.com True Cost</a></li>
              <li><a href="/contractor-vs-eor-legal-misclassification-risk-matrix/" class="hover:text-emerald-400 transition">Misclassification Risk Matrix</a></li>
              <li><a href="/hiring-remote-engineers-in-latin-america-vs-eastern-europe-eor-cost/" class="hover:text-emerald-400 transition">LATAM vs Eastern Europe Costs</a></li>
              <li><a href="/#providers" class="hover:text-emerald-400 transition">Provider Fee Matrix</a></li>
              <li><a href="/#faq" class="hover:text-emerald-400 transition">EOR FAQ & Regulations</a></li>
            </ul>
          </div>

          <!-- Column 3: Telemetry & Machine Discovery -->
          <div>
            <h4 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Discovery & Standards</h4>
            <ul class="space-y-2 text-xs text-slate-400">
              <li><a href="/llms.txt" class="hover:text-emerald-400 transition font-mono">/llms.txt (LLM Standard)</a></li>
              <li><a href="/robots.txt" class="hover:text-emerald-400 transition font-mono">/robots.txt</a></li>
              <li><a href="/sitemap.xml" class="hover:text-emerald-400 transition font-mono">/sitemap.xml</a></li>
              <li><a href="/8303260f1bf94264ac6d00aa93efde28.txt" class="hover:text-emerald-400 transition font-mono">IndexNow Key</a></li>
            </ul>
          </div>
        </div>

        <div class="border-t border-slate-800/80 pt-6 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-400 gap-4">
          <p>&copy; 2026 EORCalculator. Real-world international employment cost research. Not legal or tax advice.</p>
          <p class="text-[11px] text-slate-500 font-mono">Astro SSG • Sub-millisecond Client Calculation Engine</p>
        </div>
      </div>
    </footer>
  </body>
</html>
