const title = "Contractor vs EOR: Worker Misclassification Matrix";
const description = "Assess international worker classification risk. Evaluate behavioral control, economic dependence, permanent establishment (PE), and retroactive social tax liabilities across 6 tech hubs.";

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "@id": "https://site-15-ruby.vercel.app/contractor-vs-eor-legal-misclassification-risk-matrix/#article",
      "url": canonical,
      "headline": "Contractor vs EOR: Legal Misclassification Risk Matrix",
      "description": "Comprehensive legal risk framework comparing independent contractors and Employer of Record structures across six key international hiring jurisdictions.",
      "inLanguage": "en-US",
      "author": {
        "@type": "Organization",
        "name": "EORCalculator",
        "url": "https://site-15-ruby.vercel.app/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "EORCalculator",
        "url": "https://site-15-ruby.vercel.app/"
      },
      "datePublished": "2026-03-01T08:00:00Z",
      "dateModified": "2026-09-06T19:00:00Z"
    },
    {
      "@type": "Dataset",
      "@id": "https://site-15-ruby.vercel.app/contractor-vs-eor-legal-misclassification-risk-matrix/#dataset",
      "name": "Global Independent Contractor Misclassification Legal Assessment Matrix",
      "description": "Risk scoring across civil liability, statutory social charges, labor court penalties, and permanent establishment exposure across Brazil, Poland, India, Philippines, Argentina, and UK.",
      "creator": {
        "@type": "Organization",
        "name": "EORCalculator"
      },
      "variableMeasured": ["Misclassification Severity Score", "Retroactive Social Taxes", "Statutory Severance Multiplier", "Permanent Establishment Risk"]
    }
