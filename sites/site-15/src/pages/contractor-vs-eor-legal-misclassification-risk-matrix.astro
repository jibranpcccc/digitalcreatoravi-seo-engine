          <h3 class="text-base font-bold text-white mb-4">Worker Classification Checklist:</h3>
          <div class="space-y-3 text-xs">
            <div class="flex items-start gap-3">
              <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 font-mono font-bold">SAFE CONTRACTOR</span>
              <span class="text-slate-300">Project-based deliverable with defined end date (&lt; 6 months), contractor bills multiple clients, operates via their own registered legal company, supplies own hardware, sets own hours.</span>
            </div>
            <div class="flex items-start gap-3">
              <span class="px-2 py-0.5 rounded bg-rose-500/10 text-rose-400 font-mono font-bold">MANDATORY EOR</span>
              <span class="text-slate-300">Indefinite duration, 40 hours/week dedicated full-time, integrated into team Slack/email, managing proprietary software architecture, receives regular fixed monthly compensation.</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Interactive Calculator CTA -->
      <div class="bg-gradient-to-r from-emerald-950/80 via-slate-950 to-teal-950/80 border border-emerald-500/40 rounded-2xl p-6 text-center my-10">
        <h3 class="text-xl font-bold text-white mb-2">Simulate Your Compliance Upgrade Costs</h3>
        <p class="text-xs sm:text-sm text-slate-400 max-w-xl mx-auto mb-4">
