                <td class="py-3.5 px-4 font-mono text-amber-300">Industrial Disputes Act & EPFO Norms</td>
                <td class="py-3.5 px-4">
                  <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-yellow-500/10 text-yellow-400 border border-yellow-500/25">MODERATE</span>
                </td>
                <td class="py-3.5 px-4 text-slate-300">
