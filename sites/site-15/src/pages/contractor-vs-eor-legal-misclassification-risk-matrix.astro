                <td class="py-3.5 px-4 font-mono text-amber-300">Four-Fold Test (DOLE / Labor Code)</td>
                <td class="py-3.5 px-4">
                  <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-amber-500/10 text-amber-400 border border-amber-500/25">MODERATE-HIGH</span>
                </td>
