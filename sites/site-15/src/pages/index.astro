---
import Layout from '../layouts/Layout.astro';

const canonical = "https://site-15-ruby.vercel.app/";
const title = "Global Employer of Record (EOR) Cost & Hidden FX Fee Calculator | EORCalculator";
const description = "Calculate true total cost to company (TCTC) for hiring international employees via Deel, Remote, Oyster, and Multiplier. Uncover hidden 1.5%-2.5% FX spreads, employer social contributions, and deposit locks.";

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://site-15-ruby.vercel.app/#website",
      "url": "https://site-15-ruby.vercel.app/",
      "name": "EORCalculator",
      "description": "Global Employer of Record (EOR) true cost auditing and foreign exchange fee calculator.",
      "publisher": {
        "@type": "Organization",
        "name": "EORCalculator",
        "url": "https://site-15-ruby.vercel.app/"
      }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://site-15-ruby.vercel.app/#calculator",
      "name": "Global EOR True-Cost & FX Fee Calculator",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "Interactive cross-border payroll calculator modeling statutory employer social contributions, platform fees, and hidden FX conversion markups across Brazil, Poland, India, Philippines, Argentina, and the UK."
    },
    {
      "@type": "FAQPage",
      "@id": "https://site-15-ruby.vercel.app/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What hidden fees do Employer of Record (EOR) platforms charge beyond the monthly SaaS fee?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The largest hidden fee in global EOR payroll is the foreign exchange (FX) spread. EOR platforms typically apply a 1.5% to 2.5% markup over the mid-market interbank exchange rate when converting employer invoice currency to local salary and statutory social contribution disbursements. Additional hidden costs include mandatory 1-2 month upfront refundable security deposits, offboarding legal compliance charges, localized benefit administration markups, and contractor reclassification fees."
          }
        },
        {
          "@type": "Question",
          "name": "How do EOR platforms generate margin from foreign exchange (FX) spreads?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "When an employer funds payroll in USD and the employee is paid in Brazilian Real (BRL) or Polish Zloty (PLN), the EOR executes an FX conversion. Instead of applying the live mid-market interbank exchange rate, the provider applies a commercial retail rate loaded with a 1.5% to 2.5% spread on the entire gross salary plus employer taxes. For an engineering team with $50,000 monthly payroll, a 2% spread extracts $1,000 every single month in hidden FX fees."
          }
        },
        {
          "@type": "Question",
          "name": "What are mandatory employer social contributions, and why do they vary between countries?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mandatory employer social contributions are legally required payroll taxes paid directly by the employer to municipal, state, and national social security, healthcare, pension, and unemployment funds. In Brazil, statutory burden reaches 36% to 43% due to INSS, FGTS, and mandatory 13th-month accruals. In Poland, ZUS accounts for ~21%. In the UK, Employer National Insurance contributes 13.8% to 15.0%, and in India, EPF and gratuity average ~16.5%."
          }
        },
        {
          "@type": "Question",
          "name": "Why do EORs require an upfront security deposit of 1 to 2 months salary?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Because the EOR is the legal employer in-country, they are strictly liable under local labor law for employee wages, statutory severance, and tax remittances if the client company defaults or enters insolvency. To insulate themselves from labor court judgments and mandatory severance liabilities, EORs lock 1 to 2 months of gross salary and statutory employer taxes in an escrow reserve until contract termination."
          }
        },
        {
          "@type": "Question",
          "name": "When does it make financial sense to incorporate an owned local entity instead of using an EOR?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "As a rule of thumb, when you hire between 8 to 15 full-time employees in a single jurisdiction, incorporating an owned subsidiary becomes more cost-effective. At $599/month per seat across 12 employees, EOR SaaS fees total $86,256 annually plus FX markups. By contrast, maintaining a local legal entity typically costs $15,000 to $30,000 annually after initial setup fees."
          }
        }
      ]
    }
  ]
});
---

<Layout title={title} description={description} canonical={canonical} schemaJson={schemaJson}>
  <!-- Hero Section -->
  <div class="pt-6 pb-12 text-center max-w-4xl mx-auto">
    <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/25 text-emerald-400 text-xs font-mono mb-4">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
      <span>2026 Remote Payroll Benchmark Engine</span>
    </div>

    <!-- Exactly ONE H1 -->
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-tight mb-6">
      Global Employer of Record (EOR) Cost & Hidden FX Fee Calculator
    </h1>

    <p class="text-slate-400 text-base sm:text-lg max-w-2xl mx-auto mb-8 leading-relaxed">
      Auditing the true Total Cost to Company (TCTC). Calculate mandatory statutory employer taxes, SaaS seat fees, and undisclosed 1.5%–2.5% foreign exchange conversion markups across Deel, Remote, Oyster, and Multiplier.
    </p>

    <!-- 45-60 Word Featured Snippet Box with green accent border -->
    <div class="bg-gradient-to-br from-slate-900/90 via-slate-900/60 to-slate-950 border-2 border-emerald-500/80 rounded-2xl p-6 shadow-2xl shadow-emerald-500/10 text-left mb-10 max-w-3xl mx-auto backdrop-blur-sm">
      <div class="flex items-center space-x-2.5 text-xs font-bold font-mono uppercase tracking-wider text-emerald-400 mb-2">
        <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Quick Answer: Global EOR True Employment Cost</span>
      </div>
      <p class="text-sm md:text-base text-slate-100 leading-relaxed font-medium">
        An Employer of Record (EOR) true monthly cost includes employee gross salary, mandatory local statutory employer taxes (16% to 43%), the provider SaaS seat fee ($400 to $699/month), and an undisclosed 1.5% to 2.5% foreign exchange conversion spread. For a $5,000 gross employee, true company expense typically reaches $6,300 to $7,600 monthly.
      </p>
    </div>
  </div>

  <!-- Interactive Client-Side EOR Calculator -->
  <section id="calculator" class="max-w-5xl mx-auto mb-20 scroll-mt-24">
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl shadow-black/60 relative overflow-hidden">
      <!-- Glow Decor -->
      <div class="absolute -top-32 -right-32 w-64 h-64 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-32 -left-32 w-64 h-64 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="flex flex-col md:flex-row justify-between items-start md:items-center border-b border-slate-800 pb-6 mb-8 gap-4">
        <div>
          <h2 class="text-2xl font-bold text-white tracking-tight flex items-center gap-2">
            <span class="text-emerald-400 font-mono">01.</span> True Cost to Company (TCTC) Simulator
          </h2>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">
            Real-time multi-currency breakdown including local tax brackets, platform charges, and FX spreads.
          </p>
        </div>

        <!-- Billing Cycle Toggle -->
        <div class="flex items-center space-x-2 bg-slate-950 p-1 rounded-xl border border-slate-800 text-xs font-medium">
          <button id="btn-billed-monthly" class="px-3 py-1.5 rounded-lg bg-emerald-500 text-slate-950 font-bold transition cursor-pointer">
            Monthly Billing
          </button>
          <button id="btn-billed-annual" class="px-3 py-1.5 rounded-lg text-slate-400 hover:text-white transition cursor-pointer">
            Annual Commitment (-17%)
          </button>
        </div>
      </div>

      <!-- Controls Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <!-- 1. Country Selection -->
        <div>
          <label class="block text-xs font-mono font-bold text-slate-300 uppercase tracking-wider mb-2">
            Target Country (Jurisdiction)
          </label>
          <select id="select-country" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-emerald-400 transition font-sans cursor-pointer">
            <option value="brazil" selected>Brazil (BRL) - ~40.5% Social Burden</option>
            <option value="poland">Poland (PLN) - ~21.0% Social Burden</option>
            <option value="india">India (INR) - ~16.5% Social Burden</option>
            <option value="philippines">Philippines (PHP) - ~18.8% Social Burden</option>
            <option value="argentina">Argentina (ARS) - ~34.8% Social Burden</option>
            <option value="uk">United Kingdom (GBP) - ~17.5% Social Burden</option>
          </select>
          <p id="country-hint" class="text-[11px] text-emerald-400/90 font-mono mt-2">
            Includes FGTS (8%), INSS (20-28%), 13th month & vacation accruals.
          </p>
        </div>

        <!-- 2. Gross Salary Input -->
        <div>
          <div class="flex justify-between items-center mb-2">
            <label class="text-xs font-mono font-bold text-slate-300 uppercase tracking-wider">
              Monthly Employee Gross Salary (USD)
            </label>
            <span id="salary-display" class="text-xs font-mono text-emerald-400 font-bold">$5,000 / mo</span>
          </div>
          <div class="relative">
            <span class="absolute left-4 top-3 text-slate-500 font-mono text-sm">$</span>
            <input
              type="number"
              id="input-salary"
              min="1000"
              max="35000"
              step="250"
              value="5000"
              class="w-full bg-slate-950 border border-slate-700 rounded-xl pl-8 pr-4 py-3 text-white text-sm focus:outline-none focus:border-emerald-400 font-mono transition"
            />
          </div>
          <!-- Preset buttons -->
          <div class="flex items-center space-x-1.5 mt-2">
            <button type="button" class="preset-salary text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition cursor-pointer" data-val="3000">$3,000</button>
            <button type="button" class="preset-salary text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition cursor-pointer" data-val="5000">$5,000</button>
            <button type="button" class="preset-salary text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition cursor-pointer" data-val="8000">$8,000</button>
            <button type="button" class="preset-salary text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition cursor-pointer" data-val="12000">$12,000</button>
          </div>
        </div>

        <!-- 3. Provider Selection -->
        <div>
          <label class="block text-xs font-mono font-bold text-slate-300 uppercase tracking-wider mb-2">
            Selected EOR Platform
          </label>
          <select id="select-provider" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-emerald-400 transition font-sans cursor-pointer">
            <option value="deel" selected>Deel ($599/mo standard, ~2.0% FX)</option>
            <option value="remote">Remote.com ($699/mo standard, ~1.5% FX)</option>
            <option value="oyster">Oyster HR ($599/mo standard, ~2.2% FX)</option>
            <option value="multiplier">Multiplier ($400/mo standard, ~1.9% FX)</option>
          </select>
          <p id="provider-hint" class="text-[11px] text-slate-400 font-mono mt-2">
            Owned infrastructure in 100+ nations. Standard 1-mo security deposit.
          </p>
        </div>
      </div>

      <!-- Live Calculation Results Cards -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        <!-- Card 1: Gross Salary -->
        <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">
          <div class="text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-1">1. Gross Salary</div>
          <div id="res-gross" class="text-xl sm:text-2xl font-black text-white font-mono">$5,000</div>
          <div class="text-[10px] text-slate-500 font-mono mt-1">Paid directly to employee</div>
        </div>

        <!-- Card 2: Statutory Employer Taxes -->
        <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">
          <div class="text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-1 flex items-center justify-between">
            <span>2. Employer Taxes</span>
            <span id="badge-tax-rate" class="text-emerald-400 font-bold">40.5%</span>
          </div>
          <div id="res-taxes" class="text-xl sm:text-2xl font-black text-emerald-400 font-mono">$2,025</div>
          <div id="res-taxes-note" class="text-[10px] text-slate-500 font-mono mt-1">Mandatory local statutory charges</div>
        </div>

        <!-- Card 3: Platform Fee -->
        <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">
          <div class="text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-1">3. EOR Platform Fee</div>
          <div id="res-platform" class="text-xl sm:text-2xl font-black text-cyan-400 font-mono">$599</div>
          <div id="res-platform-cycle" class="text-[10px] text-slate-500 font-mono mt-1">Billed monthly</div>
        </div>

        <!-- Card 4: Hidden FX Spread -->
        <div class="bg-slate-950 border border-amber-500/30 rounded-xl p-4 relative overflow-hidden">
          <div class="absolute top-0 right-0 px-2 py-0.5 bg-amber-500/20 text-amber-300 font-mono text-[9px] font-bold rounded-bl-lg border-l border-b border-amber-500/30">
            HIDDEN SPREAD
          </div>
          <div class="text-[11px] font-mono text-amber-300 uppercase tracking-wider mb-1 flex items-center gap-1">
            <span>4. FX Markup</span>
            <span id="badge-fx-rate" class="text-amber-400 font-bold">(~2.0%)</span>
          </div>
          <div id="res-fx" class="text-xl sm:text-2xl font-black text-amber-400 font-mono">$141</div>
          <div class="text-[10px] text-slate-400 font-mono mt-1">Billed on total cross-border remit</div>
        </div>
      </div>

      <!-- True Monthly Total Banner -->
      <div class="bg-gradient-to-r from-emerald-950/70 via-slate-950 to-teal-950/70 border border-emerald-500/40 rounded-2xl p-6 mb-8 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <div class="flex items-center space-x-2 text-xs font-mono font-bold text-emerald-400 uppercase tracking-wider mb-1">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>True Total Cost to Company (TCTC)</span>
          </div>
          <div class="flex items-baseline space-x-3">
            <span id="res-total" class="text-3xl sm:text-4xl font-black text-white font-mono">$7,765</span>
            <span class="text-slate-400 text-sm font-sans">/ month total invoice</span>
          </div>
          <p class="text-xs text-slate-400 mt-1">
            Effective employer overhead: <strong id="res-overhead-pct" class="text-emerald-400 font-mono font-bold">+55.3%</strong> above employee gross salary.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full md:w-auto">
          <!-- Upfront Deposit Box -->
          <div class="bg-slate-900/90 border border-slate-800 rounded-xl px-4 py-2 text-right">
            <div class="text-[10px] font-mono text-slate-400 uppercase">Upfront Deposit Lock</div>
            <div id="res-deposit" class="text-base font-bold text-slate-200 font-mono">$7,025</div>
            <div class="text-[9px] text-slate-500 font-mono">1 month gross + social taxes</div>
          </div>

          <!-- Copy Button -->
          <button id="btn-copy-calc" class="inline-flex items-center justify-center space-x-2 px-4 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs transition shadow-lg shadow-emerald-500/20 cursor-pointer">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span id="btn-copy-text">Copy Audit Spec</span>
          </button>
        </div>
      </div>

      <!-- Live 4-Provider Comparative Matrix for current inputs -->
      <div class="mt-8 border-t border-slate-800 pt-6">
        <h3 class="text-base font-bold text-white mb-4 flex items-center gap-2">
          <span>Comparative Provider Total in</span>
          <span id="comp-country-label" class="text-emerald-400">Brazil</span>
          <span class="text-xs font-mono font-normal text-slate-400">($5,000 Gross Salary)</span>
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="provider-compare-grid">
          <!-- Populated by JavaScript -->
        </div>
      </div>
    </div>
  </section>

  <!-- Comprehensive Provider Breakdown Table -->
  <section id="providers" class="max-w-6xl mx-auto mb-20">
    <div class="text-center max-w-3xl mx-auto mb-8">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-slate-800 text-slate-300 text-xs font-mono mb-3">
        <span>Transparency Benchmark</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
        2026 EOR Platform Architecture & Fee Schedule
      </h2>
      <p class="text-sm text-slate-400 mt-2">
        Comparing Deel, Remote.com, Oyster, and Multiplier across legal entity ownership, currency conversion margins, and contract terms.
      </p>
    </div>

    <div class="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-950 shadow-2xl">
      <table class="w-full text-left text-xs sm:text-sm text-slate-300">
        <thead class="bg-slate-900/90 text-slate-200 font-mono uppercase text-[11px] border-b border-slate-800">
          <tr>
            <th class="py-4 px-4 sm:px-6 font-bold">Metric / Policy</th>
            <th class="py-4 px-4 font-bold text-emerald-400">Deel</th>
            <th class="py-4 px-4 font-bold text-cyan-400">Remote.com</th>
            <th class="py-4 px-4 font-bold text-purple-400">Oyster HR</th>
            <th class="py-4 px-4 font-bold text-amber-400">Multiplier</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/70 font-sans">
          <tr class="hover:bg-slate-900/40 transition">
            <td class="py-4 px-4 sm:px-6 font-semibold text-white">Monthly Seat Fee (Monthly billing)</td>
            <td class="py-4 px-4 font-mono text-emerald-400 font-bold">$599 / seat</td>
            <td class="py-4 px-4 font-mono text-cyan-400 font-bold">$699 / seat</td>
            <td class="py-4 px-4 font-mono text-purple-400 font-bold">$599 / seat</td>
            <td class="py-4 px-4 font-mono text-amber-400 font-bold">$400 / seat</td>
          </tr>
          <tr class="hover:bg-slate-900/40 transition">
            <td class="py-4 px-4 sm:px-6 font-semibold text-white">Annual Commitment Discount</td>
            <td class="py-4 px-4 font-mono">$499 / seat / mo</td>
            <td class="py-4 px-4 font-mono">$599 / seat / mo</td>
            <td class="py-4 px-4 font-mono">$499 / seat / mo</td>
            <td class="py-4 px-4 font-mono">$300–$350 / seat</td>
          </tr>
          <tr class="hover:bg-slate-900/40 transition">
            <td class="py-4 px-4 sm:px-6 font-semibold text-white">
              Estimated FX Markup Spread
              <span class="block text-[10px] font-normal text-slate-500">Spread over interbank mid-market</span>
            </td>
            <td class="py-4 px-4 font-mono text-amber-300 font-semibold">1.8% – 2.2%</td>
            <td class="py-4 px-4 font-mono text-emerald-300 font-semibold">1.2% – 1.6%</td>
            <td class="py-4 px-4 font-mono text-amber-300 font-semibold">2.0% – 2.5%</td>
            <td class="py-4 px-4 font-mono text-amber-300 font-semibold">1.7% – 2.1%</td>
          </tr>
          <tr class="hover:bg-slate-900/40 transition">
            <td class="py-4 px-4 sm:px-6 font-semibold text-white">Entity Infrastructure Model</td>
            <td class="py-4 px-4">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                100+ Owned Entities
              </span>
            </td>
            <td class="py-4 px-4">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
                100% Owned (No Partners)
              </span>
            </td>
            <td class="py-4 px-4">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono bg-slate-800 text-slate-300 border border-slate-700">
                Hybrid (Owned + Partner)
              </span>
            </td>
            <td class="py-4 px-4">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono bg-slate-800 text-slate-300 border border-slate-700">
                Hybrid (Owned APAC/LATAM)
              </span>
            </td>
          </tr>
          <tr class="hover:bg-slate-900/40 transition">
            <td class="py-4 px-4 sm:px-6 font-semibold text-white">Security Deposit Requirement</td>
            <td class="py-4 px-4 text-xs font-mono">1 Month (Salary + Taxes)</td>
            <td class="py-4 px-4 text-xs font-mono">1 Month (Salary + Taxes)</td>
            <td class="py-4 px-4 text-xs font-mono">1 – 2 Months (Country dependent)</td>
            <td class="py-4 px-4 text-xs font-mono">1 Month (Salary + Taxes)</td>
          </tr>
          <tr class="hover:bg-slate-900/40 transition">
            <td class="py-4 px-4 sm:px-6 font-semibold text-white">Contractor Management Add-on</td>
            <td class="py-4 px-4 font-mono">$49 / contractor / mo</td>
            <td class="py-4 px-4 font-mono">$29 / contractor / mo</td>
            <td class="py-4 px-4 font-mono">$29 / contractor / mo</td>
            <td class="py-4 px-4 font-mono">$40 / contractor / mo</td>
          </tr>
          <tr class="hover:bg-slate-900/40 transition">
            <td class="py-4 px-4 sm:px-6 font-semibold text-white">Offboarding & Severance Admin</td>
            <td class="py-4 px-4 text-xs">Statutory legal pass-through; standard $0 fee</td>
            <td class="py-4 px-4 text-xs">Included in base fee; localized severance council</td>
            <td class="py-4 px-4 text-xs">Statutory pass-through; exit package documentation</td>
            <td class="py-4 px-4 text-xs">Included in enterprise contract tier</td>
          </tr>
        </tbody>
      </table>
    </div>
