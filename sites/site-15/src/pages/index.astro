  <section id="faq" class="max-w-4xl mx-auto mb-20 scroll-mt-24">
    <div class="text-center mb-10">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
        Frequently Asked Questions: Global EOR Costs
      </h2>
      <p class="text-sm text-slate-400 mt-2">
        Clear, unvarnished explanations of international payroll compliance and vendor pricing mechanisms.
      </p>
    </div>

    <div class="space-y-4">
      <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-6">
        <h3 class="text-base font-bold text-white mb-2">
          What hidden fees do Employer of Record (EOR) platforms charge beyond the monthly SaaS fee?
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          The largest hidden cost is the <strong>foreign exchange (FX) spread</strong>. Providers convert employer funding (USD or EUR) into local currency (BRL, PLN, INR) at rates with a 1.5% to 2.5% markup over the mid-market interbank rate. Other secondary costs include mandatory 1–2 month upfront security deposit locks, localized benefit administration commissions, offboarding/severance calculation fees, and contractor-to-employee conversion surcharges.
        </p>
      </div>

      <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-6">
        <h3 class="text-base font-bold text-white mb-2">
          How do EOR platforms make money on foreign exchange (FX) spreads?
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          When an employer funds payroll in USD and the employee is paid in Brazilian Real (BRL) or Polish Zloty (PLN), the EOR executes an FX conversion. Rather than passing through wholesale spot rates, providers add a 1.5%–2.5% markup to the converted sum. Crucially, this markup applies to both the employee gross salary <em>and</em> the mandatory employer tax remittances sent to local treasuries.
        </p>
      </div>

      <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-6">
        <h3 class="text-base font-bold text-white mb-2">
          What are mandatory employer social contributions, and why do they vary so widely?
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          Mandatory employer contributions represent taxes that companies must pay above gross salary directly to local governmental bodies for pension, public healthcare, unemployment insurance, and statutory accident coverage. In civil law regimes like Brazil, employers face total burdens exceeding 40% when factoring in FGTS (8%), INSS (up to 28%), and mandatory 13th-month salary and vacation accruals. In common law jurisdictions like the UK, employer National Insurance is lower (~13.8%–15.0%).
        </p>
      </div>

      <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-6">
        <h3 class="text-base font-bold text-white mb-2">
          Why do EORs require a security deposit of 1 to 2 months salary upfront?
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          Because the EOR holds the legal employment contract, local labor tribunals hold the EOR strictly liable for all compensation, tax obligations, and statutory severance if a client company defaults on invoice payments. To protect against customer insolvency, EORs require an upfront refundable cash escrow equivalent to 1 or 2 months of total compensation and statutory employer taxes.
        </p>
      </div>

      <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-6">
        <h3 class="text-base font-bold text-white mb-2">
          When does it make financial sense to incorporate an owned local entity instead of using an EOR?
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          The economic break-even threshold typically sits between <strong>8 and 15 full-time employees</strong> in a single country. At $599/month per seat, maintaining 12 employees through an EOR costs $86,256 per year in SaaS platform fees alone (excluding FX markups). In contrast, setting up and maintaining a private limited company (accounting, statutory filings, corporate director services) usually totals $15,000 to $30,000 annually.
        </p>
      </div>
    </div>
  </section>

  <!-- Client-Side Script for Interactive Calculator -->
  <script is:inline>
    const COUNTRIES = {
      brazil: {
        name: "Brazil",
        code: "BRL",
        taxRate: 0.405,
        fxSpreadDefault: 0.022,
        depositMonths: 1,
        hint: "Includes FGTS (8%), INSS (20-28%), mandatory 13th-month salary & vacation accruals."
      },
      poland: {
        name: "Poland",
        code: "PLN",
        taxRate: 0.210,
        fxSpreadDefault: 0.018,
        depositMonths: 1,
        hint: "Includes ZUS social insurance (pension, disability, accident, Labor Fund) & PPK."
      },
      india: {
        name: "India",
        code: "INR",
        taxRate: 0.165,
        fxSpreadDefault: 0.021,
        depositMonths: 1,
        hint: "Includes Employee Provident Fund (EPF 12%), EDLI, and statutory Gratuity accrual."
      },
      philippines: {
        name: "Philippines",
        code: "PHP",
        taxRate: 0.188,
        fxSpreadDefault: 0.023,
        depositMonths: 1,
        hint: "Includes SSS, PhilHealth, Pag-IBIG, and statutory mandatory 13th-month pay."
      },
      argentina: {
        name: "Argentina",
        code: "ARS",
        taxRate: 0.348,
        fxSpreadDefault: 0.025,
        depositMonths: 1,
        hint: "Includes SIPA/INSSJP (24%), ART insurance, and statutory Aguinaldo (13th pay)."
      },
      uk: {
        name: "United Kingdom",
        code: "GBP",
        taxRate: 0.175,
        fxSpreadDefault: 0.015,
        depositMonths: 1,
        hint: "Includes Employer National Insurance (13.8%-15%), 3% workplace pension & levy."
      }
    };

    const PROVIDERS = {
      deel: {
        name: "Deel",
        monthlyFee: 599,
        annualFee: 499,
        fxSpread: 0.020,
        hint: "Owned infrastructure in 100+ countries. 1-month deposit required."
      },
      remote: {
        name: "Remote.com",
        monthlyFee: 699,
        annualFee: 599,
        fxSpread: 0.015,
        hint: "100% owned legal entities with Fair Price guarantee and lower FX markup."
      },
      oyster: {
        name: "Oyster HR",
        monthlyFee: 599,
        annualFee: 499,
        fxSpread: 0.022,
        hint: "Hybrid owned/partner structure with local country compliance support."
      },
      multiplier: {
        name: "Multiplier",
        monthlyFee: 400,
        annualFee: 320,
        fxSpread: 0.019,
        hint: "Budget-friendly EOR option with deep APAC & LATAM coverage."
      }
    };

    let isAnnual = false;

    function formatUSD(num) {
      return "$" + Math.round(num).toLocaleString();
    }

    function calculate() {
      const countryEl = document.getElementById("select-country");
      const providerEl = document.getElementById("select-provider");
      const salaryEl = document.getElementById("input-salary");
      if (!countryEl || !providerEl || !salaryEl) return;

      const countryKey = countryEl.value;
      const providerKey = providerEl.value;
      const salaryInput = parseFloat(salaryEl.value) || 5000;

      const country = COUNTRIES[countryKey] || COUNTRIES.brazil;
      const provider = PROVIDERS[providerKey] || PROVIDERS.deel;

      const grossSalary = salaryInput;
      const employerTaxes = grossSalary * country.taxRate;
      const platformFee = isAnnual ? provider.annualFee : provider.monthlyFee;
      const fxRate = provider.fxSpread;
      const fxSpread = (grossSalary + employerTaxes) * fxRate;

      const trueTotal = grossSalary + employerTaxes + platformFee + fxSpread;
      const overheadPct = ((trueTotal - grossSalary) / grossSalary) * 100;
      const depositRequired = (grossSalary + employerTaxes) * country.depositMonths;

      const salaryDisplay = document.getElementById("salary-display");
      const resGross = document.getElementById("res-gross");
      const badgeTaxRate = document.getElementById("badge-tax-rate");
      const resTaxes = document.getElementById("res-taxes");
      const resTaxesNote = document.getElementById("res-taxes-note");
      const resPlatform = document.getElementById("res-platform");
      const resPlatformCycle = document.getElementById("res-platform-cycle");
      const badgeFxRate = document.getElementById("badge-fx-rate");
      const resFx = document.getElementById("res-fx");
      const resTotal = document.getElementById("res-total");
      const resOverheadPct = document.getElementById("res-overhead-pct");
      const resDeposit = document.getElementById("res-deposit");
      const countryHint = document.getElementById("country-hint");
      const providerHint = document.getElementById("provider-hint");

      if (salaryDisplay) salaryDisplay.textContent = formatUSD(grossSalary) + " / mo";
      if (resGross) resGross.textContent = formatUSD(grossSalary);
      if (badgeTaxRate) badgeTaxRate.textContent = (country.taxRate * 100).toFixed(1) + "%";
      if (resTaxes) resTaxes.textContent = formatUSD(employerTaxes);
      if (resTaxesNote) resTaxesNote.textContent = country.name + " statutory contributions";
      if (resPlatform) resPlatform.textContent = formatUSD(platformFee);
      if (resPlatformCycle) resPlatformCycle.textContent = isAnnual ? "Annual commitment (billed monthly)" : "Standard monthly billing";
      if (badgeFxRate) badgeFxRate.textContent = "(~" + (fxRate * 100).toFixed(1) + "%)";
      if (resFx) resFx.textContent = formatUSD(fxSpread);
      if (resTotal) resTotal.textContent = formatUSD(trueTotal);
      if (resOverheadPct) resOverheadPct.textContent = "+" + overheadPct.toFixed(1) + "%";
      if (resDeposit) resDeposit.textContent = formatUSD(depositRequired);
      if (countryHint) countryHint.textContent = country.hint;
      if (providerHint) providerHint.textContent = provider.hint;

      renderComparison(country, grossSalary);
    }

    function renderComparison(country, grossSalary) {
      const compLabel = document.getElementById("comp-country-label");
      if (compLabel) compLabel.textContent = country.name;

      const container = document.getElementById("provider-compare-grid");
      if (!container) return;

      const employerTaxes = grossSalary * country.taxRate;

      let html = "";
      for (const [key, p] of Object.entries(PROVIDERS)) {
        const platFee = isAnnual ? p.annualFee : p.monthlyFee;
        const fxCost = (grossSalary + employerTaxes) * p.fxSpread;
        const total = grossSalary + employerTaxes + platFee + fxCost;

        html += `
          <div class="bg-slate-950 border border-slate-800/80 rounded-xl p-4 hover:border-slate-700 transition">
            <div class="flex items-center justify-between mb-2">
              <span class="font-bold text-white text-sm">${p.name}</span>
              <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-900 text-slate-400 border border-slate-800">
                ${(p.fxSpread * 100).toFixed(1)}% FX
              </span>
            </div>
            <div class="text-lg font-black text-emerald-400 font-mono mb-1">${formatUSD(total)}<span class="text-xs text-slate-500 font-normal">/mo</span></div>
            <div class="space-y-1 text-[11px] font-mono text-slate-400">
              <div class="flex justify-between">
                <span>Fee:</span>
                <span class="text-slate-300">${formatUSD(platFee)}</span>
              </div>
              <div class="flex justify-between">
                <span>FX Spread:</span>
                <span class="text-amber-400">${formatUSD(fxCost)}</span>
              </div>
              <div class="flex justify-between">
                <span>Taxes:</span>
                <span class="text-slate-300">${formatUSD(employerTaxes)}</span>
              </div>
            </div>
          </div>
        `;
      }
      container.innerHTML = html;
    }

    document.addEventListener("DOMContentLoaded", () => {
      const inputSalary = document.getElementById("input-salary");
      const selectCountry = document.getElementById("select-country");
      const selectProvider = document.getElementById("select-provider");
      const btnMonthly = document.getElementById("btn-billed-monthly");
      const btnAnnual = document.getElementById("btn-billed-annual");
      const btnCopy = document.getElementById("btn-copy-calc");

      if (inputSalary) inputSalary.addEventListener("input", calculate);
      if (selectCountry) selectCountry.addEventListener("change", calculate);
      if (selectProvider) selectProvider.addEventListener("change", calculate);

      if (btnMonthly && btnAnnual) {
        btnMonthly.addEventListener("click", () => {
          isAnnual = false;
          btnMonthly.className = "px-3 py-1.5 rounded-lg bg-emerald-500 text-slate-950 font-bold transition cursor-pointer";
          btnAnnual.className = "px-3 py-1.5 rounded-lg text-slate-400 hover:text-white transition cursor-pointer";
          calculate();
        });

        btnAnnual.addEventListener("click", () => {
          isAnnual = true;
          btnAnnual.className = "px-3 py-1.5 rounded-lg bg-emerald-500 text-slate-950 font-bold transition cursor-pointer";
          btnMonthly.className = "px-3 py-1.5 rounded-lg text-slate-400 hover:text-white transition cursor-pointer";
          calculate();
        });
      }

      document.querySelectorAll(".preset-salary").forEach(btn => {
        btn.addEventListener("click", () => {
          const val = btn.getAttribute("data-val");
          if (inputSalary && val) {
            inputSalary.value = val;
            calculate();
          }
        });
      });

      if (btnCopy) {
        btnCopy.addEventListener("click", () => {
          const countryKey = selectCountry ? selectCountry.value : "brazil";
          const providerKey = selectProvider ? selectProvider.value : "deel";
          const country = COUNTRIES[countryKey] || COUNTRIES.brazil;
          const provider = PROVIDERS[providerKey] || PROVIDERS.deel;
          const gross = inputSalary ? (parseFloat(inputSalary.value) || 5000) : 5000;
          const taxes = gross * country.taxRate;
          const fee = isAnnual ? provider.annualFee : provider.monthlyFee;
          const fx = (gross + taxes) * provider.fxSpread;
          const total = gross + taxes + fee + fx;

          const text = `EOR True-Cost Audit Specification:
- Country: ${country.name} (${country.code})
- Provider: ${provider.name} (${isAnnual ? 'Annual' : 'Monthly'} Plan)
- Employee Gross Salary: ${formatUSD(gross)} / mo
- Statutory Employer Social Taxes (${(country.taxRate * 100).toFixed(1)}%): ${formatUSD(taxes)} / mo
- EOR Platform SaaS Fee: ${formatUSD(fee)} / mo
- Hidden FX Conversion Spread (${(provider.fxSpread * 100).toFixed(1)}%): ${formatUSD(fx)} / mo
- True Total Cost to Company (TCTC): ${formatUSD(total)} / mo
- Effective Employer Overhead: +${(((total - gross) / gross) * 100).toFixed(1)}%
Generated via EORCalculator (https://site-15-ruby.vercel.app)`;

          navigator.clipboard.writeText(text).then(() => {
            const label = document.getElementById("btn-copy-text");
            if (label) {
              label.textContent = "Copied to Clipboard!";
              setTimeout(() => { label.textContent = "Copy Audit Spec"; }, 2500);
            }
          });
        });
      }

      calculate();
    });
  </script>
</Layout>
