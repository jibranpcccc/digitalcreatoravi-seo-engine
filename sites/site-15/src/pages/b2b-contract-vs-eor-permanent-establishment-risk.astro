---
import Layout from '../layouts/Layout.astro';

const canonical = "https://site-15-ruby.vercel.app/b2b-contract-vs-eor-permanent-establishment-risk/";
const title = "B2B Contractor vs EOR: Permanent Establishment Risk";
const description = "Analyze Permanent Establishment (PE) corporate tax risks under OECD Model Tax Convention Article 5. Compare direct B2B contractor contracts against EOR legal shielding.";

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "@id": "https://site-15-ruby.vercel.app/b2b-contract-vs-eor-permanent-establishment-risk/#article",
      "url": canonical,
      "headline": "B2B Contractor vs EOR: Avoiding Permanent Establishment (PE) Tax Triggers",
      "description": "Comprehensive legal and corporate tax analysis of Permanent Establishment (PE) triggers under OECD Article 5 for international contractor hiring vs Employer of Record (EOR) shielding.",
      "inLanguage": "en-US",
      "author": {
        "@type": "Organization",
        "name": "EORCalculator Global Tax & Compliance Team",
        "url": "https://site-15-ruby.vercel.app/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "EORCalculator",
        "url": "https://site-15-ruby.vercel.app/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://site-15-ruby.vercel.app/og-banner.png"
        }
      },
      "datePublished": "2026-09-09T00:00:00Z",
      "dateModified": "2026-09-14T00:00:00Z"
    },
    {
      "@type": "HowTo",
      "name": "How to Assess and Mitigate Permanent Establishment Risk in Global Hiring",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Audit Commercial Contracting Authority",
          "text": "Review whether remote workers or contractors negotiate, alter terms, or sign customer contracts within foreign jurisdictions."
        },
        {
          "@type": "HowToStep",
          "name": "Classify Core vs Auxiliary Job Functions",
          "text": "Distinguish preparatory and auxiliary support roles from core revenue-generating product and sales activities under OECD Article 5(4)."
        },
        {
          "@type": "HowToStep",
          "name": "Evaluate Home Office Disposal Criteria",
          "text": "Analyze whether mandating remote work or paying home office rent converts private residences into fixed places of business under Article 5(1)."
        },
        {
          "@type": "HowToStep",
          "name": "Interpose an Employer of Record (EOR)",
          "text": "Transition high-risk core workers to an in-country EOR entity to formalize statutory tax withholding and create corporate liability separation."
        },
        {
          "@type": "HowToStep",
          "name": "Implement Contractual Authority Negative Covenants",
          "text": "Enforce explicit contractual clauses barring international personnel from binding the parent enterprise in commercial agreements."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://site-15-ruby.vercel.app/b2b-contract-vs-eor-permanent-establishment-risk/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Permanent Establishment (PE) in international tax law?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Permanent Establishment (PE) is a concept defined under Article 5 of the OECD Model Tax Convention that allows a foreign tax authority to deem that a non-resident company has sufficient taxable nexus in their country to levy corporate income taxes on local and attributable global profits."
          }
        },
        {
          "@type": "Question",
          "name": "How does hiring an independent sales contractor create a Dependent Agent PE?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Under OECD Article 5(5), if an independent contractor habitually negotiates or concludes commercial contracts on behalf of a foreign enterprise, or represents themselves as company sales executives without independent commercial autonomy, local tax authorities classify the worker as a dependent agent, triggering corporate tax liability."
          }
        },
        {
          "@type": "Question",
          "name": "Does using an Employer of Record (EOR) eliminate Permanent Establishment risk?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An EOR significantly reduces PE risk by acting as the legal, registered in-country employer that handles payroll taxes and statutory social withholdings. However, if the worker exercises authority to sign enterprise contracts on behalf of the client parent company, a Dependent Agent PE can still arise regardless of the EOR structure."
          }
        },
        {
          "@type": "Question",
          "name": "Can a remote worker's home office create a Fixed Place of Business PE?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Under OECD Article 5(1) commentary, if a foreign enterprise does not provide an office and effectively requires the worker to carry out core business operations from home continuously, or reimburses dedicated home office rent, local tax authorities can argue that the home office is at the disposal of the foreign enterprise."
          }
        },
        {
          "@type": "Question",
          "name": "What financial penalties arise from a retroactive Permanent Establishment assessment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A retroactive PE determination triggers multi-year corporate income tax assessments on attributed profits (20-35%), backdated employer payroll and social security taxes, severe compounding late-filing interest, and non-compliance fines ranging from 20% to 100% of unpaid liabilities."
          }
