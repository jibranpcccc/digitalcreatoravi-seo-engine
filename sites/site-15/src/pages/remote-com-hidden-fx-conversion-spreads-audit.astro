      <h2 class="text-2xl font-bold text-white border-b border-slate-800 pb-2">
        Automated Payroll Invoice FX Audit &amp; ECB Mid-Market Discrepancy Script (Python)
      </h2>
      <p>
        Use the copy-pasteable Python script below to audit your historical or upcoming EOR payroll invoices against official European Central Bank reference exchange rates. The script flags spread markups exceeding contractual thresholds:
      </p>

      <pre is:raw class="bg-slate-950 p-4 rounded-lg border border-slate-800 text-xs font-mono text-amber-300 overflow-x-auto"><code>#!/usr/bin/env python3
"""
Forensic Payroll FX Markup Auditor
Compares invoiced exchange rates against official ECB reference mid-market rates.
"""

import sys
import json
import urllib.request
from datetime import datetime

def audit_eor_invoice_fx(invoice_date_str: str, from_curr: str, to_curr: str, billed_rate: float) -> dict:
    """
    Audits the billed FX rate on an EOR invoice against real-time/historical mid-market rates.
    """
    url = f"https://api.frankfurter.app/{invoice_date_str}?from={from_curr}&to={to_curr}"
    
    try:
        req = urllib.request.Request(url, headers={'User-Agent': 'FXAuditTool/2.0'})
        with urllib.request.urlopen(req, timeout=10) as response:
            data = json.loads(response.read().decode('utf-8'))
            ecb_mid_market = data['rates'][to_curr]
    except Exception as e:
        print(f"Error fetching reference rates from ECB API: {e}", file=sys.stderr)
        sys.exit(1)

    # Calculate spread delta percentage
    # If employer is paying USD to get EUR, a worse rate gives fewer EUR per USD:
    # Markup % = ((ECB_Rate - Billed_Rate) / ECB_Rate) * 100
    spread_delta_pct = ((ecb_mid_market - billed_rate) / ecb_mid_market) * 100
    is_excessive = spread_delta_pct > 1.25

    return {
        "invoice_date": invoice_date_str,
        "currency_pair": f"{from_curr}/{to_curr}",
        "ecb_mid_market_rate": round(ecb_mid_market, 5),
        "eor_billed_rate": round(billed_rate, 5),
        "spread_markup_percent": round(spread_delta_pct, 3),
        "excessive_markup_flag": is_excessive,
        "recommendation": "Demand credit note if spread > 1.25% without notice." if is_excessive else "Within normal banking buffer."
    }

if __name__ == "__main__":
    # Example Audit: Billed USD to EUR on 2026-09-15
    result = audit_eor_invoice_fx(
        invoice_date_str="2026-09-15",
        from_curr="USD",
        to_curr="EUR",
        billed_rate=0.8842
    )
    print(json.dumps(result, indent=2))
</code></pre>

