const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does Kafka guarantee ordered delivery for GitHub webhooks?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "By partitioning Kafka topics using the GitHub repository ID (repository.id) as the message key, all events belonging to the same git repository are directed to the same Kafka partition, preserving strict chronological event order for commit pushes, PR merges, and branch creations."
      }
    },
    {
      "@type": "Question",
      "name": "Why use Kafka/Redpanda instead of standard SQS or RabbitMQ for 100k webhooks/sec?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "At 100,000 requests per second, traditional message brokers experience queue contention, high memory bloat, and costly API polling overhead. Kafka and Redpanda utilize append-only commit logs with sequential disk I/O and zero-copy transfer, providing sub-millisecond produce latency at massive scale."
      }
    },
    {
      "@type": "Question",
      "name": "How do you prevent GitHub webhook timeout errors during traffic spikes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GitHub enforces a strict 10-second response timeout on webhook deliveries. The ingestion gateway verifies the HMAC-SHA256 signature in memory (<4ms), publishes the payload asynchronously to Kafka, and immediately returns HTTP 202 Accepted, completely decoupling network ingress from downstream business logic."
      }
    }
  ]
};

const schema = {
  "@context": "https://schema.org",
  "@graph": [pageSchema, breadcrumbSchema, faqSchema]
};
