          class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-orange-500"
        />
        <div class="flex justify-between text-[11px] text-slate-500 font-mono mt-1">
          <span>1,000 evt/s</span>
          <span>25,000 evt/s</span>
          <span>50,000 evt/s</span>
          <span>100,000 evt/s</span>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
          <div class="text-xs text-orange-400 uppercase tracking-wider font-mono">HMAC-SHA256 CPU Load</div>
          <div id="hmacCores" class="text-xl font-mono font-bold text-white mt-1">0.05 CPU Cores</div>
          <div class="text-[11px] text-slate-500 font-mono mt-0.5">~1.8 µs per validation</div>
        </div>
        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
          <div class="text-xs text-emerald-400 uppercase tracking-wider font-mono">Ed25519 CPU Load</div>
          <div id="edCores" class="text-xl font-mono font-bold text-emerald-400 mt-1">1.05 CPU Cores</div>
          <div class="text-[11px] text-slate-500 font-mono mt-0.5">~42.0 µs per validation</div>
        </div>
        <div class="bg-slate-950 p-4 rounded-xl border border-orange-500/40 bg-orange-950/20">
          <div class="text-xs text-orange-300 uppercase tracking-wider font-mono font-bold">Verification Delta</div>
          <div id="deltaOut" class="text-xl font-mono font-bold text-orange-300 mt-1">23.3x Compute Spread</div>
          <div class="text-[11px] text-orange-400 font-mono mt-0.5">Asymmetric Security Trade-off</div>
        </div>
      </div>
    </div>

    <!-- Client-side script for Sizer -->
    <script is:inline>
      const tpSlider = document.getElementById('eventThroughput');
      const tpDisplay = document.getElementById('tpDisplay');
      const hmacCoresOut = document.getElementById('hmacCores');
      const edCoresOut = document.getElementById('edCores');
      const deltaOut = document.getElementById('deltaOut');

      function updateThroughput(val) {
        const events = Number(val);
        // HMAC: ~1.8us -> 1 event = 0.0000018 core-seconds
        const hmacCores = (events * 0.0000018).toFixed(2);
        // Ed25519: ~42.0us -> 1 event = 0.000042 core-seconds
        const edCores = (events * 0.000042).toFixed(2);

        tpDisplay.textContent = events.toLocaleString() + ' events/sec';
        hmacCoresOut.textContent = hmacCores + ' CPU Cores';
        edCoresOut.textContent = edCores + ' CPU Cores';
        deltaOut.textContent = '23.3x Compute Spread';
      }

      if (tpSlider) {
        tpSlider.addEventListener('input', (e) => updateThroughput(e.target.value));
      }
    </script>

    <!-- H2: Strategic Selection Framework -->
    <h2 class="text-2xl sm:text-3xl font-bold text-white mb-6 border-b border-slate-800 pb-3">
      6. Architectural Decision Matrix: When to Select HMAC vs Ed25519
    </h2>
    <div class="text-slate-300 space-y-4 mb-8">
      <p>
        Choosing between HMAC-SHA256 and Ed25519 is an engineering trade-off between <strong>computational efficiency</strong> and <strong>security blast-radius isolation</strong>:
      </p>
      <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-900/60 p-1 shadow-2xl mb-8">
        <table class="w-full text-left text-sm text-slate-300">
          <thead class="bg-slate-900 text-xs uppercase tracking-wider text-slate-400 border-b border-slate-800">
            <tr>
              <th class="px-5 py-3 font-bold text-white">System Architecture Context</th>
              <th class="px-5 py-3 font-bold text-white">Recommended Primitive</th>
              <th class="px-5 py-3 font-bold text-white">Core Engineering Rationale</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800 text-xs font-mono">
            <tr>
              <td class="px-5 py-3 text-slate-200">High-volume internal microservices (&gt;50k QPS)</td>
              <td class="px-5 py-3 text-orange-400 font-bold">HMAC-SHA256</td>
              <td class="px-5 py-3 text-slate-400">Minimal latency impact, trusted VPC boundary</td>
            </tr>
            <tr>
              <td class="px-5 py-3 text-slate-200">Public Multi-Tenant B2B SaaS Webhooks</td>
              <td class="px-5 py-3 text-emerald-400 font-bold">Ed25519 (Asymmetric)</td>
              <td class="px-5 py-3 text-slate-400">Consumers cannot forge webhooks if compromised</td>
            </tr>
            <tr>
              <td class="px-5 py-3 text-slate-200">FinTech Payments & Transfer Confirmations</td>
              <td class="px-5 py-3 text-emerald-400 font-bold">Ed25519</td>
              <td class="px-5 py-3 text-slate-400">Non-repudiation protects legal compliance</td>
            </tr>
            <tr>
              <td class="px-5 py-3 text-slate-200">Edge Gateway / Serverless Workers (Cloudflare/Lambda)</td>
              <td class="px-5 py-3 text-orange-400 font-bold">HMAC-SHA256</td>
              <td class="px-5 py-3 text-slate-400">Zero crypto overhead avoids serverless cold starts</td>
            </tr>
            <tr>
              <td class="px-5 py-3 text-slate-200">Standard Webhooks RFC Compliance</td>
              <td class="px-5 py-3 text-emerald-400 font-bold">Ed25519 (v1a)</td>
              <td class="px-5 py-3 text-slate-400">Aligned with open webhook standardization</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p>
        For most forward-looking enterprise SaaS platforms in 2026, implementing a hybrid approach—offering Ed25519 as the primary default with HMAC-SHA256 backward compatibility—provides the gold standard in security and developer ergonomics.
      </p>
    </div>
