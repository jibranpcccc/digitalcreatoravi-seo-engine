const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why is SETNX alone insufficient for webhook idempotency in multi-node clusters?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A simple SETNX key check indicates whether an event has been seen, but does not provide distributed mutual exclusion while long-running state mutations (such as calling Stripe, charging cards, or minting SaaS seats) are in-flight. If two concurrent retry requests arrive simultaneously across different application workers, race conditions can trigger duplicate execution before the first transaction commits."
      }
    },
    {
      "@type": "Question",
      "name": "How does the Redis Redlock algorithm prevent double-billing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Redlock acquires locks independently across multiple (N >= 3 or 5) separate Redis master nodes with a short timeout and clock drift factor. A lock is only granted if a quorum (N/2 + 1) of nodes accept it, guaranteeing mutual exclusion even if a single Redis instance crashes or experiences network partitioning."
      }
    },
    {
      "@type": "Question",
      "name": "Why use an atomic Lua script for releasing locks and setting processed state?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Lua scripts run atomically within Redis's single-threaded event loop. This prevents accidental lock release if the worker's processing time exceeded the lock TTL, ensuring a worker only releases the lock if it still owns the unique random token, while updating the idempotency state to PROCESSED in one step."
      }
    }
  ]
};

const schema = {
  "@context": "https://schema.org",
  "@graph": [pageSchema, breadcrumbSchema, faqSchema]
};
