redis = aioredis.Redis(connection_pool=redis_pool)

STRIPE_WEBHOOK_SECRET = os.getenv("STRIPE_WEBHOOK_SECRET", "whsec_test_secret")

# Atomic Lua Script: Releases Redlock token AND commits PROCESSED state with 24hr TTL
COMMIT_AND_RELEASE_LUA = """
local lock_key = KEYS[1]
local state_key = KEYS[2]
local expected_token = ARGV[1]
local state_val = ARGV[2]
local state_ttl = tonumber(ARGV[3])

-- Only release the lock if the holding token matches
if redis.call('get', lock_key) == expected_token then
    redis.call('del', lock_key)
end

-- Atomically commit the idempotency key state
redis.call('set', state_key, state_val, 'EX', state_ttl)
