    <!-- Client-side script for TCO Calculator -->
    <script is:inline>
      const volSlider = document.getElementById('monthlyVol');
      const volDisplay = document.getElementById('volDisplay');
      const svixOut = document.getElementById('svixCostOut');
      const hookOut = document.getElementById('hookCostOut');
