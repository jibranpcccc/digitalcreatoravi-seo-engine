    <!-- H2: Code Benchmark Simulation -->
    <h2 class="text-2xl sm:text-3xl font-bold text-white mb-6 border-b border-slate-800 pb-3">
      4. End-to-End Delivery Simulation: Full Jitter vs Linear Retries
    </h2>
    <div class="text-slate-300 space-y-4 mb-8">
      <p>
        The following executable Python script models the mathematical behavior of exponential backoff with full jitter across 10,000 simulated transient webhook delivery failures:
      </p>
      <div class="rounded-xl overflow-hidden border border-slate-800 bg-slate-950 p-4">
        <pre is:raw class="text-xs font-mono text-orange-300 overflow-x-auto"><code>import random
import time
from typing import List, Dict

class WebhookDeliveryEngine:
    def __init__(self, base_delay_sec: float = 1.0, max_delay_sec: float = 86400.0):
        self.base_delay = base_delay_sec
        self.max_delay = max_delay_sec

    def compute_full_jitter_delay(self, attempt: int) -> float:
        """
        AWS Full Jitter Algorithm: Sleep = rand(0, min(max_delay, base * 2^attempt))
        Prevents synchronized harmonic thundering herd problems on consumer recovery.
        """
        exponential_ceiling = min(self.max_delay, self.base_delay * (2 ** attempt))
        return random.uniform(0.0, exponential_ceiling)

    def simulate_dispatch_pipeline(self, initial_failures_count: int) -> Dict[str, any]:
        attempts = 0
        total_backoff_time = 0.0
        retry_schedule: List[float] = []

        while attempts < 10:
            attempts += 1
            if attempts > initial_failures_count:
                # Target endpoint recovered
                return {
                    "status": "DELIVERED",
                    "total_attempts": attempts,
                    "cumulative_backoff_sec": round(total_backoff_time, 2),
                    "retry_intervals": [round(x, 2) for x in retry_schedule]
                }
            
            delay = self.compute_full_jitter_delay(attempts)
            retry_schedule.append(delay)
            total_backoff_time += delay

        return {
            "status": "DEAD_LETTER_QUEUE",
            "total_attempts": attempts,
            "cumulative_backoff_sec": round(total_backoff_time, 2),
            "retry_intervals": [round(x, 2) for x in retry_schedule]
        }

engine = WebhookDeliveryEngine(base_delay_sec=2.0, max_delay_sec=1800.0)
simulation_result = engine.simulate_dispatch_pipeline(initial_failures_count=4)
print("Simulation Output:", simulation_result)
</code></pre>
      </div>
