    aioredis.from_url(os.getenv("REDIS_NODE_1_URL", "redis://redis-1:6379/0"), decode_responses=True),
    aioredis.from_url(os.getenv("REDIS_NODE_2_URL", "redis://redis-2:6379/0"), decode_responses=True),
    aioredis.from_url(os.getenv("REDIS_NODE_3_URL", "redis://redis-3:6379/0"), decode_responses=True),
]

STRIPE_WEBHOOK_SECRET = os.getenv("STRIPE_WEBHOOK_SECRET", "whsec_live_example")

# Atomic Lua Script: Releases lock only if token matches and transitions status to PROCESSED
RELEASE_AND_COMMIT_LUA = """
local lock_key = KEYS[1]
local state_key = KEYS[2]
local expected_token = ARGV[1]
local state_ttl = tonumber(ARGV[2])

if redis.call('get', lock_key) == expected_token then
    redis.call('del', lock_key)
end

redis.call('set', state_key, 'PROCESSED', 'EX', state_ttl)
return 1
"""

async def acquire_redlock(lock_key: str, token: str, ttl_ms: int = 15000) -> bool:
    """Attempts to acquire lock across majority quorum of independent nodes."""
    start_time = time.perf_counter()
    acquired_count = 0
    timeout_per_node = 0.05  # 50ms socket timeout

    async def try_acquire(client):
        try:
            res = await asyncio.wait_for(
                client.set(lock_key, token, px=ttl_ms, nx=True),
                timeout=timeout_per_node
            )
            return bool(res)
        except Exception:
            return False

    results = await asyncio.gather(*[try_acquire(node) for node in REDIS_NODES])
    acquired_count = sum(results)
    elapsed_ms = (time.perf_counter() - start_time) * 1000

    # Quorum is majority: Math.floor(N / 2) + 1 => 2 of 3
    is_quorum = acquired_count >= 2
    is_valid_time = elapsed_ms < (ttl_ms * 0.8)

    if is_quorum and is_valid_time:
        return True
    else:
        # Rollback partial acquisitions
        await release_redlock(lock_key, token)
        return False

async def release_redlock(lock_key: str, token: str):
    """Safely releases token across all nodes."""
    SAFE_UNLOCK = "if redis.call('get', KEYS[1]) == ARGV[1] then return redis.call('del', KEYS[1]) else return 0 end"
    await asyncio.gather(*[node.eval(SAFE_UNLOCK, 1, lock_key, token) for node in REDIS_NODES], return_exceptions=True)

