      <h2 class="text-2xl font-bold text-white border-b border-slate-800 pb-2">
        Production TypeScript / Node.js Implementation with Exponential Decay and DLQ Routing
      </h2>
      <p>
        The following copyable, production-ready TypeScript implementation features Full Jitter calculation, granular HTTP status filtering, request timeout management, and Dead Letter Queue (DLQ) integration:
      </p>

      <pre is:raw class="bg-slate-950 p-4 rounded-lg border border-slate-800 text-xs font-mono text-cyan-300 overflow-x-auto"><code>import crypto from 'crypto';

export interface WebhookRetryOptions {
  baseDelaySec: number;
  maxDelaySec: number;
  maxAttempts: number;
  requestTimeoutMs: number;
}

export interface WebhookPayload {
  eventId: string;
  url: string;
  body: Record&lt;string, any&gt;;
  signature: string;
}

export class ProductionWebhookDispatcher {
  private readonly options: WebhookRetryOptions;

  constructor(options: Partial&lt;WebhookRetryOptions&gt; = {}) {
    this.options = {
      baseDelaySec: options.baseDelaySec ?? 1.0,
      maxDelaySec: options.maxDelaySec ?? 64.0,
      maxAttempts: options.maxAttempts ?? 8,
      requestTimeoutMs: options.requestTimeoutMs ?? 5000,
    };
  }

  /**
   * Computes Full Jitter delay in milliseconds:
   * delay = uniform_random(0, min(cap, base * 2^attempt))
   */
  public computeFullJitterDelayMs(attempt: number): number {
    const exponentialCeiling = Math.min(
      this.options.maxDelaySec,
      this.options.baseDelaySec * Math.pow(2, attempt)
    );
    // Cryptographically secure random float in [0, 1)
    const randomBuffer = crypto.randomBytes(4);
    const randomFraction = randomBuffer.readUInt32LE(0) / 0xffffffff;
    return Math.floor(randomFraction * exponentialCeiling * 1000);
  }

  public async deliverWithRetry(
    payload: WebhookPayload,
    onDeadLetter: (payload: WebhookPayload, err: Error, attempts: number) => Promise&lt;void&gt;
  ): Promise&lt;boolean&gt; {
    let attempt = 0;

    while (attempt &lt; this.options.maxAttempts) {
      try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() =&gt; controller.abort(), this.options.requestTimeoutMs);

        const response = await fetch(payload.url, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Webhook-ID': payload.eventId,
            'X-Webhook-Signature': payload.signature,
            'Idempotency-Key': payload.eventId,
          },
          body: JSON.stringify(payload.body),
          signal: controller.signal,
        });

        clearTimeout(timeoutId);

        // Immediate success on HTTP 2xx
        if (response.ok) {
          return true;
        }

        // Non-retryable client errors (400 Bad Request, 401 Unauthorized, 403 Forbidden, 404 Not Found)
        if (response.status &gt;= 400 &amp;&amp; response.status &lt; 500 &amp;&amp; response.status !== 429) {
          throw new Error(`Non-retryable HTTP client error: ${response.status}`);
        }

        // If rate limited with Retry-After header, parse and honor it
        let delayMs = this.computeFullJitterDelayMs(attempt);
        if (response.status === 429) {
          const retryAfterHeader = response.headers.get('Retry-After');
          if (retryAfterHeader) {
            const serverDelaySec = parseInt(retryAfterHeader, 10);
            if (!isNaN(serverDelaySec)) {
              // Add small 0-1s jitter to avoid synchronized retry stampede
              delayMs = (serverDelaySec * 1000) + Math.floor(Math.random() * 1000);
            }
          }
        }

        attempt++;
        if (attempt &gt;= this.options.maxAttempts) {
          break;
        }

        await new Promise((res) =&gt; setTimeout(res, delayMs));
      } catch (err: any) {
        attempt++;
        if (attempt &gt;= this.options.maxAttempts || err.message.includes('Non-retryable')) {
          await onDeadLetter(payload, err, attempt);
          return false;
        }
        const delayMs = this.computeFullJitterDelayMs(attempt);
        await new Promise((res) =&gt; setTimeout(res, delayMs));
      }
    }

    await onDeadLetter(payload, new Error('Max attempts exhausted'), attempt);
    return false;
  }
}
</code></pre>

      <h2 class="text-2xl font-bold text-white border-b border-slate-800 pb-2">
        High-Throughput Zero-Allocation Go Implementation for Distributed Goroutines
      </h2>
      <p>
        In high-volume Go webhook services (such as dispatchers executing 50,000+ goroutines concurrently), garbage collector pauses can degrade latency. The following zero-allocation implementation uses bit shifts, math/rand/v2, and integer arithmetic:
      </p>

      <pre is:raw class="bg-slate-950 p-4 rounded-lg border border-slate-800 text-xs font-mono text-cyan-300 overflow-x-auto"><code>package webhook

import (
	"context"
	"math"
	"math/rand/v2"
	"net/http"
	"time"
)

type BackoffConfig struct {
	Base time.Duration
	Cap  time.Duration
}

// ComputeFullJitter returns a uniform random duration between 0 and min(cap, base * 2^attempt)
// Guaranteed zero heap allocations.
func (c *BackoffConfig) ComputeFullJitter(attempt int) time.Duration {
	if attempt &lt; 0 {
		attempt = 0
	}

	// Bit shift guard against integer overflow on 64-bit platforms
	var multiplier int64
	if attempt &gt;= 30 {
		multiplier = math.MaxInt32
	} else {
		multiplier = int64(1 &lt;&lt; attempt)
	}

	calculatedCap := c.Base * time.Duration(multiplier)
	if calculatedCap &gt; c.Cap || calculatedCap &lt;= 0 {
		calculatedCap = c.Cap
	}

	// rand/v2 N returns a uniform pseudo-random number in [0, calculatedCap)
	return rand.N(calculatedCap)
}

func DispatchWithJitterContext(ctx context.Context, cfg *BackoffConfig, maxRetries int, sendFunc func() (*http.Response, error)) error {
	for attempt := 0; attempt &lt; maxRetries; attempt++ {
		resp, err := sendFunc()
		if err == nil &amp;&amp; resp.StatusCode &gt;= 200 &amp;&amp; resp.StatusCode &lt; 300 {
			if resp.Body != nil {
				_ = resp.Body.Close()
			}
			return nil
		}

		if resp != nil &amp;&amp; resp.Body != nil {
			_ = resp.Body.Close()
		}

		delay := cfg.ComputeFullJitter(attempt)

		select {
		case &lt;-ctx.Done():
			return ctx.Err()
		case &lt;-time.After(delay):
			// Proceed to subsequent retry attempt
		}
	}
	return context.DeadlineExceeded
}
</code></pre>

      <h2 class="text-2xl font-bold text-white border-b border-slate-800 pb-2">
        HTTP 429 Rate Limits &amp; Parsing the 'Retry-After' Header Protocol
      </h2>
      <p>
        When downstream servers employ token bucket or sliding-window rate limiters, they reject requests with <strong>HTTP 429 Too Many Requests</strong> and transmit an explicit <code>Retry-After</code> response header defined in RFC 9110 (Section 10.2.3).
      </p>
      <p>
        The <code>Retry-After</code> header takes one of two mutually exclusive formats:
      </p>
      <ol class="list-decimal pl-5 space-y-2 text-slate-300">
        <li><strong>Delay-Seconds</strong>: A non-negative decimal integer representing the number of seconds to wait (e.g. <code>Retry-After: 120</code>).</li>
        <li><strong>HTTP-Date</strong>: An absolute timestamp conforming to the IMF-fixdate format (e.g. <code>Retry-After: Wed, 24 Sep 2026 15:30:00 GMT</code>).</li>
      </ol>
      <p>
        A naive implementation that strictly sleeps for the exact number of seconds returned by <code>Retry-After</code> recreates the thundering herd problem: every concurrent request that received the 429 will wake up simultaneously when the cooldown expires! The robust architecture combines the server's mandatory delay with a small additive random jitter:
      </p>
      <div class="bg-slate-950 p-4 rounded-lg border border-slate-800 text-xs font-mono text-cyan-300 overflow-x-auto my-4">
        <code>effective_sleep = server_retry_after_ms + uniform_random(0, 1500ms)</code>
      </div>

      <h2 class="text-2xl font-bold text-white border-b border-slate-800 pb-2">
        Idempotency Keys, Redis Distributed Locks, and Deduplication Fencing
      </h2>
      <p>
        Because Full Jitter deliberately staggers retries across extended time windows, network socket timeouts create severe edge conditions. For instance:
      </p>
      <ul class="list-disc pl-5 space-y-2 text-slate-300">
        <li>A customer endpoint receives a webhook payment notification (<code>charge.success</code>) and commits the database transaction.</li>
        <li>However, the TCP connection drops during the TLS termination phase, causing the webhook dispatcher to throw a socket timeout (ECONNRESET).</li>
        <li>The dispatcher records a delivery failure, calculates a 4.5-second jittered backoff, and retries the webhook.</li>
      </ul>
      <p>
        Without idempotency controls, the recipient customer will process the charge twice. To guarantee strict <strong>at-least-once with exactly-once processing semantics</strong>, every webhook payload must feature a deterministic <code>Idempotency-Key</code> header (UUIDv4) that the recipient validates with Redis distributed fencing:
      </p>

      <pre is:raw class="bg-slate-950 p-4 rounded-lg border border-slate-800 text-xs font-mono text-cyan-300 overflow-x-auto"><code>-- Atomic Redis Idempotency Lock (Lua Script)
-- KEYS[1] = idempotency_key, ARGV[1] = worker_id, ARGV[2] = ttl_seconds (86400)
local key = KEYS[1]
local worker = ARGV[1]
local ttl = tonumber(ARGV[2])

local exists = redis.call('EXISTS', key)
if exists == 1 then
    -- Key already processed or being processed by another worker
    return 0
else
    -- Claim key atomically with 24-hour expiration
    redis.call('SET', key, worker, 'EX', ttl)
    return 1
end
</code></pre>

      <h2 class="text-2xl font-bold text-white border-b border-slate-800 pb-2">
