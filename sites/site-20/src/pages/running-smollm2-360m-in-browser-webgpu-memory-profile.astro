      <script is:inline>
        function updateLlmCalc() {
          const ctx = parseInt(document.getElementById('llm-ctx').value, 10);
          const quant = document.getElementById('llm-quant').value;
          const dev = document.getElementById('llm-dev').value;

          document.getElementById('llm-ctx-val').textContent = ctx.toLocaleString() + " Tokens";

          let weightMb = 118.2;
          let kvPer1k = 9.0;
          let actMb = 8.4;
          let speedFactor = 1.0;

          if (quant === 'fp16') {
            weightMb = 720.0;
            kvPer1k = 18.0;
            actMb = 9.2;
            speedFactor = 0.65;
          } else if (quant === 'fp32') {
            weightMb = 1440.0;
            kvPer1k = 36.0;
            actMb = 18.5;
            speedFactor = 0.30;
          }

          const kvMb = (ctx / 1000.0) * kvPer1k;
          const totalVram = weightMb + kvMb + actMb;

          let baseSpeed = 84.0;
          if (dev === 'rtx') baseSpeed = 140.0;
          if (dev === 'mobile') baseSpeed = 42.0;
          const effectiveSpeed = (baseSpeed * speedFactor).toFixed(1);

          document.getElementById('res-llm-weights').textContent = weightMb.toFixed(1) + " MB";
          document.getElementById('res-llm-kv').textContent = kvMb.toFixed(1) + " MB";
          document.getElementById('res-llm-total').textContent = totalVram.toFixed(1) + " MB";
          document.getElementById('res-llm-speed').textContent = effectiveSpeed + " tok/s";
        }

        document.getElementById('llm-ctx').addEventListener('input', updateLlmCalc);
        document.getElementById('llm-quant').addEventListener('change', updateLlmCalc);
        document.getElementById('llm-dev').addEventListener('change', updateLlmCalc);
        updateLlmCalc();
      </script>

      <h2 class="text-2xl font-bold text-white border-b border-slate-800 pb-2">
        Zero-Egress Offline Persistence: Cache Storage, IndexedDB, and Sub-350ms Cold Starts
      </h2>
      <p>
        The single most frustrating user experience in client-side AI is waiting for repeated model weight downloads upon each page refresh. Transformers.js v3 incorporates automatic integration with the browser's native <strong>Cache Storage API</strong>.
      </p>
      <p>
        When a user visits your application for the first time, the 118MB quantized ONNX bundle is streamed into the browser cache. On subsequent visits—even if the user disconnects their network completely or enters airplane mode:
      </p>
      <ul class="space-y-2 text-slate-300 list-disc pl-5">
        <li>The browser satisfies model fetch requests locally from disk cache with zero HTTP roundtrips.</li>
