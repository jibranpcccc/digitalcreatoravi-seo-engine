      <h2 class="text-2xl font-bold text-white border-b border-slate-800 pb-2">
        Production Architecture: Transformers.js v3 Web Worker with Streaming Generation
      </h2>
      <p>
        Executing neural network inference on the browser's main UI thread causes severe interface freezes, dropped animation frames, and unresponsiveness. The production pattern isolates all ONNX Runtime WebGPU operations inside a dedicated background Web Worker using asynchronous streaming channels:
      </p>

      <pre is:raw class="bg-slate-950 p-4 rounded-lg border border-slate-800 text-xs font-mono text-emerald-300 overflow-x-auto"><code>// worker.js: Dedicated Client-Side WebGPU Inference Thread
import { pipeline, TextStreamer, env } from '@huggingface/transformers';

// Configure ONNX Runtime Web to utilize WebGPU execution provider
env.backends.onnx.wasm.proxy = false;
env.allowLocalModels = false;

let generator = null;

self.addEventListener('message', async (event) => {
  const { type, payload } = event.data;

  if (type === 'INITIALIZE_MODEL') {
    try {
      self.postMessage({ status: 'LOADING_WEIGHTS', progress: 0 });

      // Initialize pipeline with q4f16 quantization and WebGPU device binding
      generator = await pipeline('text-generation', 'HuggingFaceTB/SmolLM2-360M-Instruct', {
        device: 'webgpu',
        dtype: 'q4f16',
        progress_callback: (p) => {
          if (p.status === 'progress') {
            self.postMessage({ status: 'DOWNLOADING', file: p.file, progress: Math.round(p.progress) });
          }
        }
      });

      self.postMessage({ status: 'READY' });
    } catch (err) {
      self.postMessage({ status: 'ERROR', error: err.message });
    }
  }

  if (type === 'GENERATE_COMPLETION') {
    if (!generator) {
      self.postMessage({ status: 'ERROR', error: 'Model not initialized' });
      return;
    }

    try {
      const streamer = new TextStreamer(generator.tokenizer, {
        skip_prompt: true,
        skip_special_tokens: true,
        callback_function: (outputToken) => {
          self.postMessage({ status: 'STREAMING_TOKEN', token: outputToken });
        }
      });

      const output = await generator(payload.prompt, {
        max_new_tokens: payload.max_tokens || 512,
        temperature: payload.temperature || 0.7,
        top_p: 0.9,
        do_sample: true,
        streamer
      });

      self.postMessage({ status: 'GENERATION_COMPLETE', result: output });
    } catch (err) {
      self.postMessage({ status: 'ERROR', error: err.message });
    }
  }
});
</code></pre>

      <p>
        The parent thread initializes and interacts with the worker via clean asynchronous promises:
      </p>

      <pre is:raw class="bg-slate-950 p-4 rounded-lg border border-slate-800 text-xs font-mono text-emerald-300 overflow-x-auto"><code>// main.js: UI Thread Integration
const aiWorker = new Worker(new URL('./worker.js', import.meta.url), { type: 'module' });

aiWorker.postMessage({ type: 'INITIALIZE_MODEL' });

aiWorker.onmessage = (e) => {
  const { status, token, progress, error } = e.data;
  
  if (status === 'READY') {
    console.log('[WebGPU] SmolLM2-360M successfully loaded into VRAM.');
  } else if (status === 'STREAMING_TOKEN') {
    document.getElementById('ai-output').textContent += token;
  } else if (status === 'ERROR') {
    console.error('[WebGPU Exception]:', error);
  }
};
</code></pre>

      <h2 class="text-2xl font-bold text-white border-b border-slate-800 pb-2">
