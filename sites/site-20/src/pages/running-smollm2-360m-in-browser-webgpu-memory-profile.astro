            <span class="block text-[11px] font-mono text-slate-400">Model Weights</span>
            <span id="res-llm-weights" class="text-lg font-black text-emerald-400">118.2 MB</span>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800">
            <span class="block text-[11px] font-mono text-slate-400">KV Cache Buffer</span>
            <span id="res-llm-kv" class="text-lg font-black text-cyan-300">18.5 MB</span>
          </div>
