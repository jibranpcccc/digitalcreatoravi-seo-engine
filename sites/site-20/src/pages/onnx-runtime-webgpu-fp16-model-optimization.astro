<pre is:raw class="bg-[#070B12] border border-slate-800 p-4 rounded-b-lg overflow-x-auto text-slate-200 font-mono text-xs leading-relaxed">
import * as ort from 'onnxruntime-web/webgpu';

async function initWebGPUSession(modelUrl) {
  // Verify adapter capabilities
  if (!navigator.gpu) {
    throw new Error("WebGPU is not supported in this browser environment.");
  }
  
  const adapter = await navigator.gpu.requestAdapter();
  const supportsFP16 = adapter.features.has('shader-f16');
  console.log(`[WebGPU] Native FP16 hardware support: ${supportsFP16}`);

  // Set global WebAssembly/WebGPU options
  ort.env.wasm.numThreads = 4;
  ort.env.wasm.proxy = true;

  const sessionOptions = {
    executionProviders: [
      {
        name: 'webgpu',
        deviceType: 'gpu',
        preferredOutputFormat: supportsFP16 ? 'float16' : 'float32',
      }
    ],
    graphOptimizationLevel: 'all',
  };

  console.log("[*] Initializing ONNX inference session from remote CDN...");
  const session = await ort.InferenceSession.create(modelUrl, sessionOptions);
  console.log("[+] WebGPU Inference session ready for execution.");
  return session;
}
