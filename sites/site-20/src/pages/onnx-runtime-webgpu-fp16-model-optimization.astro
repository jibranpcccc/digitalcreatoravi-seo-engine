import os
import onnx
from pathlib import Path
from onnxruntime.transformers import optimizer
from onnxruntime.transformers.fusion_options import FusionOptions
import onnxruntime as ort

def optimize_transformer_for_webgpu(
    input_onnx_model: str,
    output_onnx_model: str,
    model_type: str = "bert",
    num_heads: int = 12,
    hidden_size: int = 768
):
    """
    Fuses MultiHeadAttention and LayerNorm kernels and quantizes weights to FP16
    for high-speed WebGPU execution in ONNX Runtime Web.
    """
    print(f"[*] Reading base model: {input_onnx_model}")
    input_path = Path(input_onnx_model)
    output_path = Path(output_onnx_model)
    output_path.parent.mkdir(parents=True, exist_ok=True)

    # 1. Configure graph fusion options
    fusion_options = FusionOptions(model_type)
    fusion_options.enable_attention = True
    fusion_options.enable_layer_norm = True
    fusion_options.enable_fast_gelu = True
    fusion_options.enable_skip_layer_norm = True
    fusion_options.enable_bias_gelu = True

    # 2. Run graph optimizer
    print(f"[*] Fusing attention and normalization operations for model_type='{model_type}'...")
    opt_model = optimizer.optimize_model(
        str(input_path),
        model_type=model_type,
        num_heads=num_heads,
        hidden_size=hidden_size,
        opt_level=99,
        optimization_options=fusion_options,
        use_gpu=False  # Perform transformations on host CPU
    )

    # 3. Convert FP32 float tensors to IEEE 754 half-precision FP16
    print("[*] Converting graph weights and operations to float16 (FP16)...")
    opt_model.convert_float_to_float16(
        keep_io_types=False,   # Convert input/output to fp16 for zero-copy WebGPU buffers
        min_positive_val=1e-7, # Guard against underflow
        max_finite_val=65504   # Max FP16 representation
    )

    # 4. Save optimized graph artifact
    opt_model.save_model_to_file(str(output_path))
    
    orig_size_mb = input_path.stat().st_size / (1024 * 1024)
    opt_size_mb = output_path.stat().st_size / (1024 * 1024)
    compression = (1.0 - (opt_size_mb / orig_size_mb)) * 100

    print(f"[+] Optimization Complete!")
    print(f"    Original Size:  {orig_size_mb:.2f} MB")
    print(f"    Optimized FP16: {opt_size_mb:.2f} MB ({compression:.1f}% reduction)")

    # 5. Sanity check: Verify model topology
    onnx_model = onnx.load(str(output_path))
    onnx.checker.check_model(onnx_model)
    print("[+] ONNX topology verification passed.")

if __name__ == "__main__":
    # Example: Optimize an exported sentence-transformer or BERT encoder
    SRC = "models/all-MiniLM-L6-v2/model.onnx"
    DST = "models/all-MiniLM-L6-v2-webgpu/model_fp16.onnx"
    
    # In production, adjust num_heads and hidden_size to your model architecture:
    optimize_transformer_for_webgpu(
        input_onnx_model=SRC,
        output_onnx_model=DST,
        model_type="bert",
        num_heads=12,
        hidden_size=384
    )
