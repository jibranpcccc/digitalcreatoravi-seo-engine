    <div class="bg-emerald-950/20 border-l-4 border-l-emerald-500 border-y border-r border-emerald-500/30 rounded-xl p-6 shadow-xl mb-10">
      <div class="text-xs font-bold uppercase tracking-wider text-emerald-400 font-mono mb-2">
        ⚡ Quick Answer: Browser WebGPU LLM Inference
      </div>
      <p class="text-sm sm:text-base text-slate-200 leading-relaxed">
        <strong>Transformers.js v3</strong> unlocks direct client-side GPU acceleration in modern Chromium browsers using the W3C WebGPU standard and ONNX Runtime Web. By downloading quantized 4-bit ONNX weights directly into the browser’s Origin Private File System (OPFS), models like <strong>Phi-3.5-mini (3.8B)</strong> sustain <strong>32.4 tokens/second</strong> with zero server-side compute cost and complete user data privacy.
      </p>
    </div>

    <!-- Section 1: The Client-Side AI Paradigm Shift -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-4">The Client-Side AI Paradigm: Zero Cloud API Costs</h2>
      <p class="text-slate-300 text-base leading-relaxed mb-4">
        Serving LLMs in production via cloud API providers (OpenAI, Anthropic, AWS Bedrock) presents two persistent operational headaches: soaring marginal token costs at scale and severe regulatory data compliance friction (GDPR, HIPAA). Sending confidential patient medical records or enterprise source code across third-party networks requires complex BAA agreements and risk audits.
      </p>
      <p class="text-slate-300 text-base leading-relaxed mb-4">
        The arrival of <strong>WebGPU</strong> as a W3C standard, combined with <strong>Transformers.js v3</strong> from Hugging Face, fundamentally changes this equation. WebGPU provides low-overhead, direct access to the client machine's underlying graphics hardware (DirectX 12 on Windows, Metal on macOS/iOS, and Vulkan on Linux/Android), enabling browser-based neural network execution with compute efficiency approaching native compiled C++ runtimes.
      </p>
    </section>

    <!-- Section 2: Complete Implementation Guide -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-4">Full Production Implementation: Web Worker Architecture</h2>
      <p class="text-slate-300 text-sm leading-relaxed mb-4">
        Running large neural networks directly on the browser's main UI thread causes interface stuttering and jank during matrix multiplications. In production, always offload inference to a <strong>Web Worker</strong>. Below is the complete worker and client implementation:
      </p>

      <!-- Worker Script -->
      <div class="mb-6">
        <h3 class="text-base font-bold text-cyan-400 font-mono mb-2">1. The Web Worker Script (worker.js):</h3>
        <div class="rounded-xl border border-slate-800 bg-slate-900/90 p-4 font-mono text-xs text-cyan-300 overflow-x-auto">
          <pre is:raw>
import { pipeline, env, TextStreamer } from '@huggingface/transformers';

// Configure WebGPU backend and proxy flags
env.backends.onnx.wasm.proxy = false;
env.allowLocalModels = false;

let generator = null;

self.addEventListener('message', async (e) => {
  const { type, payload } = e.data;

  if (type === 'INIT_MODEL') {
    self.postMessage({ type: 'STATUS', message: 'Loading ONNX weights into WebGPU...' });
    
    // Load 4-bit quantized Phi-3.5-mini optimized for WebGPU
    generator = await pipeline(
      'text-generation',
      'onnx-community/Phi-3.5-mini-instruct-onnx-web',
      {
        device: 'webgpu',
        dtype: 'q4',
        progress_callback: (p) => {
          if (p.status === 'progress') {
            self.postMessage({ type: 'DOWNLOAD_PROGRESS', file: p.file, progress: p.progress });
          }
        }
      }
    );

    self.postMessage({ type: 'READY' });
  }

  if (type === 'GENERATE') {
    const { prompt, maxTokens } = payload;
    
    // Stream tokens back to UI as they are generated
    const streamer = new TextStreamer(generator.tokenizer, {
      skip_prompt: true,
      callback_function: (tokenText) => {
        self.postMessage({ type: 'TOKEN', token: tokenText });
      }
    });

    const output = await generator(prompt, {
      max_new_tokens: maxTokens || 128,
      temperature: 0.7,
      streamer
    });

    self.postMessage({ type: 'DONE', fullText: output[0].generated_text });
  }
});
          </pre>
        </div>
      </div>

      <!-- Main Client Script -->
      <div class="mb-6">
        <h3 class="text-base font-bold text-cyan-400 font-mono mb-2">2. UI Controller (main.js):</h3>
        <div class="rounded-xl border border-slate-800 bg-slate-900/90 p-4 font-mono text-xs text-emerald-400 overflow-x-auto">
          <pre is:raw>
const worker = new Worker(new URL('./worker.js', import.meta.url), { type: 'module' });

worker.postMessage({ type: 'INIT_MODEL' });

worker.onmessage = (e) => {
  const { type, token, progress, fullText } = e.data;
  
  if (type === 'DOWNLOAD_PROGRESS') {
    console.log(`Downloading model shards: ${Math.round(progress)}%`);
  }
  if (type === 'READY') {
    console.log('Model instantiated on WebGPU. Ready to generate.');
    worker.postMessage({
      type: 'GENERATE',
      payload: { prompt: 'Explain the difference between TCP and UDP in 2 sentences:', maxTokens: 64 }
    });
  }
  if (type === 'TOKEN') {
    document.getElementById('outputBox').textContent += token;
  }
  if (type === 'DONE') {
    console.log('Inference complete.');
  }
};
          </pre>
