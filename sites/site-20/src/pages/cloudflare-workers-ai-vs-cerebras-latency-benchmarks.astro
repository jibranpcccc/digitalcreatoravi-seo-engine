import { performance } from 'perf_hooks';

interface BenchmarkResult {
  provider: string;
  coldStart: boolean;
  ttftMs: number;
  totalDurationMs: number;
  tokensGenerated: number;
  tokensPerSec: number;
}

async function benchmarkProvider(
  name: string,
  endpoint: string,
  apiKey: string,
  model: string,
  prompt: string
): Promise&lt;BenchmarkResult&gt; {
  const startTime = performance.now();
  let firstTokenTime: number | null = null;
  let tokenCount = 0;

  const response = await fetch(endpoint, {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${apiKey}`,
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({
      model: model,
      messages: [{ role: 'user', content: prompt }],
      stream: true,
      max_tokens: 256,
      temperature: 0.1
    })
  });

  if (!response.ok || !response.body) {
    throw new Error(`[${name}] Request failed: ${response.status} ${response.statusText}`);
  }

  const reader = response.body.getReader();
  const decoder = new TextDecoder('utf-8');

  while (true) {
    const { done, value } = await reader.read();
    if (done) break;

    const chunk = decoder.decode(value, { stream: true });
    if (!firstTokenTime &amp;&amp; chunk.includes('data:')) {
      firstTokenTime = performance.now();
    }

    // Count completion chunks
    const matches = chunk.match(/"content":\s*"[^"]+"/g);
    if (matches) {
      tokenCount += matches.length;
    }
  }

  const endTime = performance.now();
  const ttftMs = (firstTokenTime ? firstTokenTime - startTime : endTime - startTime);
  const totalDurationMs = endTime - startTime;
  const genDurationSec = (endTime - (firstTokenTime || startTime)) / 1000;
  const tokensPerSec = genDurationSec &gt; 0 ? tokenCount / genDurationSec : 0;

  return {
    provider: name,
    coldStart: ttftMs &gt; 1000,
    ttftMs: Number(ttftMs.toFixed(2)),
    totalDurationMs: Number(totalDurationMs.toFixed(2)),
    tokensGenerated: tokenCount,
    tokensPerSec: Number(tokensPerSec.toFixed(1))
  };
}

// Example execution for comparative evaluation
async function runSuite() {
  const testPrompt = "Explain the difference between on-chip SRAM and off-chip HBM3 memory bandwidth.";
  
  console.log("--> Starting Empirical Edge AI Benchmark...");
  // Benchmark Groq
  if (process.env.GROQ_API_KEY) {
    const groqRes = await benchmarkProvider(
      "Groq LPU",
      "https://api.groq.com/openai/v1/chat/completions",
      process.env.GROQ_API_KEY,
      "llama-3.1-8b-instant",
      testPrompt
    );
    console.log(`[Groq] TTFT: ${groqRes.ttftMs}ms | Throughput: ${groqRes.tokensPerSec} tok/s`);
  }

  // Benchmark Cerebras
  if (process.env.CEREBRAS_API_KEY) {
    const cerebrasRes = await benchmarkProvider(
      "Cerebras CS-3",
      "https://api.cerebras.ai/v1/chat/completions",
      process.env.CEREBRAS_API_KEY,
      "llama3.1-8b",
      testPrompt
    );
    console.log(`[Cerebras] TTFT: ${cerebrasRes.ttftMs}ms | Throughput: ${cerebrasRes.tokensPerSec} tok/s`);
  }
}
