---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Edge AI Inference Leaderboard: WebGPU, ONNX Runtime & CoreML";
const pageDescription = "Empirical edge AI inference benchmarks comparing WebGPU, ONNX Runtime Web, Cloudflare Workers AI, and Apple CoreML. Latency, tokens/s throughput, and VRAM memory profiling.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://edgeruntimehq.pages.dev/#website",
      "url": "https://edgeruntimehq.pages.dev/",
      "name": "EdgeRuntimeHQ",
      "description": "Empirical Edge AI & WebGPU Inference Benchmark Laboratory"
    },
    {
      "@type": "Dataset",
      "@id": "https://edgeruntimehq.pages.dev/#dataset",
      "name": "Edge AI Inference Latency & Memory Matrix 2026",
      "description": "Empirical TTFT, decoding throughput, and memory footprint benchmarks for Llama-3.2, Whisper, SmolLM2, and CLIP across WebGPU, ONNX Runtime Web, Apple CoreML, and Cloudflare Workers AI.",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "creator": {
        "@type": "Organization",
        "name": "EdgeRuntimeHQ Research Lab"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://edgeruntimehq.pages.dev/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does WebGPU achieve 10x-20x speedups over WebAssembly (WASM) for LLMs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "WebGPU dispatches raw WGSL compute shaders directly onto client GPU hardware execution units. While WASM SIMD is constrained to 128-bit CPU registers and single-digit execution threads, WebGPU dispatches thousands of parallel SIMD warps, achieving 30 to 80 tokens/second on client hardware."
          }
        },
        {
          "@type": "Question",
          "name": "What are the browser memory limits for running LLMs via WebGPU?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Browsers restrict single GPU storage buffer allocations via maxStorageBufferBindingSize (typically 1GB to 2GB in Chrome/Edge, 1GB in Safari). Loading models larger than 2GB requires tensor sharding across multiple storage buffers or unified memory heaps, making 4-bit quantization (W4A16) essential for in-browser client inference."
          }
        },
        {
          "@type": "Question",
          "name": "How does ONNX Runtime Web select between WebGPU and WebAssembly execution providers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ONNX Runtime Web checks navigator.gpu availability and WGSL compute shader support at runtime. If GPU context initialization succeeds, it engages the webgpu execution provider. If unavailable or blocked by browser permissions, it falls back to the wasm provider with multi-threaded pthread workers and 128-bit SIMD intrinsics."
          }
        },
        {
          "@type": "Question",
          "name": "Is Apple CoreML faster than in-browser WebGPU on Apple Silicon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, native Apple CoreML directly accesses the dedicated 16-core Apple Neural Engine (ANE) and unified memory bus with zero browser sandbox overhead. CoreML typically demonstrates 30% to 50% lower Time to First Token and 40% higher tokens/second than in-browser WebGPU on identical M-series chips."
          }
        },
        {
          "@type": "Question",
          "name": "How do edge serverless runtimes compare to purely client-side WebGPU?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Edge serverless runtimes like Cloudflare Workers AI execute models on centralized edge GPU clusters (e.g. NVIDIA A10G/L40S) distributed across global PoPs, introducing 30ms-60ms network RTT but eliminating client hardware requirements and download sizes. Client WebGPU requires downloading model weights once but provides 100% offline operation and zero per-token infrastructure costs."
          }
        },
        {
          "@type": "Question",
          "name": "What quantization format provides the optimal latency-to-perplexity ratio on edge devices?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For small language models (1B to 3B parameters), W4A16 (4-bit weights packed with 16-bit activation dequantization kernels) offers the optimal balance, preserving over 98% of baseline FP16 perplexity while reducing memory footprint by 72% and doubling memory bandwidth throughput."
          }
        }
      ]
    }
  ]
};

const quickAnswerText = "Edge AI inference executes machine learning models directly on client hardware or localized edge gateways without round-trip cloud API latency. Modern runtimes like WebGPU, ONNX Runtime Web, and Apple CoreML leverage client-side GPU shader cores and NPUs, cutting p95 Time to First Token under 85ms while ensuring zero-data-egress compliance and 100% offline autonomy.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  schema={schema}
>
  <!-- Hero Section -->
  <div class="relative overflow-hidden bg-gradient-to-b from-slate-900 via-slate-950 to-slate-950 border-b border-slate-800/80 pt-16 pb-20">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#10b98108_1px,transparent_1px),linear-gradient(to_bottom,#10b98108_1px,transparent_1px)] bg-[size:32px_32px] pointer-events-none"></div>
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-emerald-500/10 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs font-mono text-slate-400 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-emerald-400 transition-colors">Home</a>
        <span class="text-slate-600">/</span>
        <span class="text-emerald-400">Benchmarks</span>
        <span class="text-slate-600">/</span>
        <span class="text-slate-500">Edge Runtime Leaderboard</span>
      </nav>

      <div class="max-w-4xl">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-emerald-950/60 border border-emerald-500/30 text-xs font-mono text-emerald-400 mb-6 shadow-[0_0_15px_rgba(16,185,129,0.15)]">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>Empirical Edge Inference Lab • Updated September 2026</span>
        </div>

        <!-- Primary Header -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.1] mb-6">
          Edge AI Inference Leaderboard: WebGPU, ONNX Runtime & CoreML
        </h1>

        <p class="text-lg sm:text-xl text-slate-300 font-light leading-relaxed mb-8">
          Standardized empirical latency benchmarks, token generation throughput, and resident memory footprint across browser runtimes, client hardware NPUs, and global edge serverless clusters.
        </p>

        <!-- 45-60 word featured snippet Quick Answer box with green accent border -->
        <div class="border-l-4 border-emerald-500 bg-emerald-950/20 p-6 rounded-r-xl border border-emerald-500/30 my-8 shadow-[0_0_25px_rgba(16,185,129,0.1)]">
          <div class="flex items-center gap-2 text-xs font-mono font-bold text-emerald-400 uppercase tracking-wider mb-2">
            <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            Quick Answer: What is Edge AI Inference & How Does It Perform?
          </div>
          <p class="text-slate-200 text-sm sm:text-base leading-relaxed font-normal">
            Edge AI inference executes machine learning models directly on client hardware or localized edge gateways without round-trip cloud API latency. Modern runtimes like WebGPU, ONNX Runtime Web, and Apple CoreML leverage client-side GPU shader cores and NPUs, cutting p95 Time to First Token under 85ms while ensuring zero-data-egress compliance and 100% offline autonomy.
          </p>
        </div>

        <!-- Quick Stats Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8">
          <div class="p-4 rounded-xl bg-slate-900/80 border border-slate-800">
            <div class="text-2xl sm:text-3xl font-mono font-bold text-emerald-400">16ms</div>
            <div class="text-xs text-slate-400 mt-1">Lowest TTFT (CoreML ANE)</div>
          </div>
          <div class="p-4 rounded-xl bg-slate-900/80 border border-slate-800">
            <div class="text-2xl sm:text-3xl font-mono font-bold text-cyan-400">142 t/s</div>
            <div class="text-xs text-slate-400 mt-1">Peak Decoding Speed</div>
          </div>
          <div class="p-4 rounded-xl bg-slate-900/80 border border-slate-800">
            <div class="text-2xl sm:text-3xl font-mono font-bold text-amber-400">W4A16</div>
            <div class="text-xs text-slate-400 mt-1">Quantized Standard</div>
          </div>
          <div class="p-4 rounded-xl bg-slate-900/80 border border-slate-800">
            <div class="text-2xl sm:text-3xl font-mono font-bold text-violet-400">0 KB</div>
            <div class="text-xs text-slate-400 mt-1">Cloud Data Egress</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Interactive Client-Side Edge Runtime Latency & Memory Matrix -->
  <section id="matrix" class="py-16 bg-slate-950 border-b border-slate-800/80 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-4xl font-bold text-white tracking-tight mb-4">
          Interactive Edge Runtime Latency & Memory Matrix
        </h2>
        <p class="text-slate-400 text-sm sm:text-base">
          Select an open-weight foundation model and target execution runtime to profile empirical Time to First Token (TTFT), sustained decoding speed, and resident memory footprint.
        </p>
      </div>

      <!-- Matrix Container Card -->
      <div class="bg-slate-900/90 rounded-2xl border border-slate-800 p-6 sm:p-8 shadow-2xl backdrop-blur">
        <!-- Control Selectors -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8 pb-8 border-b border-slate-800">
          <!-- Model Selection -->
          <div>
            <label class="block text-xs font-mono uppercase tracking-wider text-slate-400 mb-3 font-semibold">
              1. Select Foundation Model
            </label>
            <div class="grid grid-cols-2 gap-2.5" id="model-selector">
              <button type="button" data-model="llama" class="model-btn active p-3 rounded-xl border border-emerald-500 bg-emerald-500/10 text-white font-medium text-left transition-all hover:border-emerald-400 flex flex-col justify-between">
                <span class="font-bold text-sm text-emerald-300">Llama-3.2-1B</span>
                <span class="text-[11px] text-slate-400 font-mono mt-1">LLM • W4A16 • ~710MB</span>
              </button>

              <button type="button" data-model="whisper" class="model-btn p-3 rounded-xl border border-slate-800 bg-slate-950/60 text-slate-300 font-medium text-left transition-all hover:border-slate-700 flex flex-col justify-between">
                <span class="font-bold text-sm text-white">Whisper-Tiny</span>
                <span class="text-[11px] text-slate-400 font-mono mt-1">ASR • INT8 • ~39MB</span>
              </button>

              <button type="button" data-model="smollm" class="model-btn p-3 rounded-xl border border-slate-800 bg-slate-950/60 text-slate-300 font-medium text-left transition-all hover:border-slate-700 flex flex-col justify-between">
                <span class="font-bold text-sm text-white">SmolLM2-360M</span>
                <span class="text-[11px] text-slate-400 font-mono mt-1">SLM • W4A16 • ~240MB</span>
              </button>

              <button type="button" data-model="clip" class="model-btn p-3 rounded-xl border border-slate-800 bg-slate-950/60 text-slate-300 font-medium text-left transition-all hover:border-slate-700 flex flex-col justify-between">
                <span class="font-bold text-sm text-white">CLIP-ViT</span>
                <span class="text-[11px] text-slate-400 font-mono mt-1">Vision • FP16 • ~170MB</span>
              </button>
            </div>
          </div>

          <!-- Runtime Selection -->
          <div>
            <label class="block text-xs font-mono uppercase tracking-wider text-slate-400 mb-3 font-semibold">
              2. Select Edge Runtime Environment
            </label>
            <div class="grid grid-cols-2 gap-2.5" id="runtime-selector">
              <button type="button" data-runtime="webgpu" class="runtime-btn active p-3 rounded-xl border border-emerald-500 bg-emerald-500/10 text-white font-medium text-left transition-all hover:border-emerald-400 flex flex-col justify-between">
                <span class="font-bold text-sm text-emerald-300">WebGPU Browser</span>
                <span class="text-[11px] text-slate-400 font-mono mt-1">Chrome/Edge WGSL GPU</span>
              </button>

              <button type="button" data-runtime="onnx" class="runtime-btn p-3 rounded-xl border border-slate-800 bg-slate-950/60 text-slate-300 font-medium text-left transition-all hover:border-slate-700 flex flex-col justify-between">
                <span class="font-bold text-sm text-white">ONNX Runtime Web</span>
                <span class="text-[11px] text-slate-400 font-mono mt-1">ORT WebGPU / WASM SIMD</span>
              </button>

              <button type="button" data-runtime="cloudflare" class="runtime-btn p-3 rounded-xl border border-slate-800 bg-slate-950/60 text-slate-300 font-medium text-left transition-all hover:border-slate-700 flex flex-col justify-between">
                <span class="font-bold text-sm text-white">Cloudflare Workers AI</span>
                <span class="text-[11px] text-slate-400 font-mono mt-1">Edge Serverless PoPs</span>
              </button>

              <button type="button" data-runtime="coreml" class="runtime-btn p-3 rounded-xl border border-slate-800 bg-slate-950/60 text-slate-300 font-medium text-left transition-all hover:border-slate-700 flex flex-col justify-between">
                <span class="font-bold text-sm text-white">Apple CoreML</span>
                <span class="text-[11px] text-slate-400 font-mono mt-1">Native ANE + Metal API</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Dynamic Visualization Dashboard -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
          <!-- Metric Visual Bars -->
          <div class="lg:col-span-2 space-y-6">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-lg text-white flex items-center gap-2">
                <span id="display-model-name" class="text-emerald-400">Llama-3.2-1B</span>
                <span class="text-slate-600">on</span>
                <span id="display-runtime-name" class="text-cyan-400">WebGPU Browser</span>
              </h3>
              <span id="display-hw-badge" class="px-2.5 py-1 rounded bg-slate-800 text-slate-300 font-mono text-xs border border-slate-700">
                Client GPU (WGSL)
              </span>
            </div>

            <!-- Metric 1: TTFT -->
            <div class="bg-slate-950/80 p-4 rounded-xl border border-slate-800">
              <div class="flex justify-between items-center mb-2">
                <span class="text-xs font-mono uppercase text-slate-400 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                  Time to First Token (TTFT)
                </span>
                <span class="text-xs text-slate-500 font-mono">Lower is better</span>
              </div>
              <div class="flex items-baseline justify-between mb-2">
                <span id="metric-ttft-val" class="text-2xl sm:text-3xl font-mono font-extrabold text-cyan-400">82 ms</span>
                <span id="metric-ttft-rel" class="text-xs text-emerald-400 font-mono">⚡ 1.4x faster than WASM</span>
              </div>
              <div class="w-full h-3 rounded-full bg-slate-900 overflow-hidden">
                <div id="bar-ttft" class="h-full bg-gradient-to-r from-cyan-500 to-emerald-400 rounded-full transition-all duration-500" style="width: 41%;"></div>
              </div>
            </div>

            <!-- Metric 2: Throughput -->
            <div class="bg-slate-950/80 p-4 rounded-xl border border-slate-800">
              <div class="flex justify-between items-center mb-2">
                <span class="text-xs font-mono uppercase text-slate-400 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  Sustained Generation Throughput
                </span>
                <span class="text-xs text-slate-500 font-mono">Higher is better</span>
              </div>
              <div class="flex items-baseline justify-between mb-2">
                <span id="metric-tps-val" class="text-2xl sm:text-3xl font-mono font-extrabold text-emerald-400">34.2 tokens/s</span>
                <span id="metric-tps-rel" class="text-xs text-emerald-400 font-mono">Real-time interactive reading</span>
              </div>
              <div class="w-full h-3 rounded-full bg-slate-900 overflow-hidden">
                <div id="bar-tps" class="h-full bg-gradient-to-r from-emerald-500 to-teal-400 rounded-full transition-all duration-500" style="width: 24%;"></div>
              </div>
            </div>

            <!-- Metric 3: Memory -->
            <div class="bg-slate-950/80 p-4 rounded-xl border border-slate-800">
              <div class="flex justify-between items-center mb-2">
                <span class="text-xs font-mono uppercase text-slate-400 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                  Resident Memory Footprint (RAM / VRAM)
                </span>
                <span class="text-xs text-slate-500 font-mono">Lower is better</span>
              </div>
              <div class="flex items-baseline justify-between mb-2">
                <span id="metric-mem-val" class="text-2xl sm:text-3xl font-mono font-extrabold text-amber-400">820 MB</span>
                <span id="metric-mem-rel" class="text-xs text-slate-400 font-mono">Fits within 1GB Browser Buffer</span>
              </div>
              <div class="w-full h-3 rounded-full bg-slate-900 overflow-hidden">
                <div id="bar-mem" class="h-full bg-gradient-to-r from-amber-500 to-yellow-400 rounded-full transition-all duration-500" style="width: 41%;"></div>
              </div>
            </div>
          </div>

          <!-- Technical Specs Column -->
          <div class="bg-slate-950/90 rounded-xl border border-slate-800 p-5 space-y-4 text-xs font-mono">
            <h4 class="text-white font-bold uppercase tracking-wider text-xs pb-2 border-b border-slate-800 flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
              Execution Profile
            </h4>

            <div>
              <span class="text-slate-500 block">Cold Start Pipeline Initialization</span>
              <span id="spec-cold-start" class="text-slate-200 font-semibold text-sm">1,450 ms</span>
            </div>

            <div>
              <span class="text-slate-500 block">Quantization & Weight Packing</span>
              <span id="spec-quant" class="text-slate-200 font-semibold text-sm">W4A16 AWQ Block-Quant</span>
            </div>

            <div>
              <span class="text-slate-500 block">Target Architecture Acceleration</span>
              <span id="spec-target" class="text-emerald-400 font-semibold text-sm">Direct3D 12 / Metal / Vulkan via WGSL</span>
            </div>

            <div>
              <span class="text-slate-500 block">Privacy & Data Boundary</span>
              <span id="spec-privacy" class="text-emerald-300 font-semibold text-sm">100% Client-Side (0 Data Sent)</span>
            </div>

            <div class="pt-3 border-t border-slate-800">
              <a id="spec-guide-link" href="/webgpu-vs-wasm-in-browser-llm-inference-benchmarks/" class="inline-flex items-center gap-1.5 text-xs text-cyan-400 hover:text-cyan-300 underline underline-offset-4">
                <span>Read detailed execution profile</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Comprehensive 2026 Empirical Leaderboard Table -->
  <section id="benchmarks" class="py-16 bg-slate-900/40 border-b border-slate-800/80 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
        <div>
          <div class="text-xs font-mono uppercase text-emerald-400 tracking-wider mb-2 font-semibold">
            Laboratory Empirical Data
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            Edge AI Inference Leaderboard (2026 Field Benchmarks)
          </h2>
        </div>
        <div class="text-xs text-slate-400 font-mono">
          Tested on Chrome 128 (WebGPU) • M3 Max ANE • Cloudflare PoP (Frankfurt)
        </div>
      </div>

      <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-950/80 shadow-xl">
        <table class="w-full text-left text-xs sm:text-sm font-mono border-collapse">
          <thead>
            <tr class="border-b border-slate-800 bg-slate-900 text-slate-300 uppercase text-[11px] tracking-wider">
              <th class="py-3.5 px-4 font-semibold">Model</th>
              <th class="py-3.5 px-4 font-semibold">Runtime / Engine</th>
              <th class="py-3.5 px-4 font-semibold">Precision</th>
              <th class="py-3.5 px-4 font-semibold">TTFT (p95)</th>
              <th class="py-3.5 px-4 font-semibold">Throughput</th>
              <th class="py-3.5 px-4 font-semibold">Memory</th>
              <th class="py-3.5 px-4 font-semibold">Cold Start</th>
              <th class="py-3.5 px-4 font-semibold">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 text-slate-300">
            <tr class="hover:bg-slate-900/40 transition-colors">
              <td class="py-3.5 px-4 font-bold text-white">Llama-3.2-1B</td>
              <td class="py-3.5 px-4 text-emerald-400">Apple CoreML (ANE)</td>
              <td class="py-3.5 px-4 text-slate-400">W4A16</td>
              <td class="py-3.5 px-4 font-bold text-emerald-300">41 ms</td>
              <td class="py-3.5 px-4 font-bold text-emerald-400">54.8 tok/s</td>
              <td class="py-3.5 px-4 text-amber-400">760 MB</td>
              <td class="py-3.5 px-4 text-slate-400">620 ms</td>
              <td class="py-3.5 px-4"><span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-[10px]">Tier 1 Native</span></td>
            </tr>

            <tr class="hover:bg-slate-900/40 transition-colors">
              <td class="py-3.5 px-4 font-bold text-white">Llama-3.2-1B</td>
              <td class="py-3.5 px-4 text-cyan-400">WebGPU (Chrome WGSL)</td>
              <td class="py-3.5 px-4 text-slate-400">W4A16</td>
              <td class="py-3.5 px-4 font-bold text-slate-200">82 ms</td>
              <td class="py-3.5 px-4 font-bold text-cyan-400">34.2 tok/s</td>
              <td class="py-3.5 px-4 text-amber-400">820 MB</td>
              <td class="py-3.5 px-4 text-slate-400">1,450 ms</td>
              <td class="py-3.5 px-4"><span class="px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 text-[10px]">Web Ready</span></td>
            </tr>

            <tr class="hover:bg-slate-900/40 transition-colors">
              <td class="py-3.5 px-4 font-bold text-white">Llama-3.2-1B</td>
              <td class="py-3.5 px-4 text-slate-300">ONNX Runtime Web</td>
              <td class="py-3.5 px-4 text-slate-400">W4A16</td>
