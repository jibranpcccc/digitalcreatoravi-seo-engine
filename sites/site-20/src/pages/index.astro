    let currentModel = 'llama';
    let currentRuntime = 'webgpu';

    function updateMatrixView() {
      const model = benchmarkData[currentModel];
      const data = model.runtimes[currentRuntime];

      // Update Labels
      document.getElementById('display-model-name').textContent = model.name;
      document.getElementById('display-runtime-name').textContent = data.name;
      document.getElementById('display-hw-badge').textContent = data.hw;

      // Update Metric Values
      document.getElementById('metric-ttft-val').textContent = data.ttft + ' ms';
      document.getElementById('metric-ttft-rel').textContent = data.ttftRel;
      document.getElementById('bar-ttft').style.width = data.ttftBar + '%';

      document.getElementById('metric-tps-val').textContent = data.tps;
      document.getElementById('metric-tps-rel').textContent = data.tpsRel;
      document.getElementById('bar-tps').style.width = data.tpsBar + '%';

      document.getElementById('metric-mem-val').textContent = data.mem;
      document.getElementById('metric-mem-rel').textContent = data.memRel;
      document.getElementById('bar-mem').style.width = data.memBar + '%';

      // Update Specs
      document.getElementById('spec-cold-start').textContent = data.cold;
      document.getElementById('spec-quant').textContent = model.quant;
      document.getElementById('spec-target').textContent = data.target;
      document.getElementById('spec-privacy').textContent = data.privacy;
      document.getElementById('spec-guide-link').setAttribute('href', model.guideUrl);
    }

    // Attach Model Listeners
    document.querySelectorAll('#model-selector .model-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        document.querySelectorAll('#model-selector .model-btn').forEach(b => {
          b.classList.remove('active', 'border-emerald-500', 'bg-emerald-500/10');
          b.classList.add('border-slate-800', 'bg-slate-950/60');
          const title = b.querySelector('span:first-child');
          if (title) title.classList.replace('text-emerald-300', 'text-white');
        });

        target.classList.add('active', 'border-emerald-500', 'bg-emerald-500/10');
        target.classList.remove('border-slate-800', 'bg-slate-950/60');
        const activeTitle = target.querySelector('span:first-child');
        if (activeTitle) activeTitle.classList.replace('text-white', 'text-emerald-300');

        currentModel = target.getAttribute('data-model');
        updateMatrixView();
      });
    });

    // Attach Runtime Listeners
    document.querySelectorAll('#runtime-selector .runtime-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        document.querySelectorAll('#runtime-selector .runtime-btn').forEach(b => {
          b.classList.remove('active', 'border-emerald-500', 'bg-emerald-500/10');
          b.classList.add('border-slate-800', 'bg-slate-950/60');
          const title = b.querySelector('span:first-child');
          if (title) title.classList.replace('text-emerald-300', 'text-white');
        });

        target.classList.add('active', 'border-emerald-500', 'bg-emerald-500/10');
        target.classList.remove('border-slate-800', 'bg-slate-950/60');
        const activeTitle = target.querySelector('span:first-child');
        if (activeTitle) activeTitle.classList.replace('text-white', 'text-emerald-300');

        currentRuntime = target.getAttribute('data-runtime');
        updateMatrixView();
      });
    });
  </script>
</Layout>
