    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Client-Side WASM Redaction",
      "item": "https://localdocprivacy.netlify.app/redact-pdf-locally-browser-wasm-guide/"
    }
  ]
};

const schema = {
  "@context": "https://schema.org",
  "@graph": [pageSchema, breadcrumbSchema]
