      </p>

      <h2 class="text-2xl font-bold text-white border-b border-slate-800 pb-2">
        Production TypeScript Sanitization Worker Implementation with Binary Object Tree Rebuilding
      </h2>
      <p>
        The following copyable TypeScript implementation runs inside a dedicated Web Worker. It loads the PDF ArrayBuffer, deletes all classic Info dictionary properties, unlinks the Catalog XMP stream, strips application PieceInfo, and rebuilds the cross-reference tables without using incremental update appends:
      </p>

      <pre is:raw class="bg-slate-950 p-4 rounded-lg border border-slate-800 text-xs font-mono text-emerald-300 overflow-x-auto"><code>import { PDFDocument, PDFName, PDFNull, PDFRawStream } from 'pdf-lib';

export interface MetadataAuditReport {
  originalSizeBytes: number;
  cleanedSizeBytes: number;
  executionDurationMs: number;
  purgedFields: string[];
  xmpStreamFound: boolean;
  pieceInfoFound: boolean;
}

export interface SanitizationOutput {
  sanitizedPdfBytes: Uint8Array;
  report: MetadataAuditReport;
}

/**
 * Sanitizes PDF documents entirely in browser client memory.
 * Guarantees zero-network transmission and complete object tree restructuring.
 */
export async function sanitizePdfInBrowser(pdfBuffer: ArrayBuffer): Promise&lt;SanitizationOutput&gt; {
  const startTime = performance.now();
  const purgedFields: string[] = [];

  // Load PDF document into memory without rendering visual raster layers
  const pdfDoc = await PDFDocument.load(pdfBuffer, {
    updateMetadata: false,
    ignoreEncryption: true,
    throwOnInvalidObject: false,
  });

  const originalSizeBytes = pdfBuffer.byteLength;

  // 1. Wipe Classic Trailer /Info Dictionary entries
  pdfDoc.setTitle('');
  pdfDoc.setAuthor('');
  pdfDoc.setSubject('');
  pdfDoc.setKeywords([]);
  pdfDoc.setProducer('');
  pdfDoc.setCreator('');
  pdfDoc.setCreationDate(new Date(0));
  pdfDoc.setModificationDate(new Date(0));
  purgedFields.push('Info:Title', 'Info:Author', 'Info:Creator', 'Info:Producer', 'Info:Timestamps');

  // 2. Eradicate Extensible Metadata Platform (XMP) Stream from Document Catalog
  const catalog = pdfDoc.catalog;
  const metadataKey = PDFName.of('Metadata');
  let xmpStreamFound = false;

  if (catalog.has(metadataKey)) {
    catalog.delete(metadataKey);
    xmpStreamFound = true;
    purgedFields.push('Catalog:XMP_Metadata_Stream');
  }

  // 3. Purge Application-Specific Private Dictionaries (/PieceInfo)
  const pieceInfoKey = PDFName.of('PieceInfo');
  let pieceInfoFound = false;
  if (catalog.has(pieceInfoKey)) {
    catalog.delete(pieceInfoKey);
    pieceInfoFound = true;
    purgedFields.push('Catalog:PieceInfo');
  }

  // 4. Traverse Page Objects to strip individual Page PieceInfo dictionaries
  const pages = pdfDoc.getPages();
  for (let i = 0; i &lt; pages.length; i++) {
    const pageNode = pages[i].node;
    if (pageNode.has(pieceInfoKey)) {
      pageNode.delete(pieceInfoKey);
      purgedFields.push(`Page[${i}]:PieceInfo`);
    }
  }

  // 5. Serialize PDF with full structural object re-indexing (Disables incremental appends)
  const sanitizedPdfBytes = await pdfDoc.save({
    useObjectStreams: false,
    addDefaultPage: false,
  });

  const executionDurationMs = Math.round(performance.now() - startTime);

  return {
    sanitizedPdfBytes,
    report: {
      originalSizeBytes,
      cleanedSizeBytes: sanitizedPdfBytes.byteLength,
      executionDurationMs,
      purgedFields,
      xmpStreamFound,
      pieceInfoFound,
    },
  };
}
</code></pre>

