      "@id": "https://groklogtester.pages.dev/syslog-rfc-5424-grok-pattern-validator-cheatsheet/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the structural difference between Syslog RFC 3164 and RFC 5424?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "RFC 3164 (legacy BSD syslog) uses an informal, unversioned format lacking year or timezone data and structured attributes. RFC 5424 establishes a standardized 8-field header featuring explicit protocol versions, microsecond ISO-8601 timestamps, process IDs, message IDs, and bracketed structured data key-value blocks."
          }
        },
        {
          "@type": "Question",
          "name": "How does RFC 5424 represent missing or null header values?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "RFC 5424 strictly mandates the nilvalue character '-' (single ASCII hyphen) for any header field where information is unknown or omitted. Grok parsers must explicitly match (?:PATTERN|-) to prevent dropped logs."
          }
        },
        {
          "@type": "Question",
          "name": "What is the standard production Grok pattern for RFC 5424?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The verified pattern is: ^<%{POSINT:syslog_pri}>%{NONNEGINT:syslog_ver} +(?:%{TIMESTAMP_ISO8601:syslog_ts}|-) +(?:%{HOSTNAME:syslog_host}|-) +(?:%{NOTSPACE:syslog_app}|-) +(?:%{NOTSPACE:syslog_proc}|-) +(?:%{NOTSPACE:syslog_msgid}|-) +(?:(?<syslog_sd>\\[[^\\]]+\\])|-) *(?<syslog_msg>.*)$"
          }
        },
        {
          "@type": "Question",
          "name": "How is the PRI (Priority) header decomposed into Facility and Severity?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The PRI numerical value satisfies the formula PRI = Facility * 8 + Severity. Facility is derived via integer division (PRI >> 3 or PRI // 8), and Severity is derived via bitwise modulo (PRI & 7 or PRI % 8)."
          }
        },
        {
          "@type": "Question",
          "name": "Why does Vector VRL outperform Logstash Grok on RFC 5424 logs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Vector VRL utilizes a compiled Rust zero-copy byte scanner that parses RFC 5424 headers in 185,000 events/second per core without the CPU backtracking and memory allocations typical of JVM-based regex engines."
          }
        }
      ]
    },
