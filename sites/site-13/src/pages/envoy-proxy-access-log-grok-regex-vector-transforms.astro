  <script is:inline>
    const flagDescriptions = {
      'UH': 'UH: No Healthy Upstream Host',
      'UF': 'UF: Upstream Connection Failure',
      'UO': 'UO: Upstream Overflow (Circuit Broken)',
      'UT': 'UT: Upstream Request Timeout',
      'DC': 'DC: Downstream Connection Termination',
      'NR': 'NR: No Route Configured',
      '-': 'None: Successful Normal Routing'
    };

    function parseEnvoyUI() {
      const text = document.getElementById('envoy-input').value.trim();
      const regex = /^\[([^\]]+)\]\s+"(\S+)\s+(\S+)\s+(\S+)"\s+(\d+)\s+(\S+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\S+)/;
      const match = text.match(regex);

      if (match) {
        const method = match[2];
        const path = match[3];
        const status = match[5];
        const flags = match[6];
        const duration = match[9];
        const upstreamDur = match[10];

        document.getElementById('dec-route').innerText = `${method} ${path}`;
        document.getElementById('dec-status').innerText = `${status} ${status === '200' ? 'OK' : status === '503' ? 'Service Unavailable' : 'Status'}`;
        document.getElementById('dec-status').className = `text-sm font-bold font-mono mt-1 ${status.startsWith('2') ? 'text-emerald-400' : 'text-rose-400'}`;
        
        document.getElementById('dec-flag').innerText = flagDescriptions[flags] || `Flag: ${flags}`;
        document.getElementById('dec-lat').innerText = `${duration}ms (Upstream: ${upstreamDur}ms)`;
      } else {
        document.getElementById('dec-route').innerText = 'Unmatched';
        document.getElementById('dec-status').innerText = 'Parse Error';
        document.getElementById('dec-flag').innerText = 'Check Log Format';
      }
    }

    document.getElementById('envoy-input')?.addEventListener('input', parseEnvoyUI);

    document.querySelectorAll('.flag-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const flag = e.target.getAttribute('data-flag');
        let current = document.getElementById('envoy-input').value;
        current = current.replace(/\s\d{3}\s(\S+)\s/, ` 503 ${flag} `);
        document.getElementById('envoy-input').value = current;
        parseEnvoyUI();
      });
    });
  </script>
