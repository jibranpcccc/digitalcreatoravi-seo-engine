  <!-- Client-Side Grok Engine Script -->
  <script is:inline>
    const GROK_DICTIONARY = {
      'USERNAME': '[a-zA-Z0-9._-]+',
      'USER': '[a-zA-Z0-9._-]+',
      'INT': '(?:[+-]?(?:[0-9]+))',
      'BASE10NUM': '(?<![0-9.+-])(?>[+-]?(?:(?:[0-9]+(?:\\.[0-9]+)?)|(?:\\.[0-9]+)))',
      'NUMBER': '(?:[+-]?(?:[0-9]+(?:\\.[0-9]+)?))',
      'POSINT': '\\b\\d+\\b',
      'WORD': '\\b\\w+\\b',
      'NOTSPACE': '\\S+',
      'SPACE': '\\s*',
      'DATA': '.*?',
      'GREEDYDATA': '.*',
      'IPV6': '(?:(?:[0-9A-Fa-f]{1,4}:){7}(?:[0-9A-Fa-f]{1,4}|:)|(?:[0-9A-Fa-f]{1,4}:){6}(?:[0-9A-Fa-f]{1,4}|:)|(?:[0-9A-Fa-f]{1,4}:){5}(?::[0-9A-Fa-f]{1,4}|:)|:(?::[0-9A-Fa-f]{1,4}){1,7})',
      'IPV4': '(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)',
      'IP': '(?:(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)|(?:(?:[0-9A-Fa-f]{1,4}:){7}(?:[0-9A-Fa-f]{1,4}|:)))',
      'HOSTNAME': '\\b(?:[0-9A-Za-z][0-9A-Za-z-]{0,62})(?:\\.(?:[0-9A-Za-z][0-9A-Za-z-]{0,62}))*(\\.?|\\b)',
      'IPORHOST': '(?:(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)|\\b(?:[0-9A-Za-z][0-9A-Za-z-]{0,62})(?:\\.(?:[0-9A-Za-z][0-9A-Za-z-]{0,62}))*(\\.?|\\b))',
      'MONTH': '(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sep(?:tember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)',
      'MONTHDAY': '(?:(?:0[1-9])|(?:[12][0-9])|(?:3[01])|[1-9])',
      'YEAR': '(?:\\d\\d){1,2}',
      'HOUR': '(?:2[0123]|[01]?[0-9])',
      'MINUTE': '(?:[0-5][0-9])',
      'SECOND': '(?:(?:[0-5]?[0-9]|60)(?:[:.,][0-9]+)?)',
      'TIME': '(?!^)(?:2[0123]|[01]?[0-9]):(?:[0-5][0-9])(?::(?:(?:[0-5]?[0-9]|60)(?:[:.,][0-9]+)?))',
      'DATE': '(?:\\d{4}-\\d{2}-\\d{2})',
      'HTTPDATE': '(?:(?:0[1-9])|(?:[12][0-9])|(?:3[01])|[1-9])/(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sep(?:tember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)/(?:\\d\\d){1,2}:(?:2[0123]|[01]?[0-9]):(?:[0-5][0-9]):(?:(?:[0-5]?[0-9]|60)(?:[:.,][0-9]+)?) [+-]?[0-9]+',
      'TIMESTAMP_ISO8601': '(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:?[0-9]{2})?)',
      'URIPATH': '(?:/[A-Za-z0-9$.+!*\x27(),~:;=@#%_\\-]*)+',
      'URIPARAM': '\\?[A-Za-z0-9$.+!*\x27(),~:;=@#%_\\-]*',
      'URIPATHPARAM': '(?:/[A-Za-z0-9$.+!*\x27(),~:;=@#%_\\-]*)+(?:\\?[A-Za-z0-9$.+!*\x27(),~:;=@#%_\\-]*)*',
      'LOGLEVEL': '(?:[Aa]lert|ALERT|[Tt]race|TRACE|[Dd]ebug|DEBUG|[Nn]otice|NOTICE|[Ii]nfo|INFO|[Ww]arn?(?:ing)?|WARN?(?:ING)?|[Ee]rr?(?:or)?|ERR?(?:OR)?|[Cc]rit?(?:ical)?|CRIT?(?:ICAL)?|[Ff]atal|FATAL|[Ss]ev(?:ere)?|SEV(?:ERE)?|[Ee]merg(?:ency)?|EMERG(?:ENCY)?)',
      'UUID': '[A-Fa-f0-9]{8}-(?:[A-Fa-f0-9]{4}-){3}[A-Fa-f0-9]{12}'
    };

    const PRESETS = {
      nginx: {
        log: '192.168.1.105 - - [06/Sep/2026:14:22:18 +0000] "GET /api/v2/products/4192 HTTP/1.1" 200 4528 "https://example.com/shop" "Mozilla/5.0 (Windows NT 10.0; Win64; x64)" 0.042',
        grok: '%{IPORHOST:client_ip} %{DATA:ident} %{DATA:auth} \\[%{HTTPDATE:timestamp}\\] "%{WORD:verb} %{URIPATHPARAM:request_path} HTTP/%{NUMBER:http_version}" %{NUMBER:status_code:int} %{NUMBER:bytes_sent:int} "%{DATA:referrer}" "%{DATA:user_agent}" %{NUMBER:duration_ms:float}'
      },
      cloudfront: {
        log: '2026-09-06 14:35:10 SFO53-C1 198.51.100.42 GET d111111abcdef8.cloudfront.net /assets/bundle.js 200 14820 https://example.com Mozilla/5.0 - Hit c4b93b2a-89a1-43ef-b924-f3e4c2560381 cdn.example.com https 14820 0.018 - TLSv1.3 TLS_AES_128_GCM_SHA256 Hit',
        grok: '%{DATE:date} %{TIME:time} %{NOTSPACE:x_edge_location} %{IPORHOST:client_ip} %{WORD:verb} %{NOTSPACE:host} %{URIPATHPARAM:request_path} %{NUMBER:status_code:int} %{NUMBER:bytes_sent:int} %{DATA:referrer} %{DATA:user_agent} %{NOTSPACE:cookie} %{WORD:result_type} %{NOTSPACE:request_id} %{NOTSPACE:host_header} %{NOTSPACE:protocol} %{NUMBER:bytes_received:int} %{NUMBER:duration_ms:float} %{DATA:ssl_protocol} %{DATA:ssl_cipher} %{DATA:response_result_type}'
      },
      docker: {
        log: '{"log":"10.244.3.15 - [06/Sep/2026:14:38:00 +0000] POST /v1/auth/token 201 128 14.2ms\\n","stream":"stdout","time":"2026-09-06T14:38:00.129384729Z","container_id":"9f82ab39c18d","image":"auth-service:v2.4"}',
        grok: '\\{"log":"%{IPORHOST:client_ip} - \\[%{HTTPDATE:timestamp}\\] %{WORD:verb} %{URIPATHPARAM:request_path} %{NUMBER:status_code:int} %{NUMBER:bytes_sent:int} %{NUMBER:duration_ms:float}ms.*'
      },
      syslog: {
        log: '<134>1 2026-09-06T14:40:12.451Z edge-gateway-01 nginx 40912 - [client@192.168.1.84 request="/checkout/pay" status=502 duration=1240] Upstream connection timeout to payment-svc:8080',
        grok: '<%{POSINT:priority}>%{POSINT:version} %{TIMESTAMP_ISO8601:timestamp} %{NOTSPACE:hostname} %{NOTSPACE:app_name} %{POSINT:proc_id} %{NOTSPACE:msg_id} \\[client@%{IPORHOST:client_ip} request="%{URIPATHPARAM:request_path}" status=%{NUMBER:status_code:int} duration=%{NUMBER:duration_ms:float}\\] %{GREEDYDATA:message}'
      }
    };

    const rawLogInput = document.getElementById('rawLogInput');
    const grokPatternInput = document.getElementById('grokPatternInput');
    const btnParse = document.getElementById('btnParse');
    const btnCopyJson = document.getElementById('btnCopyJson');
    const btnCopyRegex = document.getElementById('btnCopyRegex');
    const logLengthBadge = document.getElementById('logLengthBadge');
    const compileStatusBadge = document.getElementById('compileStatusBadge');
    const matchStatusLabel = document.getElementById('matchStatusLabel');
    const execLatency = document.getElementById('execLatency');
    const jsonOutput = document.getElementById('jsonOutput');
    const jsonKeyCount = document.getElementById('jsonKeyCount');
    const compiledRegexOutput = document.getElementById('compiledRegexOutput');

    const valClientIp = document.getElementById('valClientIp');
    const valStatusCode = document.getElementById('valStatusCode');
    const valRequestPath = document.getElementById('valRequestPath');
    const valDurationMs = document.getElementById('valDurationMs');

    let currentCompiledRegexStr = '';
    let currentParsedData = {};

    function compileGrokToRegex(grokPattern) {
      const typeMap = {};
      const grokRegex = /%\{([A-Za-z0-9_]+)(?::([A-Za-z0-9_]+)(?::([A-Za-z0-9_]+))?)?\}/g;

      const compiled = grokPattern.replace(grokRegex, (match, patternName, fieldName, fieldType) => {
        const patternDef = GROK_DICTIONARY[patternName] || '.*?';
        if (fieldName) {
          if (fieldType) {
            typeMap[fieldName] = fieldType;
          }
          return '(?<' + fieldName + '>' + patternDef + ')';
        }
        return '(?:' + patternDef + ')';
      });

      return { regexStr: compiled, typeMap };
    }

    function evaluateLogParser() {
      const startTime = performance.now();
      const rawLog = rawLogInput.value.trim();
      const grokExpr = grokPatternInput.value.trim();

      logLengthBadge.textContent = rawLog.length + ' chars';

      if (!rawLog || !grokExpr) {
        compileStatusBadge.textContent = 'Awaiting Input';
        compileStatusBadge.className = 'inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono font-semibold bg-slate-800 text-slate-400 border border-slate-700';
        return;
      }

      try {
        const { regexStr, typeMap } = compileGrokToRegex(grokExpr);
        currentCompiledRegexStr = regexStr;
        compiledRegexOutput.textContent = regexStr;

        const regex = new RegExp(regexStr);
        compileStatusBadge.textContent = 'Pattern Valid';
        compileStatusBadge.className = 'inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30';

        const match = regex.exec(rawLog);
        const endTime = performance.now();
        const duration = (endTime - startTime).toFixed(2);
        execLatency.textContent = 'Latency: ' + duration + ' ms';

        if (match && match.groups) {
          const parsed = {};
          for (const [k, v] of Object.entries(match.groups)) {
            if (v === undefined) {
              parsed[k] = null;
              continue;
            }
            const cast = typeMap[k];
            if (cast === 'int') {
              parsed[k] = parseInt(v, 10);
            } else if (cast === 'float') {
              parsed[k] = parseFloat(v);
            } else {
              parsed[k] = v;
            }
          }

          currentParsedData = parsed;
          const keyCount = Object.keys(parsed).length;
          jsonKeyCount.textContent = keyCount + ' fields extracted';
          jsonOutput.textContent = JSON.stringify(parsed, null, 2);

          matchStatusLabel.textContent = 'Status: Full Match (' + keyCount + ' keys)';
          matchStatusLabel.className = 'text-emerald-400 font-bold';

          valClientIp.textContent = parsed.client_ip || parsed.host || parsed.ip || '-';
          
          if (parsed.status_code !== undefined) {
            valStatusCode.textContent = parsed.status_code;
            const code = parseInt(parsed.status_code, 10);
            if (code >= 200 && code < 300) {
              valStatusCode.className = 'text-base font-mono font-bold text-emerald-400';
            } else if (code >= 400 && code < 500) {
              valStatusCode.className = 'text-base font-mono font-bold text-amber-400';
            } else if (code >= 500) {
              valStatusCode.className = 'text-base font-mono font-bold text-rose-400';
            } else {
              valStatusCode.className = 'text-base font-mono font-bold text-cyan-400';
            }
          } else {
            valStatusCode.textContent = '-';
            valStatusCode.className = 'text-base font-mono font-bold text-slate-500';
          }

          valRequestPath.textContent = parsed.request_path || parsed.path || parsed.uri || '-';
          
          if (parsed.duration_ms !== undefined) {
            valDurationMs.textContent = parsed.duration_ms + ' ms';
          } else if (parsed.time_taken !== undefined) {
            valDurationMs.textContent = parsed.time_taken + ' s';
          } else {
            valDurationMs.textContent = '-';
          }

        } else {
          matchStatusLabel.textContent = 'Status: No Match (Check Delimiters)';
          matchStatusLabel.className = 'text-rose-400 font-bold';
          jsonOutput.textContent = JSON.stringify({ error: 'Pattern failed to match input line', hint: 'Ensure spaces, quotes, and square brackets are escaped or accounted for.' }, null, 2);
          jsonKeyCount.textContent = '0 fields';
          valClientIp.textContent = '-';
          valStatusCode.textContent = '-';
          valRequestPath.textContent = '-';
          valDurationMs.textContent = '-';
        }

      } catch (err) {
        compileStatusBadge.textContent = 'Compilation Error';
        compileStatusBadge.className = 'inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono font-semibold bg-rose-500/20 text-rose-400 border border-rose-500/30';
        matchStatusLabel.textContent = 'Status: Regex Syntax Error';
        matchStatusLabel.className = 'text-rose-400 font-bold';
        jsonOutput.textContent = JSON.stringify({ error: err.message }, null, 2);
        compiledRegexOutput.textContent = 'Error: ' + err.message;
      }
    }

    function loadPreset(presetKey) {
      const p = PRESETS[presetKey];
      if (!p) return;

      rawLogInput.value = p.log;
      grokPatternInput.value = p.grok;

      document.querySelectorAll('.preset-btn').forEach(btn => {
        if (btn.dataset.preset === presetKey) {
          btn.className = 'preset-btn px-3 py-1.5 text-xs font-medium rounded-lg bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 transition';
        } else {
          btn.className = 'preset-btn px-3 py-1.5 text-xs font-medium rounded-lg bg-slate-800 text-slate-300 border border-slate-700 hover:border-slate-500 transition';
        }
      });

      evaluateLogParser();
    }

    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        loadPreset(btn.dataset.preset);
      });
    });

    rawLogInput.addEventListener('input', evaluateLogParser);
    grokPatternInput.addEventListener('input', evaluateLogParser);
    btnParse.addEventListener('click', evaluateLogParser);

    btnCopyJson.addEventListener('click', () => {
      const text = JSON.stringify(currentParsedData, null, 2);
      navigator.clipboard.writeText(text).then(() => {
        const orig = btnCopyJson.innerHTML;
        btnCopyJson.innerHTML = '<span class="text-emerald-400 font-bold">Copied!</span>';
        setTimeout(() => btnCopyJson.innerHTML = orig, 1800);
      });
    });

    btnCopyRegex.addEventListener('click', () => {
      if (!currentCompiledRegexStr) return;
      navigator.clipboard.writeText(currentCompiledRegexStr).then(() => {
        const orig = btnCopyRegex.innerHTML;
        btnCopyRegex.innerHTML = '<span class="text-emerald-400 font-bold">Copied!</span>';
        setTimeout(() => btnCopyRegex.innerHTML = orig, 1800);
      });
    });

    document.querySelectorAll('.btn-copy-pattern').forEach(btn => {
      btn.addEventListener('click', () => {
        const pattern = btn.dataset.pattern;
        navigator.clipboard.writeText(pattern).then(() => {
          const orig = btn.textContent;
          btn.textContent = 'Copied!';
          btn.classList.add('text-cyan-300');
          setTimeout(() => {
            btn.textContent = orig;
            btn.classList.remove('text-cyan-300');
          }, 1500);
        });
      });
    });

    loadPreset('nginx');
  </script>
</Layout>
