---
import Layout from '../layouts/Layout.astro';

const canonical = "https://groklogtester.pages.dev/cloudflare-logpush-json-schema-grok-pattern-filter/";
const slug = "cloudflare-logpush-json-schema-grok-pattern-filter";
const title = "Cloudflare HTTP Logpush: JSON Regex & ClickHouse Ingestion";
const description = "Complete technical specification for Cloudflare HTTP Logpush. Review JSON schema definitions, high-cardinality edge filters, NDJSON streaming, and production ClickHouse DDL optimizations.";

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "@id": `${canonical}#article`,
      "url": canonical,
      "headline": "Cloudflare HTTP Logpush: JSON Regex Parsing, High-Cardinality Edge Filters & ClickHouse Ingestion",
      "description": "Architectural guide to ingesting, filtering, and analyzing Cloudflare HTTP Logpush streams at petabyte scale using ClickHouse, Vector, and edge filters.",
      "inLanguage": "en-US",
      "author": {
        "@type": "Organization",
        "name": "GrokLogTester Engineering Team",
        "url": "https://groklogtester.pages.dev/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "GrokLogTester",
        "url": "https://groklogtester.pages.dev/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://groklogtester.pages.dev/og-banner.png"
        }
      },
      "datePublished": "2026-03-22T08:00:00Z",
      "dateModified": "2026-10-05T10:00:00Z"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "GrokLogTester",
          "item": "https://groklogtester.pages.dev/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "CDN & Edge Logging",
          "item": "https://groklogtester.pages.dev/#cdn"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Cloudflare Logpush",
          "item": canonical
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does Cloudflare Logpush deliver logs to cloud storage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cloudflare Logpush batches edge HTTP transaction records into compressed GZIP files containing Newline-Delimited JSON (NDJSON) and delivers them within 30 to 60 seconds to Amazon S3, Cloudflare R2, Google Cloud Storage, or Azure Blob storage via IAM role delegation or pre-signed PUT URLs."
          }
        },
        {
          "@type": "Question",
          "name": "How should ClickHouse tables be ordered for Cloudflare Logpush analytics?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For optimal primary key indexing and sparse index skipping in ClickHouse MergeTree tables, order by low-cardinality and high-selectivity filtering dimensions: ORDER BY (ClientRequestHost, EdgeResponseStatus, toDate(EdgeStartTimestamp), EdgeStartTimestamp, ClientIP). This layout allows sub-second aggregation across billions of CDN transactions."
          }
        },
        {
          "@type": "Question",
          "name": "How can teams reduce Cloudflare Logpush storage and egress costs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Teams can apply Cloudflare Logpush Job Filters to drop static asset hits (e.g. image/css/js requests) at the edge, or filter by HTTP status codes (e.g. EdgeResponseStatus >= 400) and security actions (SecurityActions != 'allow'). Filtering at the edge cuts log volume by 60% to 85% before cloud storage egress."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best way to handle BotScore and WAFAction fields?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "BotScore (0-100) should be stored as a UInt8, while WAFAction and SecurityActions should be typed as LowCardinality(String) in ClickHouse to minimize storage memory footprint and maximize columnar vectorized SIMD scan performance."
          }
        }
      ]
    }
  ]
};

const schemaJson = JSON.stringify(schemaData);
