---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Uniswap v3 Concentrated Liquidity & Impermanent Loss Math Guide | GreekVisualizer";
const pageDescription = "Comprehensive quantitative guide to Uniswap v3 concentrated liquidity: mathematical derivations of virtual reserves, tick math, divergence loss equations, and capital efficiency multipliers.";
const canonical = "https://site-19-nine.vercel.app/uniswap-v3-concentrated-liquidity-impermanent-loss-calculator/";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "headline": "Uniswap v3 Concentrated Liquidity & Impermanent Loss Math Guide",
      "description": "Analytical breakdown of Uniswap v3 concentrated liquidity curves, virtual reserves geometry, tick math, and impermanent loss equations.",
      "url": canonical,
      "datePublished": "2026-09-06",
      "dateModified": "2026-09-06",
      "author": {
        "@type": "Organization",
        "name": "GreekVisualizer Research"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does Uniswap v3 virtual reserve math work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Uniswap v3 translates the constant product curve (x * y = k) by offsetting real reserves with virtual reserves. This ensures the curve intersects the axes at finite prices P_a and P_b, allowing all capital to be fully utilized inside that range."
          }
        },
        {
          "@type": "Question",
          "name": "What is the formula for Uniswap v3 capital efficiency?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a symmetrical range centered around the current price, the capital efficiency multiplier compared to Uniswap v2 is given by 1 / (1 - (P_a / P_b)^0.25) or approximately 1 / (1 - sqrt(P_a / P_b)). A +/- 10% range achieves over 20x capital efficiency."
          }
        },
        {
          "@type": "Question",
          "name": "When does impermanent loss become permanent on Uniswap v3?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Impermanent loss becomes locked in (permanent) when the liquidity provider withdraws their position while the asset price remains diverged from the initial entry price, or when the price breaches the range and never reverts."
          }
        }
      ]
    }
  ]
});
