<pre is:raw class="bg-[#070B12] border border-slate-800 p-4 rounded-b-lg overflow-x-auto text-slate-200 font-mono text-xs leading-relaxed">
import math

def calculate_v3_impermanent_loss(p0: float, p1: float, pa: float, pb: float):
    # Computes Uniswap v3 Impermanent Loss for initial price p0, final price p1,
    # and range boundaries [pa, pb].
    sqrt_p0 = math.sqrt(p0)
    sqrt_pa = math.sqrt(pa)
    sqrt_pb = math.sqrt(pb)
    
    # Normalized real reserves for L = 1 at entry price p0
    x0 = (1.0 / sqrt_p0) - (1.0 / sqrt_pb)
    y0 = sqrt_p0 - sqrt_pa
    v_hold = x0 * p1 + y0
    
    # Value of LP position at p1
    if p1 &lt;= pa:
        # 100% token X
        x1 = (1.0 / sqrt_pa) - (1.0 / sqrt_pb)
        v_lp = x1 * p1
    elif p1 &gt;= pb:
        # 100% token Y
        y1 = sqrt_pb - sqrt_pa
        v_lp = y1
    else:
        # Inside active tick range
        sqrt_p1 = math.sqrt(p1)
        x1 = (1.0 / sqrt_p1) - (1.0 / sqrt_pb)
        y1 = sqrt_p1 - sqrt_pa
        v_lp = x1 * p1 + y1
        
    il_percentage = (v_lp - v_hold) / v_hold
    return il_percentage, v_lp, v_hold

def days_to_breakeven(il_pct: float, daily_volume: float, fee_tier: float, 
                      pool_tvl: float, capital: float):
    # Calculates operational trading days needed for fee income to offset IL.
    pool_daily_fees = daily_volume * fee_tier
    position_share = capital / pool_tvl
    my_daily_fee = pool_daily_fees * position_share
    
    dollar_il = abs(il_pct) * capital
    days = dollar_il / my_daily_fee if my_daily_fee &gt; 0 else float('inf')
    annual_fee_apr = (my_daily_fee * 365.0) / capital
    return days, annual_fee_apr

if __name__ == "__main__":
    P_ENTRY = 3000.0  # ETH price
    P_EXIT = 3600.0   # +20% price divergence
    P_LOW = 2400.0    # -20% lower tick
    P_HIGH = 3750.0   # +25% upper tick
    
    il_pct, v_lp, v_hold = calculate_v3_impermanent_loss(P_ENTRY, P_EXIT, P_LOW, P_HIGH)
    print(f"Uniswap v3 IL for +20% divergence: {il_pct * 100:.3f}%")
    
    # Compare 0.05% vs 0.30% fee tiers at $20M daily volume
    CAPITAL = 100000.0
    POOL_TVL = 20000000.0
    VOLUME = 20000000.0
    
    days_5bp, apr_5bp = days_to_breakeven(il_pct, VOLUME, 0.0005, POOL_TVL, CAPITAL)
    days_30bp, apr_30bp = days_to_breakeven(il_pct, VOLUME, 0.0030, POOL_TVL, CAPITAL)
    
    print(f"0.05% Tier: APR = {apr_5bp * 100:.2f}%, Breakeven = {days_5bp:.1f} days")
    print(f"0.30% Tier: APR = {apr_30bp * 100:.2f}%, Breakeven = {days_30bp:.1f} days")
