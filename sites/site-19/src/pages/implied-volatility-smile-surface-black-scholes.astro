import numpy as np
from scipy.stats import norm
from scipy.optimize import brentq, newton
from scipy.interpolate import griddata

class BlackScholesEngine:
    @staticmethod
    def call_price(S: float, K: float, T: float, r: float, sigma: float) -> float:
        """Computes European call price under standard BSM."""
        if T &lt;= 0.0 or sigma &lt;= 0.0:
            return max(0.0, S - K)
        d1 = (np.log(S / K) + (r + 0.5 * sigma ** 2) * T) / (sigma * np.sqrt(T))
        d2 = d1 - sigma * np.sqrt(T)
        return S * norm.cdf(d1) - K * np.exp(-r * T) * norm.cdf(d2)

    @staticmethod
    def vega(S: float, K: float, T: float, r: float, sigma: float) -> float:
        """Computes analytical first derivative w.r.t volatility (Vega)."""
        if T &lt;= 0.0 or sigma &lt;= 0.0:
            return 0.0
        d1 = (np.log(S / K) + (r + 0.5 * sigma ** 2) * T) / (sigma * np.sqrt(T))
        return S * np.sqrt(T) * norm.pdf(d1)

    @classmethod
    def implied_volatility(cls, price: float, S: float, K: float, T: float, r: float, 
                           method: str = "brentq") -> float:
        """
        Inverts Black-Scholes formula to calculate implied volatility.
        Enforces no-arbitrage intrinsic lower and upper bounds.
        """
        intrinsic = max(0.0, S - K * np.exp(-r * T))
        if price &lt;= intrinsic or price &gt;= S:
            return np.nan

        # Objective function: model_price - market_price = 0
        def objective(sigma):
            return cls.call_price(S, K, T, r, sigma) - price

        if method == "newton":
            # Fast quadratic convergence with analytical derivative
            try:
                def vega_fn(sigma):
                    return cls.vega(S, K, T, r, sigma)
                return float(newton(objective, x0=0.25, fprime=vega_fn, maxiter=50, tol=1e-6))
            except (RuntimeError, OverflowError):
                pass # Fallback to brentq on divergence

        # Brent's Method: Guaranteed convergence within bounded bracket
        try:
            return float(brentq(objective, a=1e-4, b=5.0, xtol=1e-7, maxiter=100))
        except (ValueError, RuntimeError):
            return np.nan

def generate_synthetic_market_surface():
    """Generates synthetic option market data exhibiting realistic equity skew."""
    S = 100.0   # Spot underlying
    r = 0.045   # 4.5% Risk-free rate
    strikes = np.linspace(70, 130, 13)
    tenors = np.array([30/365, 60/365, 90/365, 180/365, 360/365])

    market_quotes = []

    for T in tenors:
        for K in strikes:
            log_moneyness = np.log(K / S)
            # Parametric true volatility with skew and term structure
            true_vol = 0.20 - 0.15 * log_moneyness + 0.08 * (log_moneyness ** 2) + 0.03 * np.sqrt(T)
            premium = BlackScholesEngine.call_price(S, K, T, r, true_vol)
            market_quotes.append({
                "strike": K,
                "tenor": T,
                "price": premium,
                "log_moneyness": log_moneyness
            })
    return S, r, market_quotes

def calibrate_surface(quotes, S, r):
    """Recovers implied volatility for all market quotes and builds 2D surface grid."""
    recovered_points = []
    
    for q in quotes:
        iv = BlackScholesEngine.implied_volatility(
            price=q["price"], S=S, K=q["strike"], T=q["tenor"], r=r, method="brentq"
        )
        if not np.isnan(iv):
            recovered_points.append((q["strike"], q["tenor"], iv))

    strikes, tenors, ivs = zip(*recovered_points)
    
    # Dense interpolation grid
    grid_k = np.linspace(min(strikes), max(strikes), 50)
    grid_t = np.linspace(min(tenors), max(tenors), 50)
    mesh_k, mesh_t = np.meshgrid(grid_k, grid_t)

    # 2D Cubic Spline Griddata Interpolation
    surface_iv = griddata(
        points=(strikes, tenors),
        values=ivs,
        xi=(mesh_k, mesh_t),
        method="cubic"
    )

    print(f"[SUCCESS] Calibrated {len(recovered_points)} market points.")
    print(f"Surface Min IV: {np.nanmin(surface_iv):.4f} | Max IV: {np.nanmax(surface_iv):.4f}")
    return mesh_k, mesh_t, surface_iv

if __name__ == "__main__":
    spot, rate, quotes = generate_synthetic_market_surface()
    mesh_k, mesh_t, surf = calibrate_surface(quotes, spot, rate)
          </pre>
