    // Mathematical Normal Distribution Utilities
    function standardNormalCDF(x) {
      const a1 =  0.254829592;
      const a2 = -0.284496736;
      const a3 =  1.421413741;
      const a4 = -1.453152027;
      const a5 =  1.061405429;
      const p  =  0.3275911;

      const sign = x < 0 ? -1 : 1;
      const absX = Math.abs(x) / Math.sqrt(2.0);

      const t = 1.0 / (1.0 + p * absX);
      const erf = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * Math.exp(-absX * absX);

      return 0.5 * (1.0 + sign * erf);
    }

    function standardNormalPDF(x) {
      return (1.0 / Math.sqrt(2 * Math.PI)) * Math.exp(-0.5 * x * x);
    }

    // Black-Scholes Greeks Calculation Engine
    function calculateBSM() {
      const S = parseFloat(document.getElementById('bsm-s').value) || 100;
      const K = parseFloat(document.getElementById('bsm-k').value) || 100;
      const D = parseFloat(document.getElementById('bsm-d').value) || 30;
      const volPct = parseFloat(document.getElementById('bsm-v').value) || 30;
      const ratePct = parseFloat(document.getElementById('bsm-r').value) || 4.5;

      const T = Math.max(D / 365.0, 0.0001);
      const sigma = Math.max(volPct / 100.0, 0.001);
      const r = ratePct / 100.0;

      const sqrtT = Math.sqrt(T);
      const d1 = (Math.log(S / K) + (r + 0.5 * sigma * sigma) * T) / (sigma * sqrtT);
      const d2 = d1 - sigma * sqrtT;

      const Nd1 = standardNormalCDF(d1);
      const Nd2 = standardNormalCDF(d2);
      const N_neg_d1 = standardNormalCDF(-d1);
      const N_neg_d2 = standardNormalCDF(-d2);
      const phi_d1 = standardNormalPDF(d1);

      const exp_rT = Math.exp(-r * T);

      // Prices
      const callPrice = S * Nd1 - K * exp_rT * Nd2;
      const putPrice = K * exp_rT * N_neg_d2 - S * N_neg_d1;

      // Greeks
      const callDelta = Nd1;
      const putDelta = Nd1 - 1.0;
      const gamma = phi_d1 / (S * sigma * sqrtT);
      const vega = (S * sqrtT * phi_d1) / 100.0; // per 1% change

      // Theta per day
      const callThetaAnnual = - (S * phi_d1 * sigma) / (2 * sqrtT) - r * K * exp_rT * Nd2;
      const putThetaAnnual  = - (S * phi_d1 * sigma) / (2 * sqrtT) + r * K * exp_rT * N_neg_d2;
      const callTheta = callThetaAnnual / 365.0;
      const putTheta  = putThetaAnnual / 365.0;

      // Rho per 1% change
      const callRho = (K * T * exp_rT * Nd2) / 100.0;
      const putRho  = (-K * T * exp_rT * N_neg_d2) / 100.0;

      // Intrinsics
      const callIntrinsic = Math.max(0, S - K);
      const callExtrinsic = Math.max(0, callPrice - callIntrinsic);
      const putIntrinsic = Math.max(0, K - S);
      const putExtrinsic = Math.max(0, putPrice - putIntrinsic);

      // UI Update
      document.getElementById('disp-s').innerText = '$' + S.toFixed(2);
      document.getElementById('disp-k').innerText = '$' + K.toFixed(2);
      document.getElementById('disp-d').innerText = D + ' days';
      document.getElementById('disp-v').innerText = volPct.toFixed(1) + '%';
      document.getElementById('disp-r').innerText = ratePct.toFixed(2) + '%';

      document.getElementById('out-call-price').innerText = '$' + Math.max(0, callPrice).toFixed(2);
      document.getElementById('out-put-price').innerText = '$' + Math.max(0, putPrice).toFixed(2);

      document.getElementById('out-call-intrinsic').innerText = '$' + callIntrinsic.toFixed(2);
      document.getElementById('out-call-extrinsic').innerText = '$' + callExtrinsic.toFixed(2);
      document.getElementById('out-put-intrinsic').innerText = '$' + putIntrinsic.toFixed(2);
      document.getElementById('out-put-extrinsic').innerText = '$' + putExtrinsic.toFixed(2);

      document.getElementById('out-call-delta').innerText = (callDelta >= 0 ? '+' : '') + callDelta.toFixed(4);
      document.getElementById('out-put-delta').innerText = putDelta.toFixed(4);

      document.getElementById('out-gamma').innerText = gamma.toFixed(4);
      document.getElementById('out-gamma-exp').innerText = '+' + gamma.toFixed(4);

      document.getElementById('out-call-theta').innerText = (callTheta >= 0 ? '+$' : '-$') + Math.abs(callTheta).toFixed(4);
      document.getElementById('out-put-theta').innerText  = (putTheta >= 0 ? '+$' : '-$') + Math.abs(putTheta).toFixed(4);

      document.getElementById('out-vega').innerText = (vega >= 0 ? '+$' : '-$') + Math.abs(vega).toFixed(4);
      document.getElementById('out-call-rho').innerText = (callRho >= 0 ? '+$' : '-$') + Math.abs(callRho).toFixed(4);
      document.getElementById('out-put-rho').innerText  = (putRho >= 0 ? '+$' : '-$') + Math.abs(putRho).toFixed(4);

      // Delta visual bars
      const putWidth = Math.abs(putDelta) * 50;
      const callWidth = Math.abs(callDelta) * 50;
      document.getElementById('bar-put-delta').style.width = putWidth.toFixed(1) + '%';
      document.getElementById('bar-call-delta').style.width = callWidth.toFixed(1) + '%';

      // Moneyness indicators
      const moneynessRatio = S / K;
      const callBadge = document.getElementById('bsm-call-moneyness');
      const putBadge = document.getElementById('bsm-put-moneyness');

      if (moneynessRatio > 1.03) {
        callBadge.innerText = 'ITM';
        callBadge.className = 'text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold';
        putBadge.innerText = 'OTM';
        putBadge.className = 'text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700 font-bold';
      } else if (moneynessRatio < 0.97) {
        callBadge.innerText = 'OTM';
        callBadge.className = 'text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700 font-bold';
        putBadge.innerText = 'ITM';
        putBadge.className = 'text-[10px] font-mono px-2 py-0.5 rounded bg-rose-500/20 text-rose-300 border border-rose-500/30 font-bold';
      } else {
        callBadge.innerText = 'ATM';
        callBadge.className = 'text-[10px] font-mono px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 font-bold';
        putBadge.innerText = 'ATM';
        putBadge.className = 'text-[10px] font-mono px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 font-bold';
      }
    }

    function syncBSM(field, val) {
      if (field === 's') {
        document.getElementById('bsm-s').value = val;
        document.getElementById('bsm-s-range').value = val;
      } else if (field === 'k') {
        document.getElementById('bsm-k').value = val;
        document.getElementById('bsm-k-range').value = val;
      } else if (field === 'd') {
        document.getElementById('bsm-d').value = val;
        document.getElementById('bsm-d-range').value = val;
      } else if (field === 'v') {
        document.getElementById('bsm-v').value = val;
        document.getElementById('bsm-v-range').value = val;
      } else if (field === 'r') {
        document.getElementById('bsm-r').value = val;
        document.getElementById('bsm-r-range').value = val;
      }
      calculateBSM();
    }

    function resetBSMDefaults() {
      syncBSM('s', 100);
      syncBSM('k', 100);
      syncBSM('d', 30);
      syncBSM('v', 30);
      syncBSM('r', 4.5);
    }

    // Uniswap v3 Concentrated Liquidity IL Engine
    function syncV3() {
      const P0 = parseFloat(document.getElementById('v3-p0').value) || 2000;
      let Pa = parseFloat(document.getElementById('v3-pa').value) || 1600;
      let Pb = parseFloat(document.getElementById('v3-pb').value) || 2500;

      // Guarantee Pa < Pb
      if (Pa >= Pb) {
        Pa = Pb * 0.8;
        document.getElementById('v3-pa').value = Pa.toFixed(0);
      }

      const priceChangePct = parseFloat(document.getElementById('v3-change').value) || 0;
      const P1 = P0 * (1 + priceChangePct / 100.0);
      const feeAPY = parseFloat(document.getElementById('v3-fee-apy').value) || 0;
      const days = parseFloat(document.getElementById('v3-days').value) || 30;

      // Labels
      document.getElementById('disp-v3-p0').innerText = '$' + P0.toLocaleString();
      const paPct = ((Pa - P0) / P0) * 100;
      const pbPct = ((Pb - P0) / P0) * 100;
      document.getElementById('disp-v3-pa').innerText = '$' + Pa.toLocaleString() + ' (' + (paPct >= 0 ? '+' : '') + paPct.toFixed(1) + '%)';
      document.getElementById('disp-v3-pb').innerText = '$' + Pb.toLocaleString() + ' (' + (pbPct >= 0 ? '+' : '') + pbPct.toFixed(1) + '%)';
      document.getElementById('disp-v3-change').innerText = (priceChangePct >= 0 ? '+' : '') + priceChangePct.toFixed(1) + '%';
      document.getElementById('disp-v3-p1').innerText = '$' + P1.toFixed(2);

      document.getElementById('lbl-pa').innerText = '$' + Pa.toLocaleString();
      document.getElementById('lbl-pb').innerText = '$' + Pb.toLocaleString();
      document.getElementById('lbl-p1').innerText = '$' + P1.toFixed(0);

      // Status check
      const statusBadge = document.getElementById('disp-v3-range-status');
      const activeTag = document.getElementById('v3-active-tag');
      if (P1 < Pa) {
        statusBadge.innerText = 'OUT OF RANGE (100% Asset X)';
        statusBadge.className = 'text-rose-400 font-bold';
        activeTag.innerText = 'Exited Range: 100% Asset X';
        activeTag.className = 'text-[10px] px-2 py-0.5 rounded bg-rose-500/20 text-rose-400 border border-rose-500/30';
      } else if (P1 > Pb) {
        statusBadge.innerText = 'OUT OF RANGE (100% Asset Y)';
        statusBadge.className = 'text-cyan-400 font-bold';
        activeTag.innerText = 'Exited Range: 100% Asset Y';
        activeTag.className = 'text-[10px] px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-400 border border-cyan-500/30';
      } else {
        statusBadge.innerText = 'ACTIVE IN RANGE';
        statusBadge.className = 'text-emerald-400 font-bold';
        activeTag.innerText = 'Active Earning Trading Fees';
        activeTag.className = 'text-[10px] px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/30';
      }

      // Mathematical derivation of V3 LP Value
      // Normalized liquidity L = 1.0 for proportional calculation
      const L = 1.0;
      const sqrtP0 = Math.sqrt(P0);
      const sqrtPa = Math.sqrt(Pa);
      const sqrtPb = Math.sqrt(Pb);

      // Initial asset balances deposited at P0 (denominated in asset X and asset Y)
      let x0 = 0;
      let y0 = 0;
      if (P0 < Pa) {
        x0 = L * (1 / sqrtPa - 1 / sqrtPb);
        y0 = 0;
      } else if (P0 > Pb) {
        x0 = 0;
        y0 = L * (sqrtPb - sqrtPa);
      } else {
        x0 = L * (1 / sqrtP0 - 1 / sqrtPb);
        y0 = L * (sqrtP0 - sqrtPa);
      }
      const initialValue = x0 * P0 + y0;

      // Value of position at P1
      const sqrtP1 = Math.sqrt(P1);
      let x1 = 0;
      let y1 = 0;
      if (P1 < Pa) {
        x1 = L * (1 / sqrtPa - 1 / sqrtPb);
        y1 = 0;
      } else if (P1 > Pb) {
        x1 = 0;
        y1 = L * (sqrtPb - sqrtPa);
      } else {
        x1 = L * (1 / sqrtP1 - 1 / sqrtPb);
        y1 = L * (sqrtP1 - sqrtPa);
      }
      const v3PoolValue = x1 * P1 + y1;

      // HODL benchmark value of the initially deposited assets evaluated at P1
      const hodlValue = x0 * P1 + y0;

      // Uniswap v3 Impermanent Loss
      const v3IL = hodlValue > 0 ? (v3PoolValue - hodlValue) / hodlValue : 0;

      // Uniswap v2 Full Range IL comparison
      const k = P1 / P0;
      const v2IL = (2 * Math.sqrt(k)) / (1 + k) - 1.0;

      // Capital efficiency multiplier: approx 1 / (1 - sqrt(Pa / Pb))
      const efficiency = 1 / (1 - Math.sqrt(Pa / Pb));

      // Fee return over period
      // Note: Concentrated efficiency multiplies fee capture
      const feePeriodFraction = days / 365.0;
      const effectiveFeeAPY = feeAPY;
      const feeReturnPct = effectiveFeeAPY * feePeriodFraction;

      // Net Return vs HODL: (1 + v3IL) * (1 + feeReturnPct/100) - 1
      const netReturnVsHodl = (1 + v3IL) * (1 + feeReturnPct / 100.0) - 1.0;

      // Update UI displays
      document.getElementById('out-v3-il').innerText = (v3IL * 100).toFixed(2) + '%';
      document.getElementById('out-v2-il').innerText = (v2IL * 100).toFixed(2) + '%';
      document.getElementById('out-v3-eff').innerText = efficiency.toFixed(2) + 'x';
      document.getElementById('out-v3-net-roi').innerText = (netReturnVsHodl >= 0 ? '+' : '') + (netReturnVsHodl * 100).toFixed(2) + '%';
      document.getElementById('out-v3-fee-return').innerText = '+' + feeReturnPct.toFixed(2) + '%';

      // Table dollar calculations for a $10,000 baseline investment
      const baseUSD = 10000;
      const terminalHODLUSD = baseUSD * (hodlValue / initialValue);
      const terminalV3PoolUSD = baseUSD * (v3PoolValue / initialValue);
      const feesEarnedUSD = terminalV3PoolUSD * (feeReturnPct / 100.0);
      const terminalV3TotalUSD = terminalV3PoolUSD + feesEarnedUSD;

      const v2PoolRatio = (2 * Math.sqrt(k)) / (1 + k);
      const terminalV2USD = baseUSD * (0.5 * k + 0.5) * v2PoolRatio;

      const v3DiffUSD = terminalV3TotalUSD - terminalHODLUSD;
      const v2DiffUSD = terminalV2USD - terminalHODLUSD;

      document.getElementById('tbl-v3-val').innerText = '$' + Math.round(terminalV3TotalUSD).toLocaleString();
      document.getElementById('tbl-v3-diff').innerText = (v3DiffUSD >= 0 ? '+$' : '-$') + Math.round(Math.abs(v3DiffUSD)).toLocaleString() + ' (' + (netReturnVsHodl >= 0 ? '+' : '') + (netReturnVsHodl * 100).toFixed(2) + '%)';
      const totV3Roi = ((terminalV3TotalUSD - baseUSD) / baseUSD) * 100;
      document.getElementById('tbl-v3-tot').innerText = (totV3Roi >= 0 ? '+' : '') + totV3Roi.toFixed(2) + '%';

      document.getElementById('tbl-hodl-val').innerText = '$' + Math.round(terminalHODLUSD).toLocaleString();

      document.getElementById('tbl-v2-val').innerText = '$' + Math.round(terminalV2USD).toLocaleString();
      document.getElementById('tbl-v2-diff').innerText = (v2DiffUSD >= 0 ? '+$' : '-$') + Math.round(Math.abs(v2DiffUSD)).toLocaleString() + ' (' + (v2IL * 100).toFixed(2) + '%)';
    }

    function resetV3Defaults() {
      document.getElementById('v3-p0').value = 2000;
      document.getElementById('v3-pa').value = 1600;
      document.getElementById('v3-pa-range').value = 1600;
      document.getElementById('v3-pb').value = 2500;
      document.getElementById('v3-pb-range').value = 2500;
      document.getElementById('v3-change').value = 15;
      document.getElementById('v3-fee-apy').value = 28;
      document.getElementById('v3-days').value = 30;
      syncV3();
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', () => {
      calculateBSM();
      syncV3();
    });
  </script>
</Layout>
