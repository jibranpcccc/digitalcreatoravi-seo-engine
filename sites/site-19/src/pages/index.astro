---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Options Greeks & DeFi Impermanent Loss Visualizer";
const pageDescription = "Institutional-grade financial math visualizer: calculate Black-Scholes option pricing, first and second order Greeks (Delta, Gamma, Vega, Theta, Rho), and Uniswap v3 concentrated liquidity impermanent loss.";
const canonical = "https://site-19-nine.vercel.app/";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "GreekVisualizer Financial Math Engine",
      "url": "https://site-19-nine.vercel.app/",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "Real-time Black-Scholes analytical option Greeks calculator and Uniswap v3 concentrated liquidity impermanent loss modeling tool."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What are Options Greeks in the Black-Scholes-Merton model?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Options Greeks are partial derivatives of the theoretical option price with respect to underlying parameters. Delta measures price sensitivity to underlying asset movements, Gamma measures Delta sensitivity, Vega measures volatility impact, Theta quantifies temporal decay, and Rho reflects sensitivity to the risk-free interest rate."
          }
        },
        {
          "@type": "Question",
          "name": "Why is Uniswap v3 impermanent loss higher than Uniswap v2?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Uniswap v3 concentrates liquidity within a bounded price interval [P_a, P_b] rather than [0, infinity]. While this yields significant capital efficiency and higher fee capture, it amplifies price divergence within the interval, creating steeper impermanent loss curves equivalent to selling leveraged out-of-the-money options."
          }
        },
        {
          "@type": "Question",
          "name": "How does Gamma Scalping monetize long volatility?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Gamma scalping involves holding a long gamma position (e.g., long straddle) and dynamically adjusting underlying hedge contracts whenever the asset moves. Rebalancing locks in cash flow from buying low and selling high, which compensates for ongoing negative theta decay."
          }
        },
        {
          "@type": "Question",
          "name": "What is the mathematical link between Uniswap v3 LPs and short options?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Providing liquidity on Uniswap v3 between prices P_a and P_b produces a payoff curve virtually identical to a short put option (or covered call). The LP receives continuous trading fees (resembling premium decay) while taking downside asset risk and capping upside appreciation."
          }
        }
      ]
    }
  ]
});
---

<Layout title={pageTitle} description={pageDescription} canonical={canonical} schemaJson={schema}>
  <!-- Hero Section with exactly ONE H1 tag -->
  <section class="text-center max-w-4xl mx-auto pt-6 pb-10">
    <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono mb-6">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>INSTITUTIONAL QUANTITATIVE ENGINE • BSM &amp; V3 AMM</span>
    </div>

    <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight sm:leading-tight mb-6">
      Black-Scholes Options Greeks &amp; DeFi Impermanent Loss Visualizer
    </h1>

    <p class="text-base sm:text-lg text-slate-300 max-w-3xl mx-auto leading-relaxed mb-8">
      Analytical partial differential equations meet automated market maker geometry. Model volatility surfaces, second-order convexity, and concentrated divergence loss in real time.
    </p>

    <!-- 45-60 Word Featured Snippet Quick Answer Box with Green Accent Border -->
    <div class="border-l-4 border-emerald-500 bg-[#0B1324]/90 rounded-r-xl p-5 sm:p-6 text-left shadow-xl shadow-emerald-500/5 my-8 max-w-3xl mx-auto">
      <div class="flex items-center space-x-2 text-emerald-400 font-mono text-xs font-bold uppercase tracking-wider mb-2">
        <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        <span>Quick Answer: Quantitative Derivatives &amp; AMM Mechanics</span>
      </div>
      <p class="text-sm sm:text-base text-slate-200 leading-relaxed font-sans">
        Options Greeks measure derivative price sensitivities using Black-Scholes partial differential equations, quantifying directional delta, convexity gamma, volatility vega, and temporal theta decay. Simultaneously, Uniswap v3 concentrated liquidity creates synthetic options exposure where liquidity providers incur non-linear impermanent loss when asset ratios diverge across custom price boundaries compared to constant holding.
      </p>
    </div>
  </section>

  <!-- Interactive Dual-Tab Calculator Section -->
  <section id="calculator" class="max-w-5xl mx-auto mb-20 scroll-mt-20">
    <div class="bg-[#0C1222] border border-slate-800 rounded-2xl p-4 sm:p-8 shadow-2xl relative overflow-hidden">
      <!-- Glow ambient -->
      <div class="absolute -top-24 -right-24 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Tab Navigation -->
      <div class="flex flex-wrap border-b border-slate-800 pb-4 mb-8 gap-3 items-center justify-between">
        <div class="flex space-x-2 p-1 bg-slate-900/80 rounded-xl border border-slate-800">
          <button
            id="tab-bsm-btn"
            class="px-4 sm:px-6 py-2.5 rounded-lg text-xs sm:text-sm font-bold transition flex items-center space-x-2 bg-emerald-500 text-slate-950 shadow-md shadow-emerald-500/20"
            onclick="switchTab('bsm')"
          >
            <span class="font-mono text-base">&Delta;</span>
            <span>Black-Scholes Options Greeks</span>
          </button>
          <button
            id="tab-v3-btn"
            class="px-4 sm:px-6 py-2.5 rounded-lg text-xs sm:text-sm font-semibold transition flex items-center space-x-2 text-slate-400 hover:text-white hover:bg-slate-800/60"
            onclick="switchTab('v3')"
          >
            <span class="font-mono text-base">&Sigma;</span>
            <span>Uniswap v3 Impermanent Loss</span>
          </button>
        </div>
        <span class="text-xs font-mono text-slate-400 bg-slate-900/80 px-3 py-1.5 rounded-lg border border-slate-800 hidden sm:inline-block">
          Dynamic Float Precision: 6 Digits
        </span>
      </div>

      <!-- TAB 1: Black-Scholes Greeks Calculator -->
      <div id="tab-bsm" class="block">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
          <!-- Inputs Column (5 cols) -->
          <div class="lg:col-span-5 space-y-5 bg-[#080E1C] p-5 sm:p-6 rounded-xl border border-slate-800/80">
            <h2 class="text-sm font-bold uppercase tracking-wider text-slate-300 font-mono flex items-center justify-between">
              <span>BSM Model Parameters</span>
              <button onclick="resetBSMDefaults()" class="text-[11px] text-emerald-400 hover:underline">Reset Defaults</button>
            </h2>

            <!-- Spot Price (S) -->
            <div>
              <div class="flex justify-between text-xs mb-1.5">
                <label for="bsm-s" class="font-medium text-slate-300">Spot Price ($S)</label>
                <span class="font-mono text-emerald-400 font-bold" id="disp-s">$100.00</span>
              </div>
              <input type="range" id="bsm-s-range" min="10" max="1000" step="1" value="100" class="w-full accent-emerald-500 cursor-pointer mb-2" oninput="syncBSM('s', this.value)" />
              <div class="relative">
                <span class="absolute inset-y-0 left-3 flex items-center text-slate-500 text-xs">$</span>
                <input type="number" id="bsm-s" value="100" min="1" step="0.5" class="w-full bg-slate-950 border border-slate-800 rounded-lg pl-7 pr-3 py-1.5 text-xs font-mono text-white focus:border-emerald-500 focus:outline-none" oninput="syncBSM('s', this.value)" />
              </div>
            </div>

            <!-- Strike Price (K) -->
            <div>
              <div class="flex justify-between text-xs mb-1.5">
                <label for="bsm-k" class="font-medium text-slate-300">Strike Price ($K)</label>
                <span class="font-mono text-emerald-400 font-bold" id="disp-k">$100.00</span>
              </div>
              <input type="range" id="bsm-k-range" min="10" max="1000" step="1" value="100" class="w-full accent-emerald-500 cursor-pointer mb-2" oninput="syncBSM('k', this.value)" />
              <div class="relative">
                <span class="absolute inset-y-0 left-3 flex items-center text-slate-500 text-xs">$</span>
                <input type="number" id="bsm-k" value="100" min="1" step="0.5" class="w-full bg-slate-950 border border-slate-800 rounded-lg pl-7 pr-3 py-1.5 text-xs font-mono text-white focus:border-emerald-500 focus:outline-none" oninput="syncBSM('k', this.value)" />
              </div>
            </div>

            <!-- Days to Expiry (D) -->
            <div>
              <div class="flex justify-between text-xs mb-1.5">
                <label for="bsm-d" class="font-medium text-slate-300">Days to Expiration (D)</label>
                <span class="font-mono text-cyan-400 font-bold" id="disp-d">30 days</span>
              </div>
              <input type="range" id="bsm-d-range" min="1" max="365" step="1" value="30" class="w-full accent-cyan-500 cursor-pointer mb-2" oninput="syncBSM('d', this.value)" />
              <input type="number" id="bsm-d" value="30" min="1" max="1000" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs font-mono text-white focus:border-cyan-500 focus:outline-none" oninput="syncBSM('d', this.value)" />
            </div>

            <!-- Implied Volatility (sigma) -->
            <div>
              <div class="flex justify-between text-xs mb-1.5">
                <label for="bsm-v" class="font-medium text-slate-300">Implied Volatility (&sigma; %)</label>
                <span class="font-mono text-indigo-400 font-bold" id="disp-v">30.0%</span>
              </div>
              <input type="range" id="bsm-v-range" min="5" max="200" step="1" value="30" class="w-full accent-indigo-500 cursor-pointer mb-2" oninput="syncBSM('v', this.value)" />
              <div class="relative">
                <input type="number" id="bsm-v" value="30" min="0.1" max="500" step="0.5" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs font-mono text-white focus:border-indigo-500 focus:outline-none" oninput="syncBSM('v', this.value)" />
                <span class="absolute inset-y-0 right-3 flex items-center text-slate-500 text-xs">%</span>
              </div>
            </div>

            <!-- Risk-Free Rate (r) -->
            <div>
              <div class="flex justify-between text-xs mb-1.5">
                <label for="bsm-r" class="font-medium text-slate-300">Risk-Free Rate (r %)</label>
                <span class="font-mono text-amber-400 font-bold" id="disp-r">4.50%</span>
              </div>
              <input type="range" id="bsm-r-range" min="0" max="15" step="0.25" value="4.5" class="w-full accent-amber-500 cursor-pointer mb-2" oninput="syncBSM('r', this.value)" />
              <div class="relative">
                <input type="number" id="bsm-r" value="4.5" min="0" max="50" step="0.1" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs font-mono text-white focus:border-amber-500 focus:outline-none" oninput="syncBSM('r', this.value)" />
                <span class="absolute inset-y-0 right-3 flex items-center text-slate-500 text-xs">%</span>
              </div>
            </div>
          </div>

          <!-- Outputs Column (7 cols) -->
          <div class="lg:col-span-7 space-y-6">
            <!-- Moneyness & Prices Banner -->
            <div class="grid grid-cols-2 gap-4">
              <!-- Call Card -->
              <div class="bg-gradient-to-br from-[#0D1E16] to-[#0A1320] border border-emerald-500/30 rounded-xl p-4 shadow-lg">
                <div class="flex justify-between items-center mb-1">
                  <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 font-mono">CALL OPTION</span>
                  <span id="bsm-call-moneyness" class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">ATM</span>
                </div>
                <div class="text-2xl sm:text-3xl font-black font-mono text-white mt-1" id="out-call-price">$3.68</div>
                <div class="text-xs text-slate-400 mt-1 font-mono">Intrinsic: <span id="out-call-intrinsic" class="text-slate-200">$0.00</span> | Extrinsic: <span id="out-call-extrinsic" class="text-emerald-400">$3.68</span></div>
              </div>

              <!-- Put Card -->
              <div class="bg-gradient-to-br from-[#1E1118] to-[#0A1320] border border-rose-500/30 rounded-xl p-4 shadow-lg">
                <div class="flex justify-between items-center mb-1">
                  <span class="text-xs font-bold uppercase tracking-wider text-rose-400 font-mono">PUT OPTION</span>
                  <span id="bsm-put-moneyness" class="text-[10px] font-mono px-2 py-0.5 rounded bg-rose-500/20 text-rose-300 border border-rose-500/30">ATM</span>
                </div>
                <div class="text-2xl sm:text-3xl font-black font-mono text-white mt-1" id="out-put-price">$3.31</div>
                <div class="text-xs text-slate-400 mt-1 font-mono">Intrinsic: <span id="out-put-intrinsic" class="text-slate-200">$0.00</span> | Extrinsic: <span id="out-put-extrinsic" class="text-rose-400">$3.31</span></div>
              </div>
            </div>

            <!-- Greeks Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Delta Card -->
              <div class="bg-[#080E1C] p-4 rounded-xl border border-slate-800">
                <div class="flex justify-between items-center mb-2">
                  <div class="flex items-center space-x-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                    <span class="text-xs font-bold text-slate-200 font-mono">Delta (&Delta;)</span>
                  </div>
                  <span class="text-[10px] font-mono text-slate-400">Directional Rate</span>
                </div>
                <div class="grid grid-cols-2 gap-2 text-center my-2 font-mono">
                  <div class="bg-slate-950 p-2 rounded border border-slate-800">
                    <div class="text-[10px] text-emerald-400">Call Delta</div>
                    <div class="text-base font-bold text-white" id="out-call-delta">+0.5432</div>
                  </div>
                  <div class="bg-slate-950 p-2 rounded border border-slate-800">
                    <div class="text-[10px] text-rose-400">Put Delta</div>
                    <div class="text-base font-bold text-white" id="out-put-delta">-0.4568</div>
                  </div>
                </div>
                <!-- Visual Slider Bar for Delta -->
                <div class="mt-2">
                  <div class="flex justify-between text-[10px] text-slate-500 font-mono mb-1">
                    <span>-1.0 (Short Put)</span>
                    <span>0</span>
                    <span>+1.0 (Long Call)</span>
                  </div>
                  <div class="w-full h-2 bg-slate-900 rounded-full overflow-hidden flex">
                    <div id="bar-put-delta" class="bg-rose-500 h-full transition-all duration-200" style="width: 45.6%;"></div>
                    <div id="bar-call-delta" class="bg-emerald-500 h-full transition-all duration-200" style="width: 54.3%;"></div>
                  </div>
                </div>
              </div>

              <!-- Gamma Card -->
              <div class="bg-[#080E1C] p-4 rounded-xl border border-slate-800">
                <div class="flex justify-between items-center mb-2">
                  <div class="flex items-center space-x-1.5">
                    <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                    <span class="text-xs font-bold text-slate-200 font-mono">Gamma (&Gamma;)</span>
                  </div>
                  <span class="text-[10px] font-mono text-slate-400">Curvature / &Delta; Velocity</span>
                </div>
                <div class="bg-slate-950 p-3 rounded border border-slate-800 text-center font-mono my-2">
                  <div class="text-[10px] text-cyan-400">Both Call &amp; Put</div>
                  <div class="text-xl font-bold text-white" id="out-gamma">0.0458</div>
                </div>
                <p class="text-[11px] text-slate-400 mt-2 leading-tight">
                  Delta shifts by <span id="out-gamma-exp" class="text-cyan-300 font-mono">+0.0458</span> per \$1 move in underlying asset. Peak at-the-money.
                </p>
              </div>

              <!-- Theta Card -->
              <div class="bg-[#080E1C] p-4 rounded-xl border border-slate-800">
                <div class="flex justify-between items-center mb-2">
                  <div class="flex items-center space-x-1.5">
                    <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
                    <span class="text-xs font-bold text-slate-200 font-mono">Theta (&Theta;)</span>
                  </div>
                  <span class="text-[10px] font-mono text-slate-400">Daily Decay</span>
                </div>
                <div class="grid grid-cols-2 gap-2 text-center my-2 font-mono">
                  <div class="bg-slate-950 p-2 rounded border border-slate-800">
                    <div class="text-[10px] text-indigo-400">Call / Day</div>
                    <div class="text-sm font-bold text-slate-100" id="out-call-theta">-$0.0682</div>
                  </div>
                  <div class="bg-slate-950 p-2 rounded border border-slate-800">
                    <div class="text-[10px] text-indigo-400">Put / Day</div>
                    <div class="text-sm font-bold text-slate-100" id="out-put-theta">-$0.0559</div>
                  </div>
                </div>
                <p class="text-[11px] text-slate-400 mt-2 leading-tight">
                  Expected calendar decay per 24 hours assuming volatility &amp; spot remain invariant.
                </p>
              </div>

              <!-- Vega & Rho Card -->
              <div class="bg-[#080E1C] p-4 rounded-xl border border-slate-800">
                <div class="flex justify-between items-center mb-2">
                  <div class="flex items-center space-x-1.5">
                    <span class="w-2 h-2 rounded-full bg-violet-400"></span>
                    <span class="text-xs font-bold text-slate-200 font-mono">Vega (&nu;) &amp; Rho (&rho;)</span>
                  </div>
                  <span class="text-[10px] font-mono text-slate-400">1% Vol / Rate Sensitivities</span>
                </div>
                <div class="grid grid-cols-2 gap-2 text-center my-2 font-mono">
                  <div class="bg-slate-950 p-2 rounded border border-slate-800">
                    <div class="text-[10px] text-violet-400">Vega (per 1% &sigma;)</div>
                    <div class="text-sm font-bold text-slate-100" id="out-vega">+$0.1138</div>
                  </div>
                  <div class="bg-slate-950 p-2 rounded border border-slate-800">
                    <div class="text-[10px] text-amber-400">Call Rho (1% r)</div>
                    <div class="text-sm font-bold text-slate-100" id="out-call-rho">+$0.0435</div>
                  </div>
                </div>
                <p class="text-[11px] text-slate-400 mt-2 leading-tight">
                  Option value changes by Vega when IV shifts 100 bps; Put Rho is <span id="out-put-rho" class="text-amber-300 font-mono">-$0.0387</span>.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 2: Uniswap v3 Concentrated Liquidity Calculator -->
      <div id="tab-v3" class="hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
          <!-- Inputs Column (5 cols) -->
          <div class="lg:col-span-5 space-y-5 bg-[#080E1C] p-5 sm:p-6 rounded-xl border border-slate-800/80">
            <h2 class="text-sm font-bold uppercase tracking-wider text-slate-300 font-mono flex items-center justify-between">
              <span>Pool &amp; Range Parameters</span>
              <button onclick="resetV3Defaults()" class="text-[11px] text-emerald-400 hover:underline">Reset Defaults</button>
            </h2>

            <!-- Initial Price (P0) -->
            <div>
              <div class="flex justify-between text-xs mb-1.5">
                <label for="v3-p0" class="font-medium text-slate-300">Initial Price ($P_0$)</label>
                <span class="font-mono text-emerald-400 font-bold" id="disp-v3-p0">$2,000.00</span>
              </div>
              <input type="number" id="v3-p0" value="2000" min="1" step="10" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs font-mono text-white focus:border-emerald-500 focus:outline-none" oninput="syncV3()" />
            </div>

            <!-- Lower Bound (Pa) -->
            <div>
              <div class="flex justify-between text-xs mb-1.5">
                <label for="v3-pa" class="font-medium text-slate-300">Lower Bound ($P_a$ / $P_L$)</label>
                <span class="font-mono text-rose-400 font-bold" id="disp-v3-pa">$1,600.00 (-20%)</span>
              </div>
              <input type="range" id="v3-pa-range" min="500" max="2500" step="25" value="1600" class="w-full accent-rose-500 cursor-pointer mb-2" oninput="document.getElementById('v3-pa').value = this.value; syncV3()" />
              <input type="number" id="v3-pa" value="1600" min="1" step="10" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs font-mono text-white focus:border-rose-500 focus:outline-none" oninput="document.getElementById('v3-pa-range').value = this.value; syncV3()" />
            </div>

            <!-- Upper Bound (Pb) -->
            <div>
              <div class="flex justify-between text-xs mb-1.5">
                <label for="v3-pb" class="font-medium text-slate-300">Upper Bound ($P_b$ / $P_U$)</label>
                <span class="font-mono text-cyan-400 font-bold" id="disp-v3-pb">$2,500.00 (+25%)</span>
              </div>
              <input type="range" id="v3-pb-range" min="1800" max="4000" step="25" value="2500" class="w-full accent-cyan-500 cursor-pointer mb-2" oninput="document.getElementById('v3-pb').value = this.value; syncV3()" />
              <input type="number" id="v3-pb" value="2500" min="1" step="10" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-xs font-mono text-white focus:border-cyan-500 focus:outline-none" oninput="document.getElementById('v3-pb-range').value = this.value; syncV3()" />
            </div>

            <!-- Price Change % / New Price -->
            <div>
              <div class="flex justify-between text-xs mb-1.5">
                <label for="v3-change" class="font-medium text-slate-300">Asset Price Shift (%)</label>
                <span class="font-mono text-emerald-400 font-bold" id="disp-v3-change">+15.0%</span>
              </div>
              <input type="range" id="v3-change" min="-80" max="150" step="1" value="15" class="w-full accent-emerald-500 cursor-pointer mb-2" oninput="syncV3()" />
              <div class="text-xs font-mono text-slate-400 flex justify-between">
                <span>New Price ($P_1$): <strong class="text-white" id="disp-v3-p1">$2,300.00</strong></span>
                <span id="disp-v3-range-status" class="text-emerald-400 font-bold">IN RANGE</span>
              </div>
            </div>

            <!-- Fee APY & Days -->
            <div class="grid grid-cols-2 gap-3 pt-2 border-t border-slate-800/80">
              <div>
                <label class="text-[11px] text-slate-400 block mb-1">Fee APY (%)</label>
