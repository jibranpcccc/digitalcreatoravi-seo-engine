---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  schemaJson?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description,
  canonical = "https://site-19-nine.vercel.app/",
  schemaJson,
  image = "/og-quant-banner.png",
  type = "website"
} = Astro.props;

const canonicalUrl = canonical.endsWith('/') ? canonical : `${canonical}/`;
const ogImageUrl = image.startsWith('http') ? image : `https://site-19-nine.vercel.app${image.startsWith('/') ? '' : '/'}${image}`;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="GreekVisualizer" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Machine-Readable LLM Discovery -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Quantitative Financial Math Context Index" />

    <!-- Search Engine Verification & Theme -->
    <meta name="theme-color" content="#080C14" />

    <!-- High-Performance Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Schema.org Structured Data -->
    {schemaJson && (
      <script type="application/ld+json" set:html={schemaJson} />
    )}

    <!-- Non-Blocking Fleet Master Analytics Beacon -->
    <script is:inline>
      (function() {
        try {
          var payload = JSON.stringify({
            site: window.location.hostname,
            path: window.location.pathname,
            ref: document.referrer || "direct",
            screen: window.innerWidth + "x" + window.innerHeight,
            ts: Date.now()
          });
          var endpoint = "https://webhookwatch.vercel.app/api/track/";
          if (navigator.sendBeacon) {
            navigator.sendBeacon(endpoint, payload);
          } else {
            fetch(endpoint, { method: "POST", body: payload, keepalive: true, headers: { "Content-Type": "application/json" } }).catch(function(){});
          }
        } catch(e) {}
      })();
    </script>
      <link rel="alternate" type="application/rss+xml" title="RSS 2.0 Feed" href="/rss.xml" />
  </head>
  <body class="bg-[#080C14] text-slate-100 antialiased font-['Plus_Jakarta_Sans',sans-serif] selection:bg-emerald-500/30 selection:text-emerald-200 min-h-screen flex flex-col relative overflow-x-hidden">

    <!-- Ambient Visual Glows -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[1100px] h-[380px] bg-gradient-to-b from-emerald-500/10 via-cyan-500/5 to-transparent blur-[140px] pointer-events-none -z-10"></div>
    <div class="fixed top-96 -left-48 w-80 h-80 bg-emerald-600/5 blur-[120px] pointer-events-none -z-10"></div>
    <div class="fixed top-96 -right-48 w-80 h-80 bg-indigo-600/5 blur-[120px] pointer-events-none -z-10"></div>

    <!-- Announcement Bar -->
    <div class="border-b border-slate-800/80 bg-[#0A101D]/90 backdrop-blur-md text-xs py-2 px-4 text-center text-slate-400 flex items-center justify-center space-x-3">
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
        QUANT ENGINE 2026
      </span>
      <span class="hidden sm:inline">Black-Scholes analytical PDE solver & Uniswap v3 concentrated liquidity matrix live</span>
      <span class="sm:hidden">BSM & Uniswap v3 Math Engine</span>
      <a href="/uniswap-v3-concentrated-liquidity-impermanent-loss-calculator/" class="text-emerald-400 hover:text-emerald-300 font-semibold underline underline-offset-2 ml-1">
        Explore v3 IL Math &rarr;
      </a>
    </div>

    <!-- Navigation Header -->
    <header class="border-b border-slate-800/80 bg-[#080C14]/90 backdrop-blur-xl sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center space-x-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 via-cyan-500 to-indigo-600 p-[1px] shadow-lg shadow-emerald-500/20 group-hover:shadow-emerald-500/40 transition duration-300">
            <div class="w-full h-full bg-[#0D1322] rounded-[11px] flex items-center justify-center font-mono font-black text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-300 text-base">
              &Delta;&Theta;
            </div>
          </div>
          <div class="flex flex-col">
            <div class="flex items-center space-x-1.5">
              <span class="text-lg font-black tracking-tight text-white group-hover:text-emerald-400 transition">
                Greek<span class="text-emerald-400">Visualizer</span>
              </span>
              <span class="text-[9px] uppercase font-mono font-bold px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/25">
                PRO
              </span>
            </div>
            <span class="text-[10px] font-mono text-slate-400 tracking-wider">Options Greeks &amp; DeFi IL Engine</span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden lg:flex items-center space-x-1 text-sm font-medium text-slate-300">
          <a href="/" class="px-3 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>Visualizer Hub</span>
          </a>
          <a href="/uniswap-v3-concentrated-liquidity-impermanent-loss-calculator/" class="px-3 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition">
            Uniswap v3 IL Math
          </a>
          <a href="/options-gamma-scalping-theta-decay-hedging-strategies/" class="px-3 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition">
            Gamma Scalping &amp; Theta
          </a>
          <a href="/crypto-funding-rate-arbitrage-delta-neutral-yield-guide/" class="px-3 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition">
            Delta-Neutral Yield
          </a>
        </nav>

        <!-- Header Actions -->
        <div class="flex items-center space-x-3">
          <a
            href="/llms.txt"
            class="hidden sm:flex items-center space-x-1.5 px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-700/80 hover:border-emerald-500/60 text-xs font-mono text-emerald-400 shadow-sm transition"
            title="Machine-readable Quantitative Context Index"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>llms.txt</span>
          </a>
          <a
            href="/#calculator"
            class="inline-flex items-center px-3.5 py-1.5 rounded-lg bg-gradient-to-r from-emerald-500 to-cyan-500 hover:from-emerald-400 hover:to-cyan-400 text-slate-950 text-xs font-bold shadow-md shadow-emerald-500/20 transition"
          >
            Launch Calculator
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 py-8 w-full">
      <slot />
    </main>

    <!-- Site Footer -->
    <footer class="border-t border-slate-800/80 bg-[#05080E] mt-24 py-16 text-sm text-slate-400">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
          <!-- Column 1: Brand & Identity -->
          <div class="md:col-span-2">
            <div class="flex items-center space-x-3 mb-3">
              <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-emerald-500 to-cyan-500 flex items-center justify-center font-mono font-bold text-slate-950 text-xs">
                &Delta;&Theta;
              </div>
              <span class="text-base font-extrabold text-white">Greek<span class="text-emerald-400">Visualizer</span></span>
            </div>
            <p class="text-xs text-slate-400 max-w-sm leading-relaxed mb-4">
              Open-source quantitative financial mathematics workbench. Analytical modeling of Black-Scholes partial differential equations, option sensitivities (Delta, Gamma, Vega, Theta, Rho), and Uniswap v3 concentrated liquidity divergence loss.
            </p>
            <div class="inline-flex items-center space-x-2 px-2.5 py-1 rounded-md bg-slate-900 border border-slate-800 text-[11px] font-mono text-emerald-400">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span>Pure Client-Side Math Engine • Zero Data Telemetry</span>
            </div>
          </div>

          <!-- Column 2: Quantitative Guides -->
          <div>
            <h4 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Mathematical Models</h4>
            <ul class="space-y-2 text-xs text-slate-400">
              <li><a href="/#calculator" class="hover:text-emerald-400 transition">Black-Scholes Options Greeks</a></li>
              <li><a href="/uniswap-v3-concentrated-liquidity-impermanent-loss-calculator/" class="hover:text-emerald-400 transition">Uniswap v3 Impermanent Loss</a></li>
              <li><a href="/options-gamma-scalping-theta-decay-hedging-strategies/" class="hover:text-emerald-400 transition">Gamma Scalping &amp; Dynamic Delta</a></li>
              <li><a href="/crypto-funding-rate-arbitrage-delta-neutral-yield-guide/" class="hover:text-emerald-400 transition">Perpetual Funding Rate Arbitrage</a></li>
            </ul>
          </div>

          <!-- Column 3: Standards & Discovery -->
          <div>
            <h4 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Discovery &amp; APIs</h4>
            <ul class="space-y-2 text-xs text-slate-400">
              <li><a href="/llms.txt" class="hover:text-emerald-400 transition font-mono">/llms.txt (LLM Standard)</a></li>
              <li><a href="/robots.txt" class="hover:text-emerald-400 transition font-mono">/robots.txt</a></li>
              <li><a href="/sitemap.xml" class="hover:text-emerald-400 transition font-mono">/sitemap.xml</a></li>
              <li><a href="/8303260f1bf94264ac6d00aa93efde28.txt" class="hover:text-emerald-400 transition font-mono">IndexNow Protocol Key</a></li>
            </ul>
          </div>
        </div>

        <div class="border-t border-slate-800/80 pt-6 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-500 gap-4">
