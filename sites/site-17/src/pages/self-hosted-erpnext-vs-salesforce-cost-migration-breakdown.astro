    </section>

    <!-- CTA Section -->
    <div class="p-8 rounded-2xl bg-gradient-to-r from-cyan-950/70 via-slate-900 to-emerald-950/70 border border-cyan-500/40 text-center">
      <h3 class="text-xl sm:text-2xl font-black text-white mb-2">
        Model Your Exact Salesforce Replacement Savings
      </h3>
      <p class="text-xs sm:text-sm text-slate-300 max-w-xl mx-auto mb-6">
