      <script is:inline>
        function updateHubSpotCalc() {
          const contacts = parseInt(document.getElementById('hs-contacts').value, 10);
          const sendsPerMo = parseInt(document.getElementById('hs-sends').value, 10);

          document.getElementById('hs-contacts-val').textContent = contacts.toLocaleString() + " Contacts";

          // HubSpot Pricing Logic: Base $800 for 2,000. Above 2,000: $225 per 5,000 block (rounded up)
          let hsMonthly = 800;
          if (contacts > 2000) {
            const extraContacts = contacts - 2000;
            const extraPacks = Math.ceil(extraContacts / 5000);
            hsMonthly += extraPacks * 225;
          }
          const hsAnnual = hsMonthly * 12;

