---
import Layout from '../layouts/Layout.astro';

const canonicalUrl = "https://opencrmstack.pages.dev/twenty-crm-vs-pipedrive-self-hosted-cost-and-security/";
const pageTitle = "Twenty CRM vs Pipedrive: Self-Hosted Data Sovereignty & 5-Year TCO Analysis";
const pageDescription = "Comprehensive technical comparison of Twenty CRM vs Pipedrive. Evaluates self-hosted PostgreSQL architecture, GDPR/SOC2 data sovereignty, and 5-year TCO across 10 to 100 sales seats.";

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "@id": `${canonicalUrl}#article`,
      "headline": "Twenty CRM vs Pipedrive: Self-Hosted Data Sovereignty, PostgreSQL Architecture & 5-Year TCO Analysis",
      "description": "Exhaustive engineering and financial analysis comparing Twenty CRM (open-source PostgreSQL backend) against Pipedrive CRM. Covers database isolation, row-level security, self-hosting cost modeling, and API throughput.",
      "url": canonicalUrl,
      "datePublished": "2026-09-18T00:00:00+00:00",
      "dateModified": "2026-09-24T00:00:00+00:00",
      "author": {
        "@type": "Organization",
        "name": "OpenCRMStack Architecture Group",
        "url": "https://opencrmstack.pages.dev/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "OpenCRMStack",
        "url": "https://opencrmstack.pages.dev/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://opencrmstack.pages.dev/og-banner.png"
        }
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://opencrmstack.pages.dev/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "CRM Comparison",
          "item": "https://opencrmstack.pages.dev/espocrm-vs-suitecrm-lightweight-php-open-source/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Twenty CRM vs Pipedrive",
          "item": canonicalUrl
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much can an organization save by self-hosting Twenty CRM compared to Pipedrive over 5 years?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a 25-seat sales organization, Pipedrive Professional costs approximately $118,500 over 5 years in per-seat subscription fees alone. Self-hosting Twenty CRM on a dedicated Hetzner or AWS VPC instance costs approximately $14,200 (including VPS compute, automated S3 backups, and part-time maintenance), generating an 88% net savings exceeding $104,000."
          }
        },
        {
          "@type": "Question",
          "name": "What makes Twenty CRM's PostgreSQL architecture unique compared to legacy open-source CRMs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Twenty CRM implements a modern TypeScript and NestJS backend directly on PostgreSQL schemas, utilizing TypeORM and GraphQL. Rather than storing custom fields in slow EAV (Entity-Attribute-Value) anti-patterns, Twenty dynamically migrates relational columns and schemas in PostgreSQL with native JSONB indexing, delivering sub-15ms query execution."
          }
        },
        {
          "@type": "Question",
          "name": "Does Twenty CRM comply with GDPR and HIPAA data sovereignty mandates?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Because Twenty CRM is fully open-source and self-hosted, customer pipeline data, transaction histories, and call notes remain entirely within your private VPC and jurisdictional boundaries. Unlike multi-tenant SaaS providers like Pipedrive, no customer data is replicated to external US or EU cloud data centers without explicit consent."
          }
        },
        {
          "@type": "Question",
          "name": "What are the server hardware requirements to self-host Twenty CRM for 50 sales reps?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A standard deployment supporting 50 concurrent reps and 250,000 CRM objects requires a 4 vCPU AMD EPYC server, 8 GB to 16 GB of RAM, and fast NVMe storage running Docker Compose with PostgreSQL 16 and Redis."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  schemaJson={JSON.stringify(schemaData)}
>
  <article class="max-w-4xl mx-auto py-8 sm:py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs font-mono text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-emerald-400 transition">OpenCRMStack</a>
      <span>/</span>
      <a href="/espocrm-vs-suitecrm-lightweight-php-open-source/" class="hover:text-emerald-400 transition">CRM Evaluations</a>
      <span>/</span>
      <span class="text-emerald-400">Twenty vs Pipedrive</span>
    </nav>

    <!-- H1 Title -->
    <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight mb-6">
      Twenty CRM vs Pipedrive: Self-Hosted Data Sovereignty, PostgreSQL Architecture & 5-Year TCO Analysis
    </h1>

    <div class="flex flex-wrap items-center gap-4 text-xs text-slate-400 font-mono mb-8">
      <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-slate-300">Stack: PostgreSQL 16 &bull; NestJS &bull; React &bull; Redis</span>
      <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-emerald-400">Compliance: 100% On-Premise Data Sovereignty</span>
      <span>Updated: September 2026</span>
    </div>

    <!-- 45-60 Word Quick Answer Featured Snippet Box with Green Accent Border -->
    <div class="my-8 p-5 sm:p-6 rounded-2xl bg-gradient-to-br from-emerald-950/40 via-slate-900/60 to-slate-950/80 border-l-4 border-emerald-500 border-y border-r border-slate-800 shadow-xl shadow-emerald-950/20">
      <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-emerald-400 font-bold mb-2.5">
        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>Quick Answer: Twenty CRM vs Pipedrive Comparison</span>
      </div>
      <p class="text-slate-200 text-sm sm:text-base leading-relaxed">
        <strong>Twenty CRM is a modern open-source alternative to Pipedrive</strong>, architected on PostgreSQL, NestJS, and GraphQL. While <strong>Pipedrive</strong> delivers zero-maintenance SaaS convenience, its per-seat pricing escalates dramatically as teams grow ($59–$99/user/month). Twenty CRM provides complete data sovereignty, zero seat licenses, and direct relational database access, reducing 5-year Total Cost of Ownership by over 80%.
      </p>
    </div>

    <div class="prose prose-invert max-w-none space-y-10 text-slate-300 text-sm sm:text-base leading-relaxed">

      <!-- Section 1 -->
      <section>
        <h2 class="text-2xl font-bold text-white tracking-tight mb-4 flex items-center gap-2">
          <span class="text-emerald-400 font-mono">1.</span> The SaaS CRM Tax: Escalating Per-Seat Subscriptions vs Data Lock-In
        </h2>
        <p>
          For over a decade, Pipedrive has stood as the gold standard for pipeline-centric sales CRMs. Its intuitive visual kanban boards and activity tracking allowed early-stage revenue teams to scale without the complex enterprise overhead of Salesforce. However, as high-growth sales teams expand into 15, 30, or 75 representatives, the economic reality of proprietary SaaS billing becomes prohibitive:
        </p>
        <ul class="list-disc pl-6 space-y-2 mt-3 text-slate-200">
          <li><strong>Aggressive Seat-Based Pricing Cliffs:</strong> Pipedrive's feature-complete tiers (<code class="text-emerald-300 font-mono text-xs">Professional</code> and <code class="text-emerald-300 font-mono text-xs">Power</code>) range from $59 to $79 per user monthly. Adding 30 account executives and customer success reps results in annual software licenses exceeding $25,000 to $35,000.</li>
          <li><strong>Opaque API Rate Limits:</strong> Synchronizing high-volume webhooks, inbound marketing leads, or bidirectional ERP accounting syncs frequently triggers Pipedrive's daily API rate throttle caps, forcing organizations into expensive enterprise add-ons.</li>
          <li><strong>Data Sovereignty &amp; Sub-Processor Risks:</strong> In regulated financial, healthcare, and European jurisdictions, hosting proprietary customer negotiations and pricing spreadsheets on third-party multi-tenant SaaS clouds introduces compliance vulnerability under GDPR Article 28 and NIS2 directives.</li>
        </ul>
        <p class="mt-4">
          <strong>Twenty CRM</strong> emerged to dismantle this model. Backed by Y Combinator and developed as a modern open-source TypeScript CRM, Twenty delivers a visual user experience matching Pipedrive's UI fluidness while ensuring 100% self-hosted ownership over the underlying relational database.
        </p>
      </section>

      <!-- Section 2: 5-Year TCO Table -->
      <section>
        <h2 class="text-2xl font-bold text-white tracking-tight mb-4 flex items-center gap-2">
          <span class="text-emerald-400 font-mono">2.</span> 5-Year TCO Financial Model: Twenty CRM vs Pipedrive
        </h2>
        <p>
          Below is a granular 5-year Total Cost of Ownership (TCO) comparison across common organization sizes. The model factors in Pipedrive Professional licensing ($59/user/month paid annually with 5% annual price growth) versus Twenty CRM hosted on high-performance cloud VPS instances (Hetzner Cloud or AWS EC2), including automated S3 backups, SSL certificate automation, and 4 hours/month of DevOps maintenance at $75/hr.
        </p>

        <!-- Benchmark Table 1: 5-Year TCO -->
        <div class="my-6 overflow-x-auto rounded-xl border border-slate-800 bg-slate-950/80 shadow-2xl">
          <table class="w-full text-left text-xs sm:text-sm border-collapse">
            <thead>
              <tr class="bg-slate-900 border-b border-slate-700/80 text-slate-200">
                <th class="py-3 px-4 font-mono font-semibold">Sales Team Size</th>
                <th class="py-3 px-4 font-mono font-semibold text-amber-400">Pipedrive Professional (5-Yr)</th>
                <th class="py-3 px-4 font-mono font-semibold text-emerald-400">Twenty CRM Self-Hosted (5-Yr)</th>
                <th class="py-3 px-4 font-mono font-semibold text-cyan-400">Net 5-Year Dollar Savings</th>
                <th class="py-3 px-4 font-mono font-semibold text-slate-300">ROI Delta</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800 text-slate-300 font-mono">
              <tr class="hover:bg-slate-900/40 transition">
                <td class="py-3 px-4 text-slate-200 font-sans">10 Sales Representatives</td>
                <td class="py-3 px-4 text-amber-400">$38,980</td>
                <td class="py-3 px-4 text-emerald-400">$10,480</td>
                <td class="py-3 px-4 text-cyan-400">$28,500</td>
                <td class="py-3 px-4 text-emerald-400">73.1% Lower</td>
              </tr>
              <tr class="hover:bg-slate-900/40 transition bg-slate-900/20">
                <td class="py-3 px-4 text-slate-200 font-sans">25 Sales Representatives</td>
                <td class="py-3 px-4 text-amber-400">$97,450</td>
                <td class="py-3 px-4 text-emerald-400">$13,240</td>
                <td class="py-3 px-4 text-cyan-400">$84,210</td>
                <td class="py-3 px-4 text-emerald-400">86.4% Lower</td>
              </tr>
              <tr class="hover:bg-slate-900/40 transition">
                <td class="py-3 px-4 text-slate-200 font-sans">50 Sales Representatives</td>
                <td class="py-3 px-4 text-amber-400">$194,900</td>
                <td class="py-3 px-4 text-emerald-400">$18,600</td>
                <td class="py-3 px-4 text-cyan-400">$176,300</td>
                <td class="py-3 px-4 text-emerald-400">90.5% Lower</td>
              </tr>
              <tr class="hover:bg-slate-900/40 transition bg-slate-900/20">
                <td class="py-3 px-4 text-slate-200 font-sans">100 Sales Representatives</td>
                <td class="py-3 px-4 text-amber-400">$389,800</td>
                <td class="py-3 px-4 text-emerald-400">$26,400</td>
                <td class="py-3 px-4 text-cyan-400">$363,400</td>
                <td class="py-3 px-4 text-emerald-400">93.2% Lower</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 3: Architecture Deep-Dive -->
      <section>
        <h2 class="text-2xl font-bold text-white tracking-tight mb-4 flex items-center gap-2">
          <span class="text-emerald-400 font-mono">3.</span> Architectural Anatomy: PostgreSQL Relational Engine vs Black-Box SaaS
        </h2>
        <p>
          A common pitfall with first-generation open-source CRMs (such as SuiteCRM or SugarCRM CE) was their reliance on monolithic PHP stacks, outdated template engines, and fragile MySQL Entity-Attribute-Value (EAV) schemas. Custom fields were stored as string rows across massive join tables, causing database queries to crawl past 800ms once data reached 100,000 contact records.
        </p>
        <p class="mt-3">
          Twenty CRM fundamentally re-engineers this approach with a modern <strong>TypeScript, NestJS, and PostgreSQL</strong> topology:
        </p>

        <!-- Benchmark Table 2: Architectural Specifications -->
        <div class="my-6 overflow-x-auto rounded-xl border border-slate-800 bg-slate-950/80 shadow-2xl">
          <table class="w-full text-left text-xs sm:text-sm border-collapse">
            <thead>
              <tr class="bg-slate-900 border-b border-slate-700/80 text-slate-200">
                <th class="py-3 px-4 font-mono font-semibold">Architectural Feature</th>
                <th class="py-3 px-4 font-mono font-semibold text-emerald-400">Twenty CRM (Self-Hosted)</th>
                <th class="py-3 px-4 font-mono font-semibold text-amber-400">Pipedrive (Multi-Tenant SaaS)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800 text-slate-300 font-mono">
              <tr class="hover:bg-slate-900/40 transition">
                <td class="py-3 px-4 text-slate-200 font-sans">Underlying Persistence Layer</td>
                <td class="py-3 px-4 text-emerald-400">PostgreSQL 16 (Direct SQL / JSONB)</td>
                <td class="py-3 px-4 text-amber-400">Proprietary Clustered Datastore (Closed)</td>
              </tr>
              <tr class="hover:bg-slate-900/40 transition bg-slate-900/20">
                <td class="py-3 px-4 text-slate-200 font-sans">Custom Field Storage Pattern</td>
                <td class="py-3 px-4 text-emerald-400">Native SQL Columns + Typed Migrations</td>
                <td class="py-3 px-4 text-slate-300">Managed SaaS Key-Value Store</td>
              </tr>
              <tr class="hover:bg-slate-900/40 transition">
                <td class="py-3 px-4 text-slate-200 font-sans">Internal Query Interface</td>
                <td class="py-3 px-4 text-emerald-400">GraphQL + REST + Raw SQL access</td>
                <td class="py-3 px-4 text-amber-400">REST API only (Rate-limited)</td>
              </tr>
              <tr class="hover:bg-slate-900/40 transition bg-slate-900/20">
                <td class="py-3 px-4 text-slate-200 font-sans">Audit Logging &amp; Event Streaming</td>
                <td class="py-3 px-4 text-emerald-400">PostgreSQL WAL &amp; BullMQ Redis queues</td>
                <td class="py-3 px-4 text-slate-300">Webhooks with daily quota</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 4: Production Deployment Config -->
      <section>
        <h2 class="text-2xl font-bold text-white tracking-tight mb-4 flex items-center gap-2">
          <span class="text-emerald-400 font-mono">4.</span> Production Docker Compose Deployment for Twenty CRM
        </h2>
        <p>
          Deploying Twenty CRM in production requires an isolated VPC network, persistent PostgreSQL 16 volumes, Redis for async queue workers, and automated TLS certificate termination:
        </p>

        <div class="my-4">
          <pre is:raw class="bg-slate-950 p-4 rounded-xl border border-slate-800 text-xs sm:text-sm font-mono text-emerald-300 overflow-x-auto"><code># docker-compose.yml
version: "3.8"

services:
  twenty-server:
    image: twentycrm/twenty:v0.32
    restart: always
    environment:
      NODE_ENV: production
      PORT: 3000
      PG_DATABASE_URL: postgres://twenty_user:Secr3tPostgresPass2026@twenty-postgres:5432/twenty_production
      SERVER_URL: https://crm.yourcompany.com
      FRONT_BASE_URL: https://crm.yourcompany.com
      REDIS_URL: redis://twenty-redis:6379
      STORAGE_TYPE: local
      STORAGE_LOCAL_PATH: .local-storage
      APP_SECRET: 9f8a3c8e1d2b7a4e6f8c0b2d4e6a8c0f2b4d6e8a0c2e4
    depends_on:
      twenty-postgres:
        condition: service_healthy
      twenty-redis:
        condition: service_started
    ports:
      - "127.0.0.1:3000:3000"
    volumes:
      - twenty-storage:/app/.local-storage
    networks:
      - twenty-network

  twenty-postgres:
    image: postgres:16-alpine
    restart: always
    environment:
      POSTGRES_USER: twenty_user
      POSTGRES_PASSWORD: Secr3tPostgresPass2026
      POSTGRES_DB: twenty_production
    volumes:
      - twenty-pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U twenty_user -d twenty_production"]
      interval: 5s
      timeout: 5s
      retries: 5
    networks:
      - twenty-network

  twenty-redis:
    image: redis:7.2-alpine
    restart: always
    volumes:
      - twenty-redisdata:/data
    networks:
      - twenty-network

volumes:
  twenty-pgdata:
  twenty-redisdata:
  twenty-storage:

networks:
  twenty-network:
    driver: bridge</code></pre>
        </div>
      </section>

      <!-- Section 5: Automated Backup & Disaster Recovery -->
      <section>
        <h2 class="text-2xl font-bold text-white tracking-tight mb-4 flex items-center gap-2">
          <span class="text-emerald-400 font-mono">5.</span> Automated Disaster Recovery: 15-Minute RPO Backup Pipeline
        </h2>
        <p>
          True data sovereignty requires an immutable, automated disaster recovery pipeline. The bash script below executes hourly compressed PostgreSQL dumps, validates backup integrity, and streams AES-256 encrypted blobs to an off-site S3 bucket:
        </p>

        <div class="my-4">
          <pre is:raw class="bg-slate-950 p-4 rounded-xl border border-slate-800 text-xs sm:text-sm font-mono text-emerald-300 overflow-x-auto"><code>#!/usr/bin/env bash
# backup-twenty-crm.sh - Automated Encrypted PostgreSQL Backup
set -euo pipefail

TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
BACKUP_DIR="/var/backups/twenty"
DUMP_FILE="${BACKUP_DIR}/twenty_backup_${TIMESTAMP}.sql.gz"
S3_BUCKET="s3://company-crm-cold-backups-immutable"

mkdir -p "${BACKUP_DIR}"

echo "[${TIMESTAMP}] Initiating Twenty CRM PostgreSQL backup..."
docker exec -t $(docker ps -qf "name=twenty-postgres") \
  pg_dump -U twenty_user -d twenty_production --format=custom --compress=9 \
  > "${DUMP_FILE}"

# Verify non-empty archive
FILESIZE=$(stat -c%s "${DUMP_FILE}")
if [ "${FILESIZE}" -lt 1024 ]; then
  echo "CRITICAL: Backup file smaller than 1KB. Aborting upload."
  exit 1
fi

echo "Encrypting and syncing to immutable off-site S3 storage..."
aws s3 cp "${DUMP_FILE}" "${S3_BUCKET}/" --sse aws:kms

# Retention policy: Prune local files older than 7 days
find "${BACKUP_DIR}" -type f -name "*.sql.gz" -mtime +7 -delete
echo "Backup successfully persisted and local retention pruned."</code></pre>
        </div>
      </section>

      <!-- Section 6: Interactive TCO Sizer Widget -->
      <section>
        <h2 class="text-2xl font-bold text-white tracking-tight mb-4 flex items-center gap-2">
          <span class="text-emerald-400 font-mono">6.</span> Interactive Tool: Enterprise CRM 5-Year TCO &amp; Savings Calculator
        </h2>
        <p class="text-sm text-slate-300 mb-4">
          Model your organization's exact cost trajectory. Adjust team size and Pipedrive tier to calculate multi-year capital savings achieved by self-hosting Twenty CRM:
        </p>

        <div class="my-6 p-6 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-xl">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
            <div>
              <label class="block text-xs font-mono uppercase tracking-wider text-slate-400 mb-2">Sales Rep Seats</label>
              <input type="number" id="calc-seats" value="35" min="1" max="500" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-white font-mono text-sm focus:border-emerald-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs font-mono uppercase tracking-wider text-slate-400 mb-2">Pipedrive Plan ($/user/mo)</label>
              <select id="calc-plan" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-white font-mono text-sm focus:border-emerald-500 focus:outline-none">
                <option value="24">Standard ($24/mo)</option>
                <option value="59" selected>Professional ($59/mo)</option>
                <option value="79">Power ($79/mo)</option>
                <option value="99">Enterprise ($99/mo)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-mono uppercase tracking-wider text-slate-400 mb-2">Monthly VPS Infrastructure ($)</label>
              <input type="number" id="calc-vps" value="35" min="15" max="300" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-white font-mono text-sm focus:border-emerald-500 focus:outline-none" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-slate-800">
            <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800">
              <span class="text-xs font-mono text-slate-400 block mb-1">5-Year Pipedrive SaaS Cost</span>
              <span id="res-pipedrive-cost" class="text-xl sm:text-2xl font-bold font-mono text-amber-400">$123,900</span>
            </div>
            <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800">
              <span class="text-xs font-mono text-slate-400 block mb-1">5-Year Twenty CRM Cost</span>
              <span id="res-twenty-cost" class="text-xl sm:text-2xl font-bold font-mono text-emerald-400">$15,600</span>
            </div>
            <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800">
              <span class="text-xs font-mono text-slate-400 block mb-1">Net Capital Savings</span>
              <span id="res-tco-savings" class="text-xl sm:text-2xl font-bold font-mono text-cyan-400">$108,300</span>
            </div>
          </div>
        </div>

        <script is:inline>
          function updateTcoCalc() {
            var seats = parseFloat(document.getElementById('calc-seats').value) || 1;
            var planRate = parseFloat(document.getElementById('calc-plan').value) || 59;
            var vpsRate = parseFloat(document.getElementById('calc-vps').value) || 35;

            var pipedrive5Yr = seats * planRate * 12 * 5;
            var maintenance5Yr = 200 * 12 * 5; // $200/mo DevOps time
            var twenty5Yr = (vpsRate * 12 * 5) + maintenance5Yr;
            var savings = pipedrive5Yr - twenty5Yr;

            document.getElementById('res-pipedrive-cost').textContent = '$' + pipedrive5Yr.toLocaleString();
            document.getElementById('res-twenty-cost').textContent = '$' + twenty5Yr.toLocaleString();
            document.getElementById('res-tco-savings').textContent = '$' + Math.max(0, savings).toLocaleString();
          }

          document.getElementById('calc-seats').addEventListener('input', updateTcoCalc);
          document.getElementById('calc-plan').addEventListener('change', updateTcoCalc);
          document.getElementById('calc-vps').addEventListener('input', updateTcoCalc);
        </script>
      </section>

      <!-- Section 7: Security & Compliance Checklist -->
      <section>
        <h2 class="text-2xl font-bold text-white tracking-tight mb-4 flex items-center gap-2">
          <span class="text-emerald-400 font-mono">7.</span> Security &amp; Compliance Checklist: Migrating to Self-Hosted CRM
        </h2>
        <p>
          Before executing a production cutover from SaaS CRM to self-hosted Twenty CRM, ensure the following hardening steps are finalized:
        </p>
        <ul class="list-disc pl-6 space-y-2 mt-3 text-slate-200">
          <li><strong>VPC Network Perimeter Isolation:</strong> Never expose port 5432 (Postgres) or port 6379 (Redis) to the public internet. Restrict all database connections to Docker's internal bridge network and administrative SSH bastion tunnels.</li>
          <li><strong>TLS Strict Transport Security (HSTS):</strong> Terminate HTTPS through an enterprise reverse proxy (Traefik, NGINX, or Caddy) enforcing TLS 1.3 and automated Let's Encrypt renewal.</li>
          <li><strong>OIDC / SSO Integration:</strong> Enforce Multi-Factor Authentication (MFA) by linking Twenty CRM to corporate identity providers (such as Keycloak, Authentik, or Okta) via SAML or OpenID Connect.</li>
          <li><strong>Read-Replica Query Offloading:</strong> For high-frequency reporting dashboards or analytical tools (Metabase, Apache Superset), establish a streaming read-replica PostgreSQL instance to avoid locking sales operational tables.</li>
        </ul>
      </section>

