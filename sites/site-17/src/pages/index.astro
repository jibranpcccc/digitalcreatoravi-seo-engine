  <!-- Client-Side Calculator Logic Script -->
  <script is:inline>
    function initCalculator() {
      const repsSlider = document.getElementById('reps-slider');
      const contactsSlider = document.getElementById('contacts-slider');
      const repsDisplay = document.getElementById('reps-display');
      const contactsDisplay = document.getElementById('contacts-display');

      const sfTotal = document.getElementById('salesforce-total');
      const hsTotal = document.getElementById('hubspot-total');
      const twentyTotal = document.getElementById('twenty-total');
      const erpTotal = document.getElementById('erpnext-total');

      const savingsAmount = document.getElementById('savings-amount');
      const breakevenMonths = document.getElementById('breakeven-months');
      const percentageSavings = document.getElementById('percentage-savings');

      const tableSfLicense = document.getElementById('table-sf-license');
      const tableHsLicense = document.getElementById('table-hs-license');
      const tableSfContacts = document.getElementById('table-sf-contacts');
      const tableHsContacts = document.getElementById('table-hs-contacts');
      const tableTwentyEmail = document.getElementById('table-twenty-email');
      const tableErpnextEmail = document.getElementById('table-erpnext-email');
      const tableTwentyVps = document.getElementById('table-twenty-vps');
      const tableErpnextVps = document.getElementById('table-erpnext-vps');

      const tableSfTotal = document.getElementById('table-sf-total');
      const tableHsTotal = document.getElementById('table-hs-total');
      const tableTwentyTotal = document.getElementById('table-twenty-total');
      const tableErpnextTotal = document.getElementById('table-erpnext-total');

      function formatMoney(num) {
        return '$' + Math.round(num).toLocaleString('en-US');
      }

      function calculate() {
        const reps = parseInt(repsSlider.value, 10);
        const contacts = parseInt(contactsSlider.value, 10);

        repsDisplay.textContent = reps + (reps === 1 ? ' Rep' : ' Reps');
        contactsDisplay.textContent = contacts.toLocaleString('en-US') + ' Contacts';

        // 1. Salesforce 3-Year Model
        const sfLicense3Yr = reps * 165 * 36;
        const sfContactAddonMonthly = Math.max(0, contacts - 10000) / 1000 * 20;
        const sfContactAddon3Yr = sfContactAddonMonthly * 36;
        const sfImplementation = 15000;
        const sfAdminSupport3Yr = 6000 * 3;
        const sfTotal3Yr = sfLicense3Yr + sfContactAddon3Yr + sfImplementation + sfAdminSupport3Yr;

        // 2. HubSpot 3-Year Model
        const hsLicense3Yr = reps * 150 * 36;
        const extra10kTiers = Math.max(0, Math.ceil((contacts - 10000) / 10000));
        const hsMarketingMonthly = 3600 + (extra10kTiers * 100);
        const hsContacts3Yr = hsMarketingMonthly * 36;
        const hsOnboarding = 6000;
        const hsTotal3Yr = hsLicense3Yr + hsContacts3Yr + hsOnboarding;

        // 3. Twenty CRM 3-Year Model
        let vpsBase = 16;
        if (reps > 35) vpsBase = 60;
        else if (reps > 20) vpsBase = 30;
        const twentyVps3Yr = (vpsBase + 10) * 36;
        const emailMonthly = contacts * 0.0004;
        const twentyEmail3Yr = emailMonthly * 36;
        const twentySetup = 6500;
        const twentyMaintenance3Yr = 320 * 36;
        const twentyTotal3Yr = twentyVps3Yr + twentyEmail3Yr + twentySetup + twentyMaintenance3Yr;

        // 4. ERPNext 3-Year Model
        let erpVpsBase = 30;
        if (reps > 20) erpVpsBase = 52;
        const erpVps3Yr = (erpVpsBase + 15) * 36;
        const erpEmail3Yr = emailMonthly * 36;
        const erpSetup = 8500;
        const erpMaintenance3Yr = 350 * 36;
        const erpTotal3Yr = erpVps3Yr + erpEmail3Yr + erpSetup + erpMaintenance3Yr;

        // Displays
        sfTotal.textContent = formatMoney(sfTotal3Yr);
        hsTotal.textContent = formatMoney(hsTotal3Yr);
        twentyTotal.textContent = formatMoney(twentyTotal3Yr);
        erpTotal.textContent = formatMoney(erpTotal3Yr);

        const proprietaryAvg = (sfTotal3Yr + hsTotal3Yr) / 2;
        const netSavings = proprietaryAvg - twentyTotal3Yr;
        const pctSaved = ((netSavings / proprietaryAvg) * 100).toFixed(1);

        const propMonthlyRunRate = (proprietaryAvg - ((sfImplementation + hsOnboarding)/2)) / 36;
        const ossMonthlyRunRate = (twentyVps3Yr / 36) + emailMonthly + 320;
        const monthlySavings = propMonthlyRunRate - ossMonthlyRunRate;
        const breakEven = monthlySavings > 0 ? (twentySetup / monthlySavings).toFixed(1) : 6.0;

        savingsAmount.textContent = '+' + formatMoney(netSavings);
        breakevenMonths.textContent = Math.max(1.5, Math.min(18.0, parseFloat(breakEven))).toFixed(1) + ' Months';
        percentageSavings.textContent = pctSaved + '%';

        tableSfLicense.textContent = formatMoney(sfLicense3Yr);
        tableHsLicense.textContent = formatMoney(hsLicense3Yr);
        tableSfContacts.textContent = formatMoney(sfContactAddon3Yr);
        tableHsContacts.textContent = formatMoney(hsContacts3Yr);
        tableTwentyEmail.textContent = formatMoney(twentyEmail3Yr) + ' (SES)';
        tableErpnextEmail.textContent = formatMoney(erpEmail3Yr) + ' (SES)';
        tableTwentyVps.textContent = formatMoney(twentyVps3Yr);
        tableErpnextVps.textContent = formatMoney(erpVps3Yr);

        tableSfTotal.textContent = formatMoney(sfTotal3Yr);
        tableHsTotal.textContent = formatMoney(hsTotal3Yr);
        tableTwentyTotal.textContent = formatMoney(twentyTotal3Yr);
        tableErpnextTotal.textContent = formatMoney(erpTotal3Yr);
      }

      repsSlider.addEventListener('input', calculate);
      contactsSlider.addEventListener('input', calculate);

      const presetBtns = document.querySelectorAll('.preset-btn');
      presetBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const reps = this.getAttribute('data-reps');
          const contacts = this.getAttribute('data-contacts');
          if (reps) repsSlider.value = reps;
          if (contacts) contactsSlider.value = contacts;
          calculate();
        });
      });

      calculate();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCalculator);
    } else {
      initCalculator();
    }
  </script>
