---
import Layout from '../layouts/Layout.astro';

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Open-Source CRM Total Cost of Ownership (TCO) & Migration Calculator",
      "url": "https://opencrmstack.pages.dev/",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "All",
      "description": "Interactive financial model and migration calculator comparing 3-year TCO between Salesforce, HubSpot, Twenty CRM, and ERPNext on Hetzner VPS.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much can a company save by switching from Salesforce or HubSpot to an open-source CRM?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mid-market companies with 15 to 50 sales reps and 25,000 to 100,000 contacts typically save between $95,000 and $380,000 over three years—a 75% to 88% reduction in Total Cost of Ownership (TCO). Savings stem from eliminating per-seat SaaS taxes and contact list tier fees."
          }
        },
        {
          "@type": "Question",
          "name": "What is the typical migration break-even point for self-hosted CRMs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The break-even point typically arrives between 4 and 7 months. Even when factoring in upfront migration engineering costs ($6,500 to $12,000) and part-time DevOps infrastructure management ($300/mo), monthly SaaS license elimination immediately recovers capital expenses."
          }
        },
        {
          "@type": "Question",
          "name": "What server infrastructure is required to self-host Twenty CRM?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Twenty CRM can be deployed via Docker Compose on a Hetzner Cloud CPX31 VPS (4 vCPU AMD, 8 GB RAM, 160 GB NVMe) for approximately €14.20 ($16.00) per month. This handles up to 50 concurrent sales representatives and 250,000 contact records with sub-100ms response times."
          }
        },
        {
          "@type": "Question",
          "name": "How does open-source CRM data sovereignty benefit regulated enterprises?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Open-source self-hosted CRMs store all pipeline, customer, and transaction records inside your own isolated PostgreSQL or MariaDB database behind private VPC firewalls, ensuring full compliance with GDPR, HIPAA, and SOC2 without third-party vendor lock-in or unannounced price increases."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="Open-Source CRM TCO & Migration Cost Calculator 2026"
  description="Calculate 3-year TCO savings migrating from Salesforce or HubSpot to self-hosted Twenty CRM or ERPNext on Hetzner VPS. Compare per-seat costs, break-even months, and infrastructure ROI."
  canonical="https://opencrmstack.pages.dev/"
  schemaJson={JSON.stringify(schemaData)}
>
  <!-- Hero Section -->
  <section class="pt-8 pb-12">
    <div class="text-center max-w-4xl mx-auto mb-10">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/25 text-emerald-400 text-xs font-mono uppercase tracking-wider mb-4">
        <span>⚡ 2026 RevOps Infrastructure &amp; Licensing Model</span>
      </div>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white mb-6 leading-tight">
        Open-Source CRM Total Cost of Ownership (TCO) &amp; Migration Calculator
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Empirical financial modeling and migration benchmarks for engineering and RevOps leaders replacing proprietary seat taxes with self-hosted Docker and PostgreSQL architectures.
      </p>
    </div>

    <!-- Featured Snippet Quick Answer Box (Exact 45-60 words with green accent border) -->
    <div class="max-w-4xl mx-auto mb-12">
      <div class="p-6 rounded-2xl bg-[#0C1322] border-2 border-emerald-500/80 shadow-xl shadow-emerald-950/30 relative overflow-hidden">
        <div class="absolute top-0 right-0 bg-emerald-500 text-slate-950 text-[10px] font-mono font-black uppercase px-3 py-1 rounded-bl-lg tracking-wider">
          Quick Answer &bull; Executive Summary
        </div>
        <div class="flex items-start space-x-3 mb-2.5">
          <div class="w-6 h-6 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm shrink-0 mt-0.5">
            ✓
          </div>
          <h2 class="text-base font-bold text-white tracking-wide">
            Open-Source CRM Migration ROI &amp; TCO Payback
          </h2>
        </div>
        <p class="text-sm sm:text-base text-slate-200 leading-relaxed pl-9 font-medium" id="snippet-text">
          Migrating to self-hosted open-source CRMs like Twenty CRM or ERPNext slashes three-year Total Cost of Ownership by 75% to 88% compared to Salesforce or HubSpot. Organizations eliminate per-seat licensing penalties and contact list tier taxes, paying only infrastructure and maintenance. Upfront migration investments typically achieve full financial break-even within four to seven months.
        </p>
        <div class="mt-3 pl-9 flex flex-wrap items-center gap-4 text-xs font-mono text-emerald-400">
          <span>&bull; Median Savings: 81.4%</span>
          <span>&bull; Break-even: 4.8 Months</span>
          <span>&bull; Hetzner VPS: $16/mo</span>
        </div>
      </div>
    </div>
    <!-- Interactive TCO Calculator -->
    <div id="calculator" class="max-w-5xl mx-auto bg-[#0F172A] rounded-2xl border border-slate-800 p-6 sm:p-8 shadow-2xl relative">
      <div class="border-b border-slate-800 pb-6 mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center space-x-2 mb-1">
            <span class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span>
            <h2 class="text-xl sm:text-2xl font-black text-white tracking-tight">
              Interactive 3-Year CRM TCO Simulator
            </h2>
          </div>
          <p class="text-xs sm:text-sm text-slate-400">
            Adjust your sales team size and contact database volume to calculate exact SaaS subscription vs. self-hosted deployment costs.
          </p>
        </div>

        <!-- Presets -->
        <div class="flex items-center gap-2">
          <span class="text-xs text-slate-400 font-mono">Presets:</span>
          <button type="button" class="preset-btn px-2.5 py-1 text-xs font-mono rounded bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700 transition" data-reps="5" data-contacts="5000">
            Startup (5)
          </button>
          <button type="button" class="preset-btn px-2.5 py-1 text-xs font-mono rounded bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/40 transition" data-reps="15" data-contacts="25000">
            Scaleup (15)
          </button>
          <button type="button" class="preset-btn px-2.5 py-1 text-xs font-mono rounded bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700 transition" data-reps="40" data-contacts="75000">
            Enterprise (40)
          </button>
        </div>
      </div>

      <!-- Controls Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
        <!-- Sales Reps Slider -->
        <div class="bg-[#090D16] p-5 rounded-xl border border-slate-800">
          <div class="flex justify-between items-center mb-3">
            <label for="reps-slider" class="text-sm font-bold text-slate-200 flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
              Sales Representatives / Paid Seats
            </label>
            <span id="reps-display" class="font-mono text-lg font-black text-emerald-400 px-2.5 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/30">
              15 Reps
            </span>
          </div>
          <input
            type="range"
            id="reps-slider"
            min="1"
            max="50"
            step="1"
            value="15"
            class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-emerald-500"
          />
          <div class="flex justify-between text-[11px] font-mono text-slate-500 mt-2">
            <span>1 Rep</span>
            <span>25 Reps</span>
            <span>50 Reps</span>
          </div>
          <p class="text-[11px] text-slate-400 mt-2">
            Proprietary CRMs charge per licensed seat ($150-$165/user/mo). Open-source models support unlimited users without incremental license fees.
          </p>
        </div>

        <!-- Marketing Contacts Slider -->
        <div class="bg-[#090D16] p-5 rounded-xl border border-slate-800">
          <div class="flex justify-between items-center mb-3">
            <label for="contacts-slider" class="text-sm font-bold text-slate-200 flex items-center gap-2">
              <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
              Marketing Contacts / Leads
            </label>
            <span id="contacts-display" class="font-mono text-lg font-black text-cyan-400 px-2.5 py-0.5 rounded bg-cyan-500/10 border border-cyan-500/30">
              25,000 Contacts
            </span>
          </div>
          <input
            type="range"
            id="contacts-slider"
            min="1000"
            max="100000"
            step="1000"
            value="25000"
            class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-cyan-500"
          />
          <div class="flex justify-between text-[11px] font-mono text-slate-500 mt-2">
            <span>1,000</span>
            <span>50,000</span>
            <span>100,000</span>
          </div>
          <p class="text-[11px] text-slate-400 mt-2">
            HubSpot charges steep contact tier premiums ($100 per 10k contacts). Self-hosted setups store unlimited records in PostgreSQL with Amazon SES at $0.10/1k emails.
          </p>
        </div>
      </div>

      <!-- Live Calculated Summary Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <!-- Salesforce -->
        <div class="p-5 rounded-xl bg-slate-900/90 border border-slate-800 hover:border-slate-700 transition flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Proprietary</span>
              <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-rose-500/10 text-rose-400 border border-rose-500/20">Enterprise</span>
            </div>
            <h3 class="text-base font-bold text-white mb-1">Salesforce Sales Cloud</h3>
            <p class="text-xs text-slate-400 mb-3">$165/seat/mo + Premier Admin + Storage</p>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-black font-mono text-rose-400 mb-1" id="salesforce-total">
              $132,300
            </div>
            <div class="text-[11px] font-mono text-slate-500">3-Year Estimated TCO</div>
          </div>
        </div>

        <!-- HubSpot -->
        <div class="p-5 rounded-xl bg-slate-900/90 border border-slate-800 hover:border-slate-700 transition flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Proprietary</span>
              <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">Sales + Marketing</span>
            </div>
            <h3 class="text-base font-bold text-white mb-1">HubSpot Enterprise</h3>
            <p class="text-xs text-slate-400 mb-3">$150/rep/mo + Marketing Tier + Onboard</p>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-black font-mono text-amber-400 mb-1" id="hubspot-total">
              $224,400
            </div>
            <div class="text-[11px] font-mono text-slate-500">3-Year Estimated TCO</div>
          </div>
        </div>

        <!-- Twenty CRM -->
        <div class="p-5 rounded-xl bg-[#091522] border-2 border-emerald-500/70 shadow-lg shadow-emerald-950/40 flex flex-col justify-between relative">
          <div class="absolute -top-3 right-4 px-2 py-0.5 bg-emerald-500 text-slate-950 text-[10px] font-black rounded-full font-mono uppercase tracking-wider">
            Best Modern OSS
          </div>
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono uppercase tracking-wider text-emerald-400">Self-Hosted OSS</span>
              <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">Hetzner VPS</span>
            </div>
            <h3 class="text-base font-bold text-white mb-1">Twenty CRM Stack</h3>
            <p class="text-xs text-slate-400 mb-3">Docker Compose + Postgres + SES</p>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-black font-mono text-emerald-400 mb-1" id="twenty-total">
              $20,296
            </div>
            <div class="text-[11px] font-mono text-emerald-300/80 font-semibold">3-Year Total Cost (Hosting + Maint)</div>
          </div>
        </div>

        <!-- ERPNext -->
        <div class="p-5 rounded-xl bg-slate-900/90 border border-slate-800 hover:border-slate-700 transition flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono uppercase tracking-wider text-cyan-400">Self-Hosted OSS</span>
              <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">Frappe Suite</span>
            </div>
            <h3 class="text-base font-bold text-white mb-1">ERPNext + CRM</h3>
            <p class="text-xs text-slate-400 mb-3">Full ERP + Invoicing + CRM Pipeline</p>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-black font-mono text-cyan-400 mb-1" id="erpnext-total">
              $23,896
            </div>
            <div class="text-[11px] font-mono text-slate-500">3-Year Total Cost</div>
          </div>
        </div>
      </div>
      <!-- High-Impact ROI & Break-Even Callout Banner -->
      <div class="p-6 rounded-xl bg-gradient-to-r from-emerald-950/60 via-slate-900 to-teal-950/60 border border-emerald-500/40 mb-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center md:text-left">
          <div class="border-b md:border-b-0 md:border-r border-slate-800/80 pb-4 md:pb-0 md:pr-6">
            <span class="text-xs font-mono text-slate-400 uppercase tracking-wider block mb-1">Net 3-Year Capital Savings</span>
            <div class="text-3xl sm:text-4xl font-black font-mono text-emerald-400" id="savings-amount">
              +$158,054
            </div>
            <p class="text-xs text-slate-400 mt-1">Versus proprietary SaaS blended average</p>
          </div>

          <div class="border-b md:border-b-0 md:border-r border-slate-800/80 pb-4 md:pb-0 md:pr-6">
            <span class="text-xs font-mono text-slate-400 uppercase tracking-wider block mb-1">Migration Break-Even Period</span>
            <div class="text-3xl sm:text-4xl font-black font-mono text-cyan-400" id="breakeven-months">
              4.6 Months
            </div>
            <p class="text-xs text-slate-400 mt-1">Full payback on $6,500 initial ETL &amp; setup</p>
          </div>

          <div class="flex flex-col justify-center">
            <span class="text-xs font-mono text-slate-400 uppercase tracking-wider block mb-1">3-Year TCO Reduction Ratio</span>
            <div class="text-3xl sm:text-4xl font-black font-mono text-white" id="percentage-savings">
              88.6%
            </div>
            <p class="text-xs text-emerald-400 font-semibold mt-1">Retain 100% data sovereignty &amp; API freedom</p>
          </div>
        </div>
      </div>

      <!-- Granular Itemized Cost Breakdown Table -->
      <div class="overflow-x-auto">
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4 flex items-center gap-2">
          <span>📊 Itemized Cost Architecture (3-Year Horizon)</span>
        </h4>
        <table class="w-full text-xs sm:text-sm text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-800 text-slate-400 font-mono text-[11px] uppercase">
              <th class="py-3 px-3">Expense Category</th>
              <th class="py-3 px-3 text-rose-400">Salesforce Enterprise</th>
              <th class="py-3 px-3 text-amber-400">HubSpot Enterprise</th>
              <th class="py-3 px-3 text-emerald-400">Twenty CRM (Self-Hosted)</th>
              <th class="py-3 px-3 text-cyan-400">ERPNext (Self-Hosted)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 font-mono text-slate-300">
            <tr>
              <td class="py-3 px-3 font-sans font-medium text-white">Software Licensing (3 Years)</td>
              <td class="py-3 px-3 text-slate-300" id="table-sf-license">$89,100</td>
              <td class="py-3 px-3 text-slate-300" id="table-hs-license">$81,000</td>
              <td class="py-3 px-3 text-emerald-400 font-bold">$0 (AGPL-3.0 OSS)</td>
              <td class="py-3 px-3 text-cyan-400 font-bold">$0 (GPL-3.0 OSS)</td>
            </tr>
            <tr>
              <td class="py-3 px-3 font-sans font-medium text-white">Contact Tier / Storage Surcharges</td>
              <td class="py-3 px-3 text-slate-300" id="table-sf-contacts">$10,200</td>
              <td class="py-3 px-3 text-slate-300" id="table-hs-contacts">$137,400</td>
              <td class="py-3 px-3 text-emerald-400" id="table-twenty-email">$1,440 (SES Email)</td>
              <td class="py-3 px-3 text-cyan-400" id="table-erpnext-email">$1,440 (SES Email)</td>
            </tr>
            <tr>
              <td class="py-3 px-3 font-sans font-medium text-white">VPS Infrastructure &amp; S3 Backups</td>
              <td class="py-3 px-3 text-slate-500">Included in SaaS</td>
              <td class="py-3 px-3 text-slate-500">Included in SaaS</td>
              <td class="py-3 px-3 text-emerald-400" id="table-twenty-vps">$836 (Hetzner CPX31)</td>
              <td class="py-3 px-3 text-cyan-400" id="table-erpnext-vps">$1,356 (Hetzner CPX41)</td>
            </tr>
            <tr>
              <td class="py-3 px-3 font-sans font-medium text-white">Initial Migration &amp; Setup (Year 1)</td>
              <td class="py-3 px-3 text-slate-300">$15,000 (Consultant)</td>
              <td class="py-3 px-3 text-slate-300">$6,000 (Mandatory Onboard)</td>
              <td class="py-3 px-3 text-slate-300">$6,500 (ETL &amp; Docker)</td>
              <td class="py-3 px-3 text-slate-300">$8,500 (Frappe Setup)</td>
            </tr>
            <tr>
              <td class="py-3 px-3 font-sans font-medium text-white">Ongoing DevOps &amp; Upgrades</td>
              <td class="py-3 px-3 text-slate-300">$18,000 (Admin Support)</td>
              <td class="py-3 px-3 text-slate-500">Self-Managed SaaS</td>
              <td class="py-3 px-3 text-slate-300">$11,520 ($320/mo)</td>
              <td class="py-3 px-3 text-slate-300">$12,600 ($350/mo)</td>
            </tr>
            <tr class="bg-slate-900/60 font-bold">
              <td class="py-3.5 px-3 font-sans text-white">Total 3-Year Investment</td>
              <td class="py-3.5 px-3 text-rose-400 font-black" id="table-sf-total">$132,300</td>
              <td class="py-3.5 px-3 text-amber-400 font-black" id="table-hs-total">$224,400</td>
              <td class="py-3.5 px-3 text-emerald-400 font-black" id="table-twenty-total">$20,296</td>
              <td class="py-3.5 px-3 text-cyan-400 font-black" id="table-erpnext-total">$23,896</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <!-- Deep Architecture Comparison Matrix -->
  <section class="py-16 border-t border-slate-800/80">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight mb-3">
          Architecture &amp; Technical Capabilities Matrix
        </h2>
        <p class="text-sm text-slate-400 max-w-xl mx-auto">
          Comparing core data architecture, extensibility protocols, and governance standards across modern enterprise platforms.
        </p>
      </div>

      <div class="overflow-x-auto rounded-xl border border-slate-800 bg-[#0F172A]">
        <table class="w-full text-xs sm:text-sm text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-800 bg-slate-950/60 text-slate-400 font-mono text-[11px] uppercase">
              <th class="py-3.5 px-4">Dimension</th>
              <th class="py-3.5 px-4 text-emerald-400">Twenty CRM</th>
              <th class="py-3.5 px-4 text-cyan-400">ERPNext</th>
              <th class="py-3.5 px-4 text-amber-400">HubSpot Enterprise</th>
              <th class="py-3.5 px-4 text-rose-400">Salesforce Sales Cloud</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 text-slate-300">
            <tr>
              <td class="py-3.5 px-4 font-semibold text-white">License &amp; Ownership</td>
              <td class="py-3.5 px-4 text-emerald-400 font-mono">AGPL-3.0 (100% OSS)</td>
              <td class="py-3.5 px-4 text-cyan-400 font-mono">GPL-3.0 (100% OSS)</td>
              <td class="py-3.5 px-4 text-slate-400">Proprietary SaaS</td>
              <td class="py-3.5 px-4 text-slate-400">Proprietary SaaS</td>
            </tr>
            <tr>
              <td class="py-3.5 px-4 font-semibold text-white">Underlying Database</td>
              <td class="py-3.5 px-4 font-mono">PostgreSQL 16 + Hasura/GraphQL</td>
              <td class="py-3.5 px-4 font-mono">MariaDB 10.6 + Redis</td>
              <td class="py-3.5 px-4 text-slate-400">Black-box Multi-tenant</td>
              <td class="py-3.5 px-4 text-slate-400">Oracle / Proprietary Force.com</td>
            </tr>
            <tr>
              <td class="py-3.5 px-4 font-semibold text-white">Direct SQL / BI Access</td>
