---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  schemaJson?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description,
  canonical = "https://opencrmstack.pages.dev/",
  schemaJson,
  image = "/og-banner.png",
  type = "website"
} = Astro.props;

const canonicalUrl = canonical.endsWith('/') ? canonical : `${canonical}/`;
const ogImageUrl = image.startsWith('http') ? image : `https://opencrmstack.pages.dev${image.startsWith('/') ? '' : '/'}${image}`;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="OpenCRMStack" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- LLM Discovery -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Context Index" />

    <!-- Search Engine Verifications -->
    <meta name="google-site-verification" content="google-opencrmstack-verification" />
    <meta name="msvalidate.01" content="BING-OPENCRMSTACK-VERIFY" />
    <meta name="theme-color" content="#090D16" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Schema.org Structured Data -->
    {schemaJson && (
      <script type="application/ld+json" set:html={schemaJson} />
    )}

    <!-- Non-Blocking Fleet Telemetry Beacon -->
    <script is:inline>
      (function() {
        try {
          var payload = JSON.stringify({
            site: window.location.hostname,
            path: window.location.pathname,
            ref: document.referrer || "direct",
            screen: window.innerWidth + "x" + window.innerHeight,
            ts: Date.now()
          });
          var endpoint = "https://webhookwatch.vercel.app/api/track/";
          if (navigator.sendBeacon) {
            navigator.sendBeacon(endpoint, payload);
          } else {
            fetch(endpoint, { method: "POST", body: payload, keepalive: true, headers: { "Content-Type": "application/json" } }).catch(function(){});
          }
        } catch(e) {}
      })();
    </script>
      <link rel="alternate" type="application/rss+xml" title="RSS 2.0 Feed" href="/rss.xml" />
  </head>
  <body class="bg-[#090D16] text-slate-100 antialiased font-['Plus_Jakarta_Sans',sans-serif] selection:bg-emerald-500/30 selection:text-emerald-200 min-h-screen flex flex-col relative overflow-x-hidden">

    <!-- Ambient Visual Glows -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[900px] h-[360px] bg-gradient-to-b from-emerald-600/10 via-teal-600/5 to-transparent blur-[140px] pointer-events-none -z-10"></div>
    <div class="fixed top-96 -left-48 w-80 h-80 bg-emerald-500/5 blur-[120px] pointer-events-none -z-10"></div>
    <div class="fixed top-96 -right-48 w-80 h-80 bg-cyan-500/5 blur-[120px] pointer-events-none -z-10"></div>

    <!-- Announcement Bar -->
    <div class="border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-md text-xs py-2 px-4 text-center text-slate-400 flex items-center justify-center space-x-3">
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
        2026 TCO Benchmark
      </span>
      <span class="hidden sm:inline text-slate-300">HubSpot & Salesforce price hikes hit 14% this fiscal year.</span>
      <a href="/#calculator" class="text-emerald-400 hover:text-emerald-300 font-semibold underline underline-offset-2 transition">
        Calculate Self-Hosted ROI &rarr;
      </a>
    </div>

    <!-- Navigation Header -->
    <header class="border-b border-slate-800/80 bg-[#090D16]/90 backdrop-blur-xl sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center space-x-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-400 p-[1px] shadow-lg shadow-emerald-500/20 group-hover:shadow-emerald-500/40 transition duration-300">
            <div class="w-full h-full bg-[#0B1120] rounded-[11px] flex items-center justify-center font-mono font-black text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300 text-sm">
              &lt;CRM&gt;
            </div>
          </div>
          <div class="flex flex-col">
            <div class="flex items-center space-x-1.5">
              <span class="text-lg font-black tracking-tight text-white group-hover:text-emerald-400 transition">
                OpenCRM<span class="text-emerald-400">Stack</span>
              </span>
              <span class="text-[9px] uppercase font-mono font-bold px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/25">
                OSS ARCH
              </span>
            </div>
            <span class="text-[10px] font-mono text-slate-400 tracking-wider">Self-Hosted RevOps Architecture</span>
          </div>
        </a>

        <!-- Desktop Nav Links -->
        <nav class="hidden lg:flex items-center space-x-1 text-sm font-medium text-slate-300">
          <a href="/#calculator" class="px-3 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>TCO Calculator</span>
          </a>
          <a href="/twenty-crm-vs-hubspot-open-source-sales-pipeline-audit/" class="px-3 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition">
            Twenty vs HubSpot
          </a>
          <a href="/self-hosted-erpnext-vs-salesforce-cost-migration-breakdown/" class="px-3 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition">
            ERPNext vs Salesforce
          </a>
          <a href="/mautic-vs-hubspot-email-automation-deliverability-benchmark/" class="px-3 py-1.5 rounded-lg hover:text-white hover:bg-slate-800/60 transition">
            Mautic vs HubSpot
          </a>
        </nav>

        <!-- Right Action Items -->
        <div class="flex items-center space-x-2.5">
          <a
            href="/llms.txt"
            class="flex items-center space-x-1.5 px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-700/80 hover:border-emerald-500/60 text-xs font-mono text-emerald-400 shadow-sm transition"
            title="Machine-readable LLM Context Index"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>llms.txt</span>
          </a>
          <a
            href="/#calculator"
            class="inline-flex items-center px-3.5 py-1.5 rounded-lg bg-gradient-to-r from-emerald-500 to-teal-400 hover:from-emerald-400 hover:to-teal-300 text-slate-950 text-xs font-bold shadow-md shadow-emerald-500/20 transition"
          >
            Launch Calculator
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 py-8 w-full">
      <slot />
    </main>

    <!-- Site Footer -->
    <footer class="border-t border-slate-800/80 bg-[#05080F] mt-24 py-16 text-sm text-slate-400">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
          <!-- Column 1: Brand & Identity -->
          <div class="md:col-span-2">
            <div class="flex items-center space-x-3 mb-3">
              <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-emerald-500 to-teal-400 flex items-center justify-center font-mono font-bold text-slate-950 text-xs">
                CRM
              </div>
              <span class="text-base font-extrabold text-white">OpenCRM<span class="text-emerald-400">Stack</span></span>
            </div>
            <p class="text-xs text-slate-400 max-w-sm leading-relaxed mb-4">
              The independent engineering benchmark, Total Cost of Ownership (TCO) calculator, and migration runbook repository for modern open-source CRM and RevOps stacks.
            </p>
            <div class="inline-flex items-center space-x-2 px-2.5 py-1 rounded-md bg-slate-900 border border-slate-800 text-[11px] font-mono text-emerald-400">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span>100% Client-Side In-Browser Computation &bull; Zero Telemetry Leakage</span>
            </div>
          </div>

          <!-- Column 2: Architecture Guides -->
          <div>
            <h4 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Migration Runbooks</h4>
            <ul class="space-y-2 text-xs text-slate-400">
              <li><a href="/twenty-crm-vs-hubspot-open-source-sales-pipeline-audit/" class="hover:text-emerald-400 transition">Twenty CRM vs HubSpot Pipeline</a></li>
              <li><a href="/self-hosted-erpnext-vs-salesforce-cost-migration-breakdown/" class="hover:text-emerald-400 transition">ERPNext vs Salesforce Migration</a></li>
              <li><a href="/mautic-vs-hubspot-email-automation-deliverability-benchmark/" class="hover:text-emerald-400 transition">Mautic vs HubSpot Deliverability</a></li>
              <li><a href="/#calculator" class="hover:text-emerald-400 transition">Interactive TCO Calculator</a></li>
            </ul>
          </div>

          <!-- Column 3: Telemetry & Machine Discovery -->
          <div>
            <h4 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Discovery & Standards</h4>
            <ul class="space-y-2 text-xs text-slate-400">
              <li><a href="/llms.txt" class="hover:text-emerald-400 transition font-mono">/llms.txt</a></li>
              <li><a href="/robots.txt" class="hover:text-emerald-400 transition font-mono">/robots.txt</a></li>
              <li><a href="/sitemap.xml" class="hover:text-emerald-400 transition font-mono">/sitemap.xml</a></li>
              <li><a href="/8303260f1bf94264ac6d00aa93efde28.txt" class="hover:text-emerald-400 transition font-mono">IndexNow Key</a></li>
            </ul>
          </div>
        </div>

        <div class="border-t border-slate-800/80 pt-6 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-400 gap-4">
          <p>&copy; 2026 OpenCRMStack. Open-source enterprise RevOps models released under Apache 2.0 / MIT.</p>
          <p class="text-[11px] text-slate-400">Static Astro Engine &bull; Zero Server Latency &bull; Privacy Guaranteed</p>
        </div>
      </div>
    </footer>
  </body>
</html>
