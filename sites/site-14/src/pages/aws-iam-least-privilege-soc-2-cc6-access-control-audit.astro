---
import Layout from '../layouts/Layout.astro';

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "headline": "AWS IAM Least-Privilege for SOC 2 CC6.1: Terraform Templates & Access Reviews (2026)",
      "url": "https://site-14-sable.vercel.app/aws-iam-least-privilege-soc-2-cc6-access-control-audit/",
      "description": "Comprehensive engineering guide to implementing AWS IAM least-privilege access controls for SOC 2 Type II compliance under Trust Services Criteria CC6.1, CC6.2, and CC6.3. Includes production Terraform templates, IAM Permission Boundaries, and automated quarterly access review workflows.",
      "inLanguage": "en-US",
      "author": {
        "@type": "Organization",
        "name": "SOC2Ready Compliance Engineering Team",
        "url": "https://site-14-sable.vercel.app/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "SOC2Ready",
        "url": "https://site-14-sable.vercel.app/"
      },
      "datePublished": "2026-10-05T00:00:00Z",
      "dateModified": "2026-10-05T00:00:00Z"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What are the specific SOC 2 requirements for AWS IAM access controls?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SOC 2 Common Criteria 6.1 (Logical Access Security), 6.2 (User Registration & Access Revocation), and 6.3 (Access Modification & Least Privilege) require organizations to restrict access to production infrastructure strictly based on job roles, enforce multi-factor authentication (MFA), eliminate static root credentials, and conduct quarterly documented access reviews."
          }
        },
        {
          "@type": "Question",
          "name": "How do IAM Permission Boundaries assist in SOC 2 audits?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "IAM Permission Boundaries establish an immutable maximum ceiling of permissions that an IAM entity can ever possess. Auditors value Permission Boundaries because they prevent developers or automated CI/CD roles with policy-creation rights from performing privilege escalation (e.g. attaching AdministratorAccess to themselves)."
          }
        },
        {
          "@type": "Question",
          "name": "How can early-stage startups automate quarterly SOC 2 access reviews?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Startups can automate access reviews using GitHub Actions and AWS IAM Access Analyzer. A scheduled workflow queries IAM users and roles with inactive credentials (>90 days), generates an audit CSV report, and opens a GitHub Issue where the security lead marks approvals directly in git."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://site-14-sable.vercel.app/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Compliance Guides",
          "item": "https://site-14-sable.vercel.app/#guides"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "AWS IAM Least-Privilege Guide",
          "item": "https://site-14-sable.vercel.app/aws-iam-least-privilege-soc-2-cc6-access-control-audit/"
        }
      ]
    }
  ]
