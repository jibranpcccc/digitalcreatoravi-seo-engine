  <script is:inline>
    function updateAuditHealth() {
      const windowMonths = parseInt(document.getElementById('win-length').value) || 6;
      const headcount = parseInt(document.getElementById('win-headcount').value) || 40;
      const fails = parseInt(document.getElementById('win-fails').value) || 0;

      const totalDays = windowMonths * 30;
      const totalCycles = totalDays;
      const uptime = Math.max(0, Math.min(100, ((totalDays - fails) / totalDays) * 100));

      document.getElementById('out-samples').innerText = `${totalCycles} Test Cycles`;
      document.getElementById('out-uptime').innerText = `${uptime.toFixed(1)}%`;

      const riskEl = document.getElementById('out-risk');
      if (fails <= 3) {
        riskEl.innerText = 'LOW (Clean Opinion)';
        riskEl.className = 'text-lg font-bold text-emerald-400 font-mono mt-1';
      } else if (fails <= 8) {
        riskEl.innerText = 'MEDIUM (Auditor Notes)';
        riskEl.className = 'text-lg font-bold text-amber-400 font-mono mt-1';
      } else {
        riskEl.innerText = 'HIGH (Qualified Risk)';
        riskEl.className = 'text-lg font-bold text-rose-500 font-mono mt-1';
      }

      let cpaBase = 9000;
      if (windowMonths === 6) cpaBase = 12500;
      if (windowMonths === 12) cpaBase = 16000;
      if (headcount > 100) cpaBase += 4000;

      document.getElementById('out-cpacost').innerText = `$${cpaBase.toLocaleString()}`;
    }

    document.getElementById('win-length')?.addEventListener('change', updateAuditHealth);
    document.getElementById('win-headcount')?.addEventListener('input', updateAuditHealth);
    document.getElementById('win-fails')?.addEventListener('input', updateAuditHealth);
    updateAuditHealth();
  </script>
</Layout>
