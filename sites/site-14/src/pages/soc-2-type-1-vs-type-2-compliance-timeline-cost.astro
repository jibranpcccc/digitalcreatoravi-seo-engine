  type="article"
>
  <!-- Article Header -->
  <header class="pt-6 pb-10 border-b border-slate-800/80 mb-12">
    <div class="flex items-center space-x-2 text-xs font-mono text-emerald-400 mb-4">
      <a href="/" class="hover:underline text-slate-400">SOC2Ready</a>
      <span>/</span>
      <span class="text-emerald-400">Timeline & Cost Analysis</span>
