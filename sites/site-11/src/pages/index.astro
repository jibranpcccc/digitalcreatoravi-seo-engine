  <!-- Client-Side Search & Filtering Script -->
  <script is:inline>
    (function() {
      const searchInput = document.getElementById('searchInput');
      const regionButtons = document.querySelectorAll('.region-filter');
      const incomeButtons = document.querySelectorAll('.income-filter');
      const tableRows = document.querySelectorAll('.visa-row');
      const cards = document.querySelectorAll('.visa-card');
      const visaCounter = document.getElementById('visaCounter');
      const noResultsState = document.getElementById('noResultsState');
      const resetFiltersBtn = document.getElementById('resetFiltersBtn');
      const viewTableBtn = document.getElementById('viewTableBtn');
      const viewCardsBtn = document.getElementById('viewCardsBtn');
      const tableViewContainer = document.getElementById('tableViewContainer');
      const cardsViewContainer = document.getElementById('cardsViewContainer');

      let currentRegion = 'all';
      let currentIncome = 'all';
      let searchQuery = '';

      function filterItems() {
        let visibleCount = 0;

        // Filter Table Rows
        tableRows.forEach(function(row) {
          const name = row.getAttribute('data-name') || '';
          const region = row.getAttribute('data-region') || '';
          const incomeTier = row.getAttribute('data-income-tier') || '';
          const tax = row.getAttribute('data-tax') || '';
          const highlights = row.getAttribute('data-highlights') || '';

          const matchesRegion = currentRegion === 'all' || region === currentRegion;
          const matchesIncome = currentIncome === 'all' || incomeTier === currentIncome;
          const matchesSearch = searchQuery === '' || 
            name.includes(searchQuery) || 
            region.toLowerCase().includes(searchQuery) || 
            tax.includes(searchQuery) || 
            highlights.includes(searchQuery);

          if (matchesRegion && matchesIncome && matchesSearch) {
            row.style.display = '';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });

        // Filter Cards (synced)
        cards.forEach(function(card) {
          const name = card.getAttribute('data-name') || '';
          const region = card.getAttribute('data-region') || '';
          const incomeTier = card.getAttribute('data-income-tier') || '';
          const tax = card.getAttribute('data-tax') || '';
          const highlights = card.getAttribute('data-highlights') || '';

          const matchesRegion = currentRegion === 'all' || region === currentRegion;
          const matchesIncome = currentIncome === 'all' || incomeTier === currentIncome;
          const matchesSearch = searchQuery === '' || 
            name.includes(searchQuery) || 
            region.toLowerCase().includes(searchQuery) || 
            tax.includes(searchQuery) || 
            highlights.includes(searchQuery);

          if (matchesRegion && matchesIncome && matchesSearch) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });

        // Update Counter
        if (visaCounter) {
          visaCounter.textContent = 'Showing ' + visibleCount + ' of 38 Visas';
        }

        // Toggle No Results
        if (noResultsState) {
          if (visibleCount === 0) {
            noResultsState.classList.remove('hidden');
            if (tableViewContainer) tableViewContainer.classList.add('hidden');
            if (cardsViewContainer) cardsViewContainer.classList.add('hidden');
          } else {
            noResultsState.classList.add('hidden');
            if (isCardView) {
              if (cardsViewContainer) cardsViewContainer.classList.remove('hidden');
              if (tableViewContainer) tableViewContainer.classList.add('hidden');
            } else {
              if (tableViewContainer) tableViewContainer.classList.remove('hidden');
              if (cardsViewContainer) cardsViewContainer.classList.add('hidden');
            }
          }
        }
      }

      // Live Search Event
      if (searchInput) {
        searchInput.addEventListener('input', function(e) {
          searchQuery = e.target.value.toLowerCase().trim();
          filterItems();
        });
      }

      // Region Filter Buttons
      regionButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          regionButtons.forEach(function(b) {
            b.classList.remove('active', 'bg-amber-500', 'text-slate-950', 'font-bold');
            b.classList.add('bg-slate-800', 'text-slate-300');
          });
          btn.classList.add('active', 'bg-amber-500', 'text-slate-950', 'font-bold');
          btn.classList.remove('bg-slate-800', 'text-slate-300');
          currentRegion = btn.getAttribute('data-region') || 'all';
          filterItems();
        });
      });

      // Income Filter Buttons
      incomeButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          incomeButtons.forEach(function(b) {
            b.classList.remove('active', 'bg-amber-500', 'text-slate-950', 'font-bold');
            b.classList.add('bg-slate-800', 'text-slate-300');
          });
          btn.classList.add('active', 'bg-amber-500', 'text-slate-950', 'font-bold');
          btn.classList.remove('bg-slate-800', 'text-slate-300');
          currentIncome = btn.getAttribute('data-income') || 'all';
          filterItems();
        });
      });

      // Reset Button
      if (resetFiltersBtn) {
        resetFiltersBtn.addEventListener('click', function() {
          if (searchInput) searchInput.value = '';
          searchQuery = '';
          currentRegion = 'all';
          currentIncome = 'all';

          regionButtons.forEach(function(b, i) {
            if (i === 0) {
              b.classList.add('active', 'bg-amber-500', 'text-slate-950', 'font-bold');
              b.classList.remove('bg-slate-800', 'text-slate-300');
            } else {
              b.classList.remove('active', 'bg-amber-500', 'text-slate-950', 'font-bold');
              b.classList.add('bg-slate-800', 'text-slate-300');
            }
          });

          incomeButtons.forEach(function(b, i) {
            if (i === 0) {
              b.classList.add('active', 'bg-amber-500', 'text-slate-950', 'font-bold');
              b.classList.remove('bg-slate-800', 'text-slate-300');
            } else {
              b.classList.remove('active', 'bg-amber-500', 'text-slate-950', 'font-bold');
              b.classList.add('bg-slate-800', 'text-slate-300');
            }
          });

          filterItems();
        });
      }

      // View Toggle
      let isCardView = false;
      if (viewTableBtn && viewCardsBtn) {
        viewTableBtn.addEventListener('click', function() {
          isCardView = false;
          viewTableBtn.classList.add('bg-amber-500', 'text-slate-950');
          viewTableBtn.classList.remove('text-slate-400');
          viewCardsBtn.classList.remove('bg-amber-500', 'text-slate-950');
          viewCardsBtn.classList.add('text-slate-400');
          if (tableViewContainer) tableViewContainer.classList.remove('hidden');
          if (cardsViewContainer) cardsViewContainer.classList.add('hidden');
        });

        viewCardsBtn.addEventListener('click', function() {
          isCardView = true;
          viewCardsBtn.classList.add('bg-amber-500', 'text-slate-950');
          viewCardsBtn.classList.remove('text-slate-400');
          viewTableBtn.classList.remove('bg-amber-500', 'text-slate-950');
          viewTableBtn.classList.add('text-slate-400');
          if (cardsViewContainer) cardsViewContainer.classList.remove('hidden');
          if (tableViewContainer) tableViewContainer.classList.add('hidden');
        });
      }

      // Country Modal Logic
      const modal = document.getElementById('countryModal');
      const modalContent = document.getElementById('modalContent');
      const closeModalBtn = document.getElementById('closeModalBtn');

      document.querySelectorAll('.open-modal-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          try {
            const data = JSON.parse(btn.getAttribute('data-country') || '{}');
            if (modalContent) {
              modalContent.innerHTML = `
                <div class="flex items-center gap-3 mb-4">
                  <span class="text-4xl">${data.flag || '🛂'}</span>
                  <div>
                    <h3 class="text-2xl font-bold text-white">${data.name}</h3>
                    <span class="text-xs text-amber-400 font-mono">${data.region} • ${data.incomeTier}</span>
                  </div>
                </div>
                <div class="space-y-3 bg-slate-950 p-4 rounded-xl border border-slate-800 text-xs mb-4">
                  <div class="flex justify-between border-b border-slate-800 pb-2">
                    <span class="text-slate-400">Monthly Minimum Income:</span>
                    <span class="font-bold text-amber-400 font-mono text-sm">${data.monthlyIncomeDisplay}</span>
                  </div>
                  <div class="flex justify-between border-b border-slate-800 pb-2">
                    <span class="text-slate-400">Statutory Duration:</span>
                    <span class="text-white font-medium">${data.duration}</span>
                  </div>
                  <div class="flex justify-between border-b border-slate-800 pb-2">
                    <span class="text-slate-400">Processing Lead Time:</span>
                    <span class="text-white font-mono">${data.processingTime}</span>
                  </div>
                  <div class="flex justify-between pt-1">
                    <span class="text-slate-400">Tax Treatment:</span>
                    <span class="text-emerald-400 font-semibold">${data.taxExemption}</span>
                  </div>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed mb-4">${data.highlights}</p>
                <p class="text-[11px] text-slate-500">Statutory verification source: Consular immigration service directives 2026.</p>
              `;
            }
            if (modal) modal.classList.remove('hidden');
          } catch(e) {}
        });
      });

      if (closeModalBtn && modal) {
        closeModalBtn.addEventListener('click', function() {
          modal.classList.add('hidden');
        });
        modal.addEventListener('click', function(e) {
          if (e.target === modal) modal.classList.add('hidden');
        });
      }
    })();
  </script>
</Layout>
