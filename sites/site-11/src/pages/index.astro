const datasetSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "Global Digital Nomad Visa Index & Income Threshold Database",
  "description": "Comprehensive comparative statutory dataset tracking remote work visa requirements, minimum monthly income thresholds, processing timelines, and tax exemption structures across 38 sovereign jurisdictions worldwide.",
  "url": "https://nomadpassportindex.netlify.app/",
  "keywords": [
    "Digital Nomad Visa",
    "Income Requirements",
    "Remote Work Visa Database",
    "Tax Exemption for Nomads",
    "Beckham Law Spain",
    "Japan DNV",
    "Schengen Nomad Visas"
  ],
  "creator": {
    "@type": "Organization",
    "name": "NomadPassportIndex Research Group",
    "url": "https://nomadpassportindex.netlify.app"
  },
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "temporalCoverage": "2026",
  "spatialCoverage": "Global",
  "variableMeasured": [
    "Monthly Minimum Income Threshold in USD and Local Currency",
    "Statutory Visa Duration and Renewal Paths",
    "Consular and In-Country Processing Lead Time",
    "Expatriate Tax Exemption or Flat Rate Regime"
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the lowest income threshold for a European Digital Nomad Visa in 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Albania offers one of the lowest entry hurdles in Europe with a $1,200 monthly requirement, followed by Montenegro at approximately €1,400 ($1,500/mo) and the Czech Republic Zivno license requiring proof of around €1,650/mo in equivalent assets. Inside the Schengen Zone, Croatia requires €2,539 ($2,750) per month with a 100% local income tax exemption."
      }
    },
    {
      "@type": "Question",
      "name": "How is remote income verified during the digital nomad visa application process?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Immigration ministries require certified bank statements covering the previous 3 to 6 consecutive months, stamped employment contracts or freelance service level agreements (SLAs), and official company registration documents proving the hiring business is located outside the host country. Self-employed nomads must also present client invoices and certificate of good standing."
      }
    },
    {
      "@type": "Question",
      "name": "Do digital nomad visas exempt holders from paying local income taxes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tax policies vary significantly. Croatia, Costa Rica, and Bermuda provide complete 100% tax exemptions on foreign income. Spain provides a reduced 24% flat tax under the modified Beckham Law for up to 6 years. Japan exempts digital nomads under bilateral tax treaties for stays under 183 days, whereas other countries trigger full domestic tax residency once you stay beyond 183 days."
      }
    },
    {
      "@type": "Question",
      "name": "Can digital nomads travel freely across Europe's Schengen Area?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, a national long-stay (Type D) digital nomad visa or temporary residency permit issued by a Schengen member state (such as Spain, Portugal, Croatia, Greece, or Italy) allows you to travel freely throughout the entire 29-nation Schengen Zone for up to 90 days in any rolling 180-day window."
      }
    }
  ]
};

const combinedSchema = {
  "@context": "https://schema.org",
  "@graph": [datasetSchema, faqSchema]
};
