            <h3 class="text-sm font-bold text-white mb-2">Can I rent a long-term apartment in Japan with the Digital Nomad Visa?</h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Because digital nomads do not receive a standard Resident Card (在留カード, <em>Zairyu Card</em>) or Certificate of Residence (住民票, <em>Juminhyo</em>), leasing conventional Japanese residential real estate is difficult. Most nomads utilize furnished monthly apartments, co-living spaces, or short-term platforms that do not require domestic guarantor companies.
            </p>
          </div>
          <div class="border border-slate-800 rounded-xl p-4 bg-slate-900/40">
            <h3 class="text-sm font-bold text-white mb-2">Can I open a Japanese bank account during my 6 months?</h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              No. Japanese banks (under Foreign Exchange and Foreign Trade Act regulations) require non-residents to have lived in Japan for at least 6 months and possess a Resident Card to open regular savings accounts. Nomads must rely on international multi-currency debit accounts (e.g., Wise, Revolut) and foreign credit cards.
            </p>
          </div>
          <div class="border border-slate-800 rounded-xl p-4 bg-slate-900/40">
            <h3 class="text-sm font-bold text-white mb-2">Can I transition from tourist visa status directly to the DNV while inside Japan?</h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              No. Change of Status (在留資格変更許可) from Temporary Visitor to Designated Activities is generally rejected by regional immigration offices. You must apply for the visa at a Japanese Embassy or Consulate General in your country of citizenship or permanent legal residence.
            </p>
          </div>
        </div>
      </section>

    </div>
  </article>

  <script is:inline>
    const fxRates = {
      USD: 152.0,
      EUR: 165.0,
      GBP: 195.0,
      AUD: 100.0,
      CAD: 111.0,
      SGD: 115.0
    };

    function updateJapanCalc() {
      const curr = document.getElementById('curr-select').value;
      const annualIncome = parseFloat(document.getElementById('annual-income').value) || 0;
      const passport = document.getElementById('passport-select').value;

      const rate = fxRates[curr] || 150.0;
      const totalJpy = annualIncome * rate;
      const surplus = totalJpy - 10000000;

      document.getElementById('res-jpy').innerText = '¥' + Math.round(totalJpy).toLocaleString();

      const surplusEl = document.getElementById('res-surplus');
      if (surplus >= 0) {
        surplusEl.innerText = '+¥' + Math.round(surplus).toLocaleString();
        surplusEl.className = 'text-lg font-bold text-emerald-400 font-mono mt-1';
      } else {
        surplusEl.innerText = '-¥' + Math.round(Math.abs(surplus)).toLocaleString();
        surplusEl.className = 'text-lg font-bold text-rose-400 font-mono mt-1';
      }

      const evalEl = document.getElementById('res-eval');
      if (passport === 'treaty' && totalJpy >= 10000000) {
        const pct = Math.round((totalJpy / 10000000) * 100);
        evalEl.innerText = `QUALIFIED (${pct}%)`;
        evalEl.className = 'text-lg font-bold text-emerald-400 font-mono mt-1';
      } else if (passport !== 'treaty') {
        evalEl.innerText = 'NO TREATY';
        evalEl.className = 'text-lg font-bold text-rose-400 font-mono mt-1';
      } else {
        evalEl.innerText = 'INCOME DEFICIT';
        evalEl.className = 'text-lg font-bold text-amber-400 font-mono mt-1';
      }
    }

    document.getElementById('curr-select')?.addEventListener('change', updateJapanCalc);
    document.getElementById('annual-income')?.addEventListener('input', updateJapanCalc);
    document.getElementById('passport-select')?.addEventListener('change', updateJapanCalc);
  </script>
</Layout>
