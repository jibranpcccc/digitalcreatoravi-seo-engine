            <span>🇬🇧 United Kingdom</span>
            <span>🇦🇺 Australia</span>
            <span>🇳🇿 New Zealand</span>
            <span>🇸🇬 Singapore</span>
            <span>🇩🇪 Germany</span>
            <span>🇫🇷 France</span>
