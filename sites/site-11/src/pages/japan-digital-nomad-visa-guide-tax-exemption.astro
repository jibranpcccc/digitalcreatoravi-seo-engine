const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "Japan Digital Nomad Visa Guide: Tax Exemption & ¥10M Income Criteria",
  "description": "Statutory legal guide to Japan's 6-month Digital Nomad Visa (Specified Activities). Details on the ¥10 million JPY income threshold, 0% tax exemption under bilateral tax treaties, and mandatory private insurance.",
  "url": "https://nomadpassportindex.netlify.app/japan-digital-nomad-visa-guide-tax-exemption/",
  "datePublished": "2026-02-10T09:00:00+09:00",
  "dateModified": "2026-09-06T12:00:00+01:00",
  "author": {
    "@type": "Organization",
    "name": "NomadPassportIndex Legal Research Group",
    "url": "https://nomadpassportindex.netlify.app"
  },
  "publisher": {
    "@type": "Organization",
    "name": "NomadPassportIndex",
    "url": "https://nomadpassportindex.netlify.app"
  },
  "inLanguage": "en-US"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Who is eligible for Japan's Digital Nomad Visa?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Eligibility requires citizenship in one of the 49 nations that maintain both a bilateral Double Taxation Avoidance Agreement (DTA) with Japan and mutual visa-exemption arrangements. Applicants must earn at least ¥10,000,000 JPY (approximately $68,000 USD) in annualized gross income and hold private medical insurance with at least ¥10 million in emergency coverage."
      }
    },
    {
      "@type": "Question",
      "name": "Are digital nomads required to pay local taxes in Japan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Because the Japan Digital Nomad Visa has a maximum non-extendable validity of six months (180 days), visa holders never trigger domestic tax residency under the statutory 183-day rule. Under Japan's bilateral tax treaties, remote workers remain non-residents and are completely exempt from Japanese national income tax and local inhabitant municipal taxes (Juminzei)."
      }
    },
    {
      "@type": "Question",
      "name": "Can Japan's Digital Nomad Visa be renewed or extended from inside Japan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The visa is strictly issued for up to 6 months and cannot be renewed or extended while staying in Japan. Holders must depart Japan upon expiration. However, nomads may reapply for a new digital nomad visa from abroad after spending at least six continuous months outside Japan (the cooling-off period)."
      }
    },
    {
      "@type": "Question",
      "name": "Can I bring my spouse and children on the Japan Digital Nomad Visa?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Spouses and dependent children can accompany the primary nomad under a designated 'Designated Activities (Dependent)' status. Dependents must also be citizens of eligible treaty countries and carry equivalent private medical insurance coverage."
      }
    }
  ]
};

const combinedSchema = {
  "@context": "https://schema.org",
  "@graph": [articleSchema, faqSchema]
};
