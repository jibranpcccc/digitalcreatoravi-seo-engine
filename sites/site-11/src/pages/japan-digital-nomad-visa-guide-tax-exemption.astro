        <div class="text-xl font-bold text-white font-mono mt-1">6 Months</div>
        <div class="text-[11px] text-slate-400">Strict non-renewable stay</div>
      </div>
      <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
