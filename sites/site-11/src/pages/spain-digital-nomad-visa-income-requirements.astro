---
import Layout from '../layouts/Layout.astro';

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "Spain Digital Nomad Visa: Income Requirements, Beckham Law & 2026 Guide",
  "description": "Comprehensive statutory guide to Spain's Digital Nomad Visa (Ley de Startups). Learn the 2026 200% SMI income calculations, Beckham Law 24% tax regime, UGE 20-day in-country fast track, and documentation checklist.",
  "url": "https://nomadpassportindex.netlify.app/spain-digital-nomad-visa-income-requirements/",
  "datePublished": "2026-01-15T08:00:00+01:00",
  "dateModified": "2026-09-06T12:00:00+01:00",
  "author": {
    "@type": "Organization",
    "name": "NomadPassportIndex Legal Research Group",
    "url": "https://nomadpassportindex.netlify.app"
  },
  "publisher": {
    "@type": "Organization",
    "name": "NomadPassportIndex",
    "url": "https://nomadpassportindex.netlify.app"
  },
  "inLanguage": "en-US"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the exact monthly income required for Spain's Digital Nomad Visa in 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For 2026, the primary applicant must prove an income of at least 200% of Spain's Salario Mínimo Interprofesional (SMI), which translates to approximately €2,646 per month (or €31,752 annually). Bringing a spouse requires an additional 75% of the SMI (+€992/mo), and each dependent child requires an additional 25% (+€331/mo)."
      }
    },
    {
      "@type": "Question",
      "name": "How does the Beckham Law tax benefit work for digital nomads in Spain?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under the modified Beckham Law (Special Expatriate Tax Regime under Law 28/2022), eligible digital nomads are taxed at a flat rate of 24% on Spanish-source income up to €600,000 for up to 6 consecutive tax years, rather than progressive resident rates climbing up to 47%. Foreign investment income, capital gains, and real estate outside Spain remain completely exempt from Spanish wealth and income taxation."
      }
    },
    {
      "@type": "Question",
      "name": "Can US remote employees (W-2) obtain the Spanish Digital Nomad Visa?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, but with specific structuring. The Spanish Social Security Administration requires either a Certificate of Coverage under a bilateral totalization agreement or proof that the foreign employer has registered with Spanish Social Security. Because the US-Spain Social Security Agreement does not currently cover remote W-2 telework, many American nomads transition to an independent contractor (1099) structure or utilize an Employer of Record (EOR) with a Spanish entity."
      }
    },
    {
      "@type": "Question",
      "name": "Should I apply at a Spanish Consulate abroad or directly in Spain?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Applying in-country via the UGE-CE (Unidad de Grandes Empresas y Colectivos Estratégicos) while legally present as a tourist grants an immediate 3-year residence permit and benefits from the statutory 'positive administrative silence' (silencio administrativo positivo), which automatically approves applications if no decision is issued within 20 working days. Consular applications abroad issue a 1-year visa that must subsequently be converted into a residence card."
      }
    }
  ]
};

const combinedSchema = {
  "@context": "https://schema.org",
  "@graph": [articleSchema, faqSchema]
};
