        <div class="text-[11px] text-slate-400">200% National SMI</div>
      </div>
      <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
        <div class="text-xs text-slate-400">Permit Validity</div>
        <div class="text-xl font-bold text-white font-mono mt-1">3 Years</div>
