              <th class="p-3 text-cyan-400">OpenAI (3072-dim)</th>
              <th class="p-3 text-indigo-400">OpenAI (1024-dim MRL)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 font-mono text-xs">
            <tr>
              <td class="p-3 text-white font-sans">Initial Ingestion (100M Tokens)</td>
