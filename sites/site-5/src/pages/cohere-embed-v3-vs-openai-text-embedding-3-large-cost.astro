        function recalculateVectorRAM() {
          const vectors = parseFloat(document.getElementById('calc-vectors').value);
          const dims = parseFloat(document.getElementById('calc-dims').value);
          const bytesPerDim = parseFloat(document.getElementById('calc-quant').value);

          // Raw vector data in GB
          const rawBytes = vectors * dims * bytesPerDim;
          const rawGB = rawBytes / (1024 * 1024 * 1024);

          // HNSW graph overhead: ~32 links * 8 bytes + 16 bytes overhead = ~272 bytes per vector
          // For binary, graph overhead is roughly 60% lower due to compact scalar quantization
          const graphBytesPerVector = bytesPerDim < 1 ? 120 : 280;
          const hnswBytes = vectors * graphBytesPerVector;
          const hnswGB = hnswBytes / (1024 * 1024 * 1024);

          const totalGB = (rawGB + hnswGB) * 1.25; // 25% OS buffer headroom

          document.getElementById('res-raw-ram').textContent = rawGB.toFixed(2) + " GB";
          document.getElementById('res-hnsw-ram').textContent = hnswGB.toFixed(2) + " GB";
          document.getElementById('res-total-ram').textContent = totalGB.toFixed(2) + " GB";

          // Instance pricing estimation based on AWS r6g pricing ($0.0504 per GB RAM-hour)
          let estCost = Math.round(totalGB * 5.8);
          if (estCost < 25) estCost = 25;
          document.getElementById('res-monthly-cost').textContent = "$" + estCost + " / mo";
        }

        document.getElementById('calc-vectors').addEventListener('change', recalculateVectorRAM);
        document.getElementById('calc-dims').addEventListener('change', recalculateVectorRAM);
        document.getElementById('calc-quant').addEventListener('change', recalculateVectorRAM);
      </script>

