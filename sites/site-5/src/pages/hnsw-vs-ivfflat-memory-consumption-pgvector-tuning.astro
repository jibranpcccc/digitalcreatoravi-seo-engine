            <th class="px-5 py-3 font-bold text-white">Performance Metric</th>
            <th class="px-5 py-3 font-bold text-teal-400">HNSW (m=16, ef_c=64)</th>
            <th class="px-5 py-3 font-bold text-amber-400">IVFFlat (lists=1000, p=10)</th>
            <th class="px-5 py-3 font-bold text-cyan-400">IVFFlat (lists=1000, p=50)</th>
            <th class="px-5 py-3 font-bold text-slate-300">Variance / Production Impact</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800 text-xs font-mono">
