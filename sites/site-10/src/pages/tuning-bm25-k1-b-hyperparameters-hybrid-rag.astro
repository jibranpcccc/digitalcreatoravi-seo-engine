              <td class="p-3 font-mono text-purple-300">0.35</td>
              <td class="p-3">61.2</td>
              <td class="p-3 text-emerald-400 font-bold">66.8</td>
              <td class="p-3 text-emerald-300 font-bold">+5.6%</td>
            </tr>
