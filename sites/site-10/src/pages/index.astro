---
import Layout from '../layouts/Layout.astro';

const softwareAppSchema = {
  "@type": "SoftwareApplication",
  "name": "RAGInspect Chunking & Embedding Visualizer",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Any",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Interactive developer utility to simulate semantic chunking, fixed-token window segmentation, and evaluate embedding retrieval accuracy metrics."
};

const techArticleSchema = {
  "@type": "TechArticle",
  "headline": "RAG Pipeline Inspector: Semantic Chunking & Retrieval Leaderboard",
  "description": "Empirical benchmark measuring semantic chunking algorithms, dense vector embedding models, and hybrid search retrieval accuracy for production RAG pipelines.",
  "datePublished": "2026-09-01T00:00:00Z",
  "dateModified": "2026-09-06T00:00:00Z",
  "author": {
    "@type": "Organization",
    "name": "RAGInspect Research Labs"
  }
};

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is semantic chunking and how does it outperform fixed-size chunking in RAG?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Semantic chunking breaks text based on semantic similarity breakpoints calculated from embedding vector cosine distance between adjacent sentences, rather than arbitrary character counts. This prevents splitting coherent facts across chunks, boosting top-5 retrieval accuracy by 9% to 15% on complex documents."
      }
    },
    {
      "@type": "Question",
      "name": "Which embedding model achieves the highest retrieval accuracy on MTEB in 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In our rigorous retrieval benchmark tests, Voyage-3 ranks highest with an 89.2% Hit Rate @ 5 and an MTEB score of 68.4, followed closely by OpenAI text-embedding-3-large at 87.6% and Cohere Embed v3 at 86.8%."
      }
    },
    {
      "@type": "Question",
      "name": "Why is hybrid search (BM25 + Dense Vectors) recommended for production RAG?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Dense embeddings capture conceptual synonyms but frequently fail on exact keywords, part numbers, error codes, and legal clauses. Combining BM25 lexical inverted index scores with dense vector cosine similarity via Reciprocal Rank Fusion (RRF) eliminates zero-recall anomalies on out-of-vocabulary terms."
      }
    },
    {
      "@type": "Question",
      "name": "What is the optimal chunk overlap percentage for RAG?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For fixed-size windowing (e.g., 512 tokens), a 10% to 15% overlap (50 to 75 tokens) provides optimal boundary preservation without inflating vector index storage costs or redundant LLM context window token spend."
      }
    }
  ]
};

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [softwareAppSchema, techArticleSchema, faqSchema]
};

const embeddingModels = [
  {
    name: "Voyage-3",
    provider: "Voyage AI",
    category: "Proprietary",
    dimensions: "1,024",
    contextWindow: "32,000",
    hitRate5: "89.2%",
    mrr: "0.784",
    mtebScore: "68.4",
    cost1M: "$0.120",
    p95Latency: "48 ms",
    badge: "Leader",
    badgeColor: "bg-amber-500/10 text-amber-400 border-amber-500/30",
    bestFor: "Enterprise retrieval & domain adaptation"
  },
  {
    name: "text-embedding-3-large",
    provider: "OpenAI",
    category: "Proprietary",
    dimensions: "3,072 (1,536)",
    contextWindow: "8,191",
    hitRate5: "87.6%",
    mrr: "0.758",
    mtebScore: "64.6",
    cost1M: "$0.130",
    p95Latency: "52 ms",
    badge: "Matryoshka",
    badgeColor: "bg-emerald-500/10 text-emerald-400 border-emerald-500/30",
    bestFor: "General multilingual knowledge bases"
  },
  {
    name: "Cohere Embed v3",
    provider: "Cohere",
    category: "Proprietary",
    dimensions: "1,024",
    contextWindow: "512",
    hitRate5: "86.8%",
    mrr: "0.749",
    mtebScore: "64.5",
    cost1M: "$0.100",
    p95Latency: "41 ms",
    badge: "Compression",
    badgeColor: "bg-purple-500/10 text-purple-400 border-purple-500/30",
    bestFor: "Binary/Int8 quantization & search-first RAG"
  },
  {
    name: "BGE-M3",
    provider: "BAAI",
    category: "Open-Weights",
    dimensions: "1,024",
    contextWindow: "8,192",
    hitRate5: "85.9%",
    mrr: "0.732",
    mtebScore: "64.1",
    cost1M: "$0.00 (Self)",
    p95Latency: "28 ms*",
    badge: "Open Source",
    badgeColor: "bg-cyan-500/10 text-cyan-400 border-cyan-500/30",
    bestFor: "On-premise multi-functional dense + sparse"
  },
  {
    name: "text-embedding-004",
    provider: "Google",
    category: "Proprietary",
    dimensions: "768",
    contextWindow: "2,048",
    hitRate5: "86.1%",
    mrr: "0.738",
    mtebScore: "64.3",
    cost1M: "$0.025",
    p95Latency: "39 ms",
    badge: "High Value",
    badgeColor: "bg-blue-500/10 text-blue-400 border-blue-500/30",
    bestFor: "High-volume budget RAG workloads"
  },
  {
    name: "Jina Embeddings v3",
    provider: "Jina AI",
    category: "Open-Weights",
    dimensions: "1,024",
    contextWindow: "8,192",
    hitRate5: "85.4%",
    mrr: "0.729",
    mtebScore: "63.8",
    cost1M: "$0.020",
    p95Latency: "44 ms",
    badge: "LoRA Adapters",
    badgeColor: "bg-rose-500/10 text-rose-400 border-rose-500/30",
    bestFor: "Task-specific task adapters & asymmetric search"
  }
];
---

<Layout
  title="RAG Pipeline Inspector: Semantic Chunking & Retrieval Leaderboard"
  description="Empirical benchmark measuring semantic chunking algorithms, embedding model retrieval accuracy (Voyage-3, OpenAI, Cohere, BGE-M3), and hybrid search fusion."
  schema={pageSchema}
>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-16 overflow-hidden border-b border-slate-800/80 bg-gradient-to-b from-slate-900/60 via-slate-950 to-slate-950">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-900/20 via-transparent to-transparent pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-mono mb-4">
        <span>v2.4 Benchmark Update</span> • <span>10,000 Synthetic & Technical Queries</span>
      </div>

      <!-- Exactly ONE h1 tag -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-tight max-w-4xl">
        RAG Pipeline Inspector: <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-purple-300 to-cyan-400">Semantic Chunking & Retrieval Leaderboard</span>
      </h1>

      <p class="mt-4 text-base sm:text-lg text-slate-300 max-w-3xl leading-relaxed">
        Stop guessing chunk boundaries and vector dimensions. Measure empirical Hit Rate @ 5, Mean Reciprocal Rank (MRR), and semantic breakpoint integrity with live client-side simulation.
      </p>

      <!-- Quick Answer Featured Snippet (45-60 words) -->
      <div class="mt-8 p-5 sm:p-6 rounded-2xl bg-indigo-950/40 border border-indigo-500/30 shadow-2xl relative">
        <div class="flex items-center gap-2 text-indigo-400 text-xs font-bold uppercase tracking-wider mb-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          Quick Answer: What Optimizes RAG Retrieval Accuracy?
        </div>
        <p class="text-slate-200 text-sm sm:text-base leading-relaxed">
          A RAG pipeline retrieves domain context for LLMs to generate grounded answers. Optimization hinges on chunking strategy and embedding accuracy. Semantic chunking prevents context fragmentation across sentence boundaries, while hybrid search combining dense vectors with BM25 keyword scoring yields up to 89% retrieval precision, mitigating LLM hallucinations and reducing pipeline token overhead.
        </p>
        <div class="mt-3 flex flex-wrap gap-4 text-xs text-indigo-300 font-mono">
          <span>Semantic vs Fixed: +12.4% Recall</span>
          <span>•</span>
          <span>BM25 Hybrid Lift: +8.1% MRR</span>
          <span>•</span>
          <span>Optimal Overlap: 10-15%</span>
        </div>
      </div>

      <!-- Quick Jump Cards -->
      <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/semantic-chunking-vs-fixed-size-rag-benchmarks/" class="p-4 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-indigo-500/50 hover:bg-slate-900 transition-all group">
          <div class="flex items-center justify-between text-xs font-mono text-indigo-400 mb-1">
            <span>Guide 01</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <h3 class="font-bold text-white text-sm group-hover:text-indigo-300 transition-colors">Semantic vs Fixed Chunking</h3>
          <p class="text-xs text-slate-400 mt-1">Breakpoint distance algorithms vs sliding token windows across 100k tokens.</p>
        </a>

        <a href="/hybrid-search-bm25-vs-dense-vector-accuracy/" class="p-4 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-cyan-500/50 hover:bg-slate-900 transition-all group">
          <div class="flex items-center justify-between text-xs font-mono text-cyan-400 mb-1">
            <span>Guide 02</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <h3 class="font-bold text-white text-sm group-hover:text-cyan-300 transition-colors">Hybrid Search: BM25 + Dense</h3>
          <p class="text-xs text-slate-400 mt-1">Reciprocal Rank Fusion (RRF) vs linear convex combinations in vector DBs.</p>
        </a>

        <a href="/ragas-vs-trulens-rag-evaluation-frameworks/" class="p-4 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-purple-500/50 hover:bg-slate-900 transition-all group">
          <div class="flex items-center justify-between text-xs font-mono text-purple-400 mb-1">
            <span>Guide 03</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <h3 class="font-bold text-white text-sm group-hover:text-purple-300 transition-colors">Ragas vs TruLens Eval</h3>
          <p class="text-xs text-slate-400 mt-1">LLM-as-a-judge latency, cost, and automated CI/CD hallucination auditing.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Client-Side Chunking Visualizer Tool -->
  <section id="visualizer" class="py-16 border-b border-slate-800/80 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
        <div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-indigo-500/10 text-indigo-400 text-xs font-mono mb-2">
            Interactive Engineering Utility
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-white">Client-Side Chunking Visualizer & Simulator</h2>
          <p class="text-slate-400 text-sm mt-1 max-w-2xl">
            Simulate how text documents decompose under fixed window vs semantic cosine breakpoint threshold segmentation in real-time.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <span class="text-xs text-slate-400 font-mono">Sample Corpus:</span>
          <button id="preset-fin" class="preset-btn px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-xs text-slate-200 border border-slate-700 active:bg-indigo-600 transition-colors">Financial 10-K</button>
          <button id="preset-tech" class="preset-btn px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-xs text-slate-200 border border-slate-700 active:bg-indigo-600 transition-colors">API Architecture</button>
          <button id="preset-med" class="preset-btn px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-xs text-slate-200 border border-slate-700 active:bg-indigo-600 transition-colors">Clinical Protocol</button>
        </div>
      </div>

      <!-- Visualizer Dashboard Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Controls Panel (5 Cols) -->
        <div class="lg:col-span-5 space-y-6 bg-slate-900/90 border border-slate-800 p-6 rounded-2xl shadow-xl">
          <div class="border-b border-slate-800 pb-4">
            <label class="text-xs font-bold text-slate-300 uppercase tracking-wider block mb-2">Chunking Strategy Algorithm</label>
            <div class="grid grid-cols-2 gap-2">
              <button id="mode-fixed" class="mode-btn active px-3 py-2 rounded-xl text-xs font-semibold border transition-all bg-indigo-600 text-white border-indigo-500 shadow">
                Fixed Token Window
              </button>
              <button id="mode-semantic" class="mode-btn px-3 py-2 rounded-xl text-xs font-semibold border transition-all bg-slate-800 text-slate-300 border-slate-700 hover:border-indigo-500/50">
                Semantic Breakpoint
              </button>
            </div>
          </div>

          <!-- Slider 1: Chunk Size -->
          <div>
            <div class="flex justify-between items-center mb-1.5">
              <label for="slider-size" class="text-xs font-bold text-slate-200">Target Chunk Size (Tokens)</label>
              <span id="val-size" class="text-xs font-mono font-bold text-indigo-400 bg-indigo-950/60 px-2 py-0.5 rounded border border-indigo-800/60">384 tokens</span>
            </div>
            <input id="slider-size" type="range" min="128" max="1024" step="64" value="384" class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-indigo-500" />
            <div class="flex justify-between text-[10px] text-slate-400 font-mono mt-1">
              <span>128 (Atomic)</span>
              <span>512 (Standard)</span>
              <span>1024 (Long)</span>
            </div>
          </div>

          <!-- Slider 2: Overlap -->
          <div>
            <div class="flex justify-between items-center mb-1.5">
              <label for="slider-overlap" class="text-xs font-bold text-slate-200">Chunk Overlap Window</label>
              <span id="val-overlap" class="text-xs font-mono font-bold text-cyan-400 bg-cyan-950/60 px-2 py-0.5 rounded border border-cyan-800/60">48 tokens (12.5%)</span>
            </div>
            <input id="slider-overlap" type="range" min="0" max="192" step="16" value="48" class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-500" />
            <div class="flex justify-between text-[10px] text-slate-400 font-mono mt-1">
              <span>0% (No Overlap)</span>
              <span>12.5% (Optimal)</span>
              <span>25% (Redundant)</span>
            </div>
          </div>

          <!-- Slider 3: Semantic Cosine Threshold -->
          <div id="cosine-container" class="opacity-60 transition-opacity">
            <div class="flex justify-between items-center mb-1.5">
              <label for="slider-threshold" class="text-xs font-bold text-slate-200">Cosine Distance Split Threshold (0.0 - 1.0)</label>
              <span id="val-threshold" class="text-xs font-mono font-bold text-purple-400 bg-purple-950/60 px-2 py-0.5 rounded border border-purple-800/60">0.75 cutoff</span>
            </div>
            <input id="slider-threshold" type="range" min="0.50" max="0.95" step="0.05" value="0.75" class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-purple-500" />
            <div class="flex justify-between text-[10px] text-slate-400 font-mono mt-1">
              <span>0.50 (Coarse)</span>
              <span>0.75 (Balanced)</span>
              <span>0.95 (Granular)</span>
            </div>
          </div>

          <!-- Real-Time Metrics Output Card -->
          <div class="pt-4 border-t border-slate-800">
            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Live Simulation Telemetry</div>
            <div class="grid grid-cols-3 gap-2 text-center">
              <div class="p-2.5 rounded-xl bg-slate-950/80 border border-slate-800">
                <div class="text-[10px] text-slate-400 uppercase font-mono">Chunks</div>
                <div id="metric-chunks" class="text-lg font-bold text-white font-mono mt-0.5">4</div>
              </div>
              <div class="p-2.5 rounded-xl bg-slate-950/80 border border-slate-800">
                <div class="text-[10px] text-slate-400 uppercase font-mono">Avg Length</div>
                <div id="metric-avg" class="text-lg font-bold text-indigo-400 font-mono mt-0.5">82 w</div>
              </div>
              <div class="p-2.5 rounded-xl bg-slate-950/80 border border-slate-800">
                <div class="text-[10px] text-slate-400 uppercase font-mono">Waste Ratio</div>
                <div id="metric-waste" class="text-lg font-bold text-emerald-400 font-mono mt-0.5">11.4%</div>
              </div>
            </div>
            <div class="mt-3 p-2.5 rounded-xl bg-slate-950/50 border border-slate-800/80 text-[11px] text-slate-400 flex items-center justify-between font-mono">
              <span>Est. Vector Storage:</span>
              <span id="metric-vectors" class="text-slate-200 font-bold">4.1 KB @ 1024-dim</span>
            </div>
          </div>
        </div>

        <!-- Interactive Preview & Text Viewport (7 Cols) -->
        <div class="lg:col-span-7 flex flex-col space-y-4">
          <!-- Text Input Area -->
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-xl flex flex-col">
            <div class="flex justify-between items-center mb-2">
              <label for="corpus-input" class="text-xs font-bold text-slate-300 uppercase tracking-wider">Source Document Text</label>
              <span class="text-[11px] font-mono text-slate-400" id="raw-word-count">328 words • ~436 tokens</span>
            </div>
            <textarea id="corpus-input" rows="5" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-xs text-slate-300 font-mono leading-relaxed focus:outline-none focus:border-indigo-500 transition-colors resize-y">The Federal Reserve Open Market Committee (FOMC) convened on September 15 to assess prevailing macroeconomic indicators, headline inflation persistence, and liquidity distributions across credit facilities. The primary benchmark interest rate remained anchored at the 5.25% to 5.50% target corridor, reflecting persistent stabilization in non-farm payroll expansions. Concurrently, commercial banking entities reported tightened underwriting standards for non-recourse industrial real estate and multi-family construction loans. Corporate debt issuance saw weighted refinancing coupons escalate to 6.85%, exerting measurable pressure on leveraged capital structures and interest-coverage covenants. Secondary market liquidity in high-yield debt spreads contracted by 18 basis points over the trailing quarterly cycle, as institutional portfolio managers rotated allocations into front-end Treasury bills and sovereign liquid reserves. Furthermore, cross-border remittance clearing volumes registered a 4.2% annualized velocity decline, signaling cautious consumer sentiment across retail credit cards and unsecured auto loan portfolios.</textarea>
          </div>

          <!-- Dynamic Chunk Visualization Output -->
          <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl flex-grow flex flex-col">
            <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-4">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
                <span class="text-xs font-bold text-white uppercase tracking-wider">Partitioned Chunk Segments</span>
              </div>
              <span class="text-[11px] font-mono text-slate-400">Click a chunk to inspect vector metadata</span>
            </div>

            <!-- Chunk Cards Container -->
            <div id="chunks-container" class="space-y-3 overflow-y-auto max-h-[380px] pr-1">
              <!-- Dynamically populated via JS -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Embedding Model Leaderboard -->
  <section id="leaderboard" class="py-16 border-b border-slate-800/80 bg-slate-950/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
        <div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-mono mb-2">
            MTEB & Enterprise Retrieval Benchmarks
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-white">Dense Embedding Model Leaderboard (2026)</h2>
          <p class="text-slate-400 text-sm mt-1 max-w-2xl">
            Normalized evaluation across 10,000 multi-turn queries. Testing Hit Rate @ 5, Mean Reciprocal Rank (MRR), latency, and cost per 1M tokens.
          </p>
        </div>

        <!-- Filter Controls -->
        <div class="flex items-center gap-2">
          <button id="filter-all" class="filter-btn active px-3 py-1.5 rounded-lg text-xs font-semibold bg-indigo-600 text-white border border-indigo-500">All Models</button>
          <button id="filter-prop" class="filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 text-slate-300 border border-slate-700 hover:border-indigo-500/40">Proprietary</button>
          <button id="filter-open" class="filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 text-slate-300 border border-slate-700 hover:border-indigo-500/40">Open-Weights</button>
        </div>
      </div>

      <!-- Responsive Leaderboard Table -->
      <div class="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-900/60 shadow-2xl">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="border-b border-slate-800 bg-slate-900/90 text-[11px] font-mono text-slate-400 uppercase tracking-wider">
              <th class="py-3.5 px-4 font-semibold">Model & Provider</th>
              <th class="py-3.5 px-3 font-semibold text-center">Dimensions</th>
              <th class="py-3.5 px-3 font-semibold text-center">Max Tokens</th>
              <th class="py-3.5 px-3 font-semibold text-center">Hit Rate @ 5</th>
              <th class="py-3.5 px-3 font-semibold text-center">MRR</th>
              <th class="py-3.5 px-3 font-semibold text-center">MTEB Score</th>
              <th class="py-3.5 px-3 font-semibold text-center">Cost / 1M Tokens</th>
              <th class="py-3.5 px-3 font-semibold text-center">Latency (p95)</th>
              <th class="py-3.5 px-4 font-semibold">Optimal Deployment</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80 text-xs font-sans">
            {embeddingModels.map((m) => (
              <tr class="hover:bg-slate-800/40 transition-colors model-row" data-category={m.category}>
                <td class="py-4 px-4 font-medium text-white">
                  <div class="flex items-center gap-2">
                    <span class="font-bold text-sm text-slate-100">{m.name}</span>
                    <span class={`text-[10px] px-2 py-0.5 rounded-full border font-mono ${m.badgeColor}`}>
                      {m.badge}
                    </span>
                  </div>
                  <div class="text-[11px] text-slate-400 font-mono mt-0.5">{m.provider} • {m.category}</div>
                </td>
                <td class="py-4 px-3 text-center font-mono text-slate-300">{m.dimensions}</td>
                <td class="py-4 px-3 text-center font-mono text-slate-300">{m.contextWindow}</td>
                <td class="py-4 px-3 text-center font-mono font-bold text-emerald-400 text-sm bg-emerald-500/5">{m.hitRate5}</td>
                <td class="py-4 px-3 text-center font-mono text-indigo-300">{m.mrr}</td>
                <td class="py-4 px-3 text-center font-mono font-bold text-cyan-400 text-sm">{m.mtebScore}</td>
                <td class="py-4 px-3 text-center font-mono text-slate-200">{m.cost1M}</td>
                <td class="py-4 px-3 text-center font-mono text-slate-400">{m.p95Latency}</td>
                <td class="py-4 px-4 text-slate-400 text-[11px] leading-tight max-w-[200px]">{m.bestFor}</td>
              </tr>
            ))}
