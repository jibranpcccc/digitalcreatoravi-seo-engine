  <!-- Client-Side Script for Chunking Visualizer & Filtering -->
  <script is:inline>
    (function() {
      // Elements
      var sliderSize = document.getElementById('slider-size');
      var sliderOverlap = document.getElementById('slider-overlap');
      var sliderThreshold = document.getElementById('slider-threshold');
      var valSize = document.getElementById('val-size');
      var valOverlap = document.getElementById('val-overlap');
      var valThreshold = document.getElementById('val-threshold');
      var modeFixed = document.getElementById('mode-fixed');
      var modeSemantic = document.getElementById('mode-semantic');
      var cosineContainer = document.getElementById('cosine-container');
      var corpusInput = document.getElementById('corpus-input');
      var chunksContainer = document.getElementById('chunks-container');
      var metricChunks = document.getElementById('metric-chunks');
      var metricAvg = document.getElementById('metric-avg');
      var metricWaste = document.getElementById('metric-waste');
      var metricVectors = document.getElementById('metric-vectors');
      var rawWordCount = document.getElementById('raw-word-count');

      var currentMode = 'fixed'; // 'fixed' or 'semantic'

      var presets = {
        fin: "The Federal Reserve Open Market Committee (FOMC) convened on September 15 to assess prevailing macroeconomic indicators, headline inflation persistence, and liquidity distributions across credit facilities. The primary benchmark interest rate remained anchored at the 5.25% to 5.50% target corridor, reflecting persistent stabilization in non-farm payroll expansions. Concurrently, commercial banking entities reported tightened underwriting standards for non-recourse industrial real estate and multi-family construction loans. Corporate debt issuance saw weighted refinancing coupons escalate to 6.85%, exerting measurable pressure on leveraged capital structures and interest-coverage covenants. Secondary market liquidity in high-yield debt spreads contracted by 18 basis points over the trailing quarterly cycle, as institutional portfolio managers rotated allocations into front-end Treasury bills and sovereign liquid reserves. Furthermore, cross-border remittance clearing volumes registered a 4.2% annualized velocity decline, signaling cautious consumer sentiment across retail credit cards and unsecured auto loan portfolios.",
        tech: "Modern distributed consensus architectures employ Paxos or Raft state machine replication protocols to maintain linearizable transactional consistency across Byzantine fault-tolerant clusters. In a typical Raft cluster deployment consisting of five node replicas, an elected leader heartbeat mechanism broadcasts AppendEntries RPC messages at 50ms intervals to prevent randomized follower election timeouts. When client write transactions arrive at the leader, uncommitted log entries are sequenced into a local write-ahead log (WAL) buffer before simultaneous transmission to quorum peers. A state transition becomes permanently committed only once a strict majority (n/2 + 1 = 3 nodes) acknowledges durable fsync disk persistence. In the event of an unannounced network partition isolating the leader into a minority enclave, higher term election counters initiated by majority partitions automatically supersede stale leases, preventing split-brain corruption.",
        med: "Phase III double-blind randomized clinical trial protocol NCT-05492147 evaluates the therapeutic efficacy and pharmacokinetic safety profile of dual-targeted monoclonal antibody antagonist mAb-729 in patients exhibiting refractory metastatic adenocarcinoma. Subjects received 15 mg/kg intravenous infusions bi-weekly across a 24-week observational period alongside standardized carboplatin-paclitaxel doublet chemotherapy. Primary endpoints measured progression-free survival (PFS) categorized under RECIST v1.1 criteria via contrast-enhanced volumetric CT scans performed at 6-week intervals. Secondary endpoints assessed overall response rate (ORR), durable complete response duration, and treatment-emergent adverse events (TEAE) graded according to CTCAE v5.0 guidelines. Circulating tumor DNA (ctDNA) liquid biopsy assays monitored somatic mutation variant allele frequencies (VAF) within KRAS codon 12 and TP53 exons 5 through 8."
      };

      function updateUI() {
        var text = corpusInput.value.trim();
        var words = text.split(/\s+/).filter(Boolean);
        var totalWords = words.length;
        var estTokens = Math.round(totalWords * 1.33);
        rawWordCount.textContent = totalWords + ' words • ~' + estTokens + ' tokens';

        var size = parseInt(sliderSize.value, 10);
        var overlap = parseInt(sliderOverlap.value, 10);
        var threshold = parseFloat(sliderThreshold.value);

        valSize.textContent = size + ' tokens';
        var pct = size > 0 ? ((overlap / size) * 100).toFixed(1) : 0;
        valOverlap.textContent = overlap + ' tokens (' + pct + '%)';
        valThreshold.textContent = threshold.toFixed(2) + ' cutoff';

        var chunks = [];

        if (currentMode === 'fixed') {
          // Fixed size in approximate words (size / 1.33)
          var wordsPerChunk = Math.max(15, Math.round(size / 1.33));
          var wordsOverlap = Math.min(wordsPerChunk - 5, Math.round(overlap / 1.33));
          var step = Math.max(10, wordsPerChunk - wordsOverlap);

          for (var i = 0; i < words.length; i += step) {
            var chunkWords = words.slice(i, i + wordsPerChunk);
            if (chunkWords.length > 0) {
              chunks.push({
                text: chunkWords.join(' '),
                words: chunkWords.length,
                tokens: Math.round(chunkWords.length * 1.33),
                startIndex: i,
                isOverlap: i > 0 && wordsOverlap > 0
              });
            }
            if (i + wordsPerChunk >= words.length) break;
          }
        } else {
          // Semantic breakpoint mode based on sentence delimiters and threshold
          var sentences = text.match(/[^.!?]+[.!?]+/g) || [text];
          var currentChunkSentences = [];
          var currentWords = 0;
          var targetWords = Math.round(size / 1.33);

          sentences.forEach(function(sentence, idx) {
            var sWords = sentence.trim().split(/\s+/).length;
            // Simulated semantic distance break: if sentence adds too much or simulated distance exceeds threshold
            var simDistance = 0.5 + ((idx * 17) % 45) / 100; // deterministic pseudo-distance [0.50, 0.95]
            var shouldBreak = (currentWords + sWords > targetWords) || (simDistance > threshold && currentWords > 30);

            if (shouldBreak && currentChunkSentences.length > 0) {
              var cText = currentChunkSentences.join(' ').trim();
              var cWords = cText.split(/\s+/).length;
              chunks.push({
                text: cText,
                words: cWords,
                tokens: Math.round(cWords * 1.33),
                distance: simDistance.toFixed(2)
              });
              currentChunkSentences = [];
              currentWords = 0;
            }
            currentChunkSentences.push(sentence.trim());
            currentWords += sWords;
          });

          if (currentChunkSentences.length > 0) {
            var lastText = currentChunkSentences.join(' ').trim();
            var lastWords = lastText.split(/\s+/).length;
            chunks.push({
              text: lastText,
              words: lastWords,
              tokens: Math.round(lastWords * 1.33),
              distance: '0.62'
            });
          }
        }

        // Render Chunks
        chunksContainer.innerHTML = '';
        var totalChunkWords = 0;
        var colors = [
          'border-indigo-500/40 bg-indigo-950/20 text-indigo-300',
          'border-cyan-500/40 bg-cyan-950/20 text-cyan-300',
          'border-purple-500/40 bg-purple-950/20 text-purple-300',
          'border-emerald-500/40 bg-emerald-950/20 text-emerald-300',
          'border-amber-500/40 bg-amber-950/20 text-amber-300'
        ];

        chunks.forEach(function(chunk, idx) {
          totalChunkWords += chunk.words;
          var colorClass = colors[idx % colors.length];
          var div = document.createElement('div');
          div.className = 'p-3 rounded-xl border text-xs leading-relaxed transition-all hover:bg-slate-900 ' + colorClass;
          
          var header = '<div class="flex justify-between items-center text-[10px] font-mono mb-1.5 opacity-80">' +
            '<span>Chunk #' + (idx + 1) + '</span>' +
            '<span>' + chunk.words + ' words • ~' + chunk.tokens + ' tokens' + (chunk.distance ? ' • dist: ' + chunk.distance : '') + '</span>' +
            '</div>';
          
          var body = '<p class="text-slate-200">' + chunk.text + '</p>';
          div.innerHTML = header + body;
          chunksContainer.appendChild(div);
        });

        // Telemetry calculation
        metricChunks.textContent = chunks.length;
        var avg = chunks.length > 0 ? Math.round(totalChunkWords / chunks.length) : 0;
        metricAvg.textContent = avg + ' w';

        var totalChunkTokens = Math.round(totalChunkWords * 1.33);
        var rawTokens = Math.round(totalWords * 1.33);
        var waste = rawTokens > 0 ? (((totalChunkTokens - rawTokens) / rawTokens) * 100).toFixed(1) : 0;
        metricWaste.textContent = (waste < 0 ? 0 : waste) + '%';
        metricWaste.className = 'text-lg font-bold font-mono mt-0.5 ' + (waste > 20 ? 'text-amber-400' : 'text-emerald-400');

        var kb = ((chunks.length * 1024 * 4) / 1024).toFixed(1);
        metricVectors.textContent = chunks.length + ' vectors (' + kb + ' KB @ 1024-dim)';
      }

      // Event Listeners
      sliderSize.addEventListener('input', updateUI);
      sliderOverlap.addEventListener('input', updateUI);
      sliderThreshold.addEventListener('input', updateUI);
      corpusInput.addEventListener('input', updateUI);

      modeFixed.addEventListener('click', function() {
        currentMode = 'fixed';
        modeFixed.className = 'mode-btn active px-3 py-2 rounded-xl text-xs font-semibold border transition-all bg-indigo-600 text-white border-indigo-500 shadow';
        modeSemantic.className = 'mode-btn px-3 py-2 rounded-xl text-xs font-semibold border transition-all bg-slate-800 text-slate-300 border-slate-700 hover:border-indigo-500/50';
        cosineContainer.classList.add('opacity-40');
        updateUI();
      });

      modeSemantic.addEventListener('click', function() {
        currentMode = 'semantic';
        modeSemantic.className = 'mode-btn active px-3 py-2 rounded-xl text-xs font-semibold border transition-all bg-indigo-600 text-white border-indigo-500 shadow';
        modeFixed.className = 'mode-btn px-3 py-2 rounded-xl text-xs font-semibold border transition-all bg-slate-800 text-slate-300 border-slate-700 hover:border-indigo-500/50';
        cosineContainer.classList.remove('opacity-40');
        updateUI();
      });

      document.getElementById('preset-fin').addEventListener('click', function() {
        corpusInput.value = presets.fin;
        updateUI();
      });
      document.getElementById('preset-tech').addEventListener('click', function() {
        corpusInput.value = presets.tech;
        updateUI();
      });
      document.getElementById('preset-med').addEventListener('click', function() {
        corpusInput.value = presets.med;
        updateUI();
      });

      // Filter Leaderboard
      var filterAll = document.getElementById('filter-all');
      var filterProp = document.getElementById('filter-prop');
      var filterOpen = document.getElementById('filter-open');
      var rows = document.querySelectorAll('.model-row');

      function setFilter(activeBtn, cat) {
        [filterAll, filterProp, filterOpen].forEach(function(b) {
          b.className = 'filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 text-slate-300 border border-slate-700 hover:border-indigo-500/40';
        });
        activeBtn.className = 'filter-btn active px-3 py-1.5 rounded-lg text-xs font-semibold bg-indigo-600 text-white border border-indigo-500';

        rows.forEach(function(r) {
          if (cat === 'all' || r.getAttribute('data-category') === cat) {
            r.style.display = '';
          } else {
            r.style.display = 'none';
          }
        });
      }

      filterAll.addEventListener('click', function() { setFilter(filterAll, 'all'); });
      filterProp.addEventListener('click', function() { setFilter(filterProp, 'Proprietary'); });
      filterOpen.addEventListener('click', function() { setFilter(filterOpen, 'Open-Weights'); });

      // Init
      updateUI();
    })();
  </script>
</Layout>
