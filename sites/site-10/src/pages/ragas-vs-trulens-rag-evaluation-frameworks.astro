---
import Layout from '../layouts/Layout.astro';

const articleSchema = {
  "@type": "TechArticle",
  "headline": "Ragas vs TruLens: Automated RAG Pipeline Evaluation Framework Comparison",
  "description": "Architectural benchmark comparing Ragas and TruLens for automated LLM-as-a-judge RAG evaluation. Analysis of Context Precision, Groundedness, token cost, and CI/CD testing.",
  "datePublished": "2026-09-04T00:00:00Z",
  "dateModified": "2026-09-06T00:00:00Z",
  "author": {
    "@type": "Organization",
    "name": "RAGInspect Research Labs"
  }
};

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the key architectural difference between Ragas and TruLens?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ragas focuses on offline dataset benchmarking and synthetic evaluation set generation with isolated component metrics (Context Precision, Context Recall, Faithfulness). TruLens focuses on full-lifecycle observability, wrapping chain executions with instrumentation to record feedback functions and the RAG Triad in real-time."
      }
    },
    {
      "@type": "Question",
      "name": "What is the TruLens RAG Triad?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The TruLens RAG Triad consists of three fundamental verification checks: Context Relevance (is retrieved context relevant to the user query?), Groundedness (is the generated answer supported exclusively by the retrieved context?), and Answer Relevance (does the response directly address the user's inquiry?)."
      }
    },
    {
      "@type": "Question",
      "name": "How much does LLM-as-a-judge evaluation cost per 1,000 QA pairs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Using lightweight models like GPT-4o-mini or Claude 3.5 Haiku as judges, running a full 4-metric evaluation across 1,000 question-answer pairs costs approximately $1.80 to $2.60 in API tokens and executes in 2.5 minutes under parallel batching."
      }
    }
  ]
};

const combinedSchema = {
  "@context": "https://schema.org",
  "@graph": [articleSchema, faqSchema]
};

const frameworkComparison = [
  {
    feature: "Primary Design Focus",
    ragas: "Offline Batch Benchmark & Test-Set Gen",
    trulens: "Full Lifecycle Tracing & Live Telemetry",
    winner: "Context-dependent"
  },
  {
    feature: "Core Triad Metrics",
    ragas: "Context Precision, Recall, Faithfulness, Relevance",
    trulens: "Context Relevance, Groundedness, Answer Relevance",
    winner: "Ragas (More Granular)"
  },
  {
    feature: "Synthetic Test-Set Generation",
    ragas: "Native Evol-Instruct Pipeline (Multi-hop, Reasoning)",
    trulens: "Basic or requires external datasets",
    winner: "Ragas"
  },
  {
    feature: "Real-Time App Instrumentation",
    ragas: "Requires custom callbacks / LangSmith",
    trulens: "Native TruChain, TruLlama, TruCustom App wrappers",
    winner: "TruLens"
  },
  {
    feature: "Dashboard & Visualization UI",
    ragas: "Pandas dataframe export / Langfuse / Arize",
    trulens: "Streamlit-based TruLens Dashboard included",
    winner: "TruLens"
  },
  {
    feature: "LLM Judge Token Consumption",
    ragas: "~1,850 tokens / evaluated sample (4 metrics)",
    trulens: "~1,420 tokens / evaluated sample (3 metrics)",
    winner: "TruLens (23% Cheaper)"
  },
  {
    feature: "CI/CD Gate Integration",
    ragas: "Native pytest assertion plugins",
    trulens: "TruLens CLI & SQLite/Postgres assertion runner",
    winner: "Ragas (Simpler CI scripts)"
  }
];
