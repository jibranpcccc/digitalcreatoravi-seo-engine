          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="border-b border-slate-800 bg-slate-900/90 font-mono text-slate-400 uppercase tracking-wider">
                <th class="py-3 px-4">Evaluation Dimension</th>
                <th class="py-3 px-4 text-indigo-300">Ragas Framework</th>
                <th class="py-3 px-4 text-purple-300">TruLens Framework</th>
